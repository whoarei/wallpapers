{
  "id": "poem-7010df49ffa3ec202e72a380",
  "title": "傅家林",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "樵斧响晴雷，平林顷刻摧。",
    "兔亡三穴徙，猿吊一枝哀。",
    "桑梓思前辈，松杉惜上林。",
    "养林如养德，万木盍重栽。"
  ],
  "enabled": true,
  "collection": "宋诗选",
