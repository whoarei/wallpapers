{
  "id": "poem-ccef542b229e2d1c62f406f0",
  "title": "以人葠遗段成式",
  "author": "周繇",
  "dynasty": "唐",
  "verses": [
    "人形上品传方志，我得真英自紫团。",
    "慙非叔子空持药，更请伯言审细看。"
  ],
