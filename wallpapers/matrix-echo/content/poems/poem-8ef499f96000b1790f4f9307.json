{
  "id": "poem-8ef499f96000b1790f4f9307",
  "title": "牧童",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "蓬松袒跣倒骑牛，折得山花便满头。",
    "强使倡歌浑不听，听它天籁自鸣休。"
  ],
  "enabled": true,
  "collection": "宋诗选",
