{
  "id": "poem-1ce0388e8feb4b413b799525",
  "title": "废瑟词",
  "author": "张籍",
  "dynasty": "唐",
  "verses": [
    "古瑟在匣谁复识，玉柱颠倒朱丝黑。",
    "千年曲谱不分明，乐府无人传正声。",
    "秋虫暗穿尘作色，腹中不辨工人名。",
    "几时天下复古乐，此瑟还奏云门曲。"
  ],
  "enabled": true,
