{
  "id": "poem-b10cc45e537431dce9d35e91",
  "title": "纸被",
  "author": "徐夤",
  "dynasty": "唐",
  "verses": [
    "文采鸳鸯罢合欢，细柔轻缀好鱼牋。",
    "一床明月盖归梦，数尺白云笼冷眠。",
    "披对劲风温胜酒，拥听寒风暖于绵。",
    "赤眉豪客见皆笑，却问儒生直几钱。"
  ],
  "enabled": true,
