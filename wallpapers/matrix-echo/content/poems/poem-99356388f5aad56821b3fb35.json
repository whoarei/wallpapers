{
  "id": "poem-99356388f5aad56821b3fb35",
  "title": "夜发军中",
  "author": "李益",
  "dynasty": "唐",
  "verses": [
    "边马枥上惊，雄劒匣中鸣。",
    "半夜军书致，匈奴寇六城。",
    "中坚分暗阵，太乙起神兵。",
    "出没风云合，苍黄豺虎争。",
    "今日边庭战，缘赏不缘名。"
  ],
  "enabled": true,
