{
  "id": "poem-6f22f235cd16aa2862b72b95",
  "title": "黄神谷纪事",
  "author": "马戴",
  "dynasty": "唐",
  "verses": [
    "霹雳振秋岳，折松横洞门。",
    "云龙忽变化，但觉玉潭昏。"
  ],
  "enabled": true,
