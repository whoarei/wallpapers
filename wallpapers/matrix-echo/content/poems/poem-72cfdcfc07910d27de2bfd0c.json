{
  "id": "poem-72cfdcfc07910d27de2bfd0c",
  "title": "和元晦雪压竹韵",
  "author": "张栻",
  "dynasty": "宋",
  "verses": [
    "山行景物总清奇，知费山翁几许诗。",
    "雪急风号联骑日，月明霜净倚阑时。"
  ],
