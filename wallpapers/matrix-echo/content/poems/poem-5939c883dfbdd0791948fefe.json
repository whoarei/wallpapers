{
  "id": "poem-5939c883dfbdd0791948fefe",
  "title": "酬韩庶子",
  "author": "张籍",
  "dynasty": "唐",
  "verses": [
    "西街幽僻处，正与嬾相宜。",
    "寻寺独行远，借书常送迟。",
    "家贫无易事，身病足闲时。",
    "寂寞谁相问，祗应君自知。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
