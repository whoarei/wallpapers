{
  "id": "poem-ffec4e59784fb14edbe502a6",
  "title": "十二咏 菖蒲涧",
  "author": "李纲",
  "dynasty": "宋",
  "verses": [
    "寸根九节结孤芳，青剑凌波日日长。",
    "幸有仙方辨真赝，医师休更进菖阳。"
  ],
  "enabled": true,
