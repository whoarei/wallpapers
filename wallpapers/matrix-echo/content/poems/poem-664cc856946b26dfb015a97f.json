{
  "id": "poem-664cc856946b26dfb015a97f",
  "title": "汶归舟中",
  "author": "赵文",
  "dynasty": "宋",
  "verses": [
    "咿咿轧轧橹声歇，凄凄切切寒蛩鸣。",
    "满空星斗不解语，时与渔火争晶荧。"
  ],
  "enabled": true,
  "collection": "宋诗选",
