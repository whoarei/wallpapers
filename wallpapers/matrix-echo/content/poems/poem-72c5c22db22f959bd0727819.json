{
  "id": "poem-72c5c22db22f959bd0727819",
  "title": "古从军行",
  "author": "李颀",
  "dynasty": "唐",
  "verses": [
    "白日登山望烽火，黄昏饮马傍交河。",
    "行人刁斗风沙暗，公主琵琶幽怨多。",
    "野云万里无城郭，雨雪纷纷连大漠。",
    "胡鴈哀鸣夜夜飞，胡儿眼泪双双落。",
    "闻道玉门犹被遮，应将性命逐轻车。",
    "年年战骨埋荒外，空见蒲桃入汉家。"
  ],
  "enabled": true,
