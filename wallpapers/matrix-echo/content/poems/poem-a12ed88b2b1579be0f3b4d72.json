{
  "id": "poem-a12ed88b2b1579be0f3b4d72",
  "title": "题李山人幽居",
  "author": "张籍",
  "dynasty": "唐",
  "verses": [
    "襄阳南郭外，茅屋一书生。",
    "无事焚香坐，有时寻竹行。",
    "画苔藤杖细，踏石笋鞋轻。",
    "应笑风尘客，区区逐世名。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
