{
  "id": "poem-8c4bd4f2156ef95fc8fe603b",
  "title": "南歌子·手里金鹦鹉",
  "author": "温庭筠",
  "dynasty": "唐",
  "verses": [
    "手里金鹦鹉，胸前绣凤凰。",
    "偷眼暗形相，不如从嫁与，作鸳鸯。"
  ],
  "enabled": true,
  "collection": "花间集",
