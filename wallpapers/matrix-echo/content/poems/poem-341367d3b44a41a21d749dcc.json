{
  "id": "poem-341367d3b44a41a21d749dcc",
  "title": "过当涂",
  "author": "米芾",
  "dynasty": "宋",
  "verses": [
    "鸥鹭依寒水，蒹葭静晚风。",
    "烟光秋雨细，树色碧山重。"
  ],
  "enabled": true,
