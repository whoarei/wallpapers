{
  "id": "poem-3b41e1b7b43ee8c645689dbf",
  "title": "月晦",
  "author": "太宗皇帝",
  "dynasty": "唐",
  "verses": [
    "晦魄移中律，凝暄起丽城。",
    "罩云朝盖上，穿露晓珠呈。",
    "笑树花分色，啼枝鸟合声。",
    "披襟欢眺望，极目畅春情。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
