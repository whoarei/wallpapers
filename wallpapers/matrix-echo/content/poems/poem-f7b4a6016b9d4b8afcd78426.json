{
  "id": "poem-f7b4a6016b9d4b8afcd78426",
  "title": "唐享昊天乐 第十",
  "author": "则天皇后",
  "dynasty": "唐",
  "verses": [
    "肃肃祀典，邕邕礼秩。",
    "三献已周，九成斯毕。",
    "爰撤其俎，载迁其实。",
    "或升或降，惟诚惟质。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
