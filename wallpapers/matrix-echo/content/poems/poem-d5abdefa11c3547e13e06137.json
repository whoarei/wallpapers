{
  "id": "poem-d5abdefa11c3547e13e06137",
  "title": "点绛唇·推枕南窗",
  "author": "吴文英",
  "dynasty": "宋",
  "verses": [
    "推枕南窗，拣花寒入单纱浅。",
    "雨帘不卷。",
    "空碍调雏燕。",
    "一握柔葱，香染榴巾汗。",
    "音尘断。",
    "画罗闲扇。",
    "山色天涯远。"
  ],
  "enabled": true,
  "collection": "宋词选",
