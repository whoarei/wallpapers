{
  "id": "poem-2a4c9b5e8ac4f37d6bf8d7f5",
  "title": "富贵曲二首 一",
  "author": "贯休",
  "dynasty": "唐",
  "verses": [
    "有金张族，骄奢相续。",
    "琼树玉堂，雕墙绣毂。",
    "纨绮杂杂，钟鼓合合。",
    "美人如白牡丹花，半日只舞得一曲。",
    "乐不乐，足不足，争教他爱山青水绿。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
