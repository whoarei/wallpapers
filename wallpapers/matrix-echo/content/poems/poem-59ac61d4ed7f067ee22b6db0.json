{
  "id": "poem-59ac61d4ed7f067ee22b6db0",
  "title": "三学士",
  "author": "高明《蔡伯喈琵琶记》",
  "dynasty": "元",
  "verses": [
    "谢得公公意甚美，凡事仗托维持。",
    "假饶一举登科日，难道是双亲未老时。",
    "只恐锦衣归故里，双亲的怕不见儿。",
    "(外唱)。"
  ],
  "enabled": true,
  "collection": "元曲选",
