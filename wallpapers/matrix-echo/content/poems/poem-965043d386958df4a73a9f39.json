{
  "id": "poem-965043d386958df4a73a9f39",
  "title": "柳枝·风情渐老见春羞",
  "author": "李煜",
  "dynasty": "五代",
  "verses": [
    "风情渐老见春羞，到处芳魂感旧游。",
    "多谢长条似旧识，强垂烟穗拂人头。"
  ],
  "enabled": true,
  "collection": "南唐二主词",
