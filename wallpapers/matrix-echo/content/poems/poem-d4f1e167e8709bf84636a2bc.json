{
  "id": "poem-d4f1e167e8709bf84636a2bc",
  "title": "荆山",
  "author": "李咸用",
  "dynasty": "唐",
  "verses": [
    "良工指君疑，真玉却非玉。",
    "寄言怀宝人，不须伤手足。"
  ],
  "enabled": true,
