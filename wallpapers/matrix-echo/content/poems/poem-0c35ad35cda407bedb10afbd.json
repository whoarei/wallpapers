{
  "id": "poem-0c35ad35cda407bedb10afbd",
  "title": "游干明分韵得山字",
  "author": "陈造",
  "dynasty": "宋",
  "verses": [
    "竹风清如水，浣我尘埃颜。",
    "老禅贫无锥，小破蔬笋悭。",
    "短辕下鸱夷，共此半日闲。",
    "住笔讯鶑燕，把杯属江山。",
    "老夫病止饮，苦语涩莫删。",
    "揆予郊岛寒，著君季孟间。",
    "江柳未遽折，园花且同攀。",
    "后夜短亭梦，漫寄东风还。"
  ],
  "enabled": true,
  "collection": "宋诗选",
