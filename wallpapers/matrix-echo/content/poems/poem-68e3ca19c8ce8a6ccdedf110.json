{
  "id": "poem-68e3ca19c8ce8a6ccdedf110",
  "title": "偈颂六首 五",
  "author": "神晏",
  "dynasty": "唐",
  "verses": [
    "白云长满洞，论劫未曾亏。",
    "不话曹溪旨，焉干道者机。"
  ],
