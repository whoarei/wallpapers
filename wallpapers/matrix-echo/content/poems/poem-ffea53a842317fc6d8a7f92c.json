{
  "id": "poem-ffea53a842317fc6d8a7f92c",
  "title": "寄题江山叶氏翠香亭  其三",
  "author": "王柏",
  "dynasty": "宋",
  "verses": [
    "谁窃清香下广寒，霜风染就粟肤丹。",
    "须知叶叶苍圭色，花未开时自可观。"
  ],
  "enabled": true,
