{
  "id": "poem-c26810268365ed6b8e218349",
  "title": "示后学偈",
  "author": "令参",
  "dynasty": "唐",
  "verses": [
    "入门须有语，不语病拪芦。",
    "应须满口道，莫教带有无。"
  ],
