{
  "id": "poem-aa2c406d2f14ac703810de77",
  "title": "答西蜀欧阳侍郎颂（题拟） 二",
  "author": "延沼",
  "dynasty": "唐",
  "verses": [
    "甘露台前靡不逢，免将明暗諕盲聋。",
    "当初贬着文殊处，笑杀寒山者老翁。"
  ],
