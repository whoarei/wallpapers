{
  "id": "poem-b9e656723952fd59b851f107",
  "title": "小圃即事四首  其二",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "恰则夭夭看小桃，靓粧撚指九分消。",
    "丁宁更耐明朝雨，款曲随风送落潮。"
  ],
  "enabled": true,
