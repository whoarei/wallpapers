{
  "id": "poem-52d4da21615ed8ab15acee7b",
  "title": "女冠子·步虚坛上",
  "author": "鹿虔扆",
  "dynasty": "五代",
  "verses": [
    "步虚坛上，绛节霓旌相向，引真仙。",
    "玉佩摇蟾影，金炉袅麝烟。",
    "露浓霜简湿，风紧羽衣偏。",
    "欲留难得住，却归天。"
  ],
  "enabled": true,
  "collection": "花间集",
