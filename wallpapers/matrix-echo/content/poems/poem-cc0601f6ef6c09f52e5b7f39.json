{
  "id": "poem-cc0601f6ef6c09f52e5b7f39",
  "title": "酬王哦松八景  其四",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "噎噎梅花煖响初，晓来痕绿到蘼芜。",
    "鹗沈鹦鹉千年恨，指旧江山忍按图。"
  ],
  "enabled": true,
