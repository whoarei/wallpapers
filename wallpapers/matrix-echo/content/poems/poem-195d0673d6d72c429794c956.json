{
  "id": "poem-195d0673d6d72c429794c956",
  "title": "宿云门寺阁",
  "author": "孙逖",
  "dynasty": "唐",
  "verses": [
    "香阁东山下，烟花象外幽。",
    "悬灯千嶂夕，卷幔五湖秋。",
    "画壁余鸿雁，纱窗宿斗牛。",
    "更疑天路近，梦与白云游。"
  ],
  "enabled": true,
  "collection": "千家诗",
  "tags": [],
