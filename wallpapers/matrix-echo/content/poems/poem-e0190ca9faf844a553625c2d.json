{
  "id": "poem-e0190ca9faf844a553625c2d",
  "title": "梦天",
  "author": "李贺",
  "dynasty": "唐",
  "verses": [
    "老兔寒蟾泣天色，云楼半开壁斜白。",
    "玉轮轧露湿团光，鸾珮相逢桂香陌。",
    "黄尘清水三山下，更变千年如走马。",
    "遥望齐州九点烟，一泓海水杯中泻。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
  "tags": [
    "梦游",
