{
  "id": "poem-0e30b24269c6499facbbae4f",
  "title": "送远上人",
  "author": "李洞",
  "dynasty": "唐",
  "verses": [
    "海岳两无边，去来都偶然。",
    "齿因吟后冷，心向静中圆。",
    "虫网花间井，鸿鸣雨后天。",
    "叶书归旧寺，应附载钟船。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
