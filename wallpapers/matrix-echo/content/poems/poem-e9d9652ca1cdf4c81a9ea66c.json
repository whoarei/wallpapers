{
  "id": "poem-e9d9652ca1cdf4c81a9ea66c",
  "title": "题招隐寺即戴颙旧宅",
  "author": "李涉",
  "dynasty": "唐",
  "verses": [
    "两崖古树千般色，一井寒泉数丈冰。",
    "欲问前朝戴居士，野烟秋色是丘陵。"
  ],
  "enabled": true,
