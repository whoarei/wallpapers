{
  "id": "poem-5f440f6cdc3d09d8140ec31d",
  "title": "古北口",
  "author": "纳兰性德",
  "dynasty": "清",
  "verses": [
    "乱山入戟拥孤城，一线人争鸟道行。",
    "地险东西分障塞，云开南北望神京。",
    "新图已入三关志，往事休论十路兵。",
    "都护近来长不调，年年烽火报生平。"
  ],
  "enabled": true,
  "collection": "纳兰词",
