{
  "id": "poem-07e3271be2bea01bfae4e2e3",
  "title": "立春后一日风雨殊有寒色偶成",
  "author": "李纲",
  "dynasty": "宋",
  "verses": [
    "竟夕北风号，春回雨已膏。",
    "归程离海峤，旧服理绨袍。",
    "宿瘴须寒压，清愁欲醉逃。",
    "何当入江浙，雪片洒鹅毛。"
  ],
  "enabled": true,
  "collection": "宋诗选",
