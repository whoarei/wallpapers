{
  "id": "poem-68329d0c43f66d5bcaa12245",
  "title": "将别寄友人",
  "author": "马戴",
  "dynasty": "唐",
  "verses": [
    "帝乡归未得，辛苦事羇游。",
    "别馆一尊酒，客程千里秋。",
    "霜风红叶寺，夜雨白苹洲。",
    "长恐此时泪，不禁和恨流。"
  ],
  "enabled": true,
