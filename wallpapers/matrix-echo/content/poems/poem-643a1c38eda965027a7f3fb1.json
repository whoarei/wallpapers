{
  "id": "poem-643a1c38eda965027a7f3fb1",
  "title": "王昭君",
  "author": "崔国辅",
  "dynasty": "唐",
  "verses": [
    "汉使南还尽，胡中妾独存。",
    "紫台绵望绝，秋草不堪论。"
  ],
