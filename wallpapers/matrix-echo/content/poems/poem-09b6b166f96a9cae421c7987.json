{
  "id": "poem-09b6b166f96a9cae421c7987",
  "title": "献刘济",
  "author": "李益",
  "dynasty": "唐",
  "verses": [
    "草绿古燕州，莺声引独游。",
    "雁归天北畔，春尽海西头。",
    "向日花偏落，驰年水自流。",
    "感恩知有地，不上望京楼。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
