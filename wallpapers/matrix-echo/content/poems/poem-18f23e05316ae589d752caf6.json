{
  "id": "poem-18f23e05316ae589d752caf6",
  "title": "赤壁",
  "author": "李商隐",
  "dynasty": "唐",
  "verses": [
    "折戟沈沙铁未销，自将磨洗认前朝。",
    "东风不与周郎便，铜雀春深锁二乔。"
  ],
