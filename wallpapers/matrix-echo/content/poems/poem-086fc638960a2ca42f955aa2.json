{
  "id": "poem-086fc638960a2ca42f955aa2",
  "title": "生查子·关山魂梦长",
  "author": "王观",
  "dynasty": "宋",
  "verses": [
    "关山魂梦长，塞雁音书少。",
    "两鬓可怜青，一夜相思老。",
    "归傍碧纱窗，说与人人道。",
    "真个别离难，不似相逢好。"
  ],
  "enabled": true,
  "collection": "宋词三百首",
