{
  "id": "poem-57cb2f298f20d587e49603e9",
  "title": "楚江怀古三首 三",
  "author": "马戴",
  "dynasty": "唐",
  "verses": [
    "野风吹蕙带，骤雨滴兰桡。",
    "屈宋魂冥寞，江山思寂寥。",
    "阴霓侵晚景，海树入回潮。",
    "欲折寒芳荐，明神讵可招。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
