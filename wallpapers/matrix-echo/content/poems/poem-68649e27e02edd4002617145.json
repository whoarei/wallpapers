{
  "id": "poem-68649e27e02edd4002617145",
  "title": "次韵徐秀才十首  其六",
  "author": "陈造",
  "dynasty": "宋",
  "verses": [
    "霄霏上冥鸿，山雾卧文豹。",
    "饿鸱吓腐鼠，啄啄诧飞趠。",
    "吾徒为己学，欣戚置不校。",
    "小草或远志，诡遇乃近效。"
  ],
  "enabled": true,
  "collection": "宋诗选",
