{
  "id": "poem-e3dc6ad29034c7b88c170ba7",
  "title": "玉仙馆",
  "author": "张籍",
  "dynasty": "唐",
  "verses": [
    "长溪新雨色如泥，野水阴云尽向西。",
    "楚客天南行渐远，山山树里鹧鸪啼。"
  ],
  "enabled": true,
