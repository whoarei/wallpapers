{
  "id": "poem-5cffdc7fbea4faf820d50431",
  "title": "同前",
  "author": "无名氏《张协状元》",
  "dynasty": "元",
  "verses": [
    "长安古道，盘费知多少。",
    "婆婆早与，它便起程又早。",
    "(旦)今朝倚靠，非外来相扰。",
    "(合同前)。"
  ],
  "enabled": true,
  "collection": "元曲选",
