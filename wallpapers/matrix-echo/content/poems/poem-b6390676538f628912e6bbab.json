{
  "id": "poem-b6390676538f628912e6bbab",
  "title": "相思林",
  "author": "徐凝",
  "dynasty": "唐",
  "verses": [
    "游客远游新过岭，每逢芳树问芳名。",
    "长林遍是相思树，争遣愁人独自行。"
  ],
  "enabled": true,
