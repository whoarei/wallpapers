{
  "id": "poem-8b52524fbbb78b7d1cd35d19",
  "title": "题化城寺",
  "author": "应物",
  "dynasty": "唐",
  "verses": [
    "平高选处创莲宫，一水萦流处处通。",
    "画阁昼开迟日畔，禅房夜掩碧云中。",
    "平川不见龙行雨，幽谷遥闻虎啸风。",
    "偶与游人论法要，真元浩浩理无穷。"
  ],
  "enabled": true,
