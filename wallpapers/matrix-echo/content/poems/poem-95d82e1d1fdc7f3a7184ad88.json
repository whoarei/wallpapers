{
  "id": "poem-95d82e1d1fdc7f3a7184ad88",
  "title": "虚室",
  "author": "华镇",
  "dynasty": "宋",
  "verses": [
    "轩前列群山，轩后得虚室。",
    "宛若成都居，枵然惟四壁。",
    "清明照窗牖，不待秋月色。",
    "万籁悄无声，终年饱岑寂。"
  ],
  "enabled": true,
  "collection": "宋诗选",
