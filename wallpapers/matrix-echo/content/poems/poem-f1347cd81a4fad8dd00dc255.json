{
  "id": "poem-f1347cd81a4fad8dd00dc255",
  "title": "江南曲",
  "author": "李益",
  "dynasty": "唐",
  "verses": [
    "长乐花枝雨点销，江城日暮好相邀。",
    "春楼不闭葳蕤锁，绿水回连宛转桥。"
  ],
  "enabled": true,
