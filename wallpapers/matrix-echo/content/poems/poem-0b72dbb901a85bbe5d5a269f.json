{
  "id": "poem-0b72dbb901a85bbe5d5a269f",
  "title": "宫词  其四五",
  "author": "张公庠",
  "dynasty": "宋",
  "verses": [
    "上番宫女卷帘时，闪闪寒鸦拂晓啼。",
    "才索赭迎催进辇，紫宸门外报班齐。"
  ],
  "enabled": true,
