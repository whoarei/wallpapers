{
  "id": "poem-f391f51ee06351e91d214b34",
  "title": "独醒午坐",
  "author": "王琮",
  "dynasty": "宋",
  "verses": [
    "小槽停溜务厅闲，幕府文书省却难。",
    "竟日裴回无俗意，祇因竹外有秋山。"
  ],
  "enabled": true,
