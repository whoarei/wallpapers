{
  "id": "poem-aa9c2d678c43f3dbf6af3d7b",
  "title": "过骊山",
  "author": "孟迟",
  "dynasty": "唐",
  "verses": [
    "冷日微烟渭水愁，华清宫树不胜秋。",
    "霓裳一曲千门锁，白尽梨园弟子头。"
  ],
