{
  "id": "poem-5718dadd6a14cc5d68694ccf",
  "title": "题武关",
  "author": "李涉",
  "dynasty": "唐",
  "verses": [
    "来往悲欢万里心，多从此路计浮沈。",
    "皆缘不得空门要，舜葬苍梧直至今。"
  ],
  "enabled": true,
