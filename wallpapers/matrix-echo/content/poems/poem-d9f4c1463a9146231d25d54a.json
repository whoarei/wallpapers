{
  "id": "poem-d9f4c1463a9146231d25d54a",
  "title": "咏史诗 夷门",
  "author": "胡曾",
  "dynasty": "唐",
  "verses": [
    "六龙冉冉骤朝昏，魏国贤才杳不存。",
    "唯有侯嬴在时月，夜来空自照夷门。"
  ],
  "enabled": true,
