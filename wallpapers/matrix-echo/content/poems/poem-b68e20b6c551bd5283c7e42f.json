{
  "id": "poem-b68e20b6c551bd5283c7e42f",
  "title": "净信院",
  "author": "陈岩",
  "dynasty": "宋",
  "verses": [
    "来自青松翠竹关，秋风吹帽醉醒间。",
    "纷纷遮眼尘如海，拈起毫端又说山。"
  ],
  "enabled": true,
