{
  "id": "poem-3b5fe0a15b27e6c13fca92bf",
  "title": "新年作",
  "author": "刘长卿",
  "dynasty": "唐",
  "verses": [
    "乡心新岁切，天畔独潸然。",
    "老至居人下，春归在客先。",
    "岭猨同旦暮，江柳共风烟。",
    "已是长沙傅，从今又几年。"
  ],
  "enabled": true,
  "collection": "唐诗三百首",
