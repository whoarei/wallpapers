{
  "id": "poem-ae10c344c91dea3925580128",
  "title": "歌者十二首 十二",
  "author": "司空图",
  "dynasty": "唐",
  "verses": [
    "鹤氅花香搭槿篱，枕前蛩迸酒醒时。",
    "夕阳似照陶家菊，黄蝶无穷压故枝。"
  ],
  "enabled": true,
