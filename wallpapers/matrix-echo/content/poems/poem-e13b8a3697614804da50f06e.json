{
  "id": "poem-e13b8a3697614804da50f06e",
  "title": "重画知识壁",
  "author": "释了惠",
  "dynasty": "宋",
  "verses": [
    "幸自十方无壁落，谁将五彩画虚空。",
    "善财眼里生花翳，去却一重添一重。"
  ],
  "enabled": true,
