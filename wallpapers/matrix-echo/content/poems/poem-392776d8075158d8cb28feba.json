{
  "id": "poem-392776d8075158d8cb28feba",
  "title": "送陈司马",
  "author": "徐凝",
  "dynasty": "唐",
  "verses": [
    "家寄茅洞中，身游越城下。",
    "宁知许长史，不忆陈司马。"
  ],
  "enabled": true,
