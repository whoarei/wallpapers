{
  "id": "poem-8aaa77f816c12331640c51cf",
  "title": "遣兴二首  其二",
  "author": "李纲",
  "dynasty": "宋",
  "verses": [
    "海上归来心绪多，鬓边无那白标何。",
    "诗情粗得江山助，酒量自因风月多。",
    "黄卷中间笼圣哲，白云深处避干戈。",
    "弟兄念我心应切，故向梅花岭上过。"
  ],
  "enabled": true,
  "collection": "宋诗选",
