{
  "id": "poem-452a0a2d368af3afaa6d64c2",
  "title": "洋州三十景 涵虚亭",
  "author": "鲜于侁",
  "dynasty": "宋",
  "verses": [
    "危栏试睡听，空翠如何把。",
    "悄悄忧世心，临风一倾泻。"
  ],
  "enabled": true,
