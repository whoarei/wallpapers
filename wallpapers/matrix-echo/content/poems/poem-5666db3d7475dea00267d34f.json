{
  "id": "poem-5666db3d7475dea00267d34f",
  "title": "月夜敲砧",
  "author": "王镃",
  "dynasty": "宋",
  "verses": [
    "沉沉万籁满天星，药兔秋声处处明。",
    "落尽灯花人欲睡，一簷桐影捣衣声。"
  ],
  "enabled": true,
  "collection": "宋诗选",
