{
  "id": "poem-ee7ef4b1eabcf0584b8bd5d4",
  "title": "边城独望",
  "author": "马戴",
  "dynasty": "唐",
  "verses": [
    "聊凭危堞望，倍起异乡情。",
    "霜落蒹葭白，山昏雾露生。",
    "河滩胡鴈下，戎垒汉鼙惊。",
    "独树残秋色，狂歌泪满缨。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
  "tags": [
    "思乡"
  ],
