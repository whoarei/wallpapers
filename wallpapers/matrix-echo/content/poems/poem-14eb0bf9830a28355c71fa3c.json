{
  "id": "poem-14eb0bf9830a28355c71fa3c",
  "title": "点绛唇·石洞清寒",
  "author": "曹勋",
  "dynasty": "宋",
  "verses": [
    "石洞清寒，柳烟吹散松风静。",
    "日华光映。",
    "翠水环云径。",
    "道境多闲，不是人间景。",
    "谈清净。",
    "道师歌咏。",
    "花转云房影。"
  ],
  "enabled": true,
  "collection": "宋词选",
