{
  "id": "poem-6d1f927d1360d250ce4fe4fe",
  "title": "古出塞曲三首 一",
  "author": "贯休",
  "dynasty": "唐",
  "verses": [
    "扫尽狂胡迹，回头望故关。",
    "相逢惟死鬬，岂易得生还。",
    "纵宴参胡乐，收兵过雪山。",
    "不封十万户，此事亦应闲。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
