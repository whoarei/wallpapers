{
  "id": "poem-335763d1823223ba006957a1",
  "title": "赤枣子·惊晓漏",
  "author": "纳兰性德",
  "dynasty": "清",
  "verses": [
    "惊晓漏，护春眠。",
    "格外娇慵只自怜。",
    "寄语酿花风日好，绿窗来与上琴弦。"
  ],
  "enabled": true,
  "collection": "纳兰词",
