{
  "id": "poem-a5d7a14a475a8ee02accbbc5",
  "title": "地藏塔",
  "author": "陈岩",
  "dynasty": "宋",
  "verses": [
    "八十四级山头石，五百余年地藏坟。",
    "风撼塔铃天半语，众人都向梦中闻。"
  ],
  "enabled": true,
  "collection": "宋诗选",
