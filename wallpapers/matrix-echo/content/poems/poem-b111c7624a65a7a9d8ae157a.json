{
  "id": "poem-b111c7624a65a7a9d8ae157a",
  "title": "送知全禅师南游",
  "author": "刘得仁",
  "dynasty": "唐",
  "verses": [
    "师誉振京城，谈空万乘听。",
    "北行山已雪，南去木犹青。",
    "夜岳禅销月，秋潭汲动星。",
    "回期不可定，孤鹤在高冥。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
