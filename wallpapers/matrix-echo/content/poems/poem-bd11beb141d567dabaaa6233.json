{
  "id": "poem-bd11beb141d567dabaaa6233",
  "title": "羽调排歌",
  "author": "徐田臣《杀狗记》",
  "dynasty": "元",
  "verses": [
    "(生)愚蠢孙华，情偏意迷，全亏家有贤妻。",
    "(旦)今朝兄弟共怡怡，堪笑乔人枉用机。"
  ],
