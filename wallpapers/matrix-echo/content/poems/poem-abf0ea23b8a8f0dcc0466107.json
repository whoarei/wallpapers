{
  "id": "poem-abf0ea23b8a8f0dcc0466107",
  "title": "老农十首  其六",
  "author": "曾协",
  "dynasty": "宋",
  "verses": [
    "敢将体足惮沾涂，日日高原带雨锄。",
    "乞与丰年酬作苦，也知天意解乘除。"
  ],
  "enabled": true,
