{
  "id": "poem-895ed940d11284bb48274ab2",
  "title": "好事近·萧寺两珠红",
  "author": "王之望",
  "dynasty": "宋",
  "verses": [
    "萧寺两珠红，欲共晓霞争色。",
    "独占岁寒天气，正群芳休息。",
    "坐中清唱并阳春，写物妙诗格。",
    "霜鬓自羞簪帽，叹如何抛得。"
  ],
  "enabled": true,
  "collection": "宋词选",
