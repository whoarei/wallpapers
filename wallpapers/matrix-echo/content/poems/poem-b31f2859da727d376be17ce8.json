{
  "id": "poem-b31f2859da727d376be17ce8",
  "title": "逢侠者",
  "author": "钱起",
  "dynasty": "唐",
  "verses": [
    "燕赵悲歌士，相逢剧孟家。",
    "寸心言不尽，前路日将斜。"
  ],
  "enabled": true,
  "collection": "千家诗",
