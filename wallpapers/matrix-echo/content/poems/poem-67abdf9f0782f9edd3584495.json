{
  "id": "poem-67abdf9f0782f9edd3584495",
  "title": "捣练子·云鬓乱",
  "author": "李煜",
  "dynasty": "五代",
  "verses": [
    "云鬓乱，晚妆残，带恨眉儿远岫攒。",
    "斜托香腮春笋嫩，为谁和泪倚栏杆。"
  ],
  "enabled": true,
  "collection": "南唐二主词",
