{
  "id": "poem-e7e78079435b16d0d1f03a2b",
  "title": "边上送友人归宁",
  "author": "曹松",
  "dynasty": "唐",
  "verses": [
    "乡路穿京过，宁心去少同。",
    "日斜寻阔碛，春尽逐归鸿。",
    "独树河声外，凝笳塞色中。",
    "怜君到此处，却背老莱风。"
  ],
  "enabled": true,
