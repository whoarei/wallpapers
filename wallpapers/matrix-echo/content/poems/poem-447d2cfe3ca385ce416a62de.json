{
  "id": "poem-447d2cfe3ca385ce416a62de",
  "title": "梁太子钓台",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "晴拂双鬟晓未开，先驱寸碧渡江来。",
    "伤心旧日垂纶地，几度江春去又回。"
  ],
  "enabled": true,
