{
  "id": "poem-88da7b92e32d6affa6bbf5b2",
  "title": "帆游山",
  "author": "张又新",
  "dynasty": "唐",
  "verses": [
    "涨海尝从此地流，千帆飞过碧山头。",
    "君看深谷为陵后，翻覆人间未肯休。"
  ],
  "enabled": true,
