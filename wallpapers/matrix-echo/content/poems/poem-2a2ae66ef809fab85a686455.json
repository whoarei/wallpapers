{
  "id": "poem-2a2ae66ef809fab85a686455",
  "title": "偶宴西蜀摩诃池",
  "author": "畅当",
  "dynasty": "唐",
  "verses": [
    "珍木郁清池，风荷左右披。",
    "浅觞宁及醉，慢舸不知移。",
    "荫簟流光冷，凝簪照影欹。",
    "胡为独羁者，雪涕向涟漪。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
