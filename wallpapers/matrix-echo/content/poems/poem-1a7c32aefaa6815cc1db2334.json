{
  "id": "poem-1a7c32aefaa6815cc1db2334",
  "title": "偈颂（幷序○序为南岳齐己撰） 六十八",
  "author": "居遁",
  "dynasty": "唐",
  "verses": [
    "阎浮有大宝，见少得人稀。",
    "若人将献我，成佛一饷时。"
  ],
  "enabled": true,
