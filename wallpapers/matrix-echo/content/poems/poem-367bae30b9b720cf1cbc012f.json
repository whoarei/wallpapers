{
  "id": "poem-367bae30b9b720cf1cbc012f",
  "title": "立春偶成",
  "author": "张栻",
  "dynasty": "宋",
  "verses": [
    "律回岁晚冰霜少，春到人间草木知。",
    "便觉眼前生意满，东风吹水绿参差。"
  ],
  "enabled": true,
