{
  "id": "poem-282c54049579d681b7d48387",
  "title": "神功盛德诗  其一七",
  "author": "华镇",
  "dynasty": "宋",
  "verses": [
    "俾尔息而庶，俾尔厚而富。",
    "黄发稚齿，既仁且寿。",
    "帝歆其馨，介我纯祐。"
  ],
  "enabled": true,
  "collection": "宋诗选",
