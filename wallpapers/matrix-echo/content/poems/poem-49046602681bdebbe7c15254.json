{
  "id": "poem-49046602681bdebbe7c15254",
  "title": "折柳赠行人",
  "author": "雍裕之",
  "dynasty": "唐",
  "verses": [
    "那言柳乱垂，尽日任风吹。",
    "欲识千条恨，和烟折一枝。"
  ],
  "enabled": true,
