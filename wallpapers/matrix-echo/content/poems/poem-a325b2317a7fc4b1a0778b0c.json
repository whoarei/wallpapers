{
  "id": "poem-a325b2317a7fc4b1a0778b0c",
  "title": "端州江亭得家书二首 二",
  "author": "李绅",
  "dynasty": "唐",
  "verses": [
    "长安别日春风早，岭外今来白露秋。",
    "莫道淮南悲木叶，不闻摇落更堪愁。"
  ],
  "enabled": true,
