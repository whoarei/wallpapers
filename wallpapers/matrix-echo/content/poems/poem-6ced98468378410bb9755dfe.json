{
  "id": "poem-6ced98468378410bb9755dfe",
  "title": "风不鸣条",
  "author": "黄颇",
  "dynasty": "唐",
  "verses": [
    "五纬起祥飙，无声瑞圣朝。",
    "稍开含露蘂，才转惹烟条。",
    "密叶应潜变，低枝几暗摇。",
    "林间莺欲啭，花下蝶微飘。",
    "初满沿堤草，因生逐水苗。",
    "太平无一事，天外奏虞韶。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
