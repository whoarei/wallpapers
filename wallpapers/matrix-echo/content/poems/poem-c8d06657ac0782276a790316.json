{
  "id": "poem-c8d06657ac0782276a790316",
  "title": "登历下古城员外新亭二首  其二",
  "author": "王秬",
  "dynasty": "宋",
  "verses": [
    "吾宗固神秀，体物写谋长。",
    "形制开古迹，曾冰延乐方。",
    "太山雄地理，巨壑眇云庄。",
    "高兴泊烦促，永怀清典常。",
    "含弘知四大，出入见三光。",
    "负郭喜粳稻，安时歌吉祥。"
  ],
  "enabled": true,
  "collection": "宋诗选",
