{
  "id": "poem-e264ad06e04d3d0f7e3b05be",
  "title": "学馆闲题",
  "author": "宋伯仁",
  "dynasty": "宋",
  "verses": [
    "据见定时俱是足，苦思量处便成痴。",
    "请君打退闲烦恼，啜粥烹茶细和诗。"
  ],
