{
  "id": "poem-af4c2e847c8e7b7889605e80",
  "title": "水阁纳凉",
  "author": "王镃",
  "dynasty": "宋",
  "verses": [
    "云碧纱厨水阁中，鸳鸯花冷枕玲珑。",
    "描金团扇无人用，一阵荷香一阵风。"
  ],
  "enabled": true,
