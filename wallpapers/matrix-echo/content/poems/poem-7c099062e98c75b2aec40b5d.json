{
  "id": "poem-7c099062e98c75b2aec40b5d",
  "title": "观搊筝",
  "author": "王湾",
  "dynasty": "唐",
  "verses": [
    "虚室有秦筝，筝新月复清。",
    "弦多弄委曲，柱促语分明。",
    "晓怨凝繁手，春娇入曼声。",
    "近来唯此乐，传得美人情。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
