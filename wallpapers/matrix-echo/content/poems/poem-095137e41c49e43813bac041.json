{
  "id": "poem-095137e41c49e43813bac041",
  "title": "牧童词",
  "author": "李涉",
  "dynasty": "唐",
  "verses": [
    "朝牧牛，牧牛下江曲。",
    "夜牧牛，牧牛度村谷。",
    "荷蓑出林春雨细，芦管卧吹莎草绿。",
    "乱插蓬蒿箭满腰，不怕猛虎欺黄犊。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
  "tags": [
    "儿童",
    "讽刺"
  ],
