{
  "id": "poem-8895b49cd844fce19c981176",
  "title": "河传·风飐",
  "author": "孙光宪",
  "dynasty": "五代",
  "verses": [
    "风飐，波敛。",
    "团荷闪闪，珠倾露点。",
    "木兰舟上，何处吴娃越艳，藕花红照脸。",
    "大堤狂杀襄阳客，烟波隔，渺渺湖光白。",
    "身已归，心不归。",
    "斜晖，远汀㶉𫛶飞。"
  ],
  "enabled": true,
  "collection": "花间集",
