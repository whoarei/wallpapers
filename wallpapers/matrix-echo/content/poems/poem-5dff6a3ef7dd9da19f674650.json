{
  "id": "poem-5dff6a3ef7dd9da19f674650",
  "title": "生日  其二",
  "author": "孙嵩",
  "dynasty": "宋",
  "verses": [
    "鸿雁关河秋满眼，梧桐风雨冷吹衣。",
    "蓼莪自是长休废，独立苍苔一叹欷。"
  ],
  "enabled": true,
