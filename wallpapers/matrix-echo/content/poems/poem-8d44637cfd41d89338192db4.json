{
  "id": "poem-8d44637cfd41d89338192db4",
  "title": "杂咏  其二",
  "author": "米芾",
  "dynasty": "宋",
  "verses": [
    "巨舰横江稳不摇，顺浮溟涨午时潮。",
    "江南晴色山无翳，乞与闲人取次描。"
  ],
  "enabled": true,
