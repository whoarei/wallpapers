{
  "id": "poem-34cbf9ccdbe833d1216c7a4e",
  "title": "偈颂（幷序○序为南岳齐己撰） 十八",
  "author": "居遁",
  "dynasty": "唐",
  "verses": [
    "了得心源处处安，何须终日对林峦。",
    "玉向火中烧转润，莲华在水叶长干。"
  ],
  "enabled": true,
