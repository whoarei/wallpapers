{
  "id": "poem-0f4237aa95506d70d3402fd0",
  "title": "下楼",
  "author": "李益",
  "dynasty": "唐",
  "verses": [
    "话旧全应老，逢春喜又悲。",
    "看花行拭泪，倍觉下楼迟。"
  ],
  "enabled": true,
