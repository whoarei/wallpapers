{
  "id": "poem-6c7b708d6d11177743deecf0",
  "title": "谢朱常侍寄贶蜀茶剡纸二首 二",
  "author": "崔道融",
  "dynasty": "唐",
  "verses": [
    "百幅轻明雪未融，薛家凡纸漫深红。",
    "不应点染闲言语，留记将军盖世功。"
  ],
  "enabled": true,
