{
  "id": "poem-33468a73c0ff2b0205b235d8",
  "title": "送卢孟明还上都",
  "author": "皎然",
  "dynasty": "唐",
  "verses": [
    "江臯北风至，归客独伤魂。",
    "楚水逢乡雁，平陵忆故园。",
    "征骖嘶别馆，落日隐寒原。",
    "应及秦川望，春华满国门。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
