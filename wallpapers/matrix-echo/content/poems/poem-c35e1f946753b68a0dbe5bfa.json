{
  "id": "poem-c35e1f946753b68a0dbe5bfa",
  "title": "闲园书事招畅当",
  "author": "司空曙",
  "dynasty": "唐",
  "verses": [
    "闻蝉昼眠后，欹枕对蓬蒿。",
    "羸病嬾寻戴，田园方咏陶。",
    "傍簷虫挂静，出树蝶飞高。",
    "惆怅临清镜，思君见鬓毛。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
