{
  "id": "poem-0456bedb474bb5126c16cdc2",
  "title": "颂古三十一首  其一一",
  "author": "释玿",
  "dynasty": "宋",
  "verses": [
    "当机转处不踌躇，琉璃盘里走明珠。",
    "赵州老子村校书，一条拄杖两人舁。"
  ],
  "enabled": true,
