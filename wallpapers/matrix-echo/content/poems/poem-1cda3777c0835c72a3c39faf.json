{
  "id": "poem-1cda3777c0835c72a3c39faf",
  "title": "采桑",
  "author": "王建",
  "dynasty": "唐",
  "verses": [
    "鸟鸣桑叶间，绿条复柔柔。",
    "攀看去手近，放下长长钩。",
    "黄花盖野田，白马少年游。",
    "所念岂回顾，良人在高楼。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
