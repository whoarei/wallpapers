{
  "id": "poem-e44f05b6b691b15a6776c714",
  "title": "郊庙歌辞 周朝飨乐章 忠顺",
  "author": "不详",
  "dynasty": "唐",
  "verses": [
    "岁迎更始，节及朝元。",
    "冕旒仰止，冠劒相连。",
    "八音合奏，万物齐宣。",
    "常陈盛礼，愿永千年。"
  ],
  "enabled": true,
