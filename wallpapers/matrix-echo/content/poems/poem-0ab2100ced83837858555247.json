{
  "id": "poem-0ab2100ced83837858555247",
  "title": "题泽翁小卷  其二",
  "author": "王柏",
  "dynasty": "宋",
  "verses": [
    "断岸江波阔，迢迢十里宽。",
    "人烟藏处密，霁色媚寒滩。"
  ],
