{
  "id": "poem-e3ddfec19ba17818ef61e4fb",
  "title": "望江南·咏弦月",
  "author": "纳兰性德",
  "dynasty": "清",
  "verses": [
    "初八月，半镜上青霄。",
    "斜倚画阑娇不语，暗移梅影过红桥，裙带北风飘。"
  ],
  "enabled": true,
