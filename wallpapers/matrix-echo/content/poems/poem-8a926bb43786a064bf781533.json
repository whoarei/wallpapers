{
  "id": "poem-8a926bb43786a064bf781533",
  "title": "滕王阁春日晚望",
  "author": "曹松",
  "dynasty": "唐",
  "verses": [
    "凌春帝子阁，偶眺日移西。",
    "浪势平花坞，帆阴上柳堤。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
