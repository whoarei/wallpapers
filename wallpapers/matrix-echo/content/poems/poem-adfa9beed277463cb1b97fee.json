{
  "id": "poem-adfa9beed277463cb1b97fee",
  "title": "奉酬仲微见寄之作",
  "author": "米芾",
  "dynasty": "宋",
  "verses": [
    "倦游湖海老侵寻，去就何情适契心。",
    "一境山林资我懒，半年风月为君吟。",
    "辟开暗室成三果，选出香峦敌万金。",
    "千里寄声怀惠好，西风正隔洞庭深。"
  ],
  "enabled": true,
  "collection": "宋诗选",
  "tags": [
    "洞庭湖"
  ],
