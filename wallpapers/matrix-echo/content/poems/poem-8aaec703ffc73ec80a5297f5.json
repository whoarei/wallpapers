{
  "id": "poem-8aaec703ffc73ec80a5297f5",
  "title": "咏怀古迹五首 四",
  "author": "杜甫",
  "dynasty": "唐",
  "verses": [
    "蜀主窥吴幸三峡，崩年亦在永安宫。",
    "翠华想像空山里，玉殿虚无野寺中。",
    "古庙杉松巢水鹤，岁时伏腊走村翁。",
    "武侯祠屋常邻近，一体君臣祭祀同。"
  ],
  "enabled": true,
