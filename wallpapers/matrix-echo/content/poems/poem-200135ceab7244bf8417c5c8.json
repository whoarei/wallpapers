{
  "id": "poem-200135ceab7244bf8417c5c8",
  "title": "咏乌代陈师道",
  "author": "太宗皇帝",
  "dynasty": "唐",
  "verses": [
    "凌晨丽城去，薄暮上林栖。",
    "辞枝枝暂起，停树树还低。",
    "向日终难托，迎风讵肯迷。",
    "只待纤纤手，曲里作宵啼。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
