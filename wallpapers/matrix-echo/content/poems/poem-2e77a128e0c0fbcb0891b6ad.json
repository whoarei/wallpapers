{
  "id": "poem-2e77a128e0c0fbcb0891b6ad",
  "title": "浣溪沙·绿玉丛中紫玉条",
  "author": "向子𬤇",
  "dynasty": "宋",
  "verses": [
    "绿玉丛中紫玉条。",
    "幽花疏淡更香饶。",
    "不将朱粉污高标。",
    "空谷佳人宜结伴，贵游公子不能招。",
    "小窗相对诵离骚。"
  ],
  "enabled": true,
  "collection": "宋词选",
