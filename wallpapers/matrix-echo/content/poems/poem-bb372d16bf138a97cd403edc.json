{
  "id": "poem-bb372d16bf138a97cd403edc",
  "title": "梦江南·昏鸦尽",
  "author": "纳兰性德",
  "dynasty": "清",
  "verses": [
    "昏鸦尽，小立恨因谁。",
    "急雪乍翻香阁絮，轻风吹到胆瓶梅，心字已成灰。"
  ],
  "enabled": true,
