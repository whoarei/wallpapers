{
  "id": "poem-15142748ed590562c061fe0d",
  "title": "谢王连州送海阳图",
  "author": "李涉",
  "dynasty": "唐",
  "verses": [
    "谢家为郡实风流，画得青山寄楚囚。",
    "惊起草堂寒气晚，海阳潮水到床头。"
  ],
  "enabled": true,
