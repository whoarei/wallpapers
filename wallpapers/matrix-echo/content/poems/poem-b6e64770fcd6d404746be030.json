{
  "id": "poem-b6e64770fcd6d404746be030",
  "title": "傀儡吟",
  "author": "明皇帝",
  "dynasty": "唐",
  "verses": [
    "刻木牵丝作老翁，鸡皮鹤发与真同。",
    "须臾弄罢寂无事，还似人生一梦中。"
  ],
  "enabled": true,
