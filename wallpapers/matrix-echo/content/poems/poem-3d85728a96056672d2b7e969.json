{
  "id": "poem-3d85728a96056672d2b7e969",
  "title": "南乡子·乘彩舫",
  "author": "李珣",
  "dynasty": "五代",
  "verses": [
    "乘彩舫，过莲塘，棹歌惊起睡鸳鸯。",
    "游女带香偎伴笑，争窈窕，竞折团荷遮晚照。"
  ],
  "enabled": true,
  "collection": "花间集",
