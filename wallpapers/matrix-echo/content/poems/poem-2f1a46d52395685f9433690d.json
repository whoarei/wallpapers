{
  "id": "poem-2f1a46d52395685f9433690d",
  "title": "惜花",
  "author": "刘言史",
  "dynasty": "唐",
  "verses": [
    "年少共怜含露色，老人偏惜委尘红。",
    "如何遂得心中事，每要花时不厌风。"
  ],
  "enabled": true,
