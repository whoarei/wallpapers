{
  "id": "poem-643dba44b6f96c396ab99880",
  "title": "清平乐·阿郎去日",
  "author": "邵某",
  "dynasty": "宋",
  "verses": [
    "阿郎去日。",
    "不道长为客。",
    "底事桐庐无处觅。",
    "却得广州消息。",
    "江头一支兰船。",
    "风雨湘妃庙前。",
    "死恨无情江水，送郎一去三年。"
  ],
  "enabled": true,
  "collection": "宋词选",
