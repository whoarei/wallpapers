{
  "id": "poem-308031d8337626f147a38965",
  "title": "答人",
  "author": "太上隐者",
  "dynasty": "唐",
  "verses": [
    "偶来松树下，高枕石头眠。",
    "山中无历日，寒尽不知年。"
  ],
  "enabled": true,
