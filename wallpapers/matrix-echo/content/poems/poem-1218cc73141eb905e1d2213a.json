{
  "id": "poem-1218cc73141eb905e1d2213a",
  "title": "荷叶杯·曲砌蝶飞烟暖",
  "author": "顾敻",
  "dynasty": "五代",
  "verses": [
    "曲砌蝶飞烟暖，春半。",
    "花发柳垂条，花如双脸柳如腰。",
    "娇么娇，娇么娇。"
  ],
  "enabled": true,
  "collection": "花间集",
