{
  "id": "poem-b80a676981d64a38c02014b6",
  "title": "折杨柳",
  "author": "郑愔",
  "dynasty": "唐",
  "verses": [
    "青柳映红颜，黄云蔽紫关。",
    "忽闻边使出，枝叶为君攀。",
    "舞腰愁欲断，春心望不还。",
    "风花滚成雪，罗绮乱斑斑。"
  ],
  "enabled": true,
