{
  "id": "poem-b0b5883d344f88d804356896",
  "title": "灞上秋居",
  "author": "马戴",
  "dynasty": "唐",
  "verses": [
    "灞原风雨定，晚见鴈行频。",
    "落叶他乡树，寒灯独夜人。",
    "空园白露滴，孤壁野僧隣。",
    "寄卧郊扉久，何门致此身。"
  ],
  "enabled": true,
  "collection": "唐诗三百首",
