{
  "id": "poem-8ccc06cf46666c0071e8e65c",
  "title": "答司马承祯上劒镜",
  "author": "明皇帝",
  "dynasty": "唐",
  "verses": [
    "宝照含天地，神劒合阴阳。",
    "日月丽光景，星斗裁文章。",
    "写鉴表容质，佩服为身防。",
    "从兹一赏玩，永德保龄长。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
