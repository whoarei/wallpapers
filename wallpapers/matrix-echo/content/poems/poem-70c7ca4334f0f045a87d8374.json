{
  "id": "poem-70c7ca4334f0f045a87d8374",
  "title": "大云寺赞公房四首 四",
  "author": "杜甫",
  "dynasty": "唐",
  "verses": [
    "童儿汲井华，惯捷缾上手。",
    "沾洒不濡地，埽除似无帚。",
    "明霞烂复阁，霁雾搴高牖。",
    "侧塞被径花，飘飖委墀柳。",
    "艰难世事迫，隐遯佳期后。",
    "晤语契深心，那能总箝口。",
    "奉辞还杖策，暂别终回首。",
    "泱泱泥污人，听听国多狗。",
    "既未免羁绊，时来憩奔走。",
    "近公如白雪，执热烦何有。"
  ],
  "enabled": true,
