{
  "id": "poem-6654712f64ede949403e3aac",
  "title": "贾生",
  "author": "李商隐",
  "dynasty": "唐",
  "verses": [
    "宣室求贤访逐臣，贾生才调更无伦。",
    "可怜夜半虚前席，不问苍生问鬼神。"
  ],
  "enabled": true,
