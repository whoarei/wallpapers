{
  "id": "poem-e6f9006b493bba6e301b5a9d",
  "title": "上灵州令狐相公",
  "author": "李洞",
  "dynasty": "唐",
  "verses": [
    "征蛮破虏汉功臣，提劒归来万里身。",
    "笑倚凌烟金柱看，形容憔悴老于真。"
  ],
  "enabled": true,
