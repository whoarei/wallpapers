{
  "id": "poem-4b2b1e34172bd1a6e45709e2",
  "title": "题山院",
  "author": "权审",
  "dynasty": "唐",
  "verses": [
    "万叶风声利，一山秋气寒。",
    "晓霜浮碧瓦，落日度朱栏。"
  ],
  "enabled": true,
