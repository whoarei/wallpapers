{
  "id": "poem-69ecc8cb10aec451fd7f3f0d",
  "title": "静夜思",
  "author": "李白",
  "dynasty": "唐",
  "verses": [
    "床前明月光，疑是地上霜。",
    "举头望明月，低头思故乡。"
  ],
  "enabled": true,
  "collection": "千家诗",
