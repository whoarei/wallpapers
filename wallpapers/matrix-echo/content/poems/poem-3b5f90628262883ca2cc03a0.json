{
  "id": "poem-3b5f90628262883ca2cc03a0",
  "title": "冷湾",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "怪雨盲风塞冷湾，破头艇子出湖滩。",
    "平生无地酬忠信，独向风波险处看。"
  ],
  "enabled": true,
  "collection": "宋诗选",
