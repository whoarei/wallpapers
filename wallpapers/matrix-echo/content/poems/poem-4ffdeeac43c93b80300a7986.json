{
  "id": "poem-4ffdeeac43c93b80300a7986",
  "title": "题观音石壁",
  "author": "绍兴卜者",
  "dynasty": "宋",
  "verses": [
    "金紫玉青世所稀，牡丹花下探天机。",
    "仙游秀水真消息，身傍御炉香满衣。"
  ],
  "enabled": true,
