{
  "id": "poem-15703401e441cb5df9665bd2",
  "title": "秋郊夕望",
  "author": "马戴",
  "dynasty": "唐",
  "verses": [
    "度鸟向栖急，阴虫逢夜多。",
    "余霞媚秋汉，迥月濯沧波。",
    "蔓草将萎绝，流年其奈何。",
    "耿然摇落思，独酌不成歌。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
