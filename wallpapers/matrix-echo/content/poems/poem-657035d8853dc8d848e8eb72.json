{
  "id": "poem-657035d8853dc8d848e8eb72",
  "title": "沧浪峡",
  "author": "李山甫",
  "dynasty": "唐",
  "verses": [
    "走毂飞蹄过此傍，几人留意问沧浪。",
    "烟波莫笑趋名客，为爱朝宗日夜忙。"
  ],
  "enabled": true,
