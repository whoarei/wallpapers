{
  "id": "poem-2d3dadfd05e6ef506e017f34",
  "title": "送元结",
  "author": "张籍",
  "dynasty": "唐",
  "verses": [
    "昔日同游漳水边，如今重说恨绵绵。",
    "天涯相见还离别，客路秋风又几年。"
  ],
  "enabled": true,
