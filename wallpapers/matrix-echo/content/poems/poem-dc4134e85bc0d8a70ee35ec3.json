{
  "id": "poem-dc4134e85bc0d8a70ee35ec3",
  "title": "题泽翁小卷  其七",
  "author": "王柏",
  "dynasty": "宋",
  "verses": [
    "野渡人归处，纵横八九家。",
    "晚来寒力健，风飐酒帘斜。"
  ],
  "enabled": true,
