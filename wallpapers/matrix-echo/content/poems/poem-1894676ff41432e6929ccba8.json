{
  "id": "poem-1894676ff41432e6929ccba8",
  "title": "长庆春",
  "author": "徐凝",
  "dynasty": "唐",
  "verses": [
    "山头水色薄笼烟，久客新愁长庆年。",
    "身上五劳仍病酒，夭桃窗下背花眠。"
  ],
  "enabled": true,
