{
  "id": "poem-2bd0effbf5f7fbc3574d50f9",
  "title": "荔枝五首  其五",
  "author": "李纲",
  "dynasty": "宋",
  "verses": [
    "百马崩腾耆旧悲，只今戈戟暗江湄。",
    "自知疏拙蒙恩重，犹得南来食荔枝。"
  ],
  "enabled": true,
  "collection": "宋诗选",
