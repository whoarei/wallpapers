{
  "id": "poem-16473630602036d98b45a9df",
  "title": "横吹曲辞 关山月二首 一",
  "author": "戴叔伦",
  "dynasty": "唐",
  "verses": [
    "月出照关山，秋风人未还。",
    "清光无远近，乡泪半书间。"
  ],
  "enabled": true,
