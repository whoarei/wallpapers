{
  "id": "poem-04b45f5c74d9573f2b3cd083",
  "title": "江行无题一百首 八十五",
  "author": "钱珝",
  "dynasty": "唐",
  "verses": [
    "兴闲停桂楫，路好过松门。",
    "不负佳山水，还开酒一樽。"
  ],
  "enabled": true,
