{
  "id": "poem-0e78a65de60b4f1ff0eb0d85",
  "title": "悼诗",
  "author": "后主煜",
  "dynasty": "唐",
  "verses": [
    "永念难消释，孤怀痛自嗟。",
    "雨深秋寂莫，愁引病增加。",
    "咽绝风前思，昏蒙眼上花。",
    "空王应念我，穷子正迷家。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
