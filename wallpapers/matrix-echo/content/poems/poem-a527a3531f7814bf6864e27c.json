{
  "id": "poem-a527a3531f7814bf6864e27c",
  "title": "滕王阁",
  "author": "张乔",
  "dynasty": "唐",
  "verses": [
    "昔人登览处，遗阁大江隅。",
    "叠浪有时有，闲云无日无。",
    "早凉先燕去，返照后帆孤。",
    "未得营归计，菱歌满旧湖。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
  "tags": [
    "滕王阁"
