{
  "id": "poem-de67eed4e55a5298864ade53",
  "title": "答李浣",
  "author": "韦应物",
  "dynasty": "唐",
  "verses": [
    "林中观易罢，溪上对鸥闲。",
    "楚俗饶词客，何人最往还。"
  ],
  "enabled": true,
