{
  "id": "poem-8f9d3f0e9b0e93341abda5f2",
  "title": "杨柳枝·御柳如丝映九重",
  "author": "温庭筠",
  "dynasty": "唐",
  "verses": [
    "御柳如丝映九重，凤凰窗映绣芙蓉。",
    "景阳楼畔千条路，一面新妆等晓风。"
  ],
  "enabled": true,
