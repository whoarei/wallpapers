{
  "id": "poem-eb3c3414e1522a6f9a4ac511",
  "title": "同颜六少府旅宦秋中之作",
  "author": "高适",
  "dynasty": "唐",
  "verses": [
    "传君昨夜怅然悲，独坐新斋木落时。",
    "逸气旧来凌燕雀，高才何得混妍媸。",
    "迹留黄绶人多叹，心在青云世莫知。",
    "不是鬼神无正直，从来州县有瑕疵。"
  ],
  "enabled": true,
