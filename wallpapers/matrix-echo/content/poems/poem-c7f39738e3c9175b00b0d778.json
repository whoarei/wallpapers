{
  "id": "poem-c7f39738e3c9175b00b0d778",
  "title": "和定国湖上  其一",
  "author": "刘跂",
  "dynasty": "宋",
  "verses": [
    "溪光涵影碧萧萧，四合深林不见梢。",
    "寒暑若言无避处，世间那有况云巢。"
  ],
  "enabled": true,
