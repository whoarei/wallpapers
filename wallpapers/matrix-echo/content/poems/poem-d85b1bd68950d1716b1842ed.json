{
  "id": "poem-d85b1bd68950d1716b1842ed",
  "title": "寄紫阁隐者",
  "author": "贯休",
  "dynasty": "唐",
  "verses": [
    "积翠藏一叟，常思未得游。",
    "不知在岩下，为复在峰头。",
    "苔上枯藤笐，泉淋破石楼。",
    "伊余更何事，不学此翁休。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
