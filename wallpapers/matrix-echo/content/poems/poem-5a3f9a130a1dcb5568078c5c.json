{
  "id": "poem-5a3f9a130a1dcb5568078c5c",
  "title": "秋月",
  "author": "程颢",
  "dynasty": "宋",
  "verses": [
    "清溪流过碧山头，空水澄鲜一色秋。",
    "隔断红尘三十里，白云红叶两悠悠。"
  ],
  "enabled": true,
  "collection": "千家诗",
  "tags": [],
