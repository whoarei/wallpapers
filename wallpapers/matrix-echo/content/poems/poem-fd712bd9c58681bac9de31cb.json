{
  "id": "poem-fd712bd9c58681bac9de31cb",
  "title": "铜雀妓",
  "author": "高适",
  "dynasty": "唐",
  "verses": [
    "日暮铜雀迥，秋深玉座清。",
    "萧森松柏望，委郁绮罗情。",
    "君恩不再得，妾舞为谁轻。"
  ],
  "enabled": true,
