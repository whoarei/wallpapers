{
  "id": "poem-d67ee2799c810dd07c0de99f",
  "title": "花庵二首  其二",
  "author": "司马光",
  "dynasty": "宋",
  "verses": [
    "谁谓花庵陋，徒为见者嗤。",
    "此中胜广厦，人自不能知。"
  ],
  "enabled": true,
