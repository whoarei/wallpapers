{
  "id": "poem-19d91d4bbcf9fb89fe307f46",
  "title": "东门之𫮃",
  "author": "佚名",
  "dynasty": "先秦",
  "verses": [
    "东门之𫮃，茹藘在阪。其室则迩，其人甚远。",
    "东门之栗，有践家室。岂不尔思？子不我即！"
  ],
  "enabled": true,
  "collection": "诗经",
