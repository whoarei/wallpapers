{
  "id": "poem-7fefc517b628cd2c16dd9aff",
  "title": "章和二年中",
  "author": "李贺",
  "dynasty": "唐",
  "verses": [
    "云萧索，田风拂拂，麦芒如篲黍如粟。",
    "关中父老百领襦，关东吏人乏诟租。",
    "健犊春耕土膏黑，菖蒲丛丛沿水脉。",
    "殷勤为我下田租，百钱携偿丝桐客。",
    "游春漫光坞花白，野林散香神降席。",
    "拜神得寿献天子，七星贯断姮娥死。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
