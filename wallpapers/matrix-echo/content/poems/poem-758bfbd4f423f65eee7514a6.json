{
  "id": "poem-758bfbd4f423f65eee7514a6",
  "title": "留别南溪二首 二",
  "author": "李渤",
  "dynasty": "唐",
  "verses": [
    "如云不厌苍梧远，似鴈逢春又北归。",
    "惟有隐山溪上月，年年相望两依依。"
  ],
  "enabled": true,
