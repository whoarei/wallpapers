{
  "id": "poem-984b8e4264023584e9efdf64",
  "title": "寻纪道士偶会诸叟",
  "author": "李益",
  "dynasty": "唐",
  "verses": [
    "山阴寻道士，暎竹羽衣新。",
    "侍坐双童子，陪游五老人。",
    "水花松下静，坛草雪中春。",
    "见说桃源洞，如今犹避秦。"
  ],
  "enabled": true,
