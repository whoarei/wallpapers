{
  "id": "poem-f6556fbcdbfeca8dae455bdb",
  "title": "金山",
  "author": "张栻",
  "dynasty": "宋",
  "verses": [
    "万顷洪涛里，巍然阅古今。",
    "云烟三岛接，花木四时深。",
    "乱石维舟住，西风倚槛吟。",
    "朝宗知不断，凄切此时心。"
  ],
  "enabled": true,
  "collection": "宋诗选",
