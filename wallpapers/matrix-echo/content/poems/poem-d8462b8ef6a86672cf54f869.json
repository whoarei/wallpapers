{
  "id": "poem-d8462b8ef6a86672cf54f869",
  "title": "游城东王驸马亭",
  "author": "陆畅",
  "dynasty": "唐",
  "verses": [
    "城外无尘水间松，秋天木落见山容。",
    "共寻萧史江亭去，一望终南紫阁峰。"
  ],
  "enabled": true,
