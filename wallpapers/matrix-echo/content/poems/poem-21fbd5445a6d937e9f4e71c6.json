{
  "id": "poem-21fbd5445a6d937e9f4e71c6",
  "title": "咏柳",
  "author": "贺知章",
  "dynasty": "唐",
  "verses": [
    "碧玉妆成一树高，万条垂下绿丝绦。",
    "不知细叶谁裁出，二月春风似剪刀。"
  ],
