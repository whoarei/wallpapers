{
  "id": "poem-259fe33644bac99d5b946acd",
  "title": "风琴赠选上人",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "万籁甫消声，锵然忽自鸣。",
    "独宜风力小，双与月华清。",
    "历历谐三叠，玲玲叶九成。",
    "宫商虽断续，何处不分明。"
  ],
  "enabled": true,
  "collection": "宋诗选",
