{
  "id": "poem-7ca62ce61e38d5a036305790",
  "title": "送刘方石归旴江  其二",
  "author": "王同祖",
  "dynasty": "宋",
  "verses": [
    "昨日新闻未忍听，忧时赢得鬓毛星。",
    "归休高卧西江上，祗恐川原草木腥。"
  ],
  "enabled": true,
