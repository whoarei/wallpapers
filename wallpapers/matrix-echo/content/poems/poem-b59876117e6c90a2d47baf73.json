{
  "id": "poem-b59876117e6c90a2d47baf73",
  "title": "菩萨蛮·稽山鉴水无寒暑",
  "author": "曹勋",
  "dynasty": "宋",
  "verses": [
    "稽山鉴水无寒暑。",
    "荷香莲露相倾注。",
    "堂拟揖樵风。",
    "山围晚照红。",
    "桃根随秀叶。",
    "玉麈频招客。",
    "客况不言蓬。",
    "回船逸兴同。"
  ],
  "enabled": true,
  "collection": "宋词选",
