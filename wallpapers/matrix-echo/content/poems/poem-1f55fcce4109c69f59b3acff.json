{
  "id": "poem-1f55fcce4109c69f59b3acff",
  "title": "赠陈长史妓",
  "author": "刘言史",
  "dynasty": "唐",
  "verses": [
    "宝钿云和玉禁僊，深含媚靥褭朱弦。",
    "春风不怕君王恨，引出幽花落外边。"
  ],
  "enabled": true,
