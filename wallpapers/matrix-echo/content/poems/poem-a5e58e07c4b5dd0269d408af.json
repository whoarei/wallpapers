{
  "id": "poem-a5e58e07c4b5dd0269d408af",
  "title": "独游二首 二",
  "author": "皎然",
  "dynasty": "唐",
  "verses": [
    "临水兴不尽，虚舟可同嬉。",
    "还云与归鸟，若共山僧期。",
    "世事吾不预，此心谁得知。",
    "西峰有禅老，应见独游时。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
