{
  "id": "poem-6d3a05b78c6b0719455afe4c",
  "title": "题壁",
  "author": "杨凝式",
  "dynasty": "唐",
  "verses": [
    "院似禅心静，花如觉性圆。",
    "自然知了义，争肯学神仙。"
  ],
