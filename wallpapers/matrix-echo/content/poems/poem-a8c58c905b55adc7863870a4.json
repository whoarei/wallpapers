{
  "id": "poem-a8c58c905b55adc7863870a4",
  "title": "王神童",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "夙慧虽无蔕，抽萌便不凡。",
    "兰薰腾玉砌，侯国荐冰衔。",
    "荷橐行须复，牙签尽疗馋。",
    "一经千佛字，先把客儿搀。"
  ],
  "enabled": true,
  "collection": "宋诗选",
