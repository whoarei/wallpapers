{
  "id": "poem-5c48bc1178843b392da09948",
  "title": "偶然作六首 五",
  "author": "王维",
  "dynasty": "唐",
  "verses": [
    "赵女弹箜篌，复能邯郸舞。",
    "夫壻轻薄儿，鬬鸡事齐主。",
    "黄金买歌笑，用钱不复数。",
    "许史相经过，高门盈四牡。",
    "客舍有儒生，昂藏出邹鲁。",
    "读书三十年，腰间无尺组。",
    "被服圣人教，一生自穷苦。"
  ],
  "enabled": true,
