{
  "id": "poem-0cd2d83634c50871397e0d82",
  "title": "楚江怀古三首 二",
  "author": "马戴",
  "dynasty": "唐",
  "verses": [
    "惊鸟去无际，寒蛩鸣我傍。",
    "芦洲生早雾，兰隰下微霜。",
    "列宿分穷野，空流注大荒。",
    "看山候明月，聊自整云装。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
