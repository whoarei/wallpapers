{
  "id": "poem-743cc6aafe185e811f6170ea",
  "title": "题僧壁",
  "author": "赵嘏",
  "dynasty": "唐",
  "verses": [
    "晓望疎林露满巾，碧山秋寺属闲人。",
    "溪头尽日看红叶，却笑高僧衣有尘。"
  ],
