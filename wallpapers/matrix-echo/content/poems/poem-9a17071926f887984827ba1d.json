{
  "id": "poem-9a17071926f887984827ba1d",
  "title": "七夕",
  "author": "沈佺期",
  "dynasty": "唐",
  "verses": [
    "秋近雁行稀，天高鹊夜飞。",
    "妆成应懒织，今夕渡河归。",
    "月皎宜穿线，风轻得曝衣。",
    "来时不可觉，神验有光辉。"
  ],
  "enabled": true,
