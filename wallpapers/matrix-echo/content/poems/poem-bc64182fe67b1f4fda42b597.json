{
  "id": "poem-bc64182fe67b1f4fda42b597",
  "title": "浄名  其一",
  "author": "米芾",
  "dynasty": "宋",
  "verses": [
    "厌市冲烟入，忘怀对客迟。",
    "吟看飞鸟没，坐到夕阳时。"
  ],
  "enabled": true,
