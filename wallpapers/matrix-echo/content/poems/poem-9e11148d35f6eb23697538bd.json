{
  "id": "poem-9e11148d35f6eb23697538bd",
  "title": "寿蔡大资",
  "author": "华镇",
  "dynasty": "宋",
  "verses": [
    "岩岩巨镇瞻维岳，落落乔松栋干姿。",
    "物外风神时远鹤，几先识断世元龟。",
    "还逢周寝占熊旦，恰是商岩肖象时。",
    "愿酝东溟为寿酒，一年一献一瑶巵。"
  ],
  "enabled": true,
  "collection": "宋诗选",
