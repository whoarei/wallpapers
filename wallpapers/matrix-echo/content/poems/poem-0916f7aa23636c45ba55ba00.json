{
  "id": "poem-0916f7aa23636c45ba55ba00",
  "title": "和前人韵  其二",
  "author": "王柏",
  "dynasty": "宋",
  "verses": [
    "庭前日日见兰芽，谁把青山特地遮。",
    "雁影寂寥君又远，归期夜夜卜灯花。"
  ],
  "enabled": true,
