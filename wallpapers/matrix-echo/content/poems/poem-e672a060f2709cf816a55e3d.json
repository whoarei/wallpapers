{
  "id": "poem-e672a060f2709cf816a55e3d",
  "title": "秦淮",
  "author": "华镇",
  "dynasty": "宋",
  "verses": [
    "渺渺方山道，江流一派通。",
    "寒沙翘白鹭，夕霭暝丹枫。",
    "平截埋金地，虚涵建邺宫。",
    "六朝乘王气，疏凿竟无功。"
  ],
  "enabled": true,
  "collection": "宋诗选",
