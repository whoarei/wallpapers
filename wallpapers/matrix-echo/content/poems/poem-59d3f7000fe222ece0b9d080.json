{
  "id": "poem-59d3f7000fe222ece0b9d080",
  "title": "乐府杂词三首 二",
  "author": "刘言史",
  "dynasty": "唐",
  "verses": [
    "蝉鬓红冠粉黛轻，云和新教羽衣成。",
    "月光如雪金堦上，迸却颇梨义甲声。"
  ],
  "enabled": true,
