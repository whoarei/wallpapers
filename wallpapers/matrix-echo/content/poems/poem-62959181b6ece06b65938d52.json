{
  "id": "poem-62959181b6ece06b65938d52",
  "title": "春江花月夜二首 二",
  "author": "张子容",
  "dynasty": "唐",
  "verses": [
    "交甫怜瑶珮，仙妃难重期。",
    "沈沈绿江晚，惆怅碧云姿。",
    "初逢花上月，言是弄珠时。"
  ],
  "enabled": true,
