{
  "id": "poem-a686e1a552039e3e173aab19",
  "title": "甘棠",
  "author": "佚名",
  "dynasty": "先秦",
  "verses": [
    "蔽芾甘棠，勿翦勿伐，召伯所茇。",
    "蔽芾甘棠，勿翦勿败，召伯所憩。",
    "蔽芾甘棠，勿翦勿拜，召伯所说。"
  ],
  "enabled": true,
  "collection": "诗经",
  "tags": [],
