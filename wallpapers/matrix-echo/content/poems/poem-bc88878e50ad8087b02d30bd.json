{
  "id": "poem-bc88878e50ad8087b02d30bd",
  "title": "题庾楼",
  "author": "张栻",
  "dynasty": "宋",
  "verses": [
    "南瞻庐阜北淮山，下有长江万顷寒。",
    "往事无边随去浪，西风有客傍阑干。"
  ],
  "enabled": true,
  "collection": "宋诗选",
  "tags": [
    "长江"
  ],
