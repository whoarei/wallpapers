{
  "id": "poem-2858849b281ae4a481cbf86b",
  "title": "阮郎归·留连春意晚花稠",
  "author": "赵",
  "dynasty": "宋",
  "verses": [
    "留连春意晚花稠。",
    "云疏雨未收。",
    "新荷池面叶齐抽。",
    "凉天醉碧楼。",
    "能达理，有何愁。",
    "心宽万事休。",
    "人生还似水中沤。",
    "金尊尽更酬。"
  ],
  "enabled": true,
  "collection": "宋词选",
