{
  "id": "poem-3f35ddfd66838e2f8652c0cb",
  "title": "春寒",
  "author": "徐凝",
  "dynasty": "唐",
  "verses": [
    "乱雪从教舞，回风任听吹。",
    "春寒能作底，已被柳条欺。"
  ],
  "enabled": true,
