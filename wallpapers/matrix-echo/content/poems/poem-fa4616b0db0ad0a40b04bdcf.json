{
  "id": "poem-fa4616b0db0ad0a40b04bdcf",
  "title": "荔枝五首  其四",
  "author": "李纲",
  "dynasty": "宋",
  "verses": [
    "荔子蛮方也自丹，不如闽岭为微酸。",
    "玉盘磊珂三千颗，犹忆甘芳绕齿寒。"
  ],
  "enabled": true,
  "collection": "宋诗选",
