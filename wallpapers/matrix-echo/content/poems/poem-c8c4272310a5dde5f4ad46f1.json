{
  "id": "poem-c8c4272310a5dde5f4ad46f1",
  "title": "诗三首  其二",
  "author": "释遇贤",
  "dynasty": "宋",
  "verses": [
    "心闲增道气，忍事敌灾屯。",
    "谨言终少祸，节俭胜求人。"
  ],
