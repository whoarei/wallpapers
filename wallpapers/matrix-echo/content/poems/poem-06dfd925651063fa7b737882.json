{
  "id": "poem-06dfd925651063fa7b737882",
  "title": "侍郎宅泛池",
  "author": "徐凝",
  "dynasty": "唐",
  "verses": [
    "莲子花边回竹岸，鸡头叶上荡兰舟。",
    "谁知洛北朱门里，便到江南绿水游。"
  ],
  "enabled": true,
