{
  "id": "poem-07cf9e44f42155651f013fa2",
  "title": "邵尧夫先生哀辞二首  其二",
  "author": "司马光",
  "dynasty": "宋",
  "verses": [
    "慕德闻风久，论交倾盖新。",
    "何须半面旧，不待一言亲。",
    "讲道切磋直，忘怀笑语真。",
    "重言蒙跖实，佩服敢书绅。"
  ],
  "enabled": true,
  "collection": "宋诗选",
