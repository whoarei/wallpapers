{
  "id": "poem-7f9c70d97471211c61485f9f",
  "title": "杂诗三首 二",
  "author": "沈佺期",
  "dynasty": "唐",
  "verses": [
    "妾家临渭北，春梦著辽西。",
    "何苦朝鲜郡，年年事鼓鼙。",
    "燕来红壁语，莺向绿窗啼。",
    "为许长相忆，阑干玉筯齐。"
  ],
  "enabled": true,
