{
  "id": "poem-13ca3dca325b8bd7fe5aba8c",
  "title": "华顶",
  "author": "李绅",
  "dynasty": "唐",
  "verses": [
    "欲向仙峰炼九丹，独瞻华顶礼仙坛。",
    "石标琪树凌空碧，水挂银河映月寒。",
    "天外鹤声随绛节，洞中云气隐琅玕。",
    "浮生未有从师地，空诵仙经想羽翰。"
  ],
  "enabled": true,
