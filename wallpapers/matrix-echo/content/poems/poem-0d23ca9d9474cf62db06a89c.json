{
  "id": "poem-0d23ca9d9474cf62db06a89c",
  "title": "横吹曲辞 折杨柳",
  "author": "翁绶",
  "dynasty": "唐",
  "verses": [
    "紫陌金堤映绮罗，游人处处动离歌。",
    "阴移古戍迷荒草，花带残阳落远波。",
    "台上少年吹白雪，楼中思妇敛青蛾。",
    "殷勤攀折赠行客，此去关山雨雪多。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
