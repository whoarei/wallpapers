{
  "id": "poem-8e40d5f5ba3f39ead4ccace3",
  "title": "大臣荐对诗",
  "author": "米芾",
  "dynasty": "宋",
  "verses": [
    "笏引上天梯，鞘鸣奋地雷。",
    "谁云天尺五，亲见玉皇来。"
  ],
  "enabled": true,
