{
  "id": "poem-1889cf954bb4db810295bcd1",
  "title": "牛头庵颂",
  "author": "文益",
  "dynasty": "唐",
  "verses": [
    "国城南，祖师庵。",
    "庵旧址，依云岚。",
    "兽驯淑，人相参。",
    "忽有心，终不堪。"
  ],
  "enabled": true,
