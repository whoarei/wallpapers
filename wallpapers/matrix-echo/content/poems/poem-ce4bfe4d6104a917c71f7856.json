{
  "id": "poem-ce4bfe4d6104a917c71f7856",
  "title": "代人乞花",
  "author": "李益",
  "dynasty": "唐",
  "verses": [
    "绣户朝眠起，开帘满地花。",
    "春风解人意，欲落妾西家。"
  ],
  "enabled": true,
