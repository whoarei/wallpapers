{
  "id": "poem-d075fb8be5914ffc55a19393",
  "title": "赠海东僧",
  "author": "张籍",
  "dynasty": "唐",
  "verses": [
    "别家行万里，自说过扶余。",
    "学得中州语，能为外国书。",
    "与医收海藻，持咒取龙鱼。",
    "更问同来伴，天台几处居。"
  ],
  "enabled": true,
