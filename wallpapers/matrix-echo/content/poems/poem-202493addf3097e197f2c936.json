{
  "id": "poem-202493addf3097e197f2c936",
  "title": "菩萨蛮·风庭瑟瑟灯明灭",
  "author": "李弥逊",
  "dynasty": "宋",
  "verses": [
    "风庭瑟瑟灯明灭。",
    "碧梧枝上蝉声歇。",
    "枕冷梦魂惊。",
    "一阶寒水明。",
    "鸟飞人未起。",
    "月露清如洗。",
    "无语听残更。",
    "愁从两鬓生。"
  ],
  "enabled": true,
  "collection": "宋词选",
