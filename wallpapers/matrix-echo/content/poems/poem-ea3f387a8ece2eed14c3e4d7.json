{
  "id": "poem-ea3f387a8ece2eed14c3e4d7",
  "title": "隋宫",
  "author": "李商隐",
  "dynasty": "唐",
  "verses": [
    "乘兴南游不戒严，九重谁省谏书函。",
    "春风举国裁宫锦，半作障泥半作帆。"
  ],
  "enabled": true,
