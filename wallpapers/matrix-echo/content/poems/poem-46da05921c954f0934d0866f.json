{
  "id": "poem-46da05921c954f0934d0866f",
  "title": "隋堤怀古",
  "author": "张祜",
  "dynasty": "唐",
  "verses": [
    "隋季穷兵复濬川，自为猛虎可周旋。",
    "锦帆东去不归日，汴水西来无尽年。",
    "本欲山河传百二，谁知钟鼎已三千。",
    "那堪重问江都事，回望空悲绿树烟。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
  "tags": [
    "忧国忧民",
    "怀古"
