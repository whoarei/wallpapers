{
  "id": "poem-da4004fef6b941822f9179ab",
  "title": "村市",
  "author": "宋伯仁",
  "dynasty": "宋",
  "verses": [
    "山暗风屯雨，溪浑水浴沙。",
    "小桥通古寺，疎柳纳残鸦。",
    "苜蓿重沽酒，芝麻旋点茶。",
    "愿人长似旧，岁岁插桃花。"
  ],
  "enabled": true,
  "collection": "宋诗选",
