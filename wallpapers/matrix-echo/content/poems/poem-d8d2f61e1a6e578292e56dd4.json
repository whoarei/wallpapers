{
  "id": "poem-d8d2f61e1a6e578292e56dd4",
  "title": "横吹曲辞 折杨柳",
  "author": "欧阳瑾",
  "dynasty": "唐",
  "verses": [
    "垂柳拂妆台，葳蕤叶半开。",
    "年华枝上见，边思曲中来。",
    "嫩色宜新雨，轻花伴落梅。",
    "朝朝倦攀折，征戍几时回。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
