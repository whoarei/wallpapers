{
  "id": "poem-c03fe9e4074dcb9708167bae",
  "title": "永泰公主挽歌二首 一",
  "author": "吴兢",
  "dynasty": "唐",
  "verses": [
    "秾华从妇道，厘降适诸侯。",
    "河汉天孙合，潇湘帝子游。",
    "关雎方作训，鸣凤自相求。",
    "可叹凌波迹，东川遂不流。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
