{
  "id": "poem-3190da259e7cf80006e96132",
  "title": "送曾秀才",
  "author": "徐铉",
  "dynasty": "宋",
  "verses": [
    "淦水神仙宅，仙山夹县楼。",
    "吾孙好诗句，归咏故乡秋。",
    "紫竹遮书幌，红蕉拂钓舟。",
    "东堂有平路，莫谒外诸侯。"
  ],
  "enabled": true,
  "collection": "宋诗选",
