{
  "id": "poem-5ca6867c1e01ef61ee3580c5",
  "title": "菊",
  "author": "吕从庆",
  "dynasty": "唐",
  "verses": [
    "短篱偎曲径，风雨困秋曦。",
    "竞惜芙蓉冷，何知更有伊。"
  ],
  "enabled": true,
