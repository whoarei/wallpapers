{
  "id": "poem-4abd166a4db231a8f1c33cf8",
  "title": "送边上从事",
  "author": "周繇",
  "dynasty": "唐",
  "verses": [
    "戎装佩镆鎁，走马逐轻车。",
    "衰草城边路，残阳垄上笳。",
    "黄河穿汉界，青冢出胡沙。",
    "提笔男儿事，功名立可夸。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
  "tags": [
    "黄河"
  ],
