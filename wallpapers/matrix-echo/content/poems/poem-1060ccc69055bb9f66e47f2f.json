{
  "id": "poem-1060ccc69055bb9f66e47f2f",
  "title": "从吕扬州觅芍药栽",
  "author": "张栻",
  "dynasty": "宋",
  "verses": [
    "扬州风物故依然，梦想他时楚水边。",
    "乞与灵根归自种，梢头茧栗看新年。"
  ],
  "enabled": true,
