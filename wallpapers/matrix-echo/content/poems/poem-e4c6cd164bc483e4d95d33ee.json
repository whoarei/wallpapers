{
  "id": "poem-e4c6cd164bc483e4d95d33ee",
  "title": "南乡子·渔市散",
  "author": "李珣",
  "dynasty": "五代",
  "verses": [
    "渔市散，渡船稀，越南云树望中微。",
    "行客待湘天欲暮，送春浦，愁听猩猩啼瘴雨。"
  ],
  "enabled": true,
  "collection": "花间集",
