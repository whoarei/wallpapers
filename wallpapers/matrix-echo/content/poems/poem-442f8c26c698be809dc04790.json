{
  "id": "poem-442f8c26c698be809dc04790",
  "title": "姑熟杂咏 慈姥竹",
  "author": "李赤",
  "dynasty": "唐",
  "verses": [
    "野竹攒石生，含烟映江岛。",
    "翠色落波深，虚声带寒早。",
    "龙吟曾未听，凤曲吹应好。",
    "不学蒲柳凋，贞心常自保。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
