{
  "id": "poem-4986d895f2a4bd46fb52a8dd",
  "title": "菩萨蛮 其九",
  "author": "温庭筠",
  "dynasty": "唐",
  "verses": [
    "满宫明月梨花白，故人万里关山隔。",
    "金雁一双飞，泪痕沾绣衣。",
    "小园芳草绿，家住越溪曲。",
    "杨柳色依依，燕归君不归。"
  ],
  "enabled": true,
  "collection": "花间集",
  "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/五代诗词/huajianji/huajianji-1-juan.json#record-8",
