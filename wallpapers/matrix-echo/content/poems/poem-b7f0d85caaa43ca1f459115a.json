{
  "id": "poem-b7f0d85caaa43ca1f459115a",
  "title": "子规",
  "author": "项斯",
  "dynasty": "唐",
  "verses": [
    "游魂自相叫，宁复记前身。",
    "飞过人家月，声连客路春。",
    "梦边催晓急，愁外送风频。",
    "自有沾花血，相和泪滴新。"
  ],
  "enabled": true,
