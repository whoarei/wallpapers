{
  "id": "poem-bd523d8556b803c2c1a12f35",
  "title": "城南即事  其六",
  "author": "张栻",
  "dynasty": "宋",
  "verses": [
    "枕边风雨过今春，起步园林已绿阴。",
    "更向坡头望湘浦，水云无际遶遥岑。"
  ],
  "enabled": true,
