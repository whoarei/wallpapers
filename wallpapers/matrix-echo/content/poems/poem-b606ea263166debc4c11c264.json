{
  "id": "poem-b606ea263166debc4c11c264",
  "title": "春秋战国门 冯讙",
  "author": "周昙",
  "dynasty": "唐",
  "verses": [
    "兔窟穿成主再兴，辈流狐伏敢骄矜。",
    "冯讙不是无能者，要试君心欲展能。"
  ],
  "enabled": true,
