{
  "id": "poem-a287ec73448f6e39ec420788",
  "title": "秋宵",
  "author": "钱遹",
  "dynasty": "宋",
  "verses": [
    "南邻灯火冷，三叹愁夜永。",
    "北里歌未终，已惊初日红。",
    "不知昼夜谁拘管，一等秋宵有长短。"
  ],
  "enabled": true,
