{
  "id": "poem-b0712f145c5a035711abc4d4",
  "title": "观碁",
  "author": "子兰",
  "dynasty": "唐",
  "verses": [
    "拂局尽消时，能因长路迟。",
    "点头初得计，格手待无疑。",
    "寂默亲遗景，凝神入过思。",
    "共藏多少意，不语两相知。"
  ],
  "enabled": true,
