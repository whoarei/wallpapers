{
  "id": "poem-208ec8a7a4be4dd43a339568",
  "title": "高司马移竹",
  "author": "马戴",
  "dynasty": "唐",
  "verses": [
    "丛居堂下幸君移，翠掩灯窗露叶垂。",
    "莫羡孤生在山者，无人看著拂云枝。"
  ],
  "enabled": true,
