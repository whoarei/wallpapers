{
  "id": "poem-f925353e14deec83fb39e4b6",
  "title": "冬日骆家亭子",
  "author": "刘得仁",
  "dynasty": "唐",
  "verses": [
    "亭台腊月时，松竹见贞姿。",
    "林积烟藏日，风吹水合池。",
    "恨无人此住，静有鹤相窥。",
    "是景吟诗徧，真于野客宜。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
