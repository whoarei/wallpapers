{
  "id": "poem-fcaf730055dcae4ad4d2fd2b",
  "title": "偈颂（幷序○序为南岳齐己撰） 七十五",
  "author": "居遁",
  "dynasty": "唐",
  "verses": [
    "老似临江树，风摇枝必危。",
    "岸崩随水去，入海勿人追。"
  ],
  "enabled": true,
