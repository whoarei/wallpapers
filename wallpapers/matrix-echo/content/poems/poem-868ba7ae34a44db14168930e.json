{
  "id": "poem-868ba7ae34a44db14168930e",
  "title": "王叔武示忠州张使君德远近诗次韵三首  其一",
  "author": "曾协",
  "dynasty": "宋",
  "verses": [
    "垂绅立朝著，智略胜吾丘。",
    "列戟分名郡，儿童说细侯。",
    "卷舒谁罣碍，中外且嬉游。",
    "闻说淮南守，天边又拜州。"
  ],
  "enabled": true,
  "collection": "宋诗选",
  "tags": [],
