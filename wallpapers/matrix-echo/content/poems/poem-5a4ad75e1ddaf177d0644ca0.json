{
  "id": "poem-5a4ad75e1ddaf177d0644ca0",
  "title": "巴童荅",
  "author": "李贺",
  "dynasty": "唐",
  "verses": [
    "巨鼻宜山褐，庞眉入苦吟。",
    "非君唱乐府，谁识怨秋深。"
  ],
