{
  "id": "poem-742b07a82f5a3c76858af964",
  "title": "奉和李右相赏会昌林亭",
  "author": "孙逖",
  "dynasty": "唐",
  "verses": [
    "贤相初陪跸，灵山本降神。",
    "作京雄近县，开阁宠平津。",
    "地胜林亭好，时清宴赏频。",
    "百泉萦草木，万井布郊畛。",
    "德与春和盛，功将造化邻。",
    "还嗤渭滨叟，岁晚独垂纶。"
  ],
  "enabled": true,
