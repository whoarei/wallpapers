{
  "id": "poem-55cfd1e9595a8cd4987fe57a",
  "title": "赋得",
  "author": "刘长卿",
  "dynasty": "唐",
  "verses": [
    "莺啼燕语报新年，马邑龙堆路几千。",
    "家住层城临汉苑，[心]随明月到胡天。",
    "机中锦字论长恨，楼上花枝笑独眠。",
    "为问元戎窦车骑，何时返斾勒燕然。"
  ],
  "enabled": true,
