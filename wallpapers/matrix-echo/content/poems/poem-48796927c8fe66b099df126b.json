{
  "id": "poem-48796927c8fe66b099df126b",
  "title": "春夜宿云际寺",
  "author": "斐公衍",
  "dynasty": "唐",
  "verses": [
    "境静闻钟声易响，庭高见月影难沈。",
    "青山解隔尘中事，流水能清物外心。"
  ],
  "enabled": true,
