{
  "id": "poem-8adf66a950ace96f176ae6a1",
  "title": "南乡子·云带雨",
  "author": "李珣",
  "dynasty": "五代",
  "verses": [
    "云带雨，浪迎风，钓翁回棹碧湾中。",
    "春酒香熟鲈鱼美，谁同醉？",
    "缆却扁舟篷底睡。"
  ],
  "enabled": true,
  "collection": "花间集",
  "tags": [],
