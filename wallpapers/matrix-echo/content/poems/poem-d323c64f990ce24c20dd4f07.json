{
  "id": "poem-d323c64f990ce24c20dd4f07",
  "title": "人日立春",
  "author": "卢仝",
  "dynasty": "唐",
  "verses": [
    "春度春归无限春，今朝方始觉成人。",
    "从今尅己应犹及，颜与梅花俱自新。"
  ],
