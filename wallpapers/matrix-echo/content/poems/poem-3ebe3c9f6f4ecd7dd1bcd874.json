{
  "id": "poem-3ebe3c9f6f4ecd7dd1bcd874",
  "title": "寄梅处士",
  "author": "张籍",
  "dynasty": "唐",
  "verses": [
    "扰扰人间是与非，官闲自觉省心机。",
    "六行班里身常下，九列符中事亦稀。",
    "市客惯曾赊贱药，家僮惊见著新衣。",
    "君今独得居山乐，应喜多时未办归。"
  ],
  "enabled": true,
