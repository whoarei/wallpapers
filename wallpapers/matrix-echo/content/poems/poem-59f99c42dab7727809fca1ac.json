{
  "id": "poem-59f99c42dab7727809fca1ac",
  "title": "更漏子·鹊桥边",
  "author": "向子𬤇",
  "dynasty": "宋",
  "verses": [
    "鹊桥边，牛渚上。",
    "翠节红旌相向。",
    "承玉露，御金风。",
    "年年岁岁同。",
    "懒飞梭，停弄杼。",
    "遥想彩云深处。",
    "人咫尺，事关山。",
    "无聊独倚栏。"
  ],
  "enabled": true,
  "collection": "宋词选",
