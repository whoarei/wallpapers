{
  "id": "poem-f7714f909489722bf62696c3",
  "title": "偈颂六十七首  其一五",
  "author": "释原妙",
  "dynasty": "宋",
  "verses": [
    "天关久锁不开容，日夜滂沱鼓黑风。",
    "愤性一槌俱击碎，顶门迸出一轮红。"
  ],
  "enabled": true,
