{
  "id": "poem-87f09d94c9ac0b7c22f31448",
  "title": "永明山居诗（六十九首） 六十六",
  "author": "延寿",
  "dynasty": "唐",
  "verses": [
    "得丧从来事甚均，任缘徒用苦劳神。",
    "野蔬随分堪充口，石室依稀可庇身。",
    "碧海几时无去棹，红衢何日息征轮。",
    "若教求道如求利，举世浑成无事人。"
  ],
  "enabled": true,
