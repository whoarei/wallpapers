{
  "id": "poem-4a22ad47c62c8ee24818f988",
  "title": "鹦鹉",
  "author": "来鹄",
  "dynasty": "唐",
  "verses": [
    "色白还应及雪衣，觜红毛绿语仍奇。",
    "年年锁在金笼里，何似陇山闲处飞。"
  ],
  "enabled": true,
