{
  "id": "poem-c07d293ba20d62b24d41a260",
  "title": "金陵览古 直渎",
  "author": "朱存",
  "dynasty": "宋",
  "verses": [
    "昼役人功夜鬼功，阳开阴阖几时终。",
    "不闻掷土江中语，争得盈流一水通。"
  ],
