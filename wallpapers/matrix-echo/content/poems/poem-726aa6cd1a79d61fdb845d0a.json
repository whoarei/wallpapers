{
  "id": "poem-726aa6cd1a79d61fdb845d0a",
  "title": "姑熟杂咏 天门山",
  "author": "李赤",
  "dynasty": "唐",
  "verses": [
    "迥出江水上，双峰自相对。",
    "岸映松色寒，石分浪花碎。",
    "参差远天际，缥缈晴霞外。",
    "落日舟去遥，回首沈青霭。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
  "tags": [
    "天门山"
  ],
