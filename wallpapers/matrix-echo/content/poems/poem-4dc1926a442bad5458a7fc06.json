{
  "id": "poem-4dc1926a442bad5458a7fc06",
  "title": "送古之奇赴安西幕",
  "author": "李端",
  "dynasty": "唐",
  "verses": [
    "畴昔十年兄，相逢五校营。",
    "今宵举杯酒，陇月见军城。",
    "堠火经阴绝，边人接晓行。",
    "殷勤送书记，强虏几时平。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
