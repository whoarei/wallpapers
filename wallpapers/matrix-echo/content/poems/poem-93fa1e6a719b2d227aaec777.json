{
  "id": "poem-93fa1e6a719b2d227aaec777",
  "title": "送卢少府之任巩洛",
  "author": "李洞",
  "dynasty": "唐",
  "verses": [
    "从知东甸尉，铨注似恩除。",
    "带土移嵩术，和泉送尹鱼。",
    "印床寒鹭宿，壁记醉僧书。",
    "堂下诸昆在，无妨候起居。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
