{
  "id": "poem-300c1ad664fb83e2ba29e5af",
  "title": "劝人 二十二",
  "author": "义存",
  "dynasty": "唐",
  "verses": [
    "报汝等知乎，真性不在途。",
    "色身祇要闲，何用苦区区。"
  ],
