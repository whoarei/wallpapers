{
  "id": "poem-f1321950f52830ea55b2d1e9",
  "title": "送友人之永嘉",
  "author": "项斯",
  "dynasty": "唐",
  "verses": [
    "长贫知不易，去计拟何逃。",
    "相对人愁别，经过几处劳。",
    "城连沙岫远，山断夏云高。",
    "犹想成诗处，秋灯半照涛。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
