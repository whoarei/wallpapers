{
  "id": "poem-068a47f86cac18c1debf004b",
  "title": "花影",
  "author": "苏轼",
  "dynasty": "宋",
  "verses": [
    "重重叠叠上瑶台，几度呼童扫不开。",
    "刚被太阳收拾去，却教明月送将来。"
  ],
  "enabled": true,
