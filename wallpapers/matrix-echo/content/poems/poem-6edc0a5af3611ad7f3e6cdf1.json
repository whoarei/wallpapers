{
  "id": "poem-6edc0a5af3611ad7f3e6cdf1",
  "title": "送王炎弼赴山阳守以兵卫森画戟宴寝凝清香为韵十首  其九",
  "author": "曾协",
  "dynasty": "宋",
  "verses": [
    "复旦风云合，丹心日月明。",
    "江神回朗照，霁色向来清。"
  ],
  "enabled": true,
