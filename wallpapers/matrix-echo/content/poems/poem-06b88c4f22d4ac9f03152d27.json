{
  "id": "poem-06b88c4f22d4ac9f03152d27",
  "title": "咏李",
  "author": "张𬸦",
  "dynasty": "唐",
  "verses": [
    "李树子，元来不是偏。",
    "巧知娘子意，掷果到渠边。"
  ],
  "enabled": true,
