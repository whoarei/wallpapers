{
  "id": "poem-692b01786f945e7cea477830",
  "title": "苕溪新上人石窗",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "太白岩空夜弗扃，好风不约满疏櫺。",
    "旧题寂寞无人管，散作苕溪水上云。"
  ],
  "enabled": true,
