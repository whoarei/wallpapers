{
  "id": "poem-5daa34d056b365913037c9c7",
  "title": "阮郎归·江南江北雪漫漫",
  "author": "向子𬤇",
  "dynasty": "宋",
  "verses": [
    "江南江北雪漫漫。",
    "遥知易水寒。",
    "同云深处望三关。",
    "断肠山又山。",
    "天可老，海能翻。",
    "消除此恨难。",
    "频闻遣使问平安。",
    "几时鸾辂还。"
  ],
  "enabled": true,
  "collection": "宋词选",
