{
  "id": "poem-61b2f13fb2384d26776917b5",
  "title": "破船",
  "author": "杜甫",
  "dynasty": "唐",
  "verses": [
    "平生江海心，宿昔具扁舟。",
    "岂惟青溪上，日傍柴门游。",
    "苍皇避乱兵，缅邈怀旧丘。",
    "邻人亦已非，野竹独修修。",
    "船舷不重扣，埋没已经秋。",
    "仰看西飞翼，下媿东逝流。",
    "故者或可掘，新者亦易求。",
    "所悲数奔窜，白屋难久留。"
  ],
  "enabled": true,
