{
  "id": "poem-d5921db4e6f1423b9597c21f",
  "title": "春晦送客",
  "author": "雍裕之",
  "dynasty": "唐",
  "verses": [
    "野酌乱无巡，送君兼送春。",
    "明年春色至，莫作未归人。"
  ],
  "enabled": true,
