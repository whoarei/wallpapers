{
  "id": "poem-ea5c47ed32bd0f8673dbf084",
  "title": "秋望",
  "author": "李咸用",
  "dynasty": "唐",
  "verses": [
    "云阴惨澹柳阴稀，游子天涯一望时。",
    "风闪雁行疎又密，地回江势急还迟。",
    "荣枯物理终难测，贵贱人生自不知。",
    "未达谁能多叹息，尘埃争损得男儿。"
  ],
  "enabled": true,
