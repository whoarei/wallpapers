{
  "id": "poem-6e05ddf7c91d6bcaba507497",
  "title": "送严明府入关谒黎京兆",
  "author": "皎然",
  "dynasty": "唐",
  "verses": [
    "春日异秋风，何为怨别同。",
    "潮回芳渚没，花落昼山空。",
    "旅候闻嘶马，残阳望断鸿。",
    "应思右内史，相见直城中。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
