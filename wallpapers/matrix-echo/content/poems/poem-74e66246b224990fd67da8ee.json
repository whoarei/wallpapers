{
  "id": "poem-74e66246b224990fd67da8ee",
  "title": "河南府试十二月乐词 六月",
  "author": "李贺",
  "dynasty": "唐",
  "verses": [
    "裁生罗，伐湘竹。",
    "帔拂疎霜簟秋玉，炎炎红镜东方开。",
    "晕如车轮上裴回，啾啾赤帝骑龙来。"
  ],
  "enabled": true,
