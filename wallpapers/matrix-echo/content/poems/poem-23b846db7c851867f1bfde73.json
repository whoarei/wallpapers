{
  "id": "poem-23b846db7c851867f1bfde73",
  "title": "偈颂七十一首  其五二",
  "author": "释了惠",
  "dynasty": "宋",
  "verses": [
    "南山鼈鼻蛇，撺入新罗国。",
    "吞却镇海珠，咬杀嘉州佛。"
  ],
