{
  "id": "poem-604e812a5c134b99ce921f24",
  "title": "送同落第者东归",
  "author": "李益",
  "dynasty": "唐",
  "verses": [
    "东门有行客，落日满前山。",
    "圣代谁知者，沧洲今独还。",
    "片云归海暮，流水背城闲。",
    "余亦依嵩颍，松花深闭关。"
  ],
  "enabled": true,
