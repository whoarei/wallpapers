{
  "id": "poem-c27417bd2b90bf392b91a78f",
  "title": "郊庙歌辞 祭神州乐章 迎神",
  "author": "不详",
  "dynasty": "唐",
  "verses": [
    "黄舆厚载，赤寰归德。",
    "含育九区，保安万国。",
    "诚敬无怠，禋祀有则。",
    "乐以迎神，其仪不忒。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
