{
  "id": "poem-e3452d5fd9995a5561d4d8ee",
  "title": "题王氏志嘉堂二首  其一",
  "author": "李纲",
  "dynasty": "宋",
  "verses": [
    "秀岭云屏拥，湍流玉佩锵。",
    "竹光深锁翠，兰气暗腾芳。",
    "岂谓兵戈日，来登君子堂。",
    "美才方世用，嘉遯自难忘。"
  ],
  "enabled": true,
  "collection": "宋诗选",
