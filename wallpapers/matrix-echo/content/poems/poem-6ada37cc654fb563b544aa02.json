{
  "id": "poem-6ada37cc654fb563b544aa02",
  "title": "梦二叔",
  "author": "王十朋",
  "dynasty": "宋",
  "verses": [
    "二叔年皆八十余，经年不见久无书。",
    "江山不隔还乡梦，昨夜迢迢到佛庐。"
  ],
  "enabled": true,
