{
  "id": "poem-d09d8e934e385f9bb5dd488f",
  "title": "送庞百篇之任青阳县尉",
  "author": "张乔",
  "dynasty": "唐",
  "verses": [
    "都堂公试日，词翰独超群。",
    "品秩台庭与，篇章圣主闻。",
    "乡连三楚树，县对九华云。",
    "多少青门客，临岐共羡君。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
