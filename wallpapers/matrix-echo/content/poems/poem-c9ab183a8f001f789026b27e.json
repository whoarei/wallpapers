{
  "id": "poem-c9ab183a8f001f789026b27e",
  "title": "章台夜思",
  "author": "韦庄",
  "dynasty": "唐",
  "verses": [
    "清瑟怨遥夜，遶弦风雨哀。",
    "孤灯闻楚角，残月下章台。",
    "芳草已云暮，故人殊未来。",
    "乡书不可寄，秋雁又南回。"
  ],
  "enabled": true,
  "collection": "唐诗三百首",
