{
  "id": "poem-1c20b4bf3dbf6cb0b6547831",
  "title": "过马嵬",
  "author": "李益",
  "dynasty": "唐",
  "verses": [
    "汉将如云不直言，寇来翻罪绮罗恩。",
    "托君休洗莲花血，留记千年妾泪痕。"
  ],
  "enabled": true,
