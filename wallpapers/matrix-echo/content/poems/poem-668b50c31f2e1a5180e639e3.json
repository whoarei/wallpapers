{
  "id": "poem-668b50c31f2e1a5180e639e3",
  "title": "夜坐",
  "author": "宋伯仁",
  "dynasty": "宋",
  "verses": [
    "柏香烟里瀹山茶，穷似烧丹道士家。",
    "窗纸渐明寒月上，一肱清梦入梅花。"
  ],
  "enabled": true,
  "collection": "宋诗选",
