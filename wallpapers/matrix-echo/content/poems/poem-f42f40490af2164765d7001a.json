{
  "id": "poem-f42f40490af2164765d7001a",
  "title": "偈颂（幷序○序为南岳齐己撰） 四十八",
  "author": "居遁",
  "dynasty": "唐",
  "verses": [
    "在梦那知梦是虚，觉来方觉梦中无。",
    "迷时恰似梦中士，悟后还同睡起夫。"
  ],
  "enabled": true,
