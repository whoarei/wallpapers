{
  "id": "poem-834d08446b56596bd564f2e0",
  "title": "宫词  其一八",
  "author": "张公庠",
  "dynasty": "宋",
  "verses": [
    "池北池南柳对黄，翠华游幸昼初长。",
    "宫娥从驾知多少，十里朱轮半日香。"
  ],
  "enabled": true,
