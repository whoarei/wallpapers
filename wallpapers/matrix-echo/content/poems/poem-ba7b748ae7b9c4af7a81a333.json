{
  "id": "poem-ba7b748ae7b9c4af7a81a333",
  "title": "赠兄",
  "author": "何兆",
  "dynasty": "唐",
  "verses": [
    "洛阳纸价因兄贵，蜀地红牋为弟贫。",
    "南北东西九千里，除兄与弟更无人。"
  ],
  "enabled": true,
