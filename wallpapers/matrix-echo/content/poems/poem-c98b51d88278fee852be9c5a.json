{
  "id": "poem-c98b51d88278fee852be9c5a",
  "title": "好事近·风细晚轩凉",
  "author": "洪适",
  "dynasty": "宋",
  "verses": [
    "风细晚轩凉，妙句初挥新墨。",
    "绿水池中宾佐，对嫩荷擎绿。",
    "坐看微月上云头，清臂映寒玉。",
    "只恐朝来酒醒，有文书羁束。"
  ],
  "enabled": true,
  "collection": "宋词选",
