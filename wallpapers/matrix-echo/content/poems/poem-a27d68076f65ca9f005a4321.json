{
  "id": "poem-a27d68076f65ca9f005a4321",
  "title": "同卫八题陆少府书斋",
  "author": "高适",
  "dynasty": "唐",
  "verses": [
    "知君薄州县，好静无冬春。",
    "散帙至栖鸟，明灯留故人。",
    "深房腊酒熟，高院梅花新。",
    "若是周旋地，当令风义亲。"
  ],
  "enabled": true,
