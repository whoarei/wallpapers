{
  "id": "poem-5909f0c60096e9aba55a68b9",
  "title": "咸阳送房济侍御归太原幕",
  "author": "卢纶",
  "dynasty": "唐",
  "verses": [
    "旧居无旧邻，似见故乡春。",
    "复对别离酒，欲成衰老人。",
    "客衣频染泪，军旅亦多尘。",
    "握手重相勉，平生心所因。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
