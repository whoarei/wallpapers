{
  "id": "poem-0dab0d46892208478348b921",
  "title": "笔",
  "author": "米芾",
  "dynasty": "宋",
  "verses": [
    "摹画由来妙手知，彩笺落处直疑飞。",
    "寸心用尽终何补，赢得霜毫秃后归。"
  ],
  "enabled": true,
