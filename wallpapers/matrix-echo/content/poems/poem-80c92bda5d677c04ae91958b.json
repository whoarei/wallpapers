{
  "id": "poem-80c92bda5d677c04ae91958b",
  "title": "秋蛩",
  "author": "雍裕之",
  "dynasty": "唐",
  "verses": [
    "雨绝苍苔地，月斜青草阶。",
    "蛩鸣谁不怨，况是正离怀。"
  ],
  "enabled": true,
