{
  "id": "poem-920577abc0adffc3a19c7c5a",
  "title": "宫词五首 二",
  "author": "顾况",
  "dynasty": "唐",
  "verses": [
    "玉楼天半起笙歌，风送宫嫔笑语和。",
    "月殿影开闻夜漏，水精帘卷近银河。"
  ],
  "enabled": true,
