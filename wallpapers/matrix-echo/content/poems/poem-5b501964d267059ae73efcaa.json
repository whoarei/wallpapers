{
  "id": "poem-5b501964d267059ae73efcaa",
  "title": "郊庙歌辞 禅社首乐章 太和",
  "author": "贺知章、源乾曜",
  "dynasty": "唐",
  "verses": [
    "昭昭有唐，天俾万国。",
    "列祖应命，四宗顺则。",
    "申锡无疆，宗我同德。",
    "曾孙继序，享神配极。"
  ],
  "enabled": true,
