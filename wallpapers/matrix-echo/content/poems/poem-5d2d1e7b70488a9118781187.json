{
  "id": "poem-5d2d1e7b70488a9118781187",
  "title": "天边行",
  "author": "杜甫",
  "dynasty": "唐",
  "verses": [
    "天边老人归未得，日暮东临大江哭。",
    "陇右河源不种田，胡骑羌兵入巴蜀。",
    "洪涛滔天风拔木，前飞秃鹙后鸿鹄。",
    "九度附书向洛阳，十年骨肉无消息。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
  "tags": [
    "思乡",
    "漂泊"
  ],
