{
  "id": "poem-da1b18fd6ed56d417355bf7c",
  "title": "归舟三绝  其二",
  "author": "王柏",
  "dynasty": "宋",
  "verses": [
    "波声拍枕不成眠，拥被推篷月尚圆。",
    "霜下夜深人正悄，数声飞雁度林颠。"
  ],
  "enabled": true,
