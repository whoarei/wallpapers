{
  "id": "poem-4ac7f00a92a608dba9d2fe7b",
  "title": "慈恩寺东楼",
  "author": "曹松",
  "dynasty": "唐",
  "verses": [
    "寺楼凉出竹，非与曲江赊。",
    "野火流穿苑，秦山叠入巴。",
    "风梢离众叶，岸角积虚沙。",
    "此地钟声近，令人思未涯。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
