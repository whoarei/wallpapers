{
  "id": "poem-4164532be59e6d5b878cbaef",
  "title": "赠张云容舞",
  "author": "杨贵妃",
  "dynasty": "唐",
  "verses": [
    "罗袖动香香不已，红蕖褭褭秋烟里。",
    "轻云岭上乍摇风，嫩柳池边初拂水。"
  ],
  "enabled": true,
