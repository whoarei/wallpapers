{
  "id": "poem-02467c7057fbf31c42f5c1f3",
  "title": "别山居",
  "author": "刘得仁",
  "dynasty": "唐",
  "verses": [
    "万壑千岩景象开，登临未足又须回。",
    "凭师莫断松间路，秋月圆时弟子来。"
  ],
  "enabled": true,
