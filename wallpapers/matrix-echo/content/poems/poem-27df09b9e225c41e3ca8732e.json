{
  "id": "poem-27df09b9e225c41e3ca8732e",
  "title": "送穆寂赴举",
  "author": "皎然",
  "dynasty": "唐",
  "verses": [
    "天子锡玄𫄸，倾山礼隐沦。",
    "君抛青霞去，荣资观国宾。",
    "劒光既陆离，琼彩何璘玢。",
    "夙驾别情远，商弦秋意新。",
    "冥冥鸿鹄姿，数尺看苍旻。",
    "残寇近宋郊，西行恶飙尘。",
    "立身素耿介，处难思经纶。",
    "春府搜才日，高科得一人。"
  ],
  "enabled": true,
