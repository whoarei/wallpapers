{
  "id": "poem-e25da707a17f25d35d7547a4",
  "title": "乐城白鹤寺",
  "author": "沈佺期",
  "dynasty": "唐",
  "verses": [
    "碧海开龙藏，青云起雁堂。",
    "潮声迎法鼓，雨气湿天香。",
    "树接前山暗，溪承瀑水凉。",
    "无言谪居远，清净得空王。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
