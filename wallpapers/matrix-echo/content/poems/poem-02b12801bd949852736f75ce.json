{
  "id": "poem-02b12801bd949852736f75ce",
  "title": "登慈恩寺塔",
  "author": "张乔",
  "dynasty": "唐",
  "verses": [
    "窗户几层风，清凉碧落中。",
    "世人来往别，烟景古今同。",
    "列岫横秦断，长河极塞空。",
    "斜阳越乡思，天末见归鸿。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
