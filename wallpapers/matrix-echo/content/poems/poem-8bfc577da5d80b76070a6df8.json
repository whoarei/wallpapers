{
  "id": "poem-8bfc577da5d80b76070a6df8",
  "title": "燕归梁·风摆红藤卷绣帘",
  "author": "欧阳修",
  "dynasty": "宋",
  "verses": [
    "风摆红藤卷绣帘。",
    "宝鉴慵拈。",
    "日高梳洗几时忺。",
    "金盆水、弄纤纤。",
    "髻云谩亸残花淡，和娇媚、瘦岩岩。",
    "离情更被宿酲兼。",
    "空惹得、病厌厌。"
  ],
  "enabled": true,
  "collection": "宋词选",
