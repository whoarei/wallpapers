{
  "id": "poem-c9af65e58f1deb9c132c9995",
  "title": "题清远峡观音院二首 一",
  "author": "卢肇",
  "dynasty": "唐",
  "verses": [
    "清潭洞澈深千丈，危岫攀萝上几层。",
    "秋尽更无黄叶树，夜阑唯对白头僧。"
  ],
  "enabled": true,
