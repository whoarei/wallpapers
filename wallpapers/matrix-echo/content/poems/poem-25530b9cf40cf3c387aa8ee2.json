{
  "id": "poem-25530b9cf40cf3c387aa8ee2",
  "title": "减字木兰花·斜红翠叠",
  "author": "向子𬤇",
  "dynasty": "宋",
  "verses": [
    "斜红翠叠。",
    "何许花神来献瑞。",
    "粲粲裳衣。",
    "割得天孙锦一机。",
    "真香妙质。",
    "不耐世间风与日。",
    "着意遮围。",
    "莫放春光造次归。"
  ],
  "enabled": true,
  "collection": "宋词选",
