{
  "id": "poem-fec51c139d541fbc81aff867",
  "title": "卓笔峰",
  "author": "王十朋",
  "dynasty": "宋",
  "verses": [
    "束缚真凭造化功，巍巍直气贯鸿蒙。",
    "雨将苔色生彤管，山吐虹光遶兔锋。",
    "未数如椽曾入梦，误疑怪事尚书空。",
    "士人毛颖多荣辱，恩宠才衰便不同。"
  ],
  "enabled": true,
  "collection": "宋诗选",
