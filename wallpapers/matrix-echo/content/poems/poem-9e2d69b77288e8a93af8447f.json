{
  "id": "poem-9e2d69b77288e8a93af8447f",
  "title": "客中初夏",
  "author": "司马光",
  "dynasty": "宋",
  "verses": [
    "四月清和雨乍晴，南山当户转分明。",
    "更无柳絮因风起，惟有葵花向日倾。"
  ],
  "enabled": true,
  "collection": "千家诗",
