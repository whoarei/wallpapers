{
  "id": "poem-85e1045c005a31d6344ccd32",
  "title": "次韵徐秀才十首  其三",
  "author": "陈造",
  "dynasty": "宋",
  "verses": [
    "向来孟浩然，醉眼高宇宙。",
    "清诗落京师，苏李欲束咮。",
    "蔗陇槎头鳊，未觉黄金富。",
    "纤钩饵虾蝇，但取浮阳嗅。"
  ],
  "enabled": true,
  "collection": "宋诗选",
