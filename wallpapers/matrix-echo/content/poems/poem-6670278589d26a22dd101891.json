{
  "id": "poem-6670278589d26a22dd101891",
  "title": "送咸安公主",
  "author": "孙叔向",
  "dynasty": "唐",
  "verses": [
    "卤簿迟迟出国门，汉家公主嫁乌孙。",
    "玉颜便向穹庐去，卫霍空承明主恩。"
  ],
  "enabled": true,
