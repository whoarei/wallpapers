{
  "id": "poem-641c836da70f891993ec8d6f",
  "title": "游子吟",
  "author": "孟郊",
  "dynasty": "唐",
  "verses": [
    "慈母手中线，游子身上衣。",
    "临行密密缝，意恐迟迟归。",
    "谁言寸草心，报得三春晖。"
  ],
  "enabled": true,
