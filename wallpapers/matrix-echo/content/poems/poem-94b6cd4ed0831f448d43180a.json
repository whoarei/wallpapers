{
  "id": "poem-94b6cd4ed0831f448d43180a",
  "title": "寄华阴姚少府",
  "author": "喻坦之",
  "dynasty": "唐",
  "verses": [
    "泰华当公署，为官兴可知。",
    "砚和青霭冻，帘对白云垂。",
    "峻掌光浮日，危莲影入池。",
    "料于三考内，应惜德音移。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
