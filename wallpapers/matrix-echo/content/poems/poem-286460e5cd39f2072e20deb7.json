{
  "id": "poem-286460e5cd39f2072e20deb7",
  "title": "谒金门·溪声咽",
  "author": "蔡伸",
  "dynasty": "宋",
  "verses": [
    "溪声咽。",
    "溪上有人离别。",
    "别语叮咛和泪说。",
    "罗巾沾泪血。",
    "尽做刚肠如铁。",
    "到此也应愁绝。",
    "回首断山帆影灭。",
    "画船空载月。"
  ],
  "enabled": true,
  "collection": "宋词选",
