{
  "id": "poem-620337d071fb7b94f505aff7",
  "title": "壁间韵  其三",
  "author": "赵崇鉘",
  "dynasty": "宋",
  "verses": [
    "海棠开尽故清寒，漠漠梨花暮色闲。",
    "酒满绿樽愁满酒，醉凭枕障认巫山。"
  ],
  "enabled": true,
  "collection": "宋诗选",
