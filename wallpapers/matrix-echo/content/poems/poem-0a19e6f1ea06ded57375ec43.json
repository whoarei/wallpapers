{
  "id": "poem-0a19e6f1ea06ded57375ec43",
  "title": "过高台获信老诗集",
  "author": "张栻",
  "dynasty": "宋",
  "verses": [
    "萧然僧榻碧云端，细读君诗夜未阑。",
    "门外苍松霜雪里，比君佳处让高寒。"
  ],
  "enabled": true,
