{
  "id": "poem-3534b59165e5fbae490f2676",
  "title": "密云",
  "author": "纳兰性德",
  "dynasty": "清",
  "verses": [
    "白檀山下水声秋，地踞潮河最上流。",
    "日暮行人寻堠馆，凉砧一片古檀州。"
  ],
  "enabled": true,
