{
  "id": "poem-ab1a21be20d16168f0be363c",
  "title": "上洛桥",
  "author": "李益",
  "dynasty": "唐",
  "verses": [
    "金谷园中柳，春来似舞腰。",
    "何堪好风景，独上洛阳桥。"
  ],
  "enabled": true,
