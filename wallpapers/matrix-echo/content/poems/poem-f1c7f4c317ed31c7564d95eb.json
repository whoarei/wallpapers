{
  "id": "poem-f1c7f4c317ed31c7564d95eb",
  "title": "宿建德江",
  "author": "孟浩然",
  "dynasty": "唐",
  "verses": [
    "移舟泊烟渚，日暮客愁新。",
    "野旷天低树，江清月近人。"
  ],
  "enabled": true,
