{
  "id": "poem-f6a0bbbc07bad5cb7681886c",
  "title": "赠侯山人",
  "author": "熊孺登",
  "dynasty": "唐",
  "verses": [
    "一见清容惬素闻，有人传是紫阳君。",
    "来时玉女裁春服，翦破湘山几片云。"
  ],
  "enabled": true,
