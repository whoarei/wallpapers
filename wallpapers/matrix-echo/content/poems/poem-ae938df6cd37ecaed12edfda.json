{
  "id": "poem-ae938df6cd37ecaed12edfda",
  "title": "寄栖一上人",
  "author": "贯休",
  "dynasty": "唐",
  "verses": [
    "花堑接沧洲，阴云闲楚丘。",
    "雨声虽到夜，吟味不如秋。",
    "古屋藏花鸽，荒园聚乱流。",
    "无机心便是，何用话归休。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
