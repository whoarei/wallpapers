{
  "id": "poem-e31fbba44c51c7c897b5329c",
  "title": "和段成式 一",
  "author": "周繇",
  "dynasty": "唐",
  "verses": [
    "回簪转黛喜猜防，粉署裁诗助酒狂。",
    "若遇仙丹偕羽化，便随萧史亦何伤。"
  ],
  "enabled": true,
