{
  "id": "poem-fcb378969002d5997434a4b8",
  "title": "咏史诗 李陵台",
  "author": "胡曾",
  "dynasty": "唐",
  "verses": [
    "北入单于万里疆，五千兵败滞穷荒。",
    "英雄不伏蛮夷死，更筑高台望故乡。"
  ],
  "enabled": true,
