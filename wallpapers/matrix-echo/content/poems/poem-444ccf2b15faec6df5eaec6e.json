{
  "id": "poem-444ccf2b15faec6df5eaec6e",
  "title": "赠晦公禅人",
  "author": "贯休",
  "dynasty": "唐",
  "verses": [
    "流阳为役者，相访叶纷纷。",
    "有句虽如我，无心未似君。",
    "搆林青及竹，茆屋暖于云。",
    "何日相将去，千山麋鹿群。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
