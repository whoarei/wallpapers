{
  "id": "poem-ae620cc2c8b29edb23e8a57b",
  "title": "春秋战国门 公叔",
  "author": "周昙",
  "dynasty": "唐",
  "verses": [
    "吴起南奔魏国荒，必听公叔失贤良。",
    "无谋纵欲离安邑，可免河沟徙大梁。"
  ],
  "enabled": true,
