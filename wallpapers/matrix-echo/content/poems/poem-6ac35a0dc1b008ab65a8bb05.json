{
  "id": "poem-6ac35a0dc1b008ab65a8bb05",
  "title": "春日书怀",
  "author": "赵嘏",
  "dynasty": "唐",
  "verses": [
    "暖莺春日舌难穷，枕上愁生晓听中。",
    "应褭绿窗残梦断，杏园零落满枝风。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
