{
  "id": "poem-ab109bef3427b987678c8dbc",
  "title": "诉衷情·东风杨柳欲青青",
  "author": "晏殊",
  "dynasty": "宋",
  "verses": [
    "东风杨柳欲青青。",
    "烟淡雨初晴。",
    "恼他香阁浓睡，撩乱有啼莺。",
    "眉叶细，舞腰轻。",
    "宿妆成。",
    "一春芳意，三月和风，牵系人情。"
  ],
  "enabled": true,
  "collection": "宋词选",
