{
  "id": "poem-5a5bc7bce362675b2b21700c",
  "title": "颂古七十六首  其三",
  "author": "释士珪",
  "dynasty": "宋",
  "verses": [
    "月里姮娥不画眉，只将云雾作罗衣。",
    "不知梦逐青鸾去，犹把花枝盖面归。"
  ],
  "enabled": true,
