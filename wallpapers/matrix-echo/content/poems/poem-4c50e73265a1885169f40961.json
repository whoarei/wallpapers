{
  "id": "poem-4c50e73265a1885169f40961",
  "title": "所居即事六首（原注：丹阳闲居寄郑明府如范上人。） 其四（原注：春日寓言。）",
  "author": "张祜",
  "dynasty": "唐",
  "verses": [
    "寂寞春风意未降，酒狂诗癖旧无双。",
    "柳花飞处曾逢雪，桃叶开提忆渡江。",
    "自古不堪居陋巷，从今休更犯危邦。",
    "圣朝何用询名姓，从放书生老北窗。"
  ],
  "enabled": true,
