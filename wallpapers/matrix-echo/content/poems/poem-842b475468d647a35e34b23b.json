{
  "id": "poem-842b475468d647a35e34b23b",
  "title": "边上作三首 一",
  "author": "贯休",
  "dynasty": "唐",
  "verses": [
    "山无绿兮水无清，风既毒兮沙亦腥。",
    "胡儿走马疾飞鸟，联翩射落云中声。"
  ],
  "enabled": true,
