{
  "id": "poem-4b31cf9174af7b0a522576ad",
  "title": "禅社首乐章",
  "author": "源乾曜",
  "dynasty": "唐",
  "verses": [
    "灵具醉，杳熙熙。",
    "灵将往，眇禗禗。",
    "愿明德，吐正词。",
    "烂遗光，流祯祺。"
  ],
  "enabled": true,
