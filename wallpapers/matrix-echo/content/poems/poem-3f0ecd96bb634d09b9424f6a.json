{
  "id": "poem-3f0ecd96bb634d09b9424f6a",
  "title": "咏院中藂竹",
  "author": "吕太一",
  "dynasty": "唐",
  "verses": [
    "擢擢当轩竹，青青重岁寒。",
    "心贞徒见赏，箨小未成竿。"
  ],
  "enabled": true,
