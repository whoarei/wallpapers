{
  "id": "poem-796b2935a7ac2fd000e53220",
  "title": "定西番·苍翠浓阴满院",
  "author": "毛熙震",
  "dynasty": "五代",
  "verses": [
    "苍翠浓阴满院，莺对语，蝶交飞，戏蔷薇。",
    "斜日倚栏风好，余香出绣衣。",
    "未得玉郎消息，几时归。"
  ],
  "enabled": true,
