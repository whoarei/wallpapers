{
  "id": "poem-f506fc8850c9eeafba43df5a",
  "title": "巫山高",
  "author": "沈佺期",
  "dynasty": "唐",
  "verses": [
    "巫山高不极，合沓状奇新。",
    "暗谷疑风雨，阴崖若鬼神。",
    "月明三峡曙，潮满九江春。",
    "为问阳台客，应知入梦人。"
  ],
  "enabled": true,
