{
  "id": "poem-5489bf8a7430d9e1ba100f63",
  "title": "仙人塘",
  "author": "陈岩",
  "dynasty": "宋",
  "verses": [
    "陂塘一曲水泓澄，山簇瑶台十二层。",
    "剩脉余膏流不尽，芝田蕙圃岁常登。"
  ],
  "enabled": true,
  "collection": "宋诗选",
