{
  "id": "poem-85cd0d02106d6b02ba285caf",
  "title": "咏史诗 汉江",
  "author": "胡曾",
  "dynasty": "唐",
  "verses": [
    "汉江一带碧流长，两岸春风起绿杨。",
    "借问胶船何处没，欲停兰棹祀昭王。"
  ],
  "enabled": true,
