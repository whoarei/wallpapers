{
  "id": "poem-caeb86ca64a3d2e4f95ccb5d",
  "title": "颂古十九首  其七",
  "author": "释法全",
  "dynasty": "宋",
  "verses": [
    "日暖风和莺啭新，柳垂金线系东君。",
    "东君不惜无私力，一点花红一点春。"
  ],
  "enabled": true,
