{
  "id": "poem-cafebc91135dad8ebd86cd33",
  "title": "春晴",
  "author": "王驾",
  "dynasty": "宋",
  "verses": [
    "雨前初见花间蕊，雨后全无叶底花。",
    "蜂蝶纷纷过墙去，却疑春色在邻家。"
  ],
  "enabled": true,
  "collection": "千家诗",
