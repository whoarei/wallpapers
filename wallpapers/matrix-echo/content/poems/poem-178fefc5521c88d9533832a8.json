{
  "id": "poem-178fefc5521c88d9533832a8",
  "title": "登骊山高顶寓目",
  "author": "中宗皇帝",
  "dynasty": "唐",
  "verses": [
    "四郊秦汉国，八水帝王都。",
    "阊阖雄里闬，城阙壮规模。",
    "贯渭称天邑，含岐实奥区。",
    "金门披玉馆，因此识皇图。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
