{
  "id": "poem-c71e383ed841fcec9f02df60",
  "title": "邠宁春日",
  "author": "李益",
  "dynasty": "唐",
  "verses": [
    "桃李年年上国新，风沙日日塞垣人。",
    "伤心更见庭前柳，忽有千条欲占春。"
  ],
  "enabled": true,
