{
  "id": "poem-1a2321cf378de3735b97bf09",
  "title": "对月二首 一",
  "author": "张乔",
  "dynasty": "唐",
  "verses": [
    "圆魄上寒空，皆言四海同。",
    "安知千里外，不有雨兼风。"
  ],
  "enabled": true,
