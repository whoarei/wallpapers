{
  "id": "poem-d2c1ace2e3f52ca23768e1e8",
  "title": "答鄜畤友人同宿见示",
  "author": "马戴",
  "dynasty": "唐",
  "verses": [
    "为客自堪悲，风尘日满衣。",
    "承明无计入，旧隐但怀归。",
    "雪积孤城暗，灯残晓角微。",
    "相逢喜同宿，此地故人稀。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
