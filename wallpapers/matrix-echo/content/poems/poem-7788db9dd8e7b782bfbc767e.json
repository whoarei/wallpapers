{
  "id": "poem-7788db9dd8e7b782bfbc767e",
  "title": "琼花",
  "author": "宋伯仁",
  "dynasty": "宋",
  "verses": [
    "莫讶重栽聚八仙，几经边警亦堪怜。",
    "珠帘十里春狼籍，且把天香作旧年。"
  ],
  "enabled": true,
