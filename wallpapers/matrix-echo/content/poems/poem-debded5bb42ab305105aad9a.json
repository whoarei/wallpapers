{
  "id": "poem-debded5bb42ab305105aad9a",
  "title": "寻天目徐君",
  "author": "皎然",
  "dynasty": "唐",
  "verses": [
    "常见仙翁变姓名，岂知松子号初平。",
    "逢人不道往来处，卖药还将鸡犬行。",
    "独鹤天边俱得性，浮云世上共无情。",
    "三花落地君犹在，笑抚安期昨日生。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
