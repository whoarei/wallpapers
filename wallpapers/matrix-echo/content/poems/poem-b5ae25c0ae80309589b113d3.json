{
  "id": "poem-b5ae25c0ae80309589b113d3",
  "title": "赠窦十九",
  "author": "崔峒",
  "dynasty": "唐",
  "verses": [
    "灵台暮宿意多违，木落花开羡客归。",
    "江海几时传锦字，风尘不觉化缁衣。",
    "山阳会里同人少，灞曲农时故老稀。",
    "幸得汉皇容直谏，怜君未遇觉人非。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
