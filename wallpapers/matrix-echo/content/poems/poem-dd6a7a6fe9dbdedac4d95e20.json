{
  "id": "poem-dd6a7a6fe9dbdedac4d95e20",
  "title": "怀方干张为",
  "author": "贯休",
  "dynasty": "唐",
  "verses": [
    "冥搜入仙窟，半夜水堂前。",
    "吾道祗如此，古人多亦然。",
    "萤沈荒坞雾，月苦绿梧蝉。"
  ],
  "enabled": true,
