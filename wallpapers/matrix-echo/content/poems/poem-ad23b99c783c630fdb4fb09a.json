{
  "id": "poem-ad23b99c783c630fdb4fb09a",
  "title": "秦州杂诗",
  "author": "杜甫",
  "dynasty": "唐",
  "verses": [
    "凤林戈未息，鱼海路常难。",
    "候火云峰峻，悬军幕井干。",
    "风连西极动，月过北庭寒。",
    "故老思飞将，何时议筑坛。"
  ],
  "enabled": true,
  "collection": "千家诗",
  "tags": [],
