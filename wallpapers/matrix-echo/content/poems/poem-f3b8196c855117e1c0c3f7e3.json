{
  "id": "poem-f3b8196c855117e1c0c3f7e3",
  "title": "别洞庭维谅上人",
  "author": "皎然",
  "dynasty": "唐",
  "verses": [
    "白云关我不关他，此物留君情最多。",
    "情著春风生橘树，归心不怕洞庭波。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
