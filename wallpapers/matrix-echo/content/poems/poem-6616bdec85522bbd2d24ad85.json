{
  "id": "poem-6616bdec85522bbd2d24ad85",
  "title": "宿扬州水馆",
  "author": "李绅",
  "dynasty": "唐",
  "verses": [
    "舟依浅岸参差合，桥映晴虹上下连。",
    "轻檝过时摇水月，远灯繁处隔秋烟。",
    "却思海峤还凄叹，近涉江涛更凛然。",
    "闲凭栏干指星汉，尚疑轩盖在楼船。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
