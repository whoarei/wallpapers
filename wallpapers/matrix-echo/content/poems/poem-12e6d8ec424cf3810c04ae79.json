{
  "id": "poem-12e6d8ec424cf3810c04ae79",
  "title": "近闻",
  "author": "杜甫",
  "dynasty": "唐",
  "verses": [
    "近闻犬戎远遁逃，牧马不敢侵临洮。",
    "渭水逶迤白日净，陇山萧瑟秋云高。",
    "崆峒五原亦无事，北庭数有关中使。",
    "似闻赞普更求亲，舅甥和好应难弃。"
  ],
  "enabled": true,
