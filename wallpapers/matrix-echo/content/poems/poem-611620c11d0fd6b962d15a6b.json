{
  "id": "poem-611620c11d0fd6b962d15a6b",
  "title": "喜秋风",
  "author": "杨景贤",
  "dynasty": "元",
  "verses": [
    "珠泪垂，柔肠结，两眉攒，寸心裂。",
    "好儿女似花开谢，早相离半月。"
  ],
  "enabled": true,
  "collection": "元曲选",
