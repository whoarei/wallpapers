{
  "id": "poem-eb0133cc9078d0a2a7bc6bbf",
  "title": "河广",
  "author": "佚名",
  "dynasty": "先秦",
  "verses": [
    "谁谓河广？一苇杭之。谁谓宋远？跂予望之。",
    "谁谓河广？曾不容刀。谁谓宋远？曾不崇朝。"
  ],
  "enabled": true,
  "collection": "诗经",
