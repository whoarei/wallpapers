{
  "id": "poem-ae724ec22cc310b4e0000e55",
  "title": "留题凝翠阁二绝  其二",
  "author": "李纲",
  "dynasty": "宋",
  "verses": [
    "山秀波平望不穷，此身浑堕翠光中。",
    "兵戈满眼栖何地，注目溪头群玉峰。"
  ],
  "enabled": true,
