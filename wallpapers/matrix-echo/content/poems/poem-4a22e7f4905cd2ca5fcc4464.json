{
  "id": "poem-4a22e7f4905cd2ca5fcc4464",
  "title": "台城",
  "author": "韦庄",
  "dynasty": "唐",
  "verses": [
    "江雨霏霏江草齐，六朝如梦鸟空啼。",
    "无情最是台城柳，依旧烟笼十里堤。"
  ],
  "enabled": true,
