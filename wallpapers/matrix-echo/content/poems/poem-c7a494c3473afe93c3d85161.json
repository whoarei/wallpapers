{
  "id": "poem-c7a494c3473afe93c3d85161",
  "title": "五次韵",
  "author": "王十朋",
  "dynasty": "宋",
  "verses": [
    "涪陵妃子谩名园，岂似闽南绿一盘。",
    "最喜色同青玉案，不妨功并紫金丹。",
    "画看红紫品流俗，诗嚼氷霜牙颊寒。",
    "吟罢闲观右军帖，来禽青李可同餐。"
  ],
  "enabled": true,
