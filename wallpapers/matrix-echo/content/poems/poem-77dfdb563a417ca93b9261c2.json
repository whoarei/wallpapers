{
  "id": "poem-77dfdb563a417ca93b9261c2",
  "title": "赠项斯",
  "author": "张籍",
  "dynasty": "唐",
  "verses": [
    "端坐吟诗忘忍饥，万人中觅似君稀。",
    "门连野水风长到，驴放秋原夜不归。",
    "日煖剩收新落叶，天寒更著旧生衣。",
    "曲江亭上频频见，为爱鸬鹚雨里飞。"
  ],
  "enabled": true,
