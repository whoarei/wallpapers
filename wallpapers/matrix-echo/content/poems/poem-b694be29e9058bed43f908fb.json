{
  "id": "poem-b694be29e9058bed43f908fb",
  "title": "女冠子·绿云高髻",
  "author": "牛峤",
  "dynasty": "五代",
  "verses": [
    "绿云高髻，点翠匀红时世。月如眉。",
    "浅笑含双靥，低声唱小词。",
    "眼看唯恐化，魂荡欲相随。",
    "玉趾回娇步，约佳期。"
  ],
  "enabled": true,
  "collection": "花间集",
