{
  "id": "poem-591f29b4fb3b15ab66120d32",
  "title": "画猿",
  "author": "孙嵩",
  "dynasty": "宋",
  "verses": [
    "客子平生三峡游，青猿树树悬高秋。",
    "归来落笔成天趣，中传蜀月巴云意。",
    "如何猿叫驿边时，只欠行人唱竹枝。"
  ],
  "enabled": true,
  "collection": "宋诗选",
