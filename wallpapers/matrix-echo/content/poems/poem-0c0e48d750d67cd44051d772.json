{
  "id": "poem-0c0e48d750d67cd44051d772",
  "title": "送僧归南康",
  "author": "贯休",
  "dynasty": "唐",
  "verses": [
    "壳壳学得律，还乡见苦情。",
    "远思芳草盛，不入楚山行。",
    "帆入汀烟健，经吟戍月清。",
    "到乡同学辈，应到赣江迎。"
  ],
  "enabled": true,
