{
  "id": "poem-f2f790a102ca0a6b778ce1ca",
  "title": "咏史诗 细腰宫",
  "author": "胡曾",
  "dynasty": "唐",
  "verses": [
    "楚王辛苦战无功，国破城荒霸业空。",
    "唯有青春花上露，至今犹泣细腰宫。"
  ],
  "enabled": true,
