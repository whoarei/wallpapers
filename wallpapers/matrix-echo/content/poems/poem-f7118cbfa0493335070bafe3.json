{
  "id": "poem-f7118cbfa0493335070bafe3",
  "title": "过故人庄",
  "author": "孟浩然",
  "dynasty": "唐",
  "verses": [
    "故人具鸡黍，邀我至田家。",
    "绿树村边合，青山郭外斜。",
    "开筵面场圃，把酒话桑麻。",
    "待到重阳日，还来就菊花。"
  ],
  "enabled": true,
