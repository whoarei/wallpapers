{
  "id": "poem-f1f8e6054c078a6cc83a48a6",
  "title": "破山璎珞桧",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "雪枝新纵纵，霜子旧玲玲。",
    "漙露烦添缀，萦风缓剪零。",
    "贯珠烦蚁度，编贝倩谁经。",
    "瑶草随山尽，来寻千岁苓。"
  ],
  "enabled": true,
  "collection": "宋诗选",
