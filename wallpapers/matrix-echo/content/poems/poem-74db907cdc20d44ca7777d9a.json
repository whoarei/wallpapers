{
  "id": "poem-74db907cdc20d44ca7777d9a",
  "title": "忆王孙·凉生冰簟怯衣单",
  "author": "蔡伸",
  "dynasty": "宋",
  "verses": [
    "凉生冰簟怯衣单。",
    "明月楼高空画栏。",
    "满院啼螀人未眠。",
    "掩重关。",
    "乌鹊南飞风露寒。"
  ],
  "enabled": true,
  "collection": "宋词选",
