{
  "id": "poem-2fd07f5c5c6e4008f22a501a",
  "title": "诉衷情·冷落绣衾谁与伴",
  "author": "纳兰性德",
  "dynasty": "清",
  "verses": [
    "冷落绣衾谁与伴，倚香篝。",
    "春睡起，斜日照梳头。",
    "欲写两眉愁，休休。",
    "远山残翠收，莫登楼。"
  ],
  "enabled": true,
  "collection": "纳兰词",
  "tags": [],
