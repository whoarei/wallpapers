{
  "id": "poem-f48934ec90efa4d022851a06",
  "title": "燕雁",
  "author": "汪宗臣",
  "dynasty": "宋",
  "verses": [
    "秋来春去雁宾熟，秋去春来燕子忙。",
    "寒暑自分人事信，不须禽类互炎凉。"
  ],
  "enabled": true,
