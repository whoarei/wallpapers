{
  "id": "poem-ebd4193d02f540b1bcad5d05",
  "title": "挽严四府君",
  "author": "华镇",
  "dynasty": "宋",
  "verses": [
    "岁事时无失，先畴手自耘。",
    "克家亲有养，投老意弥勤。",
    "方羡高年庆，旋惊白日曛。",
    "可怜坟上土，仍占垅头云。"
  ],
  "enabled": true,
  "collection": "宋诗选",
