{
  "id": "poem-8d8c6c908773e0916855f5b8",
  "title": "诉衷情·香灭帘垂春漏永",
  "author": "顾敻",
  "dynasty": "五代",
  "verses": [
    "香灭帘垂春漏永，整鸳衾。",
    "罗带重，双凤，缕黄金。",
    "窗外月光临，沉沉。",
    "断肠无处寻，负春心。"
  ],
  "enabled": true,
  "collection": "花间集",
