{
  "id": "poem-e11491626032ade853703667",
  "title": "读杜工部集二首 一",
  "author": "贯休",
  "dynasty": "唐",
  "verses": [
    "造化拾无遗，唯应杜甫诗。",
    "岂非玄域橐，夺得古人旗。",
    "日月精华薄，山川气概卑。",
    "古今吟不尽，惆怅不同时。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
