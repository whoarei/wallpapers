{
  "id": "poem-4eced3fae0a4165b051bdccb",
  "title": "菩萨蛮·铜簧韵脆锵寒竹",
  "author": "李煜",
  "dynasty": "五代",
  "verses": [
    "铜簧韵脆锵寒竹，新声慢奏移纤玉。",
    "眼色暗相钩，秋波横欲流。",
    "雨云深绣户，未便谐衷素。",
    "宴罢又成空，魂迷春梦中。"
  ],
  "enabled": true,
  "collection": "南唐二主词",
