{
  "id": "poem-cececf4f85db4f578f3af647",
  "title": "箬溪楼制锦堂长兴长官赵可斋新制  其二",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "古制宜藏巧，吾宁十目窥。",
    "弗将青镜掩，谁兆白鸥疑。",
    "雁鹜方群散，罝罦各自施。",
    "悠然机杼别，无媿召南思。"
  ],
  "enabled": true,
  "collection": "宋诗选",
