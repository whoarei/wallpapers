{
  "id": "poem-bb7e2119a70fed985648e9cc",
  "title": "入邑阻风  其一",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "鬭风鹢退不忺飞，还似当年过宋时。",
    "又似雪舟人兴尽，归时却是顺风吹。"
  ],
