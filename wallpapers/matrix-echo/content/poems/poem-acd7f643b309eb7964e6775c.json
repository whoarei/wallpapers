{
  "id": "poem-acd7f643b309eb7964e6775c",
  "title": "题李员外厅",
  "author": "李山甫",
  "dynasty": "唐",
  "verses": [
    "石砌蛩吟响，草堂人语稀。",
    "道孤思绝唱，年长渐知非。",
    "名利终成患，烟霞亦可依。",
    "高丘松盖古，闲地药苗肥。",
    "猨鸟啼嘉景，牛羊傍晚晖。",
    "幽栖还自得，清啸坐忘机。",
    "爱彼人深处，白云相伴归。"
  ],
  "enabled": true,
