{
  "id": "poem-746eeba1dea08b23b35a6a45",
  "title": "数日",
  "author": "赵崇鉘",
  "dynasty": "宋",
  "verses": [
    "数日东风欺病骨，侵凌晓色作轻寒。",
    "客来坐久无谈柄，共看游丝上井栏。"
  ],
  "enabled": true,
  "collection": "宋诗选",
