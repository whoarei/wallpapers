{
  "id": "poem-90b126b4bce072e836ece375",
  "title": "江上书怀",
  "author": "崔峒",
  "dynasty": "唐",
  "verses": [
    "骨肉天涯别，江山日落时。",
    "泪流襟上血，发变镜中丝。",
    "胡越书难到，存亡梦岂知。",
    "登高回首罢，形影自相随。"
  ],
  "enabled": true,
