{
  "id": "poem-bcac90583ac65b491b420c70",
  "title": "广惠寺",
  "author": "蔡清臣",
  "dynasty": "宋",
  "verses": [
    "云中老树冷萧萧，溪上僧归倚画桡。",
    "谁为秋风乘兴去，松窗先听富阳潮。"
  ],
  "enabled": true,
