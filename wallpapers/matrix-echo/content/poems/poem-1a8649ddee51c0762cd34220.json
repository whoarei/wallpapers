{
  "id": "poem-1a8649ddee51c0762cd34220",
  "title": "送乐平苗明府",
  "author": "卢纶",
  "dynasty": "唐",
  "verses": [
    "累职比柴桑，清秋入楚乡。",
    "一船灯照浪，两岸树凝霜。",
    "亭吏趋寒雾，山城敛曙光。",
    "无辞折腰久，仲德在鸳行。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
