{
  "id": "poem-6f910df0bea0765c326900a0",
  "title": "非所寄王都护姨夫",
  "author": "佚名",
  "dynasty": "唐",
  "verses": [
    "敦煌数度访来人，握手千回问懿亲。",
    "蓬转已闻过海畔，莎居见说傍河津。",
    "戎庭事事皆违意，虏口朝朝计苦辛。",
    "缧绁傥逢恩降日，宿心言豁（原作「豁」）在他辰。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
