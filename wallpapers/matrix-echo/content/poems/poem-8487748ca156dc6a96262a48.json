{
  "id": "poem-8487748ca156dc6a96262a48",
  "title": "寄孙冲主簿",
  "author": "张籍",
  "dynasty": "唐",
  "verses": [
    "低折沧州簿，无书整两春。",
    "马从同事借，妻怕罢官贫。",
    "道僻收闲药，诗高笑故人。",
    "仍闻长吏奏，表乞锁厅频。"
  ],
  "enabled": true,
