{
  "id": "poem-7803545d6e2302e4d2bd1343",
  "title": "句  其二",
  "author": "滕元发",
  "dynasty": "宋",
  "verses": [
    "寒日边声断，春风塞草长。",
    "传闻汉都护，归奉万年觞。"
  ],
