{
  "id": "poem-acb7a93401cc164a783085db",
  "title": "经故宅有感",
  "author": "周繇",
  "dynasty": "唐",
  "verses": [
    "身没南荒雨露赊，朱门空锁旧繁华。",
    "池塘凿就方通水，桃杏栽成未见花。",
    "异代图书藏几箧，倾城罗绮散谁家。",
    "昔年埏埴生灵地，今日生人为叹嗟。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
