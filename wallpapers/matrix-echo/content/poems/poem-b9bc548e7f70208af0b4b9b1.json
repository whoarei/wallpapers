{
  "id": "poem-b9bc548e7f70208af0b4b9b1",
  "title": "画堂春·外潮莲子长参差",
  "author": "张先",
  "dynasty": "宋",
  "verses": [
    "外潮莲子长参差。",
    "霁山青处鸥飞。",
    "水天溶漾画桡迟。",
    "人影鉴中移。",
    "桃叶浅声双唱，杏红深色轻衣。",
    "小荷障面避斜晖。",
    "分得翠阴归。"
  ],
  "enabled": true,
  "collection": "宋词选",
