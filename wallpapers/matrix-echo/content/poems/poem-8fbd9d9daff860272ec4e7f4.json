{
  "id": "poem-8fbd9d9daff860272ec4e7f4",
  "title": "寄远",
  "author": "马戴",
  "dynasty": "唐",
  "verses": [
    "坐想亲爱远，行嗟天地阔。",
    "积疹甘毁颜，沈忧更销骨。",
    "迢迢游子心，望望归云没。",
    "乔木非故里，高楼共明月。",
    "夜深秋风多，闻鴈来天末。"
  ],
  "enabled": true,
