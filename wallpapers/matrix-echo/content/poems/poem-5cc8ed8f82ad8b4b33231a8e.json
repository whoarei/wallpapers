{
  "id": "poem-5cc8ed8f82ad8b4b33231a8e",
  "title": "送张道士归山",
  "author": "王维",
  "dynasty": "唐",
  "verses": [
    "先生何处去，王屋访茅君。",
    "别妇留丹诀，驱鸡入白云。",
    "人间若剩住，天上复离群。",
    "当作辽城鹤，仙歌使尔闻。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
