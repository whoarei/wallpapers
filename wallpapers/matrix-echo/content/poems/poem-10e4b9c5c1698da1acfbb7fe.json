{
  "id": "poem-10e4b9c5c1698da1acfbb7fe",
  "title": "上元怀古二首 二",
  "author": "李山甫",
  "dynasty": "唐",
  "verses": [
    "争帝图王德尽衰，骤兴驰霸亦何为。",
    "君臣都是一塲笑，家国共成千载悲。",
    "排岸远樯森似槊，落波残照赫如旗。",
    "今朝城上难回首，不见楼船索战时。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
