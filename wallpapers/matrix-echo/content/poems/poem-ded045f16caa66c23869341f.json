{
  "id": "poem-ded045f16caa66c23869341f",
  "title": "羔裘",
  "author": "佚名",
  "dynasty": "先秦",
  "verses": [
    "羔裘豹祛，自我人居居。岂无他人？维子之故。",
    "羔裘豹褎，自我人究究。岂无他人？维子之好。"
  ],
  "enabled": true,
  "collection": "诗经",
