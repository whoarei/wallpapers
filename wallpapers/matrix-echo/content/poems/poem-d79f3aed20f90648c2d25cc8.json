{
  "id": "poem-d79f3aed20f90648c2d25cc8",
  "title": "同诸公寻李方直不遇",
  "author": "包何",
  "dynasty": "唐",
  "verses": [
    "闻说到扬州，吹箫忆旧游。",
    "人来多不见，莫是上迷楼。"
  ],
  "enabled": true,
