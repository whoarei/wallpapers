{
  "id": "poem-5ce2ebbd33de80678ccd7b72",
  "title": "宿灵泉寺二首  其一",
  "author": "刘跂",
  "dynasty": "宋",
  "verses": [
    "石磴排林端，路转阴岭滑。",
    "侧身长风外，凛落天为阔。",
    "冉冉光风浮，金轮起天末。"
  ],
  "enabled": true,
  "collection": "宋诗选",
