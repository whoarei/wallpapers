{
  "id": "poem-78833fb6db784bc506268f2f",
  "title": "绿水词",
  "author": "李贺",
  "dynasty": "唐",
  "verses": [
    "今宵好风月，阿侯在何处。",
    "为有倾人色，翻成足愁苦。",
    "东湖采莲叶，南湖拔蒲根。",
    "未持寄小姑，且持感愁魂。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
