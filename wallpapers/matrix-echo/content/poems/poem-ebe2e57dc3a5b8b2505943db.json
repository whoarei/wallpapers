{
  "id": "poem-ebe2e57dc3a5b8b2505943db",
  "title": "浣溪沙·凤髻抛残秋草生",
  "author": "纳兰性德",
  "dynasty": "清",
  "verses": [
    "凤髻抛残秋草生。",
    "高梧湿月冷无声。",
    "当时七夕记深盟。",
    "信得羽衣传钿合，悔教罗袜葬倾城。",
    "人间空唱雨淋铃。"
  ],
  "enabled": true,
  "collection": "纳兰词",
