{
  "id": "poem-c447b11e9da70c9c881d4e56",
  "title": "孤雁",
  "author": "王镃",
  "dynasty": "宋",
  "verses": [
    "叫入青云忆弟兄，影随双翮见分明。",
    "黄昏独过秋江上，自拣芦花歇又惊。"
  ],
  "enabled": true,
