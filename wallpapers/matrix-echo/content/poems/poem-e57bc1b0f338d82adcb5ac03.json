{
  "id": "poem-e57bc1b0f338d82adcb5ac03",
  "title": "偈颂 八",
  "author": "文偃",
  "dynasty": "唐",
  "verses": [
    "万像森罗极细微，素话当人却道非。",
    "相逢相见呵呵笑，顾伫停机复是谁。"
  ],
