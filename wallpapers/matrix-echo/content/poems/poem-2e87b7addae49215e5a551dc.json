{
  "id": "poem-2e87b7addae49215e5a551dc",
  "title": "偶登苏州重玄阁",
  "author": "张祜",
  "dynasty": "唐",
  "verses": [
    "飞阁层层茂苑间，夏凉秋晚屙登攀。",
    "万家前后皆临水，四槛高低尽见山。",
    "何事越王侵敌国，不妨辽鹤唁人寰。",
    "五湖直下须归去，自笑身闲迹未闲。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
