{
  "id": "poem-98903be794466ce63ff6d645",
  "title": "赠笔工",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "散捉紫毫新脱颖，玄泓渴饮淬锋寒。",
    "将军翰墨场中老，避槊方知夺槊难。"
  ],
  "enabled": true,
  "collection": "宋诗选",
