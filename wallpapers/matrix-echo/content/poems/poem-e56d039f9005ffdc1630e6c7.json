{
  "id": "poem-e56d039f9005ffdc1630e6c7",
  "title": "享太庙乐章",
  "author": "刘晏",
  "dynasty": "唐",
  "verses": [
    "汉祚惟永，神功中兴。",
    "夙驱氛祲，天覆黎蒸。",
    "三光再朗，庶绩其凝。",
    "重熙累叶，景命是膺。"
  ],
  "enabled": true,
