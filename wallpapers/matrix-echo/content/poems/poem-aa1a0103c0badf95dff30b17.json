{
  "id": "poem-aa1a0103c0badf95dff30b17",
  "title": "秋夜达萧关",
  "author": "于邺",
  "dynasty": "唐",
  "verses": [
    "扰扰浮梁路，人忙月自闲。",
    "去年为塞客，今夜宿萧关。",
    "辞国几经岁，望乡空见山。",
    "不知江叶下，又作布衣还。"
  ],
  "enabled": true,
