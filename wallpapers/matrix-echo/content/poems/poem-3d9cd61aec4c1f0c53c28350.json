{
  "id": "poem-3d9cd61aec4c1f0c53c28350",
  "title": "夜游曲",
  "author": "郑愔",
  "dynasty": "唐",
  "verses": [
    "汉室欢娱盛，魏国文雅遒。",
    "许史多暮宿，应陈从夜游。",
    "西园䜩公子，北里召王侯。",
    "讵似将军猎，空嗟亭尉留。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
