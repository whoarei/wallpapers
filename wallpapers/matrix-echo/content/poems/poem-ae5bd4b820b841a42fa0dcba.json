{
  "id": "poem-ae5bd4b820b841a42fa0dcba",
  "title": "客自江南话过亡友朱司议故宅",
  "author": "包佶",
  "dynasty": "唐",
  "verses": [
    "交臂多相共，风流忆此人。",
    "海翻移里巷，书蠹积埃尘。",
    "奉佛栖禅久，辞官上疏频。",
    "故来分半宅，惟是旧交亲。"
  ],
  "enabled": true,
