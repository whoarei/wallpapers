{
  "id": "poem-37abb93f992e56b11962cc16",
  "title": "闻猨",
  "author": "苏拯",
  "dynasty": "唐",
  "verses": [
    "秋风飒飒猨声起，客恨猨哀一相似。",
    "漫向孤危惊客心，何曾解入笙歌耳。"
  ],
  "enabled": true,
