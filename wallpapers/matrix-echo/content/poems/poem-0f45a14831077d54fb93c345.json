{
  "id": "poem-0f45a14831077d54fb93c345",
  "title": "荷叶杯·歌发谁家筵上",
  "author": "顾敻",
  "dynasty": "五代",
  "verses": [
    "歌发谁家筵上，寥亮。",
    "别恨正悠悠，兰釭背帐月当楼。",
    "愁么愁，愁么愁。"
  ],
  "enabled": true,
