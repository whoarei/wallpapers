{
  "id": "poem-104d3fd6c589558652c910ed",
  "title": "奉和御制旋师喜捷",
  "author": "裴漼",
  "dynasty": "唐",
  "verses": [
    "殊类骄无长，王师示有征。",
    "中军才受律，妖寇已亡精。",
    "斩虏还遮塞，绥降更筑城。",
    "从来攻必克，天策振奇兵。"
  ],
  "enabled": true,
