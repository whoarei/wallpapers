{
  "id": "poem-6c1618e97a7ae59d19ed0ec4",
  "title": "升平词十首 五",
  "author": "薛能",
  "dynasty": "唐",
  "verses": [
    "一物至周天，洪纤尽晏然。",
    "车书无异俗，甲子并丰年。",
    "奇技皆归朴，征夫亦服田。",
    "君王故不有，台鼎合韦弦。"
  ],
  "enabled": true,
