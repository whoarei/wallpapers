{
  "id": "poem-ab6e62d2a3496fcfb81a18dc",
  "title": "早朝",
  "author": "王维",
  "dynasty": "唐",
  "verses": [
    "皎洁明星高，苍茫远天曙。",
    "槐雾暗不开，城鸦鸣稍去。",
    "始闻高阁声，莫辨更衣处。",
    "银烛已成行，金门俨驺驭。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
