{
  "id": "poem-c0220a3288bbcdc57ee284d0",
  "title": "促织",
  "author": "张乔",
  "dynasty": "唐",
  "verses": [
    "念尔无机自有情，迎寒辛苦弄梭声。",
    "椒房金屋何曾识，偏向贫家壁下鸣。"
  ],
