{
  "id": "poem-8b9b338516e74d6ac5ed10a8",
  "title": "答五陵太守",
  "author": "王昌龄",
  "dynasty": "唐",
  "verses": [
    "仗剑行千里，微躯敢一言。",
    "曾为大梁客，不负信陵恩。"
  ],
  "enabled": true,
