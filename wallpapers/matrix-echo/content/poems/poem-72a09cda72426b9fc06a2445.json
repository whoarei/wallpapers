{
  "id": "poem-72a09cda72426b9fc06a2445",
  "title": "喜雪",
  "author": "明皇帝",
  "dynasty": "唐",
  "verses": [
    "日观卜先征，时巡顺物情。",
    "风行未备礼，云密遽飘霙。",
    "委树寒花发，萦空落絮轻。",
    "朝如玉已会，庭似月犹明。",
    "既覩肤先合，还欣尺有盈。",
    "登封何以报？因此谢功成。"
  ],
  "enabled": true,
