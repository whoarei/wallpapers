{
  "id": "poem-8c217f68864c7f5130d826ee",
  "title": "古扇",
  "author": "项斯",
  "dynasty": "唐",
  "verses": [
    "昨日裁成夺夏威，忽逢秋节便相违。",
    "寒尘妬尽秦王女，凉殿恩随汉主妃。",
    "似月旧临红粉面，有风休动麝香衣。",
    "千年萧瑟关人事，莫语当时掩泪归。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
