{
  "id": "poem-168021a3ecca93b09d603aea",
  "title": "赠施都正三首  其二",
  "author": "陈造",
  "dynasty": "宋",
  "verses": [
    "雨窗舞晦明，风竹作骚屑。",
    "断无思归梦，人境两清绝。",
    "道人气金玉，妙论挟冰雪。",
    "未须金鼎丹，始可黑霜发。"
  ],
  "enabled": true,
  "collection": "宋诗选",
