{
  "id": "poem-8a57b772846578082c9f0be0",
  "title": "瑞香",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "谱上先题五老名，宫袍云锦旧为隣。",
    "华风似惜诗人老，一样裁成紫绮新。"
  ],
