{
  "id": "poem-08ae1a2ba9b75e11a12cc719",
  "title": "越州怀古",
  "author": "张祜",
  "dynasty": "唐",
  "verses": [
    "振檝大江东，前林波万顷。",
    "高秋海天阔，色落湖山影。",
    "行寻王谢迹，望望登绝岭。",
    "荒林草木瘦，古树泉石冷。",
    "昔游不可见，牢落余风景。",
    "穷愁心未死，一笔聊复秉。",
    "。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
