{
  "id": "poem-8fb280e06f4839a5fa7ea056",
  "title": "金蕉叶",
  "author": "杨景贤",
  "dynasty": "元",
  "verses": [
    "正待要扫筝擘阮，忽受取观音差遣。",
    "西天路妖魔万千，保护着唐僧庶免。"
  ],
  "enabled": true,
  "collection": "元曲选",
