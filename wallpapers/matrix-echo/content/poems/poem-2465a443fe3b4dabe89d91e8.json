{
  "id": "poem-2465a443fe3b4dabe89d91e8",
  "title": "边上送杨侍御鞫狱回",
  "author": "马戴",
  "dynasty": "唐",
  "verses": [
    "狱成冤雪晚云开，豸角威清塞鴈回。",
    "飞将送迎遥避马，离亭不敢劝金杯。"
  ],
  "enabled": true,
