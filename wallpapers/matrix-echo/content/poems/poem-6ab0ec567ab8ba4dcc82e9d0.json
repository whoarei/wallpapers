{
  "id": "poem-6ab0ec567ab8ba4dcc82e9d0",
  "title": "上之回",
  "author": "沈佺期",
  "dynasty": "唐",
  "verses": [
    "制书下关右，天子问回中。",
    "坛𫮃经过远，威仪侍从雄。",
    "黄麾摇昼日，青幰曳松风。",
    "回望甘泉道，龙山隐汉宫。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
