{
  "id": "poem-b8e79ffd9d037f1ed8ab041b",
  "title": "郊庙歌辞 祭方丘乐章 顺和",
  "author": "不详",
  "dynasty": "唐",
  "verses": [
    "坤厚载物，德柔垂祉。",
    "九域咸雍，四溟为纪。",
    "敬因良节，虔修阴祀。",
    "广乐式张，灵其降止。"
  ],
  "enabled": true,
