{
  "id": "poem-e3dbaa30501cfbbac70bd3c1",
  "title": "下第寄友人",
  "author": "马戴",
  "dynasty": "唐",
  "verses": [
    "金门君待问，石室我思归。",
    "圣主尊黄屋，何人荐白衣。",
    "年来御沟柳，赠别雨霏霏。"
  ],
  "enabled": true,
