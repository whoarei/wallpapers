{
  "id": "poem-92bd4be2079f98dde9a9927d",
  "title": "酬郭给事",
  "author": "王维",
  "dynasty": "唐",
  "verses": [
    "洞门高阁霭余辉，桃李阴阴柳絮飞。",
    "禁里疎钟官舍晚，省中啼鸟吏人稀。",
    "晨摇玉佩趋金殿，夕奉天书拜琐闱。",
    "强欲从君无那老，将因卧病解朝衣。"
  ],
  "enabled": true,
  "collection": "唐诗三百首",
