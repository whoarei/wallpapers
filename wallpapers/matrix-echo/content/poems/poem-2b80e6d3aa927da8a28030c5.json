{
  "id": "poem-2b80e6d3aa927da8a28030c5",
  "title": "送沈亚之赴郢掾",
  "author": "徐凝",
  "dynasty": "唐",
  "verses": [
    "千万乘骢沈司户，不须惆怅郢中游。",
    "几年白雪无人唱，今日唯君上雪楼。"
  ],
  "enabled": true,
