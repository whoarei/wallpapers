{
  "id": "poem-d623a26bad88022c3d715ae7",
  "title": "赠陈望尧",
  "author": "李咸用",
  "dynasty": "唐",
  "verses": [
    "若说精通事艺长，词人争及孝廉郎。",
    "秋萤短焰难盈案，邻烛余光不满行。",
    "鹄箭亲疎虽异的，桂花高下一般香。",
    "明时公道还堪信，莫遣锥锋久在囊。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
