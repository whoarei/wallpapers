{
  "id": "poem-eca2aa1ff7e55aa3f5a8f51f",
  "title": "杂兴六首 三",
  "author": "皎然",
  "dynasty": "唐",
  "verses": [
    "谁高齐公子，泣听雍门琴。",
    "死且何足伤，殊非达人心。"
  ],
