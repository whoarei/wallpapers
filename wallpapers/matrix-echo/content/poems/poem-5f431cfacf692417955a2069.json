{
  "id": "poem-5f431cfacf692417955a2069",
  "title": "广教不厌亭",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "眼挂层峦醉益青，旋疑身是出山云。",
    "一泉一石忘情地，都作鸿沟与俗分。"
  ],
  "enabled": true,
