{
  "id": "poem-b6cc698a08ad1720744719ab",
  "title": "自叹",
  "author": "宋伯仁",
  "dynasty": "宋",
  "verses": [
    "又作淮南客，边尘压鬓毛。",
    "夜长蛩聒聒，家远雁忉忉。",
    "把酒天徒问，推篷月正高。",
    "英雄四方志，休恋故人袍。"
  ],
  "enabled": true,
  "collection": "宋诗选",
