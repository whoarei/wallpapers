{
  "id": "poem-dcba374f6780b6cec9c689da",
  "title": "送净道人",
  "author": "徐铉",
  "dynasty": "宋",
  "verses": [
    "北阜与西山，前期梦寐间。",
    "羡师乘兴去，应拟此生闲。",
    "乔木人谁在，鲈鱼我未还。",
    "归心寄秋水，东去日潺潺。"
  ],
  "enabled": true,
  "collection": "宋诗选",
