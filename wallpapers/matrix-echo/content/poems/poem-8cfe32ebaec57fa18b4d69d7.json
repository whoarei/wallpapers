{
  "id": "poem-8cfe32ebaec57fa18b4d69d7",
  "title": "寄人二首 一",
  "author": "崔道融",
  "dynasty": "唐",
  "verses": [
    "花上断续雨，江头来去风。",
    "相思春欲尽，未遣酒尊空。"
  ],
  "enabled": true,
