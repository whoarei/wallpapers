{
  "id": "poem-4cf2ee824b703af511b67a71",
  "title": "卜算子·风生杜若洲",
  "author": "张孝祥",
  "dynasty": "宋",
  "verses": [
    "风生杜若洲，日暮垂杨浦。",
    "行到田田乱叶边，不见凌波女。",
    "独自倚危栏，欲向荷花语。",
    "无奈荷花不应人，背立啼红雨。"
  ],
  "enabled": true,
  "collection": "宋词选",
