{
  "id": "poem-fed30af5894651615a647dd9",
  "title": "传言玉女",
  "author": "高明《蔡伯喈琵琶记》",
  "dynasty": "元",
  "verses": [
    "烛影摇红，帘幕瑞烟浮动，画堂中珠围翠拥。",
    "妆台对月，下鸾鹤神仙仪从。",
    "玉箫声里，一双鸣凤。"
  ],
  "enabled": true,
  "collection": "元曲选",
  "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/元曲/yuanqu.json#record-5057",
