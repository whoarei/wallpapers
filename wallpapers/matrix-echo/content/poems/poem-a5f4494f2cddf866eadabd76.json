{
  "id": "poem-a5f4494f2cddf866eadabd76",
  "title": "长信草",
  "author": "崔国辅",
  "dynasty": "唐",
  "verses": [
    "长信宫中草，年年愁处生。",
    "故侵珠履迹，不使玉阶行。"
  ],
  "enabled": true,
