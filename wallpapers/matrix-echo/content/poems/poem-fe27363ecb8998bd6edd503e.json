{
  "id": "poem-fe27363ecb8998bd6edd503e",
  "title": "颂古七十六首  其一○",
  "author": "释士珪",
  "dynasty": "宋",
  "verses": [
    "少室山前风过耳，九年人事随流水。",
    "若还是弄潮人，切须莫入洪波里。"
  ],
