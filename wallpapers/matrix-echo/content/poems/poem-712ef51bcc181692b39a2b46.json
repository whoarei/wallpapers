{
  "id": "poem-712ef51bcc181692b39a2b46",
  "title": "题屏",
  "author": "刘季孙",
  "dynasty": "宋",
  "verses": [
    "呢喃燕子语梁间，底事来惊梦里闲。",
    "说与旁人浑不解，杖藜携酒看芝山。"
  ],
  "enabled": true,
