{
  "id": "poem-b2d29be9ac9d092d675080d3",
  "title": "精舍遇雨",
  "author": "可止",
  "dynasty": "唐",
  "verses": [
    "空门寂寂淡吾身，溪雨微微洗客尘。",
    "卧向白云情未尽，任他黄鸟醉芳春。"
  ],
  "enabled": true,
