{
  "id": "poem-5b90c8b592f07ea245c64e13",
  "title": "灌花",
  "author": "柴元彪",
  "dynasty": "宋",
  "verses": [
    "小圃辛勤植众芳，年年雨露借恩光。",
    "近来天意高难问，抱瓮从朝到夕阳。"
  ],
  "enabled": true,
