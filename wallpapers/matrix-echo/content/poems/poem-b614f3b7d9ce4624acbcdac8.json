{
  "id": "poem-b614f3b7d9ce4624acbcdac8",
  "title": "又和开叔",
  "author": "司马光",
  "dynasty": "宋",
  "verses": [
    "寒梅犯雪荣，大隐久专名。",
    "异种生江渚，何年到洛城。",
    "色如虚室白，香似主人清。",
    "响使吴儿见，不思菰菜羮。"
  ],
  "enabled": true,
  "collection": "宋诗选",
