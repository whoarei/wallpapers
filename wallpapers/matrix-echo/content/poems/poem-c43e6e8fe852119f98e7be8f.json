{
  "id": "poem-c43e6e8fe852119f98e7be8f",
  "title": "小游仙诗九十八首 六十九",
  "author": "曹唐",
  "dynasty": "唐",
  "verses": [
    "笑擎云液紫瑶觥，共请云和碧玉笙。",
    "花下偶然吹一曲，人间因织董双成。"
  ],
