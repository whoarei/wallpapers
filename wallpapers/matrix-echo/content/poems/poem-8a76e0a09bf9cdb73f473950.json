{
  "id": "poem-8a76e0a09bf9cdb73f473950",
  "title": "惜花",
  "author": "张籍",
  "dynasty": "唐",
  "verses": [
    "蒙蒙庭树花，坠地无颜色。",
    "日暮东风起，飘扬玉阶侧。",
    "残蘂在犹稀，青条耸复直。",
    "为君结芳实，令君勿叹息。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
