{
  "id": "poem-aa2165827407fbe3245699ee",
  "title": "题岳州僧舍",
  "author": "裴说",
  "dynasty": "唐",
  "verses": [
    "喜到重湖北，孤州横晚烟。",
    "鹭衔鱼入寺，鵶接饭随船。",
    "松桧君山逈，菰蒲梦泽连。",
    "与师吟论处，秋水浸遥天。"
  ],
  "enabled": true,
