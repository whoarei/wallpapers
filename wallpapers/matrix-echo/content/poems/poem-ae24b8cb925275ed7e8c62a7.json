{
  "id": "poem-ae24b8cb925275ed7e8c62a7",
  "title": "罗汉岭上古杉",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "一亩蔽苍苔，昙猷手自栽。",
    "滴高零露馥，蟠厚烈风哀。",
    "黛色垂云黑，丹心阅世灰。",
    "儿孙几度老，独立暝云隈。"
  ],
  "enabled": true,
  "collection": "宋诗选",
