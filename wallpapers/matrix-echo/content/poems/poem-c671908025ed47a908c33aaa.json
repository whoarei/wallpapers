{
  "id": "poem-c671908025ed47a908c33aaa",
  "title": "颂古七十六首  其六三",
  "author": "释士珪",
  "dynasty": "宋",
  "verses": [
    "风头稍硬难安立，暖气才通瞌睡来。",
    "却笑明招闲费力，无端两处强差排。"
  ],
  "enabled": true,
