{
  "id": "poem-d302e212c969b925e4528f41",
  "title": "赠姚合",
  "author": "张籍",
  "dynasty": "唐",
  "verses": [
    "丹凤城门向晓开，千官相次入朝来。",
    "唯君独走冲尘土，下马桥边报直回。"
  ],
  "enabled": true,
