{
  "id": "poem-1c40540b24e0be158915b522",
  "title": "送客还幽州",
  "author": "李益",
  "dynasty": "唐",
  "verses": [
    "惆怅秦城送独归，蓟门云树远依依。",
    "秋来莫射南飞雁，从遣乘春更北飞。"
  ],
  "enabled": true,
