{
  "id": "poem-ffc8904d4787103c85d2bcf1",
  "title": "陇上独望",
  "author": "马戴",
  "dynasty": "唐",
  "verses": [
    "斜日挂边树，萧萧独望间。",
    "阴云藏汉垒，飞火照胡山。",
    "陇首行人绝，河源夕鸟还。",
    "谁为立勋者，可惜宝刀闲。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
