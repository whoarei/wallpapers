{
  "id": "poem-d4bb24c4afeb0753c4eed4c4",
  "title": "鹊巢",
  "author": "佚名",
  "dynasty": "先秦",
  "verses": [
    "维鹊有巢，维鸠居之。之子于归，百两御之。",
    "维鹊有巢，维鸠方之。之子于归，百两将之。",
    "维鹊有巢，维鸠盈之。之子于归，百两成之。"
  ],
  "enabled": true,
  "collection": "诗经",
  "tags": [],
