{
  "id": "poem-2dbb1083178fddf12a690d42",
  "title": "祭汾阴乐章",
  "author": "卢从愿",
  "dynasty": "唐",
  "verses": [
    "坤元载物，阳乐发生。",
    "播植资始，品汇咸亨。",
    "列俎棋布，方坛砥平。",
    "神歆禋祀，后德惟明。"
  ],
  "enabled": true,
