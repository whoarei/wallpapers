{
  "id": "poem-4d42a0710afd48c615244a1c",
  "title": "赵飞燕姊妹",
  "author": "赵崇嶓",
  "dynasty": "宋",
  "verses": [
    "甲帐初停燕子飞，小雏相趁共差池。",
    "春风吹水粼粼长，又有披香博士知。"
  ],
  "enabled": true,
