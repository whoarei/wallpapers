{
  "id": "poem-b8a19575cc3a7fb2d1406319",
  "title": "谒金门·伤离索",
  "author": "毛并",
  "dynasty": "宋",
  "verses": [
    "伤离索。",
    "犹记并肩池阁。",
    "病起绿窗闲倚薄。",
    "一秋天气恶。",
    "玉臂都宽金约。",
    "歌舞新来忘却。",
    "回首故人天一角。",
    "半江枫又落。"
  ],
  "enabled": true,
  "collection": "宋词选",
