{
  "id": "poem-4399cea9aa2a7ccfa6372bf2",
  "title": "病起",
  "author": "来鹄",
  "dynasty": "唐",
  "verses": [
    "春初一卧到秋深，不见红芳与绿阴。",
    "窗下展书难久读，池边扶杖欲闲吟。",
    "藕穿平地生荷叶，笋过东家作竹林。",
    "在舍浑如远乡客，诗僧酒伴镇相寻。"
  ],
  "enabled": true,
