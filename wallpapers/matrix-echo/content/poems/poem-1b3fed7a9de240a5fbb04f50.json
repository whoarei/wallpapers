{
  "id": "poem-1b3fed7a9de240a5fbb04f50",
  "title": "小圃即事四首  其三",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "练帨新裁衬缟衣，暝云垂地拥瑶姬。",
    "自知素洁难谐俗，只赴梨花淡月期。"
  ],
