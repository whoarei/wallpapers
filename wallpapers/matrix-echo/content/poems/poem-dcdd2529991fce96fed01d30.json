{
  "id": "poem-dcdd2529991fce96fed01d30",
  "title": "奉陪张燕公登南楼",
  "author": "尹懋",
  "dynasty": "唐",
  "verses": [
    "君子每垂眷，江山共流眄。",
    "水远林外明，岩近雾中见。",
    "终日西北望，何处是京县。",
    "屡登高春台，徒使泪如霰。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
