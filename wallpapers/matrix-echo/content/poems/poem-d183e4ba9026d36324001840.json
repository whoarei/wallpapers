{
  "id": "poem-d183e4ba9026d36324001840",
  "title": "木兰花减字・减字木兰花·匀红点翠",
  "author": "陈师道",
  "dynasty": "宋",
  "verses": [
    "匀红点翠。",
    "取次梳妆谁得似。",
    "风柳腰肢。",
    "尽日纤柔属阿谁。",
    "娇娇小小。",
    "却是寻春人较老。",
    "著便休痴。",
    "付与风流幕下儿。"
  ],
  "enabled": true,
  "collection": "宋词选",
