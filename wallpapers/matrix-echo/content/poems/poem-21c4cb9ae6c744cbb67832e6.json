{
  "id": "poem-21c4cb9ae6c744cbb67832e6",
  "title": "春秋战国门 又吟",
  "author": "周昙",
  "dynasty": "唐",
  "verses": [
    "马毙廐人欲就刑，百年临尽一言生。",
    "赖逢贤相能匡救，仍免吾君播恶声。"
  ],
  "enabled": true,
