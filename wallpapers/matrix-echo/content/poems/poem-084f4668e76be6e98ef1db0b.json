{
  "id": "poem-084f4668e76be6e98ef1db0b",
  "title": "僻居酬友人",
  "author": "伍乔",
  "dynasty": "宋",
  "verses": [
    "僻居惟爱近林泉，幽径闲园任藓连。",
    "向竹掩扉随鹤息，就溪安石学僧禅。",
    "古琴带月音声正，山果经霜气味全。",
    "多谢故交怜朴野，隔云时复寄佳篇。"
  ],
  "enabled": true,
