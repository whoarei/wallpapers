{
  "id": "poem-1f2950bbde727f0a353772bd",
  "title": "古意",
  "author": "张碧",
  "dynasty": "唐",
  "verses": [
    "銮舆不碾香尘灭，更残三十六宫月。",
    "手持纨扇独含情，秋风吹落横波血。"
  ],
  "enabled": true,
