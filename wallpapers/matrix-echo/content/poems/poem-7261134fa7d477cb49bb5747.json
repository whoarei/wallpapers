{
  "id": "poem-7261134fa7d477cb49bb5747",
  "title": "闲吟",
  "author": "周昙",
  "dynasty": "唐",
  "verses": [
    "考摭妍媸用破心，翦裁千古献当今。",
    "闲吟不是闲吟事，事有闲思闲要吟。"
  ],
  "enabled": true,
