{
  "id": "poem-5154640f33443e1041e93310",
  "title": "岁晚烹试小春建茶",
  "author": "张栻",
  "dynasty": "宋",
  "verses": [
    "阳月藏春妙莫窥，灵芽粟粒露全机。",
    "煮泉独啜寒窗夜，已觉东风天际归。"
  ],
  "enabled": true,
  "collection": "宋诗选",
