{
  "id": "poem-818462bf5a9761ca97429250",
  "title": "颂古七十六首  其七四",
  "author": "释士珪",
  "dynasty": "宋",
  "verses": [
    "杨歧老人锁口诀，万里长城一条铁。",
    "斫牌禅客知到来，不动金锤脑门裂。"
  ],
  "enabled": true,
