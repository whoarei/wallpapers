{
  "id": "poem-c01fe024d97e19e504583275",
  "title": "送仪州李太保丈",
  "author": "苏颂",
  "dynasty": "宋",
  "verses": [
    "持节出西𬮱，腰章入旧秦。",
    "家传虎韬术，朝有象贤人。",
    "合闭关山月，帷褰渭水春。",
    "虏尘今向息，正是雅歌辰。"
  ],
  "enabled": true,
  "collection": "宋诗选",
