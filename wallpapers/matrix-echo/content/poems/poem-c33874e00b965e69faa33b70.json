{
  "id": "poem-c33874e00b965e69faa33b70",
  "title": "芙蓉楼送辛渐二首 一",
  "author": "王昌龄",
  "dynasty": "唐",
  "verses": [
    "寒雨连天夜入湖，平明送客楚山孤。",
    "洛阳亲友如相问，一片冰心在玉壶。"
  ],
