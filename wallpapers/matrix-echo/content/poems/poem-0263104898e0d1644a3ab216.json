{
  "id": "poem-0263104898e0d1644a3ab216",
  "title": "清明",
  "author": "杜牧",
  "dynasty": "唐",
  "verses": [
    "清明时节雨纷纷，路上行人欲断魂。",
    "借问酒家何处有，牧童遥指杏花村。"
  ],
  "enabled": true,
  "collection": "千家诗",
