{
  "id": "poem-85609183e4915d2f78f82180",
  "title": "寓天台水南四首  其一",
  "author": "林宪",
  "dynasty": "宋",
  "verses": [
    "小雨凄暮春，入夜寒更作。",
    "泠泠竹间风，振我衣袂薄。",
    "野田鸣流泉，密树纷翠幄。",
    "蹑屐徐我行，长怀付寥廓。"
  ],
  "enabled": true,
  "collection": "宋诗选",
