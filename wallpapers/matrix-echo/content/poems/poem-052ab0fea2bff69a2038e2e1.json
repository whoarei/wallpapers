{
  "id": "poem-052ab0fea2bff69a2038e2e1",
  "title": "咏史",
  "author": "高适",
  "dynasty": "唐",
  "verses": [
    "尚有绨袍赠，应怜范叔寒。",
    "不知天下士，犹作布衣看。"
  ],
  "enabled": true,
  "collection": "千家诗",
