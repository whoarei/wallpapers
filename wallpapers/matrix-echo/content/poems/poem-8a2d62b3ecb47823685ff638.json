{
  "id": "poem-8a2d62b3ecb47823685ff638",
  "title": "书怀寄友人",
  "author": "沈颜",
  "dynasty": "唐",
  "verses": [
    "江湖劳遍寻，祗自长愁襟。",
    "到处慵开口，何人可话心。",
    "登楼得句远，望月抒情深。",
    "却忆山斋后，猿声相伴吟。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
