{
  "id": "poem-c259b1099f0f28d4483e2df4",
  "title": "白莲雨后渐衰",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "晓池芳柄褭残馨，褪雨欹风鹭委翎。",
    "碧展一奁秋练练，似怜玉色镜中零。"
  ],
  "enabled": true,
  "collection": "宋诗选",
