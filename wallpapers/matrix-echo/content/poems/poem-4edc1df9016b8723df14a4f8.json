{
  "id": "poem-4edc1df9016b8723df14a4f8",
  "title": "寄全椒山中道士",
  "author": "韦应物",
  "dynasty": "唐",
  "verses": [
    "今朝郡斋冷，忽念山中客。",
    "涧底束荆薪，归来煮白石。",
    "欲持一瓢酒，远慰风雨夕。",
    "落叶满空山，何处寻行迹。"
  ],
  "enabled": true,
  "collection": "唐诗三百首",
