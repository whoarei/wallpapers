{
  "id": "poem-a7e3bbf26dcd0e7f5a250272",
  "title": "眼儿媚·咏红姑娘",
  "author": "纳兰性德",
  "dynasty": "清",
  "verses": [
    "骚屑西风弄晚寒，翠袖倚阑干。",
    "霞绡裹处，樱唇微绽，靺鞨红殷。",
    "故宫事往凭谁问，无恙是朱颜。",
    "玉墀争采，玉钗争插，至正年间。"
  ],
  "enabled": true,
  "collection": "纳兰词",
  "tags": [],
