{
  "id": "poem-654dc7b647e2048d7fc8a17e",
  "title": "和主司王起",
  "author": "石贯",
  "dynasty": "唐",
  "verses": [
    "重德由来为国生，五朝清显冠公卿。",
    "风波久伫济川檝，羽翼三迁出谷莺。",
    "绛帐青衿同日贵，春兰秋菊异时荣。",
    "孔门弟子皆贤哲，谁料穷儒忝一名。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
