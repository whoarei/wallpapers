{
  "id": "poem-e28d72500164fc277d822e44",
  "title": "奉和圣制龙池篇",
  "author": "卢怀慎",
  "dynasty": "唐",
  "verses": [
    "代邸东南龙跃泉，清漪碧浪远浮天。",
    "楼台影就波中出，日月光疑镜里悬。",
    "雁沼洄流成舜海，龟书荐社应尧年。",
    "大川既济慙为楫，报德空思奉细涓。"
  ],
  "enabled": true,
