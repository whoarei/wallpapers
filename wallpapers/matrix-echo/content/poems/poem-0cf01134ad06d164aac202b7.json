{
  "id": "poem-0cf01134ad06d164aac202b7",
  "title": "送僧造普同塔",
  "author": "释行机",
  "dynasty": "宋",
  "verses": [
    "珊珊玉骨本玲珑，挂角羚羊不见踪。",
    "特地作亭图甚么，为怜松竹引清风。"
  ],
  "enabled": true,
