{
  "id": "poem-833378fcda3f9adf2f3e199b",
  "title": "偈颂 六",
  "author": "文偃",
  "dynasty": "唐",
  "verses": [
    "丱岁依山人事稀，松下相逢话道奇。",
    "锋前一句超调御，拟问如何历劫违。"
  ],
