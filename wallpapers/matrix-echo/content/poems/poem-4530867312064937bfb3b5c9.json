{
  "id": "poem-4530867312064937bfb3b5c9",
  "title": "送惟良上人归润州",
  "author": "李端",
  "dynasty": "唐",
  "verses": [
    "拟诗偏不类，又送上人归。",
    "寄世同高鹤，寻仙称坏衣。",
    "雨行江草短，露坐海帆稀。",
    "正被空门缚，临岐乞解围。"
  ],
  "enabled": true,
