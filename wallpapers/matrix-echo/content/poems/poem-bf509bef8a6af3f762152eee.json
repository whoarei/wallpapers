{
  "id": "poem-bf509bef8a6af3f762152eee",
  "title": "浣溪沙·翡翠屏开绣幄红",
  "author": "张泌",
  "dynasty": "五代",
  "verses": [
    "翡翠屏开绣幄红，谢娥无力晓妆慵，锦帷鸳被宿香浓。",
    "微雨小庭春寂寞，燕飞莺语隔帘栊，杏花凝恨倚东风。"
  ],
  "enabled": true,
  "collection": "花间集",
