{
  "id": "poem-ed9f699cda0d010f51865214",
  "title": "正朝上左相张燕公",
  "author": "杨重玄",
  "dynasty": "唐",
  "verses": [
    "岁去愁终在，春还命不来。",
    "长吁问丞相，东阁几时开。"
  ],
