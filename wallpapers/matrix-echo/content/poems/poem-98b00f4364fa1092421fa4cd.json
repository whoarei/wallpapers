{
  "id": "poem-98b00f4364fa1092421fa4cd",
  "title": "晚次巴陵",
  "author": "李端",
  "dynasty": "唐",
  "verses": [
    "雪后柳条新，巴陵城下人。",
    "烹鱼邀水客，载酒奠山神。",
    "云去低斑竹，波回动白苹。",
    "不堪逢楚老，日暮正江春。"
  ],
  "enabled": true,
