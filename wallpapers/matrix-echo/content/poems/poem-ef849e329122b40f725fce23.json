{
  "id": "poem-ef849e329122b40f725fce23",
  "title": "白云溪",
  "author": "吴巩",
  "dynasty": "唐",
  "verses": [
    "山径入修篁，深林蔽日光。",
    "夏云生嶂远，瀑水引溪长。",
    "秀迹逢皆胜，清芬坐转凉。",
    "回看玉樽夕，归路赏前忘。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
