{
  "id": "poem-662edf019b1c525d5db37f55",
  "title": "赠贾岛",
  "author": "张籍",
  "dynasty": "唐",
  "verses": [
    "篱落荒凉僮仆饥，乐游原上住多时。",
    "蹇驴放饱骑将出，秋卷装成寄与谁。",
    "拄杖傍田寻野菜，封书乞米趂时炊。",
    "姓名未上登科记，身屈惟应内史知。"
  ],
  "enabled": true,
