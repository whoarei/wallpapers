{
  "id": "poem-c25cc8af7074fa8d0a556cdf",
  "title": "卜算子·寒透小窗纱",
  "author": "黄公度",
  "dynasty": "宋",
  "verses": [
    "寒透小窗纱，漏断人初醒。",
    "翡翠屏间拾落钗，背立残釭影。",
    "欲去更踟蹰，离恨终难整。",
    "陇首流泉不忍闻，月落双溪冷。"
  ],
  "enabled": true,
  "collection": "宋词选",
