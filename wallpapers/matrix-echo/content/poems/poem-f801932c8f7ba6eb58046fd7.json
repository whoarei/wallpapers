{
  "id": "poem-f801932c8f7ba6eb58046fd7",
  "title": "相见欢·微云一抹遥峰",
  "author": "纳兰性德",
  "dynasty": "清",
  "verses": [
    "微云一抹遥峰，冷溶溶。",
    "恰与个人清晓，画眉同。",
    "红蜡泪，青绫被，水沉浓。",
    "却与黄茅野店，听西风。"
  ],
  "enabled": true,
  "collection": "纳兰词",
