{
  "id": "poem-8f8606765fef54c7b650449b",
  "title": "河南府试十二月乐词 五月",
  "author": "李贺",
  "dynasty": "唐",
  "verses": [
    "雕玉押帘额，轻縠笼虚门。",
    "井汲铅华水，扇织鸳鸯纹。",
    "回雪舞凉殿，甘露洗空绿。",
    "罗袖从徊翔，香汗沾宝粟。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
