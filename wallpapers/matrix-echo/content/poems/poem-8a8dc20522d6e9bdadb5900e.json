{
  "id": "poem-8a8dc20522d6e9bdadb5900e",
  "title": "春中田园作",
  "author": "王维",
  "dynasty": "唐",
  "verses": [
    "屋上春鸠鸣，村边杏花白。",
    "持斧伐远扬，荷锄觇泉脉。",
    "归燕识故巢，旧人看新历。",
    "临觞忽不御，惆怅远行客。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
  "tags": [
    "春天",
    "田园",
    "写景",
    "农事"
