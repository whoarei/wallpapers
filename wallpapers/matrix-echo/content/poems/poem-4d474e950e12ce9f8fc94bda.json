{
  "id": "poem-4d474e950e12ce9f8fc94bda",
  "title": "初夏睡起",
  "author": "杨万里",
  "dynasty": "宋",
  "verses": [
    "梅子流酸溅齿牙，芭蕉分绿上窗纱。",
    "日长睡起无情思，闲看儿童捉柳花。"
  ],
  "enabled": true,
  "collection": "千家诗",
