{
  "id": "poem-949a5e1ae6767a51f7d338a8",
  "title": "□□",
  "author": "佚名",
  "dynasty": "唐",
  "verses": [
    "恨到荒城一闭关，乡园阻隔万重山。",
    "咫尺音书犹不达，梦魂何处得归还。"
  ],
