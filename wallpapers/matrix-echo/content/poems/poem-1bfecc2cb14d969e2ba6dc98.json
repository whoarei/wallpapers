{
  "id": "poem-1bfecc2cb14d969e2ba6dc98",
  "title": "赠邓郎将四弟",
  "author": "马云奇",
  "dynasty": "唐",
  "verses": [
    "把袂相欢意最浓，十年言笑得朋从。",
    "怜君节操曾无易，只是青山一树松。"
  ],
