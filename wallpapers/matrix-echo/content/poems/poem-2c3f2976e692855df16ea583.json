{
  "id": "poem-2c3f2976e692855df16ea583",
  "title": "贺圣朝",
  "author": "施惠《幽闺记》",
  "dynasty": "元",
  "verses": [
    "(小生上)斩龙射虎威风，擒王捉将英雄。",
    "锦征袍相称茜巾红，镇山北山东。"
  ],
