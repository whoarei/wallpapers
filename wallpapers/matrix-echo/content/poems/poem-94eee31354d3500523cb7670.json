{
  "id": "poem-94eee31354d3500523cb7670",
  "title": "扈从书事",
  "author": "綦崇礼",
  "dynasty": "宋",
  "verses": [
    "扈从官班近，囏难报效微。",
    "又同陪法驾，复共著征衣。",
    "举目江山好，伤心井社非。",
    "何当戎马定，却作故乡归。",
    "负郭田园美，迎霜雉兔肥。",
    "风尘嗟澒洞，梦寐怅依稀。",
    "圣主兴皇祚，群公翊政机。",
    "时平当自劾，还采故山薇。"
  ],
  "enabled": true,
  "collection": "宋诗选",
