{
  "id": "poem-e9f678854696382f30ce3ba9",
  "title": "都亭驿送郭判官之幽州幕府",
  "author": "李端",
  "dynasty": "唐",
  "verses": [
    "幕府参戎事，承明伏奏归。",
    "都亭使者出，杯酒故人违。",
    "细雨沾官骑，轻风拂客衣。",
    "还从大夫后，吾党亦光辉。"
  ],
  "enabled": true,
