{
  "id": "poem-4b8207910b0e10f349adf020",
  "title": "泊秦淮",
  "author": "杜牧",
  "dynasty": "唐",
  "verses": [
    "烟笼寒水月笼沙，夜泊秦淮近酒家。",
    "商女不知亡国恨，隔江犹唱后庭花。"
  ],
  "enabled": true,
