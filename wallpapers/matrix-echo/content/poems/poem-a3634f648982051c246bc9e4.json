{
  "id": "poem-a3634f648982051c246bc9e4",
  "title": "下京口埭夜行",
  "author": "孙逖",
  "dynasty": "唐",
  "verses": [
    "孤帆度绿氛，寒浦落红曛。",
    "江树朝来出，吴歌夜渐闻。",
    "南溟接潮水，北斗近乡云。",
    "行役从兹去，归情入鴈群。"
  ],
  "enabled": true,
