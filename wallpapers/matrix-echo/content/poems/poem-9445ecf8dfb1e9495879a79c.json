{
  "id": "poem-9445ecf8dfb1e9495879a79c",
  "title": "杂诗二首 二",
  "author": "卢象",
  "dynasty": "唐",
  "verses": [
    "君家御沟上，垂柳夹朱门。",
    "列鼎会中贵，鸣珂朝至尊。",
    "死生在片议，穷达由一言。",
    "须识苦寒士，莫矜狐白温。"
  ],
  "enabled": true,
