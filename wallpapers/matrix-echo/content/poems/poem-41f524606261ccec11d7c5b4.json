{
  "id": "poem-41f524606261ccec11d7c5b4",
  "title": "升平词十首 六",
  "author": "薛能",
  "dynasty": "唐",
  "verses": [
    "日日听歌谣，区中尽祝尧。",
    "虫蝗初不害，夷狄近全销。",
    "史笔惟书瑞，天台绝见妖。",
    "因令匹夫志，转欲事清朝。"
  ],
  "enabled": true,
