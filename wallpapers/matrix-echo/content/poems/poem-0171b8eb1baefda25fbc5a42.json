{
  "id": "poem-0171b8eb1baefda25fbc5a42",
  "title": "浪淘沙·深院绣帘垂",
  "author": "毛滂",
  "dynasty": "宋",
  "verses": [
    "深院绣帘垂。",
    "前日春归。",
    "画桥杨柳弄烟霏。",
    "池面东风先解冻，龟上涟漪。",
    "酒潋玉东西。",
    "香暖狻猊。",
    "远山郁秀入双眉。",
    "待看碧桃花烂漫，春日迟迟。"
  ],
  "enabled": true,
  "collection": "宋词选",
