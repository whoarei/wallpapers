{
  "id": "poem-ead5b7031f176ae44b8cd833",
  "title": "浣溪沙·绿树藏莺莺玉啼",
  "author": "韦庄",
  "dynasty": "五代",
  "verses": [
    "绿树藏莺莺玉啼，柳丝斜拂白铜堤，弄珠江上草萋萋。",
    "日暮饮归何处客，绣鞍骢马一声嘶，满身兰麝醉如泥。"
  ],
  "enabled": true,
  "collection": "花间集",
