{
  "id": "poem-13831ae527fc65da7e739534",
  "title": "渔父·白芷汀寒立鹭鸶",
  "author": "和凝",
  "dynasty": "五代",
  "verses": [
    "白芷汀寒立鹭鸶，苹风轻剪浪花时。",
    "烟幂幂，日迟迟。",
    "香引芙蓉惹钓丝。"
  ],
  "enabled": true,
  "collection": "花间集",
