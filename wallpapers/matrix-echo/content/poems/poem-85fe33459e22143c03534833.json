{
  "id": "poem-85fe33459e22143c03534833",
  "title": "荅韦先辈春雨后见寄",
  "author": "刘得仁",
  "dynasty": "唐",
  "verses": [
    "风散五更雨，鸟啼三月春。",
    "轩窗透初日，砚席绝纤尘。",
    "帝里峰头出，邻家树色新。",
    "怜君高且静，有句寄闲人。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
