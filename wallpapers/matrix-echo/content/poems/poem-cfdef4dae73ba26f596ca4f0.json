{
  "id": "poem-cfdef4dae73ba26f596ca4f0",
  "title": "鴈来红",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "夜夜灯花巧胜裁，家书准拟傍秋开。",
    "鴈来红叶都红了，目断西风鴈不来。"
  ],
  "enabled": true,
  "collection": "宋诗选",
