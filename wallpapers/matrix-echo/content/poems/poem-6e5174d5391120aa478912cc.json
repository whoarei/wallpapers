{
  "id": "poem-6e5174d5391120aa478912cc",
  "title": "张丞见和次韵答之  其五",
  "author": "陈造",
  "dynasty": "宋",
  "verses": [
    "男儿鼎珍食，富贵倚稽古。",
    "不然东山车，稳载十眉女。",
    "可怜强项令，俗尘塞肠腑。",
    "端如溧阳尉，老诉食荠苦。"
  ],
  "enabled": true,
  "collection": "宋诗选",
