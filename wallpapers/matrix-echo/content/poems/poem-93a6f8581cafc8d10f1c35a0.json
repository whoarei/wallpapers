{
  "id": "poem-93a6f8581cafc8d10f1c35a0",
  "title": "宫词  其二",
  "author": "张公庠",
  "dynasty": "宋",
  "verses": [
    "朱字衙香伴玉𬬻，丁丁莲漏月来初。",
    "交龙画烛摇红影，准拟君王夜读书。"
  ],
  "enabled": true,
