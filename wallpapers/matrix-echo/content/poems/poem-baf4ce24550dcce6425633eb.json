{
  "id": "poem-baf4ce24550dcce6425633eb",
  "title": "峡哀 八",
  "author": "孟郊",
  "dynasty": "唐",
  "verses": [
    "峡景滑易堕，峡花怪非春。",
    "红光根潜涎，碧雨飞沃津。",
    "巴谷蛟螭心，巴乡魍魉亲。",
    "噉生不问贤，至死独养身。",
    "腥语信者谁，拗歌欢非真。",
    "仄田无异稼，毒水多狞鳞。",
    "异类不可友，峡哀哀难伸。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
