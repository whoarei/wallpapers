{
  "id": "poem-d83f7a982aa2bac8fcff31ec",
  "title": "更漏子·烟月寒",
  "author": "毛熙震",
  "dynasty": "五代",
  "verses": [
    "烟月寒，秋夜静，漏转金壶初永。",
    "罗幕下，绣屏空，灯花结碎红。",
    "人悄悄，愁无了，思梦不成难晓。",
    "长忆得，与郎期，窃香私语时。"
  ],
  "enabled": true,
  "collection": "花间集",
