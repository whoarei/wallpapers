{
  "id": "poem-b42df4073be6c0f94b83f514",
  "title": "宿江口",
  "author": "于邺",
  "dynasty": "唐",
  "verses": [
    "南渡人来绝，喧喧雁满沙。",
    "自生江上月，长有客思家。",
    "半夜下霜岸，北风吹荻花。",
    "自惊归梦断，不得到天涯。"
  ],
  "enabled": true,
