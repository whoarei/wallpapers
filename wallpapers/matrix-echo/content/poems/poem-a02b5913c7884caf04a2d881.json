{
  "id": "poem-a02b5913c7884caf04a2d881",
  "title": "答刘明府",
  "author": "张籍",
  "dynasty": "唐",
  "verses": [
    "身病多时又客居，满城亲旧尽相疎。",
    "可怜绛县刘明府，犹解频频寄远书。"
  ],
  "enabled": true,
