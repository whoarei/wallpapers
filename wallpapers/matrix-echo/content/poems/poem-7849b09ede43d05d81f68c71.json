{
  "id": "poem-7849b09ede43d05d81f68c71",
  "title": "送沈太博倅滑台",
  "author": "苏颂",
  "dynasty": "宋",
  "verses": [
    "早岁淮阳宰邑初，相君连上荐能书。",
    "新从墨绶诸侯国，便领油泥别驾舆。",
    "东郡提封今辅屏，南都接轸旧乡闾。",
    "优游乐职人应羡，官便家荣两莫如。"
  ],
  "enabled": true,
  "collection": "宋诗选",
