{
  "id": "poem-99b394c23b06f491cc659a64",
  "title": "减字木兰花·珠帘乍见",
  "author": "王之望",
  "dynasty": "宋",
  "verses": [
    "珠帘乍见。",
    "云雨无踪空有怨。",
    "锦字新词。",
    "青鸟衔来恼暗期。",
    "桃溪得路。",
    "直到仙家留客处。",
    "今日东邻。",
    "远忆当年窥宋人。"
  ],
  "enabled": true,
  "collection": "宋词选",
