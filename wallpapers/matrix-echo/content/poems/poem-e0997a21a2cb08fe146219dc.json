{
  "id": "poem-e0997a21a2cb08fe146219dc",
  "title": "江行无题一百首 三",
  "author": "钱珝",
  "dynasty": "唐",
  "verses": [
    "浦烟含夜色，冷日转秋旻。",
    "自有沈碑在，清光不照人。"
  ],
  "enabled": true,
