{
  "id": "poem-7d23195bd772f1c2aa78c467",
  "title": "题麟凤碑",
  "author": "米芾",
  "dynasty": "宋",
  "verses": [
    "非篆非科璞已雕，形容振振与萧萧。",
    "曾因忠厚方周德，坐想𬣙谟览舜韶。",
    "汉德已衰还应孽，鲁邦既弱不为妖。",
    "虚斋自是惊人玩，不胜雄狐逐怒雕。"
  ],
  "enabled": true,
  "collection": "宋诗选",
