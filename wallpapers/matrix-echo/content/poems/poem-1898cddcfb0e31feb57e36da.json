{
  "id": "poem-1898cddcfb0e31feb57e36da",
  "title": "早秋山中作",
  "author": "李山甫",
  "dynasty": "唐",
  "verses": [
    "荣枯无路入千峰，肥遯谁谐此志同。",
    "司寇亦曾遭鲁黜，步兵何事哭途穷。",
    "桧松瘦健滴秋露，户牖虚明生晚风。",
    "山思更清人影绝，陇云飞入草堂中。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
