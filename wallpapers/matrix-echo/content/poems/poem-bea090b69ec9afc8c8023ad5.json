{
  "id": "poem-bea090b69ec9afc8c8023ad5",
  "title": "谢制帅高卿剡四首  其一",
  "author": "陈造",
  "dynasty": "宋",
  "verses": [
    "宰邑非良才，朴拙瞢信己。",
    "曾无补毫发，粗不畏首尾。",
    "倚公造物手，袭璧护玷毁。",
    "世有百谪余，观旁首重稽。"
  ],
  "enabled": true,
  "collection": "宋诗选",
