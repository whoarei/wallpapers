{
  "id": "poem-6f9d1c5a35b4cd44b25791f4",
  "title": "新年作",
  "author": "宋之问",
  "dynasty": "唐",
  "verses": [
    "乡心新岁切，天畔独澘然。",
    "老至居人下，春归在客先。",
    "岭猨同旦暮，江柳共风烟。",
    "已似长沙傅，从今又几年。"
  ],
  "enabled": true,
  "collection": "唐诗三百首",
