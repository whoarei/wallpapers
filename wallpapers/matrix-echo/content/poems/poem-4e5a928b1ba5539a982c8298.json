{
  "id": "poem-4e5a928b1ba5539a982c8298",
  "title": "凉夜",
  "author": "王镃",
  "dynasty": "宋",
  "verses": [
    "断阶露草湿鸣蛩，桐树凉生落叶中。",
    "月上小楼人未睡，曲栏敲遍倚西风。"
  ],
  "enabled": true,
  "collection": "宋诗选",
