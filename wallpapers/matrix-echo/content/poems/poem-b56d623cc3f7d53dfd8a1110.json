{
  "id": "poem-b56d623cc3f7d53dfd8a1110",
  "title": "鹊桥仙·红摧绿锉",
  "author": "毛滂",
  "dynasty": "宋",
  "verses": [
    "红摧绿锉，莺愁蝶怨，满院落花风紧。",
    "醉乡好梦恰瞢腾，又冷落、一成吹醒。",
    "柔红不耐，暗香犹好，觑著翻成不忍。",
    "春心减尽眼长闲，更肯被、游丝牵引。"
  ],
  "enabled": true,
  "collection": "宋词选",
