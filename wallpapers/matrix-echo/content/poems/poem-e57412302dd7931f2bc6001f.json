{
  "id": "poem-e57412302dd7931f2bc6001f",
  "title": "春望",
  "author": "杜甫",
  "dynasty": "唐",
  "verses": [
    "国破山河在，城春草木深。",
    "感时花溅泪，恨别鸟惊心。",
    "烽火连三月，家书抵万金。",
    "白头搔更短，浑欲不胜簪。"
  ],
  "enabled": true,
