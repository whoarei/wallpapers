{
  "id": "poem-7c24d8c3803156e3764490b2",
  "title": "读庄子六绝句  其六",
  "author": "李纲",
  "dynasty": "宋",
  "verses": [
    "诋欺儒墨每云云，刍狗诗书迹已陈。",
    "泯绝是非归道妙，扫除糠粃见天真。"
  ],
  "enabled": true,
