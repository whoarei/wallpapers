{
  "id": "poem-95908584995fa64b7106c8a7",
  "title": "洋州三十景 菡萏亭",
  "author": "鲜于侁",
  "dynasty": "宋",
  "verses": [
    "夏绿分照水，秋香仍满地。",
    "吴宫谁教战，一一尽妖媚。"
  ],
  "enabled": true,
