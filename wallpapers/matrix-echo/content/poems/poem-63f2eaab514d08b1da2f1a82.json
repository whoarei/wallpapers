{
  "id": "poem-63f2eaab514d08b1da2f1a82",
  "title": "品令·败叶霜天晓",
  "author": "黄庭坚",
  "dynasty": "宋",
  "verses": [
    "败叶霜天晓。",
    "渐鼓吹、催行棹。",
    "栽成桃李未开，便解银章归报。",
    "去取麒麟图画，要及年少。",
    "劝公醉倒。",
    "别语怎向醒时道。",
    "楚山千里暮云，正锁离人情抱。",
    "记取江州司马，坐中最老。"
  ],
  "enabled": true,
  "collection": "宋词选",
