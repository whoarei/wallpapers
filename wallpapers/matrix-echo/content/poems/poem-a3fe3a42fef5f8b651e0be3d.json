{
  "id": "poem-a3fe3a42fef5f8b651e0be3d",
  "title": "武陵春·今岁重阳经闰早",
  "author": "曹勋",
  "dynasty": "宋",
  "verses": [
    "今岁重阳经闰早，金蕊粲繁枝。",
    "玉殿珠楼步辇随。",
    "高兴在东篱。",
    "且泛金英同潋滟，休与傲霜期。",
    "只恐秋香一夜衰。",
    "须插满头归。"
  ],
  "enabled": true,
  "collection": "宋词选",
