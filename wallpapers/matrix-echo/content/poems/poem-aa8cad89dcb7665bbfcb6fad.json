{
  "id": "poem-aa8cad89dcb7665bbfcb6fad",
  "title": "点绛唇·咏风兰",
  "author": "纳兰性德",
  "dynasty": "清",
  "verses": [
    "别样幽芬，更无浓艳催开处。",
    "凌波欲去，且为东风住。",
    "忒煞萧疏，争奈秋如许。",
    "还留取，冷香半缕，第一湘江雨。"
  ],
  "enabled": true,
  "collection": "纳兰词",
