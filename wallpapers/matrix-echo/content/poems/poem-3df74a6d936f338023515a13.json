{
  "id": "poem-3df74a6d936f338023515a13",
  "title": "过马当",
  "author": "徐凝",
  "dynasty": "唐",
  "verses": [
    "风波隐隐石苍苍，送客灵鸦拂去樯。",
    "三月尽头云叶秀，小姑新著好衣裳。"
  ],
  "enabled": true,
