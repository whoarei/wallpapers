{
  "id": "poem-580612a59baccaf882b9b20a",
  "title": "颂古三十一首  其二",
  "author": "释安永",
  "dynasty": "宋",
  "verses": [
    "不因一事，不长一智。",
    "不曾杀生，了无忌讳。",
    "传言送语当风流，拈得口兮失却鼻。"
  ],
  "enabled": true,
  "collection": "宋诗选",
