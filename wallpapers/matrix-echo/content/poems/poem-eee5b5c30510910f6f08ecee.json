{
  "id": "poem-eee5b5c30510910f6f08ecee",
  "title": "与刘三礼陈孝廉言志",
  "author": "李咸用",
  "dynasty": "唐",
  "verses": [
    "真宰无私造化均，年年分散月中春。",
    "皆期早蹑青云路，谁肯长为白社人。",
    "宋国高风休敛翼，圣朝公道易酬身。",
    "大须审固穿杨箭，莫遣参差鬓雪新。"
  ],
  "enabled": true,
