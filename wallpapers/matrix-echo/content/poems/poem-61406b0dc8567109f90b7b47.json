{
  "id": "poem-61406b0dc8567109f90b7b47",
  "title": "题义公禅房",
  "author": "孟浩然",
  "dynasty": "唐",
  "verses": [
    "义公习禅寂，结宇依空林。",
    "户外一峰秀，阶前众壑深。",
    "夕阳连雨足，空翠落庭阴。",
    "看取莲花净，方知不染心。"
  ],
  "enabled": true,
  "collection": "千家诗",
  "tags": [],
