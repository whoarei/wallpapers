{
  "id": "poem-34e65f3e1ee66205aa7e780c",
  "title": "巫山一段云·古庙依青嶂",
  "author": "李珣",
  "dynasty": "五代",
  "verses": [
    "古庙依青嶂，行宫枕碧流。",
    "水声山色锁妆楼，往事思悠悠。",
    "云雨朝还暮，烟花春复秋。",
    "啼猿何必近孤舟，行客自多愁。"
  ],
  "enabled": true,
  "collection": "花间集",
