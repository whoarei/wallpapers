{
  "id": "poem-de73ce3aaff0716244baa330",
  "title": "先寄左军语道",
  "author": "刘跂",
  "dynasty": "宋",
  "verses": [
    "已喜仲容连骑去，更思小陆度山来。",
    "赋槐白士愁颜甚，唤取溪傍一笑开。"
  ],
  "enabled": true,
