{
  "id": "poem-1b3902984e7905a622d00361",
  "title": "太白江油尉厅诗",
  "author": "米芾",
  "dynasty": "宋",
  "verses": [
    "岚光深院里，傍砌水泠泠。",
    "野燕巢官舍，溪云入古厅。",
    "日斜孤吏过，帘卷乱峰青。",
    "五色神仙尉，焚香读道经。"
  ],
  "enabled": true,
  "collection": "宋诗选",
