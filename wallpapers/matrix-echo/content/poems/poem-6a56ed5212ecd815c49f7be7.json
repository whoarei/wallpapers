{
  "id": "poem-6a56ed5212ecd815c49f7be7",
  "title": "毘陵东山",
  "author": "李绅",
  "dynasty": "唐",
  "verses": [
    "昔人别馆淹留处，卜筑东山学谢家。",
    "业桂半空摧枳棘，曲池平尽隔烟霞。",
    "重开渔浦连天月，更种春园满地花。",
    "依旧秋风还寂莫，数行衰柳宿啼鸦。"
  ],
  "enabled": true,
