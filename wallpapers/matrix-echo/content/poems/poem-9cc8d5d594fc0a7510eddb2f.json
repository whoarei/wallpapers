{
  "id": "poem-9cc8d5d594fc0a7510eddb2f",
  "title": "克己复礼",
  "author": "张载",
  "dynasty": "宋",
  "verses": [
    "克己工夫未肯加，吝骄封闭缩如蜗。",
    "试于中夜深思省，剖破藩篱即大家。"
  ],
  "enabled": true,
  "collection": "宋诗选",
