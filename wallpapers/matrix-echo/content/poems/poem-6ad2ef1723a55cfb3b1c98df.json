{
  "id": "poem-6ad2ef1723a55cfb3b1c98df",
  "title": "得信酬回",
  "author": "佚名",
  "dynasty": "唐",
  "verses": [
    "人回忽得信，具委书中情。",
    "覊思顿虽豁，忆君心转盈。",
    "自怜飘泊者，邂逅闭荒城。",
    "欲识肝肠断，更深听叫声。"
  ],
  "enabled": true,
