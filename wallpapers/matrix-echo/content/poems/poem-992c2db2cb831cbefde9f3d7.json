{
  "id": "poem-992c2db2cb831cbefde9f3d7",
  "title": "送韦判官得雨中山",
  "author": "卢纶",
  "dynasty": "唐",
  "verses": [
    "前峰后岭碧蒙蒙，草拥惊泉树带风。",
    "人语马嘶听不得，更堪长路在云中。"
  ],
  "enabled": true,
