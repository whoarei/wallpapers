{
  "id": "poem-b51f62f61c166785bdd105f0",
  "title": "喜见外弟又言别",
  "author": "李益",
  "dynasty": "唐",
  "verses": [
    "十年离乱后，长大一相逢。",
    "问姓惊初见，称名忆旧容。",
    "别来沧海事，语罢暮天钟。",
    "明日巴陵道，秋山又几重。"
  ],
  "enabled": true,
  "collection": "唐诗三百首",
