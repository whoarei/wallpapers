{
  "id": "poem-31d4136111fe6950626a47fc",
  "title": "次韵程公辟暮春",
  "author": "苏颂",
  "dynasty": "宋",
  "verses": [
    "日日寻春春欲还，园林游兴未应阑。",
    "间关鶑啭冲牙韵，烂漫花开历绿团。",
    "须信马蹄随处健，肯教金盏暂时干。",
    "休惊节物频更换，适意欢娱定一般。"
  ],
  "enabled": true,
  "collection": "宋诗选",
