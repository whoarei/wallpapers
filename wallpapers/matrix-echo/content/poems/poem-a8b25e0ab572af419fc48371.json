{
  "id": "poem-a8b25e0ab572af419fc48371",
  "title": "歌者十二首 一",
  "author": "司空图",
  "dynasty": "唐",
  "verses": [
    "追逐翻嫌傍管弦，金钗击节自当筵。",
    "风霜一夜燕鸿断，唱作江南袚禊天。"
  ],
  "enabled": true,
