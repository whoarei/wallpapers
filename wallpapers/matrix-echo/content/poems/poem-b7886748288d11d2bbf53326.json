{
  "id": "poem-b7886748288d11d2bbf53326",
  "title": "吊元鲁山 十",
  "author": "孟郊",
  "dynasty": "唐",
  "verses": [
    "遗婴尽雏乳，何况骨肉枝。",
    "心肠结苦诚，胸臆垂甘滋。",
    "事已出古表，谁言独今奇。",
    "贤人母万物，岂弟流前诗。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
