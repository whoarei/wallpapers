{
  "id": "poem-cd484e7464d5894da1ad9101",
  "title": "送灵云和尚颂（题拟）",
  "author": "慧救",
  "dynasty": "唐",
  "verses": [
    "谛当恒然直古今，未彻见闻实甚深。",
    "现现运转三十载，春尽萎花未君心。",
    "（《祖堂集》卷十九。",
    "）。"
  ],
