{
  "id": "poem-4e4c55546bfa7e735dcb7e53",
  "title": "奉荅燕公",
  "author": "赵冬曦",
  "dynasty": "唐",
  "verses": [
    "语别意凄凄，零陵湘水西。",
    "佳人金谷返，爱子洞庭迷。",
    "旧馆逢花发，他山值鸟啼。",
    "江天千里望，谁见绿苹齐。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
  "tags": [
    "洞庭湖"
  ],
