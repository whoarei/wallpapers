{
  "id": "poem-7aea12252e2f9bdb3285ae90",
  "title": "送淡公 九",
  "author": "孟郊",
  "dynasty": "唐",
  "verses": [
    "报恩兼报德，寺与山争鲜。",
    "橙橘金盖槛，竹蕉绿凝禅。",
    "经章音韵细，风磬清泠翩。",
    "离肠绕师足，旧忆随路延。",
    "不知几千尺，至死方绵绵。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
