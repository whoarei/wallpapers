{
  "id": "poem-06d1aad9933463cb06eba9d4",
  "title": "听筝",
  "author": "李端",
  "dynasty": "唐",
  "verses": [
    "鸣筝金粟柱，素手玉房前。",
    "欲得周郎顾，时时误拂弦。"
  ],
  "enabled": true,
