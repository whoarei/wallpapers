{
  "id": "poem-af8a86fa0a39d27de5430add",
  "title": "依韵赠南安方处士五首 二",
  "author": "徐夤",
  "dynasty": "唐",
  "verses": [
    "休把羸蹄蹋霜雪，书成何处献君王。",
    "嵩山好与浮丘约，三十六峰云外乡。"
  ],
  "enabled": true,
