{
  "id": "poem-a1c0d485c09d444437ec40ba",
  "title": "清平乐·花边柳际",
  "author": "谢逸",
  "dynasty": "宋",
  "verses": [
    "花边柳际。",
    "已渐知春意。",
    "归信不知何日是。",
    "旧恨欲拚无计。",
    "故人零落西东。",
    "题诗待倩归鸿。",
    "惟有多情芳草，年年处处相逢。"
  ],
  "enabled": true,
  "collection": "宋词选",
