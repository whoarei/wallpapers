{
  "id": "poem-fa6441a2c2f531a617e48f9f",
  "title": "拙斋",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "大巧曾闻窃得灵，主司关籥镇随身。",
    "巧还有尽无如拙，却笑天孙未识真。"
  ],
  "enabled": true,
