{
  "id": "poem-803f1c5202b4cbe7fc318636",
  "title": "恋情深·玉殿春浓花烂熳",
  "author": "毛文锡",
  "dynasty": "五代",
  "verses": [
    "玉殿春浓花烂熳，族神仙伴。",
    "罗裙窣地缕黄金，奏清音。",
    "酒阑歌罢两沉沉，一笑动君心。",
    "永作鸳鸯伴，恋情深。"
  ],
  "enabled": true,
  "collection": "花间集",
