{
  "id": "poem-96f80b3cf3eb9786098dc16b",
  "title": "保真院",
  "author": "陈岩",
  "dynasty": "宋",
  "verses": [
    "野寺荒山涧水滨，古藤翠筿自摇春。",
    "僧闲晏坐无人到，内保禅心一味真。"
  ],
  "enabled": true,
