{
  "id": "poem-a05920e9ec8aecb56ba97e80",
  "title": "永明山居诗（六十九首） 二十八",
  "author": "延寿",
  "dynasty": "唐",
  "verses": [
    "急景韶颜不可追，岂堪回首暂思之。",
    "浮云已断平生望，高节须存往日期。",
    "庭树任猿偷熟果，崖松停鹤惜高枝。"
  ],
  "enabled": true,
