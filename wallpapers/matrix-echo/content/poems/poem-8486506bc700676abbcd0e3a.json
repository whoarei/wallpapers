{
  "id": "poem-8486506bc700676abbcd0e3a",
  "title": "夜宿浙江",
  "author": "孙逖",
  "dynasty": "唐",
  "verses": [
    "扁舟夜入江潭泊，露白风高气萧索。",
    "富春渚上潮未还，天姥岑边月初落。",
    "烟水茫茫多苦辛，更闻江上越人吟。",
    "洛阳城阙何时见，西北浮云朝暝深。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
