{
  "id": "poem-66bb49215bfef7436e64b720",
  "title": "瓶梅",
  "author": "宋伯仁",
  "dynasty": "宋",
  "verses": [
    "南枝斜插古军持，瘦影参差落砚池。",
    "莫道人家窗户暖，等闲忘却陇头时。"
  ],
  "enabled": true,
