{
  "id": "poem-6b37d99b93978f95164f4eb4",
  "title": "闻瀑布冰折",
  "author": "马戴",
  "dynasty": "唐",
  "verses": [
    "万仞冰峭折，寒声投白云。",
    "光摇山月堕，我向石床闻。"
  ],
  "enabled": true,
