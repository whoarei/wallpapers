{
  "id": "poem-2148dd1ebbf0ff147108d563",
  "title": "即事",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "竹扉半掩不须敲，掠面融风著柳梢。",
    "燕子不知春寂寞，自衔泥补去年巢。"
  ],
  "enabled": true,
  "collection": "宋诗选",
