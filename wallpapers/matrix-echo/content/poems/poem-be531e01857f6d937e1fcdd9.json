{
  "id": "poem-be531e01857f6d937e1fcdd9",
  "title": "登兖州城楼",
  "author": "杜甫",
  "dynasty": "唐",
  "verses": [
    "东郡趋庭日，南楼纵目初。",
    "浮云连海岱，平野入青徐。",
    "孤嶂秦碑在，荒城鲁殿余。",
    "从来多古意，临眺独踌躇。"
  ],
  "enabled": true,
  "collection": "千家诗",
  "tags": [],
