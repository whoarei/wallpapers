{
  "id": "poem-266b4f6489c5a757cfbf4674",
  "title": "秋入关",
  "author": "贾驰",
  "dynasty": "唐",
  "verses": [
    "河上微风来，关头树初湿。",
    "今朝关城吏，又见孤客入。",
    "上国谁与期，西来徒自急。"
  ],
  "enabled": true,
