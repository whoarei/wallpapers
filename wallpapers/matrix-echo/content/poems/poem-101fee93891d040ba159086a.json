{
  "id": "poem-101fee93891d040ba159086a",
  "title": "生查子·繁灯夺霁华",
  "author": "刘克庄",
  "dynasty": "宋",
  "verses": [
    "繁灯夺霁华。",
    "戏鼓侵明发。",
    "物色旧时同，情味中年别。",
    "浅画镜中眉，深拜楼西月。",
    "人散市声收，渐入愁时节。"
  ],
  "enabled": true,
