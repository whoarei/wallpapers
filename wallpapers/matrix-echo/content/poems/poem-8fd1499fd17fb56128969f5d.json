{
  "id": "poem-8fd1499fd17fb56128969f5d",
  "title": "古苑杏花",
  "author": "张籍",
  "dynasty": "唐",
  "verses": [
    "废苑杏花在，行人愁到时。",
    "独开新堑底，半露旧烧枝。",
    "晚色连荒辙，低阴覆折碑。",
    "茫茫古陵下，春尽又谁知。"
  ],
  "enabled": true,
