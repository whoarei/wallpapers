{
  "id": "poem-8c8359be701142ea6b542f52",
  "title": "田家春望",
  "author": "高适",
  "dynasty": "唐",
  "verses": [
    "出门何所见，春色满平芜。",
    "可叹无知己，高阳一酒徒。"
  ],
  "enabled": true,
