{
  "id": "poem-abc8355959dfa9751263f805",
  "title": "晚眺",
  "author": "孟宾于",
  "dynasty": "宋",
  "verses": [
    "倚杖残秋里，吟中四顾频。",
    "西风天际雁，落日渡头人。",
    "草色衰平野，山阴歛暮尘。",
    "却寻苔径去，明月照村邻。"
  ],
  "enabled": true,
  "collection": "宋诗选",
