{
  "id": "poem-baad4c6e635dba0cc38016f7",
  "title": "登高",
  "author": "杜甫",
  "dynasty": "唐",
  "verses": [
    "风急天高猨啸哀，渚清沙白鸟飞回。",
    "无边落木萧萧下，不尽长江衮衮来。",
    "万里悲秋常作客，百年多病独登台。",
    "艰难苦恨繁霜鬓，潦倒新停浊酒桮。"
  ],
  "enabled": true,
  "collection": "唐诗三百首",
  "tags": [
