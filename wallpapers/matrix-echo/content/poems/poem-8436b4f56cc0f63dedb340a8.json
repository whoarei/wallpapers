{
  "id": "poem-8436b4f56cc0f63dedb340a8",
  "title": "韩文公见大颠",
  "author": "释了惠",
  "dynasty": "宋",
  "verses": [
    "事繁求省要，省要事频繁。",
    "纵得三平老，文公只姓韩。"
  ],
  "enabled": true,
