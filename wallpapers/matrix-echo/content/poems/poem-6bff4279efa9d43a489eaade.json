{
  "id": "poem-6bff4279efa9d43a489eaade",
  "title": "题冠盖里",
  "author": "李德裕",
  "dynasty": "唐",
  "verses": [
    "偶来冠盖里，媿是旧三公。",
    "自喜无兵术，轻裘上閟宫。"
  ],
  "enabled": true,
