{
  "id": "poem-4d8dc17353aca580999fdf68",
  "title": "斜谷道",
  "author": "于邺",
  "dynasty": "唐",
  "verses": [
    "乱峰连叠嶂，千里绿峨峨。",
    "蜀国路如此，游人车亦过。",
    "远烟当驿歛，骤雨逐风多。",
    "独忆紫芝叟，临风歌旧歌。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
