{
  "id": "poem-910ff80e9af95987d0a93a8b",
  "title": "旧国里",
  "author": "卿云",
  "dynasty": "唐",
  "verses": [
    "旧居梨岭下，风景近炎方。",
    "地暖生春早，家贫觉岁长。",
    "石房云过湿，杉径雨余香。",
    "日夕竟无事，诗书聊自强。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
