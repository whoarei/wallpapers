{
  "id": "poem-1f4afc37f4bcab8c3243a9e8",
  "title": "为李魏公赋谢汧公",
  "author": "司空曙",
  "dynasty": "唐",
  "verses": [
    "白雪高吟际，青霄远望中。",
    "谁言路遐旷，宫征暗相通。"
  ],
