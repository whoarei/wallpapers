{
  "id": "poem-d65165e7aa0d7fc83479b995",
  "title": "醉桃源・阮郎归·冬衣初染远山青",
  "author": "周邦彦",
  "dynasty": "宋",
  "verses": [
    "冬衣初染远山青。",
    "双丝云雁绫。",
    "夜寒袖湿欲成冰。",
    "都缘珠泪零。",
    "情黯黯，闷腾腾。",
    "身如秋后蝇。",
    "若教随马逐郎行。",
    "不辞多少程。"
  ],
  "enabled": true,
  "collection": "宋词选",
