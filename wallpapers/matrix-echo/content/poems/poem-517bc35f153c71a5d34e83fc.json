{
  "id": "poem-517bc35f153c71a5d34e83fc",
  "title": "捕守宫",
  "author": "赵文",
  "dynasty": "宋",
  "verses": [
    "向来上阳人，尽属沙叱利。",
    "长门不用守，蜥蜴草间戏。"
  ],
  "enabled": true,
