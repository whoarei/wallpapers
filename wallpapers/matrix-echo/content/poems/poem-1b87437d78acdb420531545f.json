{
  "id": "poem-1b87437d78acdb420531545f",
  "title": "三台令·不寐倦长更",
  "author": "李煜",
  "dynasty": "五代",
  "verses": [
    "不寐倦长更，披衣出户行。",
    "月寒秋竹冷，风切夜窗声。"
  ],
  "enabled": true,
  "collection": "南唐二主词",
