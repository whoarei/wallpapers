{
  "id": "poem-a00b704c53d9091020e20c00",
  "title": "白苎歌",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "经纱才上机，梭飞玉攕攕。",
    "怕君寻春迟，落机宽裁衫。",
    "春心乱如蓬，冉冉随春霏。",
    "芳迳晓沾露，软尘红上衣。",
    "归来恨尘污，湔衣浣纱处。",
    "难湔芳露痕，易湔衣上尘。"
  ],
  "enabled": true,
  "collection": "宋诗选",
