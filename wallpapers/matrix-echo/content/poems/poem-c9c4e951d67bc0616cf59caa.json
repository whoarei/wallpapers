{
  "id": "poem-c9c4e951d67bc0616cf59caa",
  "title": "送安法师",
  "author": "张籍",
  "dynasty": "唐",
  "verses": [
    "出郭见落日，别君临古津。",
    "远程无野寺，宿处问何人。",
    "原色不分路，锡声遥隔尘。",
    "山阴到家节，犹及蕙兰春。"
  ],
  "enabled": true,
