{
  "id": "poem-490409f38d7b2277e3c66bcb",
  "title": "题城南书院三十四咏  其七",
  "author": "张栻",
  "dynasty": "宋",
  "verses": [
    "山色顿清秋欲半，湖光更净日平西。",
    "凉风猎猎低荷盖，归翼翩翩度柳堤。"
  ],
  "enabled": true,
  "collection": "宋诗选",
