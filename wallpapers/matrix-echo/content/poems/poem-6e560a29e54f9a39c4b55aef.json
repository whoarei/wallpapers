{
  "id": "poem-6e560a29e54f9a39c4b55aef",
  "title": "春秋战国门 庄辛",
  "author": "周昙",
  "dynasty": "唐",
  "verses": [
    "庄辛正谏谓妖词，兵及鄢陵始悔思。",
    "见兔必能知顾犬，亡羊补栈未为迟。"
  ],
