{
  "id": "poem-c6fbeb5c062cec68aa01a602",
  "title": "羽林骑闺人",
  "author": "王维",
  "dynasty": "唐",
  "verses": [
    "秋月临高城，城中管弦思。",
    "离人堂上愁，稚子阶前戏。",
    "出门复暎户，望望青丝骑。",
    "行人过欲尽，狂夫终不至。",
    "左右寂无言，相看共垂泪。"
  ],
  "enabled": true,
