{
  "id": "poem-e2f22b6eb0ebab1e94a509fc",
  "title": "邯郸驿楼作",
  "author": "马戴",
  "dynasty": "唐",
  "verses": [
    "芜没丛台久，清漳废御沟。",
    "蝉鸣河外树，人在驿西楼。",
    "云烧天中赤，山当日落秋。",
    "近郊经战后，处处骨成丘。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
