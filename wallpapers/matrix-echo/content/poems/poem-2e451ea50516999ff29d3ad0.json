{
  "id": "poem-2e451ea50516999ff29d3ad0",
  "title": "柳杨送客",
  "author": "李益",
  "dynasty": "唐",
  "verses": [
    "青枫江畔白苹洲，楚客伤离不待秋。",
    "君见隋朝更何事，柳杨南渡水悠悠。"
  ],
  "enabled": true,
