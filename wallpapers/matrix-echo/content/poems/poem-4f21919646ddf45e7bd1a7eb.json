{
  "id": "poem-4f21919646ddf45e7bd1a7eb",
  "title": "颂古七十六首  其九",
  "author": "释士珪",
  "dynasty": "宋",
  "verses": [
    "海水翻空衮底流，鱼龙虾蟹信沉浮。",
    "可怜金色头陀子，直至如今笑未休。"
  ],
  "enabled": true,
