{
  "id": "poem-b35401c72ea6953b8b2e3efc",
  "title": "春日早朝",
  "author": "张籍",
  "dynasty": "唐",
  "verses": [
    "晓陌春寒朝骑来，瑞云深处见楼台。",
    "夜来新雨沙堤湿，东上合门应未开。"
  ],
