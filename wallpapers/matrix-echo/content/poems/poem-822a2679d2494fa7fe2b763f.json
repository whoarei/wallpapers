{
  "id": "poem-822a2679d2494fa7fe2b763f",
  "title": "回波辞",
  "author": "李景伯",
  "dynasty": "唐",
  "verses": [
    "回波尔时酒巵，微臣职在箴规。",
    "侍䜩既过三爵，喧哗窃恐非仪。"
  ],
  "enabled": true,
