{
  "id": "poem-90a8db87a78bce5937d40499",
  "title": "三衢道中",
  "author": "曾几",
  "dynasty": "宋",
  "verses": [
    "梅子黄时日日晴，小溪泛尽却山行。",
    "绿阴不减来时路，添得黄鹂四五声。"
  ],
  "enabled": true,
  "collection": "千家诗",
