{
  "id": "poem-c7c167268e9915e2708d47d1",
  "title": "夕次盱眙县",
  "author": "韦应物",
  "dynasty": "唐",
  "verses": [
    "落帆逗淮镇，停舫临孤驿。",
    "浩浩风起波，冥冥日沈夕。",
    "人归山郭暗，雁下芦洲白。",
    "独夜忆秦关，听钟未眠客。"
  ],
  "enabled": true,
