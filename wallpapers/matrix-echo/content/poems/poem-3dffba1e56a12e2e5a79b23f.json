{
  "id": "poem-3dffba1e56a12e2e5a79b23f",
  "title": "宿江店",
  "author": "张籍",
  "dynasty": "唐",
  "verses": [
    "野店临西浦，门前有橘花。",
    "停灯待贾客，卖酒与渔家。",
    "夜静江水白，路回山月斜。",
    "闲寻泊船处，潮落见平沙。"
  ],
  "enabled": true,
