{
  "id": "poem-6ee94761bfa3bcfca01f7ef5",
  "title": "京中即事",
  "author": "王镃",
  "dynasty": "宋",
  "verses": [
    "笙歌无处不繁华，春在鶑鶑燕燕家。",
    "谁看少年骑马过，娇红微露隔帘花。"
  ],
  "enabled": true,
  "collection": "宋诗选",
