{
  "id": "poem-723701382b317f0d0a926fcd",
  "title": "春晚闲居寄陈嵩伯",
  "author": "贯休",
  "dynasty": "唐",
  "verses": [
    "春霖闭门久，春色聚庭木。",
    "一梦辞旧山，四邻有新哭。",
    "菰蒲生白水，风篁擢纤玉。",
    "为忆湖上翁，花时独冥目。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
