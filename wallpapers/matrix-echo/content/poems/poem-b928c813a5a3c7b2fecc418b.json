{
  "id": "poem-b928c813a5a3c7b2fecc418b",
  "title": "颂古十九首  其二",
  "author": "释法全",
  "dynasty": "宋",
  "verses": [
    "布鼓当轩为击来，卧龙惊起出岩隈。",
    "千峰秀色凭谁写，一带澄江古镜开。"
  ],
  "enabled": true,
