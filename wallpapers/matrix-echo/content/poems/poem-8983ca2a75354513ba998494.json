{
  "id": "poem-8983ca2a75354513ba998494",
  "title": "宝陀岩",
  "author": "陈岩",
  "dynasty": "宋",
  "verses": [
    "阴磴层崖洞室宽，奇花异草几多般。",
    "彩云不动金光起，便作金莲法界看。"
  ],
  "enabled": true,
