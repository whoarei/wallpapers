{
  "id": "poem-38082f85e6a28225eb0419d9",
  "title": "月夕有怀",
  "author": "崔道融",
  "dynasty": "唐",
  "verses": [
    "圆光照一海，远客在孤舟。",
    "相忆无期见，中宵独上楼。"
  ],
  "enabled": true,
