{
  "id": "poem-c1197a16bfbf3ff665745635",
  "title": "清平乐·留春不住",
  "author": "王安石",
  "dynasty": "宋",
  "verses": [
    "留春不住。",
    "费尽莺儿语。",
    "满地残红宫锦污。",
    "昨夜南园风雨。",
    "小怜初上琵琶。",
    "晓来思绕天涯。",
    "不肯画堂朱户，春风自在杨花。"
  ],
  "enabled": true,
