{
  "id": "poem-9c223ef8289b474c993ee2b6",
  "title": "山居四感 吟蛩",
  "author": "李纲",
  "dynasty": "宋",
  "verses": [
    "月露凄清湿草根，寒蛩偏向夜深闻。",
    "随时感气成悲怨，不是来销逐客魂。"
  ],
  "enabled": true,
