{
  "id": "poem-0fdc09e6b5f89e2b61dd64c9",
  "title": "春夜闻笛",
  "author": "李益",
  "dynasty": "唐",
  "verses": [
    "寒山吹笛唤春归，迁客相看泪满衣。",
    "洞庭一夜无穷雁，不待天明尽北飞。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
  "tags": [
    "洞庭湖"
  ],
