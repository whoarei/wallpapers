{
  "id": "poem-054efc5d83bd8a853decc0c4",
  "title": "猿",
  "author": "曹松",
  "dynasty": "唐",
  "verses": [
    "曾宿三巴路，今来不愿听。",
    "云根啼片白，峰顶掷尖青。",
    "护果憎禽啄，栖霜觑叶零。",
    "唯应卧岚客，怜尔傍嵒扃。"
  ],
  "enabled": true,
