{
  "id": "poem-52c52850e924f7f2442c454f",
  "title": "盛京",
  "author": "纳兰性德",
  "dynasty": "清",
  "verses": [
    "拔地蛟龙宅，当关虎豹城。",
    "山连长白秀，江入混同清。",
    "庙社灵风肃，豪强右族更。",
    "明明开创业，休拟作陪京。"
  ],
  "enabled": true,
  "collection": "纳兰词",
  "tags": [],
