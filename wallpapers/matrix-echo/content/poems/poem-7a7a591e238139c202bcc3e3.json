{
  "id": "poem-7a7a591e238139c202bcc3e3",
  "title": "赤霄行",
  "author": "杜甫",
  "dynasty": "唐",
  "verses": [
    "孔雀未知牛有角，渴饮寒泉逢觝触。",
    "赤霄悬圃须往来，翠尾金花不辞辱。",
    "江中淘河吓飞燕，衔泥却落羞华屋。",
    "皇孙犹曾莲勺困，卫庄见贬伤其足。",
    "老翁慎莫怪少年，葛亮贵和书有篇。",
    "丈夫垂名动万年，记忆细故非高贤。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
