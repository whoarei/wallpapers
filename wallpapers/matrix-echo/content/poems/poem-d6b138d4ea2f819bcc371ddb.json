{
  "id": "poem-d6b138d4ea2f819bcc371ddb",
  "title": "游春",
  "author": "邢巨",
  "dynasty": "唐",
  "verses": [
    "海岳三峰古，春皇二月寒。",
    "绿潭渔子钓，红树美人攀。",
    "弱蔓环沙屿，飞花点石关。",
    "谿山游未厌，琴酌弄晴湾。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
