{
  "id": "poem-008fc4d3474689a64c9ad2a9",
  "title": "惜别",
  "author": "李咸用",
  "dynasty": "唐",
  "verses": [
    "细雨妆行色，霏霏入户来。",
    "须知相识喜，却是别愁媒。",
    "白刃方盈国，黄金不上台。"
  ],
  "enabled": true,
