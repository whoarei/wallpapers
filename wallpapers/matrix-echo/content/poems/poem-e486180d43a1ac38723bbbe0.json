{
  "id": "poem-e486180d43a1ac38723bbbe0",
  "title": "春日",
  "author": "李咸用",
  "dynasty": "唐",
  "verses": [
    "浩荡东风里，裴回无所亲。",
    "危城三面水，古树一边春。",
    "衰世难修道，花时不称贫。"
  ],
  "enabled": true,
