{
  "id": "poem-30dceceea75dd39f6b92baab",
  "title": "积雨",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "积雨低田欲再车，经旬湿稼糵寒沙。",
    "绝怜百念如焦谷，大浸稽天不复芽。"
  ],
  "enabled": true,
  "collection": "宋诗选",
