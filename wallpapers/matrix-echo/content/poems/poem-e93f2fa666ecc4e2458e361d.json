{
  "id": "poem-e93f2fa666ecc4e2458e361d",
  "title": "和明道人宿山寺",
  "author": "徐铉",
  "dynasty": "宋",
  "verses": [
    "闻道经行处，山前与水阳。",
    "磬声深小院，灯影迥高房。",
    "落宿依楼角，归云拥殿廊。",
    "羡师闲未得，早起逐班行。"
  ],
  "enabled": true,
  "collection": "宋诗选",
