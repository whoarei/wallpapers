{
  "id": "poem-0f26fe3551177acf5c961359",
  "title": "虢国夫人",
  "author": "杜甫",
  "dynasty": "唐",
  "verses": [
    "虢国夫人承主恩，平明上马入宫门。",
    "却嫌脂粉涴颜色，澹埽蛾眉朝至尊。"
  ],
  "enabled": true,
