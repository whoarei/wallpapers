{
  "id": "poem-b7237d7171907560fcf7519e",
  "title": "山店",
  "author": "卢纶",
  "dynasty": "唐",
  "verses": [
    "登登山路行时尽，决决溪泉到处闻。",
    "风动叶声山犬吠，一家松火隔秋云。"
  ],
  "enabled": true,
