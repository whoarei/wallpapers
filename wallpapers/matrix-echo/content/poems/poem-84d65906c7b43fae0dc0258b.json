{
  "id": "poem-84d65906c7b43fae0dc0258b",
  "title": "好事近·飞盖满南园",
  "author": "毛并",
  "dynasty": "宋",
  "verses": [
    "飞盖满南园，想见八仙遥集。",
    "几树海棠开遍，正新晴天色。",
    "休辞一醉任扶还，衣上酒痕湿。",
    "便恐岁华催去，听秋虫相泣。"
  ],
  "enabled": true,
  "collection": "宋词选",
