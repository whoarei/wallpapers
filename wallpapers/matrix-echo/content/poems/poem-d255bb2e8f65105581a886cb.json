{
  "id": "poem-d255bb2e8f65105581a886cb",
  "title": "送友人",
  "author": "李白",
  "dynasty": "唐",
  "verses": [
    "青山横北郭，白水遶东城。",
    "此地一为别，孤蓬万里征。",
    "浮云游子意，落日故人情。",
    "挥手自兹去，萧萧班马鸣。"
  ],
  "enabled": true,
