{
  "id": "poem-f9f44e9480a7f91336e43e2d",
  "title": "颂古三十一首  其二○",
  "author": "释原妙",
  "dynasty": "宋",
  "verses": [
    "饥火炎炎烧断肠，亲逢王膳不能尝。",
    "可怜并逐溪流去，百亿沧溟透底香。"
  ],
  "enabled": true,
  "collection": "宋诗选",
