{
  "id": "poem-562e7044a502c32bda575d2c",
  "title": "春秋战国门 再吟",
  "author": "周昙",
  "dynasty": "唐",
  "verses": [
    "周室衰微不共匡，干戈终日互争强。",
    "诸侯若解尊天子，列国何因次第亡。"
  ],
  "enabled": true,
