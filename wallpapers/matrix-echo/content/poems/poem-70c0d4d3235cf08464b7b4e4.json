{
  "id": "poem-70c0d4d3235cf08464b7b4e4",
  "title": "董监庙",
  "author": "熊孺登",
  "dynasty": "唐",
  "verses": [
    "仁杰淫祠废欲无，枯枫老栎两三株。",
    "神乌惯得商人食，飞趂征帆过蠡湖。"
  ],
  "enabled": true,
