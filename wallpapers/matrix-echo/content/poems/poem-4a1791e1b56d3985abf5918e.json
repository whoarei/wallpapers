{
  "id": "poem-4a1791e1b56d3985abf5918e",
  "title": "小游仙诗九十八首 四十一",
  "author": "曹唐",
  "dynasty": "唐",
  "verses": [
    "酒尽香残夜欲分，青童拜问紫阳君。",
    "月光悄悄笙歌远，马影龙声归五云。"
  ],
  "enabled": true,
