{
  "id": "poem-9242150dc446342a4aa74e3f",
  "title": "游春引三首 二",
  "author": "张碧",
  "dynasty": "唐",
  "verses": [
    "五陵年少轻薄客，蛮锦花多春袖窄。",
    "酌桂鸣金玩物华，星蹄绣毂填香陌。"
  ],
  "enabled": true,
