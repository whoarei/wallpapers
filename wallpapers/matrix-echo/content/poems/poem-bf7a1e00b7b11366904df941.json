{
  "id": "poem-bf7a1e00b7b11366904df941",
  "title": "驾幸三会寺应制",
  "author": "上官昭容",
  "dynasty": "唐",
  "verses": [
    "释子谈经处，轩臣刻字留。",
    "故台遗老识，残简圣皇求。",
    "驻跸怀千古，开襟望九州。",
    "四山缘塞合，二水夹城流。",
    "宸翰陪瞻仰，天杯接献酬。",
    "太平词藻盛，长愿纪鸿休。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
