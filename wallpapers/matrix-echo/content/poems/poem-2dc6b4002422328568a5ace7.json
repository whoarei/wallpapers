{
  "id": "poem-2dc6b4002422328568a5ace7",
  "title": "禁林春直",
  "author": "李昉",
  "dynasty": "宋",
  "verses": [
    "疏帘摇曳日辉辉，直阁深严半掩扉。",
    "一院有花春昼永，八方无事诏书稀。",
    "树头百啭鶑鶑语，梁上新来燕燕飞。",
    "岂合此身居此地，妨贤尸禄自知非。"
  ],
  "enabled": true,
  "collection": "宋诗选",
