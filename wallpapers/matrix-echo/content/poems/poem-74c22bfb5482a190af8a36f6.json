{
  "id": "poem-74c22bfb5482a190af8a36f6",
  "title": "和秉国芙蓉五章  其二",
  "author": "司马光",
  "dynasty": "宋",
  "verses": [
    "北方稀见诚奇物，笔界轻丝指捻红。",
    "楚蜀可怜人不赏，墙根屋角数无穷。"
  ],
  "enabled": true,
