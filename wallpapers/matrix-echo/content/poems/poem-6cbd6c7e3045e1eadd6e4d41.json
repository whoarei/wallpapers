{
  "id": "poem-6cbd6c7e3045e1eadd6e4d41",
  "title": "酬李如山见寄",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "俗棼须尽扫，扫尽又纷华。",
    "喧避蚁争市，静看蜂报衙。",
    "竹梢斑殒箨，苹渚素浮花。",
    "自把闲消遣，从容日又斜。"
  ],
  "enabled": true,
  "collection": "宋诗选",
