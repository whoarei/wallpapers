{
  "id": "poem-0c8b00c199a5c0d51688a9d8",
  "title": "夏日登观农楼和崔使君",
  "author": "皎然",
  "dynasty": "唐",
  "verses": [
    "片雨拂簷楹，烦襟四坐清。",
    "霏微过麦陇，萧散傍莎城。",
    "静爱和花落，幽闻入竹声。",
    "朝观趣无限，高咏寄深情。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
