{
  "id": "poem-51976765d4993012bccbd334",
  "title": "祀风师乐章 迎神",
  "author": "包佶",
  "dynasty": "唐",
  "verses": [
    "太皞御气，句芒肇功。",
    "苍龙青旗，爰候祥风。",
    "律以和应，神以感通。",
    "鼎俎修蚃，时惟礼崇。"
  ],
  "enabled": true,
