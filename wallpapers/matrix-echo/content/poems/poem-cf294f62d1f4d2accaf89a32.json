{
  "id": "poem-cf294f62d1f4d2accaf89a32",
  "title": "伯兄新楼十首  其四",
  "author": "王柏",
  "dynasty": "宋",
  "verses": [
    "野色晴晖展画屏，绿槐古樾两娉婷。",
    "却嫌一带无情竹，只放金华半段青。"
  ],
  "enabled": true,
