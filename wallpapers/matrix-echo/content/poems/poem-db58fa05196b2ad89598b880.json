{
  "id": "poem-db58fa05196b2ad89598b880",
  "title": "却望无锡芙蓉湖 三",
  "author": "李绅",
  "dynasty": "唐",
  "verses": [
    "逐波云影参差远，背日岚光隐见深。",
    "犹似望中连海树，月生湖上是山阴。"
  ],
  "enabled": true,
