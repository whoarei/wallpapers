{
  "id": "poem-f8bc92efb084ee06aeefe229",
  "title": "松石  其一",
  "author": "刘跂",
  "dynasty": "宋",
  "verses": [
    "笔端陶冶不无神，纸面流沙秋后云。",
    "点破沙痕便成水，一溪松石浪沄沄。"
  ],
  "enabled": true,
