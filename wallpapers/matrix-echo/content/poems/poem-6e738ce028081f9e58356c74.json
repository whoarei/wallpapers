{
  "id": "poem-6e738ce028081f9e58356c74",
  "title": "妾薄命",
  "author": "李端",
  "dynasty": "唐",
  "verses": [
    "自从君弃妾，憔悴不羞人。",
    "唯余坏粉泪，未免映衫匀。"
  ],
  "enabled": true,
