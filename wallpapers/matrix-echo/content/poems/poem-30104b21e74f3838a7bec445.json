{
  "id": "poem-30104b21e74f3838a7bec445",
  "title": "四气",
  "author": "雍裕之",
  "dynasty": "唐",
  "verses": [
    "春禽犹竞啭，夏木忽交阴。",
    "稍觉秋山远，俄惊冬霰深。"
  ],
