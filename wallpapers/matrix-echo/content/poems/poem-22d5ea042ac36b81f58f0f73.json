{
  "id": "poem-22d5ea042ac36b81f58f0f73",
  "title": "早行",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "鹎鴂初声戒趣装，强携瘦影度重冈。",
    "畏途政尔吴牛喘，误把残蟾作夕阳。"
  ],
  "enabled": true,
  "collection": "宋诗选",
