{
  "id": "poem-12af7171ba22028e10eb19af",
  "title": "生查子·斜日下平川",
  "author": "赵老",
  "dynasty": "宋",
  "verses": [
    "斜日下平川，楼角销霞缕。",
    "摆尽浊尘缨，画栋萦非雾。",
    "平生许子穷，今到知音处。",
    "约伴玉簪游，好梦从天付。"
  ],
  "enabled": true,
  "collection": "宋词选",
  "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/宋词/ci.song.2000.json#record-283",
