{
  "id": "poem-2a12783d731ef1f82491cc6f",
  "title": "减字木兰花·新诗细览",
  "author": "倪偁",
  "dynasty": "宋",
  "verses": [
    "新诗细览。",
    "满纸骊珠光眩眼。",
    "高论倾湖。",
    "倒峡词源世不如。",
    "园池日胜。",
    "只恨孤鸾犹舞镜。",
    "陶写须诗。",
    "怪得连篇字字奇。"
  ],
  "enabled": true,
  "collection": "宋词选",
