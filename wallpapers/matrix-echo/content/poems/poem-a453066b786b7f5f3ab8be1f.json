{
  "id": "poem-a453066b786b7f5f3ab8be1f",
  "title": "寄昭应王中丞",
  "author": "张籍",
  "dynasty": "唐",
  "verses": [
    "借得街西宅，开门渭水头。",
    "长贫唯要健，渐老不禁愁。",
    "独凭藤书案，空悬竹酒钩。",
    "春风石瓮寺，作意共君游。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
