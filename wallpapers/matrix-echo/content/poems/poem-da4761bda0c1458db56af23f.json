{
  "id": "poem-da4761bda0c1458db56af23f",
  "title": "闻胡邦衡改知泉州复用前韵",
  "author": "王十朋",
  "dynasty": "宋",
  "verses": [
    "上念温陵为择人，知公名节世无隣。",
    "犯颜合在论思地，起废聊为岳牧臣。",
    "缪政居前诮穅秕，刚肠别久转车轮。",
    "天教我辈簪重盍，只恐留中拱帝宸。"
  ],
  "enabled": true,
  "collection": "宋诗选",
