{
  "id": "poem-76417d151610f9d6ea7a10c8",
  "title": "老仙平沙落鴈",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "楚天如纸字横斜，纸阔行疎对落霞。",
    "传得夜来沙上影，不传书信伴梅花。"
  ],
  "enabled": true,
