{
  "id": "poem-2320133251657b3c49489d67",
  "title": "赤壁",
  "author": "杜牧",
  "dynasty": "唐",
  "verses": [
    "折戟沈沙铁未销，自将磨洗认前朝。",
    "东风不与周郎便，铜雀春深鏁二乔。"
  ],
