{
  "id": "poem-f7d4676d3ec59a27dbf3a31e",
  "title": "秋",
  "author": "李山甫",
  "dynasty": "唐",
  "verses": [
    "傍雨衣风冷渐匀，更凭青女事精神。",
    "来时将得几多雁，到处愁他无限人。",
    "能被绿杨深懊恼，谩偎黄菊送殷勤。",
    "邹家不用偏吹律，到底荣枯也自均。"
  ],
  "enabled": true,
