{
  "id": "poem-e559726c8b83a58a46dff3ac",
  "title": "还自会稽歌",
  "author": "李贺",
  "dynasty": "唐",
  "verses": [
    "野粉椒壁黄，湿萤满梁殿。",
    "台城应教人，秋衾梦铜辇。",
    "吴霜点归鬓，身与塘蒲晚。",
    "脉脉辞金鱼，羁臣守迍贱。"
  ],
  "enabled": true,
