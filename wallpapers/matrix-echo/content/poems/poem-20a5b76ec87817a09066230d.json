{
  "id": "poem-20a5b76ec87817a09066230d",
  "title": "同题仙游观",
  "author": "韩翃",
  "dynasty": "唐",
  "verses": [
    "仙台下见五城楼，风物凄凄宿雨收。",
    "山色遥连秦树晚，砧声近报汉宫秋。",
    "疎松影落空坛静，细草香闲小洞幽。",
    "何用别寻方外去，人间亦自有丹丘。"
  ],
  "enabled": true,
