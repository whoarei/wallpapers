{
  "id": "poem-318659b13271e56a185ab1dc",
  "title": "秣陵怀古",
  "author": "纳兰性德",
  "dynasty": "清",
  "verses": [
    "山色江声共寂寥，十三陵树晚萧萧。",
    "中原事业如江左，芳草何须怨六朝。"
  ],
  "enabled": true,
