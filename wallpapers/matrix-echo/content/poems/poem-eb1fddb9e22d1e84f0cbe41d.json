{
  "id": "poem-eb1fddb9e22d1e84f0cbe41d",
  "title": "题诠律师院",
  "author": "张乔",
  "dynasty": "唐",
  "verses": [
    "院凉松雨声，相对有山情。",
    "未许谿边老，犹思岳顶行。",
    "纱灯留火细，石井灌瓶清。",
    "欲问吾师外，何人得此生。"
  ],
  "enabled": true,
