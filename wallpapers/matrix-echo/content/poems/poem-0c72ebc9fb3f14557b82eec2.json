{
  "id": "poem-0c72ebc9fb3f14557b82eec2",
  "title": "六桥春望",
  "author": "王镃",
  "dynasty": "宋",
  "verses": [
    "美人娇醉落花钿，船载笙歌出柳边。",
    "春满六桥调马路，香风飘趁玉丝鞭。"
  ],
  "enabled": true,
  "collection": "宋诗选",
