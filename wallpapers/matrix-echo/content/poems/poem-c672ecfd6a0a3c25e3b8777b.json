{
  "id": "poem-c672ecfd6a0a3c25e3b8777b",
  "title": "春日偶成",
  "author": "程颢",
  "dynasty": "宋",
  "verses": [
    "云淡风轻近午天，傍花随柳过前川。",
    "时人不识余心乐，将谓偷闲学少年。"
  ],
  "enabled": true,
  "collection": "千家诗",
