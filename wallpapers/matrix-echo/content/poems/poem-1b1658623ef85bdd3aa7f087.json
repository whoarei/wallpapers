{
  "id": "poem-1b1658623ef85bdd3aa7f087",
  "title": "送僧二首 二",
  "author": "马戴",
  "dynasty": "唐",
  "verses": [
    "龛中破衲自持行，树下禅床坐一生。",
    "来往白云知岁久，满山猨鸟会经声。"
  ],
  "enabled": true,
