{
  "id": "poem-28d0ccb575b2400aaf6800a4",
  "title": "西江月·名与牡丹联谱",
  "author": "康与之",
  "dynasty": "宋",
  "verses": [
    "名与牡丹联谱，南珍独比江瑶。",
    "闽山入贡冠前朝。",
    "露叶风枝袅袅。",
    "香玉满苞仙液，绉红圆戚鲛绡。",
    "华清宫殿蜀山遥。",
    "一骑红尘失笑。"
  ],
  "enabled": true,
  "collection": "宋词选",
  "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/宋词/ci.song.8000.json#record-289",
