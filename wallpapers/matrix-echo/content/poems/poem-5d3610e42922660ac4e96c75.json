{
  "id": "poem-5d3610e42922660ac4e96c75",
  "title": "柳枝辞十二首  其四",
  "author": "徐铉",
  "dynasty": "宋",
  "verses": [
    "夹岸朱栏柳映楼，绿波平幔带花流。",
    "歌声不出长条密，忽地风回见彩舟。"
  ],
  "enabled": true,
