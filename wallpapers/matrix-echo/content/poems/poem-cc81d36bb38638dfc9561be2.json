{
  "id": "poem-cc81d36bb38638dfc9561be2",
  "title": "酒泉子·寂寞青楼",
  "author": "李珣",
  "dynasty": "五代",
  "verses": [
    "寂寞青楼，风触绣帘珠碎撼。",
    "月朦胧，花暗淡，锁春愁。",
    "寻想往事依稀梦，泪脸桃红色重。",
    "鬓欹蝉。钗坠凤，思悠悠。"
  ],
  "enabled": true,
  "collection": "花间集",
