{
  "id": "poem-fdd66a7bf1e49f154bc63077",
  "title": "偈十六首  其一三",
  "author": "释士珪",
  "dynasty": "宋",
  "verses": [
    "老禅不打鼓山鼓，送老来看雁范山。",
    "杰阁重楼都不见，溪边茅屋两三间。"
  ],
  "enabled": true,
