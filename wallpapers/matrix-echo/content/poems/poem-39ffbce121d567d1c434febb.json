{
  "id": "poem-39ffbce121d567d1c434febb",
  "title": "左掖梨花",
  "author": "丘为",
  "dynasty": "唐",
  "verses": [
    "冷艳全欺雪，余香乍入衣。",
    "春风且莫定，吹向玉阶飞。"
  ],
