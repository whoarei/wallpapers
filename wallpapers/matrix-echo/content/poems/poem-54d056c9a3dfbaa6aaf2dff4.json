{
  "id": "poem-54d056c9a3dfbaa6aaf2dff4",
  "title": "渔父",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "谋生与俗违，一叶浪中蜚。",
    "水易分团月，云难隠少微。",
    "雁沙眠晚照，鸥渚櫂晴霏。",
    "见说蓬莱浅，寻津问钓矶。"
  ],
  "enabled": true,
  "collection": "宋诗选",
