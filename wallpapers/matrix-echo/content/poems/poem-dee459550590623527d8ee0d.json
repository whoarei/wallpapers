{
  "id": "poem-dee459550590623527d8ee0d",
  "title": "咏史诗 玉门关",
  "author": "胡曾",
  "dynasty": "唐",
  "verses": [
    "西戎不敢过天山，定远功成白马闲。",
    "半夜帐中停烛坐，唯思生入玉门关。"
  ],
  "enabled": true,
