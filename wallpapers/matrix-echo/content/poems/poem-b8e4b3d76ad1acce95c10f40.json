{
  "id": "poem-b8e4b3d76ad1acce95c10f40",
  "title": "古风二首 一",
  "author": "李绅",
  "dynasty": "唐",
  "verses": [
    "春种一粒粟，秋成万颗子。",
    "四海无闲田，农夫犹饿死。"
  ],
