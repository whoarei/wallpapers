{
  "id": "poem-f3a69f36e089d5c2fd52f426",
  "title": "颂古三十一首  其三○",
  "author": "释玿",
  "dynasty": "宋",
  "verses": [
    "佛手驴脚生缘，生缘驴脚佛手。",
    "李公醉倒街头，元是张公吃酒。",
    "黄龙山里老婆禅，恰似河阳新妇丑。"
  ],
  "enabled": true,
  "collection": "宋诗选",
