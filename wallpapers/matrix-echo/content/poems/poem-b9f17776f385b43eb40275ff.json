{
  "id": "poem-b9f17776f385b43eb40275ff",
  "title": "循梅道中遣人如江南走笔寄诸季十首  其三",
  "author": "李纲",
  "dynasty": "宋",
  "verses": [
    "人传吴会破，虏向福山归。",
    "松梓定安稳，池台今是非。",
    "伤心怀故老，流泪落征衣。",
    "目断沧波上，龙舟翠盖飞。"
  ],
  "enabled": true,
  "collection": "宋诗选",
