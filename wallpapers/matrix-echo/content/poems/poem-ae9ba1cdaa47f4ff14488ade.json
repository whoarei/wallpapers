{
  "id": "poem-ae9ba1cdaa47f4ff14488ade",
  "title": "导引·重华天子",
  "author": "洪适",
  "dynasty": "宋",
  "verses": [
    "重华天子，长至奉神虞。",
    "九奏会轩朱。",
    "星晖云润东方晓，拜贶竹宫初。",
    "归来千乘护皇舆。",
    "瑞景集金铺。",
    "鸡竿高唱恩书下，惠露匝中区。"
  ],
  "enabled": true,
  "collection": "宋词选",
