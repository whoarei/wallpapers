{
  "id": "poem-a22fb8370d9c1aa39c6f0dbf",
  "title": "寄都官刘员外",
  "author": "章八元",
  "dynasty": "唐",
  "verses": [
    "旧宅平津邸，槐阴接汉宫。",
    "鸣驺驰道上，寒日直庐中。",
    "白雪歌偏丽，青云宦早通。",
    "悠然一缝掖，千里限清风。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
