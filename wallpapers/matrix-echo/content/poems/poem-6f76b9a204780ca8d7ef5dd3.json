{
  "id": "poem-6f76b9a204780ca8d7ef5dd3",
  "title": "金谷园",
  "author": "杜牧",
  "dynasty": "唐",
  "verses": [
    "繁华事散逐香尘，流水无情草自春。",
    "日暮东风怨啼鸟，落花犹似堕楼人。"
  ],
  "enabled": true,
  "collection": "唐诗三百首",
