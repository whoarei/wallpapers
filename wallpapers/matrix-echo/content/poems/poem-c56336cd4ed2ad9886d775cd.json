{
  "id": "poem-c56336cd4ed2ad9886d775cd",
  "title": "魏宫词",
  "author": "崔国辅",
  "dynasty": "唐",
  "verses": [
    "朝日照红妆，拟上铜雀台。",
    "画眉犹未了，魏帝使人催。"
  ],
