{
  "id": "poem-cda78ab047615cc9b5238ce9",
  "title": "颂古十九首  其一四",
  "author": "释法全",
  "dynasty": "宋",
  "verses": [
    "耳里种田，满口含烟。",
    "锺馗解舞十八拍，张老乘槎上九天。"
  ],
  "enabled": true,
