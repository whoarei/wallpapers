{
  "id": "poem-daa07cd0104b7742d9032580",
  "title": "秋风引",
  "author": "刘禹锡",
  "dynasty": "唐",
  "verses": [
    "何处秋风至，萧萧送雁群。",
    "朝来入庭树，孤客最先闻。"
  ],
  "enabled": true,
