{
  "id": "poem-70ee9b35dd141cba28a7a977",
  "title": "庆云见",
  "author": "李绅",
  "dynasty": "唐",
  "verses": [
    "礼成中岳陈金册，祥报卿云冠玉峰。",
    "轻未透林疑待凤，细非行雨讵从龙。",
    "卷风变彩霏微薄，照日笼光映隐重。",
    "还入九霄成沆瀣，夕岚生处鹤归松。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
