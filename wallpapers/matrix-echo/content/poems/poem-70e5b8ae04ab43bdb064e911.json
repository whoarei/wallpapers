{
  "id": "poem-70e5b8ae04ab43bdb064e911",
  "title": "荷叶杯·楚女欲归南浦",
  "author": "温庭筠",
  "dynasty": "唐",
  "verses": [
    "楚女欲归南浦，朝雨。湿愁红。",
    "小船摇漾入花里，波起。隔西风。"
  ],
  "enabled": true,
  "collection": "花间集",
