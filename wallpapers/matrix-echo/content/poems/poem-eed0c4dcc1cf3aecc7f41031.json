{
  "id": "poem-eed0c4dcc1cf3aecc7f41031",
  "title": "东门之杨",
  "author": "佚名",
  "dynasty": "先秦",
  "verses": [
    "东门之杨，其叶牂牂。昏以为期，明星煌煌。",
    "东门之杨，其叶肺肺。昏以为期，明星晢晢。"
  ],
  "enabled": true,
