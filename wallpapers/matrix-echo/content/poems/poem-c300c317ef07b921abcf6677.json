{
  "id": "poem-c300c317ef07b921abcf6677",
  "title": "春秋战国门 平公",
  "author": "周昙",
  "dynasty": "唐",
  "verses": [
    "鸿鹄轻腾万里高，何殊朝野得贤豪。",
    "能知翼戴穹苍力，不是蒙茸腹背毛。"
  ],
  "enabled": true,
