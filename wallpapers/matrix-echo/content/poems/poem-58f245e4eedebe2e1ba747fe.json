{
  "id": "poem-58f245e4eedebe2e1ba747fe",
  "title": "送神",
  "author": "司空曙",
  "dynasty": "唐",
  "verses": [
    "神之去，回风袅袅云容与。",
    "桂尊瑶席不复陈，苍山绿水暮愁人。"
  ],
  "enabled": true,
