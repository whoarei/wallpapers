{
  "id": "poem-998c78aee26047b641664613",
  "title": "题北村六首  其四",
  "author": "张载",
  "dynasty": "宋",
  "verses": [
    "风泉盈耳鬓斑斑，林下幽窗对万山。",
    "妇子职修簟食足，病身何幸亦安闲。"
  ],
  "enabled": true,
