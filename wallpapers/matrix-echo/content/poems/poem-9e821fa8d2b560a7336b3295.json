{
  "id": "poem-9e821fa8d2b560a7336b3295",
  "title": "摇柳",
  "author": "孟郊",
  "dynasty": "唐",
  "verses": [
    "弱弱本易惊，看看势难定。",
    "因风似醉舞，尽日不能正。",
    "时邀咏花女，笑辍春妆镜。"
  ],
  "enabled": true,
