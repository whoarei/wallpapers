{
  "id": "poem-8496e445836c4b2019bff2bf",
  "title": "识全",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "占得沙边柳外春，更专吟啸管阴晴。",
    "延祥观后茅茨老，月旦工夫子细评。"
  ],
  "enabled": true,
