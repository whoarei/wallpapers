{
  "id": "poem-14502bddc19fb804ca8d0c9d",
  "title": "点绛唇·燕雁无心",
  "author": "姜夔",
  "dynasty": "宋",
  "verses": [
    "燕雁无心，太湖西畔随云去。",
    "数峰清苦。",
    "商略黄昏雨。",
    "第四桥边，拟共天随住。",
    "今何许。",
    "凭栏怀古。",
    "残柳参差舞。"
  ],
  "enabled": true,
