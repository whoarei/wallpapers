{
  "id": "poem-3837154ee222a38377f1dec9",
  "title": "相见欢·十年湖海扁舟",
  "author": "毛滂",
  "dynasty": "宋",
  "verses": [
    "十年湖海扁舟。",
    "几多愁。",
    "白发青灯今夜、不宜秋。",
    "中庭树。",
    "空阶雨。",
    "思悠悠。",
    "寂寞一生心事、五更头。"
  ],
  "enabled": true,
  "collection": "宋词选",
