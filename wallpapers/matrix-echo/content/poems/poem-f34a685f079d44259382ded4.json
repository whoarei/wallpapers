{
  "id": "poem-f34a685f079d44259382ded4",
  "title": "春秋战国门 鲍叔",
  "author": "周昙",
  "dynasty": "唐",
  "verses": [
    "忠臣祝寿吐嘉词，鲍叔临轩酒一巵。",
    "安不忘危臣所愿，愿思危困必无危。"
  ],
  "enabled": true,
