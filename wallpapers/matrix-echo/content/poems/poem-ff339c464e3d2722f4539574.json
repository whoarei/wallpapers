{
  "id": "poem-ff339c464e3d2722f4539574",
  "title": "征妇词",
  "author": "王镃",
  "dynasty": "宋",
  "verses": [
    "日日妆楼望雁回，雁回郎不寄书来。",
    "谁知别后身宽窄，欲送寒衣未敢裁。"
  ],
  "enabled": true,
