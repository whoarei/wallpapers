{
  "id": "poem-b85a22f273ade021f7c6f420",
  "title": "逢归信偶寄",
  "author": "李益",
  "dynasty": "唐",
  "verses": [
    "无事将心寄柳条，等闲书字满芭蕉。",
    "乡关若有东流信，遣送扬州近驿桥。"
  ],
  "enabled": true,
