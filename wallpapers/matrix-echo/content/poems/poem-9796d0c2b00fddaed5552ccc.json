{
  "id": "poem-9796d0c2b00fddaed5552ccc",
  "title": "池上",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "冰澌潄齿夜生寒，白苎生裁踏月残。",
    "水面有风人不见，只教荷气上阑干。"
  ],
  "enabled": true,
  "collection": "宋诗选",
