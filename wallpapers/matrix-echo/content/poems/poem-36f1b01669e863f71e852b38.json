{
  "id": "poem-36f1b01669e863f71e852b38",
  "title": "赠实际英上人",
  "author": "吕江",
  "dynasty": "宋",
  "verses": [
    "实际即为诚，中庸说著形。",
    "晓来雷雨过，七十二峰青。"
  ],
