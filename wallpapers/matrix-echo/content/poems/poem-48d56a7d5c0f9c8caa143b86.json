{
  "id": "poem-48d56a7d5c0f9c8caa143b86",
  "title": "捣练子·心自小",
  "author": "李石",
  "dynasty": "宋",
  "verses": [
    "心自小，玉钗头。",
    "月娥飞下白苹洲。",
    "水中仙，月下游。",
    "江汉佩，洞庭舟。",
    "香名薄幸寄青楼。",
    "问何如，打泊浮。"
  ],
  "enabled": true,
  "collection": "宋词选",
  "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/宋词/ci.song.8000.json#record-280",
  "tags": [
    "洞庭湖"
