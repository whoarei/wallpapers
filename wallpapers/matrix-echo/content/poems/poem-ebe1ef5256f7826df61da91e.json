{
  "id": "poem-ebe1ef5256f7826df61da91e",
  "title": "送孙二",
  "author": "王维",
  "dynasty": "唐",
  "verses": [
    "郊外谁相送，夫君道术亲。",
    "书生邹鲁客，才子洛阳人。",
    "祖席依寒草，行车起暮尘。",
    "山川何寂寞，长望泪沾巾。"
  ],
  "enabled": true,
