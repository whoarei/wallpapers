{
  "id": "poem-c0fa49c21348515089e2a596",
  "title": "隠山",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "小岭明明属小支，傍山论价与山违。",
    "巢由去后箕山老，夜夜天云隠少微。"
  ],
  "enabled": true,
