{
  "id": "poem-aa943d0ac296d0ecc0fde206",
  "title": "旅夜书怀",
  "author": "杜甫",
  "dynasty": "唐",
  "verses": [
    "细草微风岸，危樯独夜舟。",
    "星垂平野阔，月涌大江流。",
    "名岂文章著，官因老病休。",
    "飘飘何所似，天地一沙鸥。"
  ],
  "enabled": true,
  "collection": "唐诗三百首",
