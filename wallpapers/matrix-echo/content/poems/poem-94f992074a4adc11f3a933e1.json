{
  "id": "poem-94f992074a4adc11f3a933e1",
  "title": "赠亮首坐",
  "author": "王十朋",
  "dynasty": "宋",
  "verses": [
    "雪顶庞眉八十余，五峰深处结精庐。",
    "阅人老眼能青白，赠我严公一轴书。"
  ],
  "enabled": true,
  "collection": "宋诗选",
