{
  "id": "poem-f162dc2609e46ee665bdc041",
  "title": "观雪",
  "author": "米芾",
  "dynasty": "宋",
  "verses": [
    "月姊封银界，龙君幻玉壶。",
    "江南三尺雪，人道十年无。"
  ],
  "enabled": true,
