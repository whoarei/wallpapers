{
  "id": "poem-6f53e30372d7d171399ad58e",
  "title": "跋王介甫游钟山图",
  "author": "张栻",
  "dynasty": "宋",
  "verses": [
    "林影溪光静自如，萧疎短鬓独骑馿。",
    "可能胸次都无事，拟向山中更著书。"
  ],
  "enabled": true,
