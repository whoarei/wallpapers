{
  "id": "poem-db63653be789d10e9196ce3f",
  "title": "同熊少府题卢主簿茅斋",
  "author": "高适",
  "dynasty": "唐",
  "verses": [
    "虚院野情在，茅斋秋兴存。",
    "孝廉趋下位，才子出高门。",
    "乃继幽人静，能令学者尊。",
    "江山归谢客，神鬼下刘根。",
    "阶树时攀折，窗书任讨论。",
    "自堪成独往，何必武陵源。"
  ],
  "enabled": true,
