{
  "id": "poem-1fc4db38ad47e38568251803",
  "title": "次韵王省干  其三",
  "author": "陈造",
  "dynasty": "宋",
  "verses": [
    "王侯文振奇，人作高山仰。",
    "世学方波颓，渠独不流荡。",
    "诸生畏雄骜，六艺厚涵养。",
    "遥知落诗笔，高像寄逸想。"
  ],
  "enabled": true,
  "collection": "宋诗选",
