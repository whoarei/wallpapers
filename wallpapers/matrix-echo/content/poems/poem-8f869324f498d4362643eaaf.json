{
  "id": "poem-8f869324f498d4362643eaaf",
  "title": "江上送客",
  "author": "李端",
  "dynasty": "唐",
  "verses": [
    "故人南去汉江阴，秋雨萧萧云梦深。",
    "江上见人应下泪，由来远客易伤心。"
  ],
  "enabled": true,
