{
  "id": "poem-4dd5b8fbd4b2f5da408ba4f5",
  "title": "劝人 十七",
  "author": "义存",
  "dynasty": "唐",
  "verses": [
    "磨砖不成镜，虚空终有月。",
    "火急自提取，莫受多生屑。"
  ],
  "enabled": true,
