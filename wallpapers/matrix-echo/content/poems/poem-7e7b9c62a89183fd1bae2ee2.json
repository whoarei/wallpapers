{
  "id": "poem-7e7b9c62a89183fd1bae2ee2",
  "title": "山居八咏 五",
  "author": "常达",
  "dynasty": "唐",
  "verses": [
    "真性寂无机，尘尘祖佛师。",
    "日明庭砌暖，霜苦药苗衰。",
    "汲水和烟酌，栽松带雪移。",
    "好听玄旨处，猨啸岭南枝。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
