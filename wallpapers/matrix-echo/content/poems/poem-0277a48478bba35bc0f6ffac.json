{
  "id": "poem-0277a48478bba35bc0f6ffac",
  "title": "和李秀才雪中求酒",
  "author": "徐铉",
  "dynasty": "宋",
  "verses": [
    "雪英飘洒绕虚廊，晓景沉沉朔吹狂。",
    "银阙晶荧标帝里，桂华纷糅认仙乡。",
    "少年风味新吟动，老叟襟怀万事忘。",
    "自倒空罇酬绝唱，书帏聊得泛寒光。"
  ],
  "enabled": true,
  "collection": "宋诗选",
