{
  "id": "poem-b103fe84fe6c9332e3807d63",
  "title": "叹庭前甘菊花",
  "author": "杜甫",
  "dynasty": "唐",
  "verses": [
    "檐前甘菊移时晚，青蘂重阳不堪摘。",
    "明日萧条醉尽醒，残花烂熳开何益。",
    "篱边野外多众芳，采撷细琐升中堂。",
    "念兹空长大枝叶，结根失所缠风霜。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
