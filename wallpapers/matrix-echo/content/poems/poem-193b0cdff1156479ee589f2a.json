{
  "id": "poem-193b0cdff1156479ee589f2a",
  "title": "题竹林寺",
  "author": "朱放",
  "dynasty": "唐",
  "verses": [
    "岁月人间促，烟霞此地多。",
    "殷勤竹林寺，更得几回过？"
  ],
  "enabled": true,
  "collection": "千家诗",
  "tags": [],
