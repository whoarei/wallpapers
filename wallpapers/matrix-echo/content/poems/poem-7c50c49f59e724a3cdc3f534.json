{
  "id": "poem-7c50c49f59e724a3cdc3f534",
  "title": "古意呈补阙乔知之",
  "author": "沈佺期",
  "dynasty": "唐",
  "verses": [
    "卢家少妇郁金堂，海燕双栖玳瑁梁。",
    "九月寒砧催木叶，十年征戍忆辽阳。",
    "白狼河北音书断，丹凤城南秋夜长。",
    "谁谓含愁独不见，更教明月照流黄。"
  ],
  "enabled": true,
  "collection": "唐诗三百首",
