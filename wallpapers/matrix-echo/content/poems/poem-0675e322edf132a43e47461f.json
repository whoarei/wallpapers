{
  "id": "poem-0675e322edf132a43e47461f",
  "title": "岩桂",
  "author": "史绳祖",
  "dynasty": "宋",
  "verses": [
    "四出花中异，三开格外芳。",
    "名高评月品，韵胜霸秋香。"
  ],
