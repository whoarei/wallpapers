{
  "id": "poem-53117b2589b8f74f2dc1341f",
  "title": "如梦令·深苑重调弦管",
  "author": "毛滂",
  "dynasty": "宋",
  "verses": [
    "深苑重调弦管。",
    "不觉银台烛短。",
    "相对有金波，天畔杯中都满。",
    "人远。",
    "人远。",
    "醉倚阑干玉冷。"
  ],
  "enabled": true,
  "collection": "宋词选",
