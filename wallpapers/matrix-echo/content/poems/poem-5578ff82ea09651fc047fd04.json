{
  "id": "poem-5578ff82ea09651fc047fd04",
  "title": "戏呈程民老",
  "author": "华镇",
  "dynasty": "宋",
  "verses": [
    "多才是处走华镳，问柳寻花九十朝。",
    "春去光阴祇恨晚，兴来行路莫知遥。",
    "谢安携妓情虽远，崔烈为公臭不消。",
    "应是醉魂伤骀荡，大歌楚些为君招。"
  ],
  "enabled": true,
  "collection": "宋诗选",
