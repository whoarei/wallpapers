{
  "id": "poem-abdf89c2bfc9b3e39864d073",
  "title": "和裴少府怀京兄弟",
  "author": "皎然",
  "dynasty": "唐",
  "verses": [
    "宦游三楚外，家在五陵原。",
    "凉夜多归梦，秋风满故园。",
    "北书无远信，西候独伤魂。",
    "空念青门别，殷勤岐路言。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
