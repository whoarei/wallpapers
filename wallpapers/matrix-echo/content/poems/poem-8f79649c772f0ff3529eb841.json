{
  "id": "poem-8f79649c772f0ff3529eb841",
  "title": "鼓吹曲辞 巫山高",
  "author": "皇甫冉",
  "dynasty": "唐",
  "verses": [
    "巫峡见巴东，迢迢半出空。",
    "云藏神女馆，雨到楚王宫。",
    "朝暮泉声落，寒暄树色同。",
    "清猨不可听，偏在九秋中。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
