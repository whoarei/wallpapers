{
  "id": "poem-7b00e93ea11920b9289ce114",
  "title": "清平乐·参横月落",
  "author": "纳兰性德",
  "dynasty": "清",
  "verses": [
    "参横月落，客绪从谁托。",
    "望里家山云漠漠，似有红楼一角。",
    "不如意事年年，消磨绝塞风烟。",
    "输与五陵公子，此时梦绕花前。"
  ],
  "enabled": true,
  "collection": "纳兰词",
