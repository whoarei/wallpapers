{
  "id": "poem-a11051b7055a5b2c3995d2a4",
  "title": "到家",
  "author": "宋伯仁",
  "dynasty": "宋",
  "verses": [
    "尘压征裘满，今朝喜到家。",
    "牵衣儿欲泪，满地菊初花。",
    "瓦甑添蒸芋，铜铛旋煮茶。",
    "安贫儒者事，何必恋天涯。"
  ],
  "enabled": true,
  "collection": "宋诗选",
