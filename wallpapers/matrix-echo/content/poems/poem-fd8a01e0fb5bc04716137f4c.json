{
  "id": "poem-fd8a01e0fb5bc04716137f4c",
  "title": "独住僧",
  "author": "徐凝",
  "dynasty": "唐",
  "verses": [
    "百补袈裟一比丘，数茎长睫覆青眸。",
    "多应独住山林惯，唯照寒泉自剃头。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
