{
  "id": "poem-82836da3e1d634c8f8e172ad",
  "title": "寄姪",
  "author": "胡舜陟",
  "dynasty": "宋",
  "verses": [
    "东辅书初至，西宫夜正寒。",
    "感时嗟阻阔，喜汝报平安。",
    "学耨知兼力，辞淳发巨澜。",
    "三冬文史足，轩翥未应难。"
  ],
  "enabled": true,
  "collection": "宋诗选",
