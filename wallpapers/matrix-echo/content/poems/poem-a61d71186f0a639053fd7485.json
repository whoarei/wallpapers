{
  "id": "poem-a61d71186f0a639053fd7485",
  "title": "悼赵清献公抃",
  "author": "释法泉",
  "dynasty": "宋",
  "verses": [
    "仕也邦为瑞，归欤世作程。",
    "人间金粟去，天上玉楼成。",
    "慧剑无纤缺，冰壶彻底清。",
    "春风瀔水路，孤月照云明。"
  ],
  "enabled": true,
  "collection": "宋诗选",
