{
  "id": "poem-4aa20e9f6f6872bc39972083",
  "title": "述怀  其一",
  "author": "王镃",
  "dynasty": "宋",
  "verses": [
    "平生自笑拙经营，薄有泉田税犊耕。",
    "实地立身终是稳，权门炙手不为荣。",
    "孤山名以吟梅重，彭泽官因爱菊轻。",
    "尘世几人贪富贵，可怜头白竟无成。"
  ],
  "enabled": true,
