{
  "id": "poem-031828ef22931eb247872884",
  "title": "冬景",
  "author": "刘克庄",
  "dynasty": "宋",
  "verses": [
    "晴窗早觉爱朝曦，竹外秋声渐作威。",
    "命仆安排新暖阁，呼童熨贴旧寒衣。",
    "叶浮嫩绿酒初熟，橙切香黄蟹正肥。",
    "蓉菊满园皆可羡，赏心从此莫相违。"
  ],
  "enabled": true,
  "collection": "千家诗",
  "tags": [],
