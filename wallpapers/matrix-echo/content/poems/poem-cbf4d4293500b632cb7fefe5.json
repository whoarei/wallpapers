{
  "id": "poem-cbf4d4293500b632cb7fefe5",
  "title": "游瀍上刘氏园",
  "author": "司马光",
  "dynasty": "宋",
  "verses": [
    "日暖孤台迥，露浓幽迳微。",
    "茅斋举白饮，沙溆踏青归。",
    "照水清满眼，穿林香湿衣。",
    "莫言春尚浅，已有杏花飞。"
  ],
  "enabled": true,
  "collection": "宋诗选",
