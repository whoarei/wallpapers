{
  "id": "poem-eb954294693bc1100837241a",
  "title": "邙山",
  "author": "沈佺期",
  "dynasty": "唐",
  "verses": [
    "北邙山上列坟茔，万古千秋对洛城。",
    "城中日夕歌钟起，山上唯闻松栢声。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
