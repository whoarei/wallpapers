{
  "id": "poem-4cdd9bc568cb1a0826701a44",
  "title": "题落叶",
  "author": "司空曙",
  "dynasty": "唐",
  "verses": [
    "霜景催危叶，今朝半树空。",
    "萧条故国异，零落旅人同。",
    "飒岸浮寒水，依堦拥夜虫。",
    "随风偏可羡，得到洛阳宫。"
  ],
  "enabled": true,
