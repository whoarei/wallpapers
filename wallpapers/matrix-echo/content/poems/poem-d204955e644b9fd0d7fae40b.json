{
  "id": "poem-d204955e644b9fd0d7fae40b",
  "title": "蚬子和尚赞",
  "author": "释了惠",
  "dynasty": "宋",
  "verses": [
    "得恁么自在，得恁么快活。",
    "古庙当丛林，捞波作衣钵。",
    "脚头到处江天阔。"
  ],
  "enabled": true,
