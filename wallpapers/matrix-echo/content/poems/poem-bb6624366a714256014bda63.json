{
  "id": "poem-bb6624366a714256014bda63",
  "title": "写情",
  "author": "李益",
  "dynasty": "唐",
  "verses": [
    "水纹珍簟思悠悠，千里佳期一夕休。",
    "从此无心爱良夜，任他明月下西楼。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
  "tags": [
    "失恋",
    "爱情"
