{
  "id": "poem-1e4bfd937243fe651ce33e29",
  "title": "夏（原作「冬」）日野望",
  "author": "佚名",
  "dynasty": "唐",
  "verses": [
    "出户过河梁，登高试望乡。",
    "云随愁处断，川逐思弥长。",
    "晚吹低藂草，遥山落夕阳。",
    "徘徊噎不语，空使泪沾裳。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
