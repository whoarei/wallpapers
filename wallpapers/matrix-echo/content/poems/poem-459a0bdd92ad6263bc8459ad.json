{
  "id": "poem-459a0bdd92ad6263bc8459ad",
  "title": "捣纸",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "万杵不为轻，丁宁玉汝成。",
    "忽闻敲月响，误作捣衣声。",
    "整整云添薄，方方雪更明。",
    "沉思过秦手，古恨满笺生。"
  ],
  "enabled": true,
  "collection": "宋诗选",
