{
  "id": "poem-abf6cf525fde18e6ee1b71db",
  "title": "赠前蔚州崔使君",
  "author": "马戴",
  "dynasty": "唐",
  "verses": [
    "战回脱剑绾铜鱼，塞鴈迎风避隼旟。",
    "欲识前时为郡政，校成上下考新书。"
  ],
  "enabled": true,
