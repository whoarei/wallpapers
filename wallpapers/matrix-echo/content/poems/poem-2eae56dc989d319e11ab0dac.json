{
  "id": "poem-2eae56dc989d319e11ab0dac",
  "title": "登纠峰顶",
  "author": "吕从庆",
  "dynasty": "唐",
  "verses": [
    "盘盘纠峰岭，不与群峰同。",
    "我来值清秋，落叶飞苍穹。",
    "洪涛湃松柏，烟雨交空蒙。",
    "爱兹竟忘返，非关足力穷。",
    "。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
