{
  "id": "poem-d740c2d38725429e8b73e773",
  "title": "月夜",
  "author": "王镃",
  "dynasty": "宋",
  "verses": [
    "不眠行绕石池吟，月色如银夜正深。",
    "山路无风枯叶静，时闻露滴响空林。"
  ],
  "enabled": true,
