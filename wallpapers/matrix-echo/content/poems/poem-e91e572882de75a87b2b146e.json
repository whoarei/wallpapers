{
  "id": "poem-e91e572882de75a87b2b146e",
  "title": "寄道者",
  "author": "赵嘏",
  "dynasty": "唐",
  "verses": [
    "洞庭先生归路长，海云望极春茫茫。",
    "别来几度向蓬岛，自傍瑶台折灵草。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
