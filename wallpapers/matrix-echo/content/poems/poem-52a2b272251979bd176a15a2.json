{
  "id": "poem-52a2b272251979bd176a15a2",
  "title": "南乡子·洞口谁家",
  "author": "欧阳炯",
  "dynasty": "五代",
  "verses": [
    "洞口谁家，木兰船系木兰花。",
    "红袖女郎相引去，游南浦，笑倚春风相对语。"
  ],
  "enabled": true,
  "collection": "花间集",
