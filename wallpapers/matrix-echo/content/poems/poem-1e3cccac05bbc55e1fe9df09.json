{
  "id": "poem-1e3cccac05bbc55e1fe9df09",
  "title": "拜宣武军节度使",
  "author": "李绅",
  "dynasty": "唐",
  "verses": [
    "油幢竝入虎旗开，锦橐从天凤诏来。",
    "星应魏师新鼓角，地嫌梁苑旧池台。",
    "日晖红斾分如电，人拥青门动若雷。",
    "伊洛镜清回首处，是非纷杂任尘埃。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
