{
  "id": "poem-84b77b7388bf234a41b96df5",
  "title": "伊川晚眺",
  "author": "李德裕",
  "dynasty": "唐",
  "verses": [
    "桑叶初黄梨叶红，伊川落日尽无风。",
    "汉储何假终南客，甪里先生在谷中。"
  ],
