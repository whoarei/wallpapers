{
  "id": "poem-0de10d3d41dbacba153cd18a",
  "title": "端州江亭得家书二首 一",
  "author": "李绅",
  "dynasty": "唐",
  "verses": [
    "雨中鹊语喧江树，风处蛛丝飏水浔。",
    "开拆远书何事喜，数行家信抵千金。"
  ],
  "enabled": true,
