{
  "id": "poem-5f9086956dfb4d86564b6972",
  "title": "天宝禁中",
  "author": "赵崇嶓",
  "dynasty": "宋",
  "verses": [
    "外庭班退寿王归，别有骄儿侍禁闱。",
    "解事老奴宁及远，君恩如许政忘机。"
  ],
