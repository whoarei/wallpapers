{
  "id": "poem-484fef0827b53e69b5d32f9f",
  "title": "送杨敬之倅湖南",
  "author": "李涉",
  "dynasty": "唐",
  "verses": [
    "久嗟尘匣掩青萍，见说除书试一听。",
    "闻君却作长沙傅，便逐秋风过洞庭。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
