{
  "id": "poem-8894994bc4304e8a3ce95106",
  "title": "松图  其一",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "李怀仁画双龙后，活在兰陵道士家。",
    "水墨工夫能幻巧，变成霜干老槎牙。"
  ],
  "enabled": true,
