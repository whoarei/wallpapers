{
  "id": "poem-eef407db1467a3ba7b9baf46",
  "title": "开岁连日有阴雨  其一",
  "author": "孙嵩",
  "dynasty": "宋",
  "verses": [
    "老杜诗章五百年，为吾替写早春篇。",
    "恰从元日逾人日，重有阴阴冷落天。"
  ],
