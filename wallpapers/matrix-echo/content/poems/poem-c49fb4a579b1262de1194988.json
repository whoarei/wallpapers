{
  "id": "poem-c49fb4a579b1262de1194988",
  "title": "山中冬夜",
  "author": "张乔",
  "dynasty": "唐",
  "verses": [
    "寒叶风摇尽，空林鸟宿稀。",
    "涧冰妨鹿饮，山雪阻僧归。",
    "夜坐尘心定，长吟语力微。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
