{
  "id": "poem-19a00c8ad77d6971b7a69578",
  "title": "积翠峰",
  "author": "延寿",
  "dynasty": "唐",
  "verses": [
    "翠压群峰地形直，落日猿声在空碧。",
    "天风吹散断崖云，古松长露三秋色。",
    "。"
  ],
  "enabled": true,
