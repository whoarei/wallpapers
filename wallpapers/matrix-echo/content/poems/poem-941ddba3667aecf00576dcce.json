{
  "id": "poem-941ddba3667aecf00576dcce",
  "title": "望商山路",
  "author": "司空曙",
  "dynasty": "唐",
  "verses": [
    "南见青山道，依然去国时。",
    "已甘长避地，谁料有还期。",
    "雨霁残阳薄，人愁独望迟。",
    "空残华发在，前事不堪思。"
  ],
  "enabled": true,
