{
  "id": "poem-3bfbbce41544bdac7555af7c",
  "title": "春雨",
  "author": "李商隐",
  "dynasty": "唐",
  "verses": [
    "怅卧新春白袷衣，白门寥落意多违。",
    "红楼隔雨相望冷，珠箔飘灯独自归。",
    "远路应悲春晼晚，残宵犹得梦依稀。",
    "玉珰缄札何由达，万里云罗一雁飞。"
  ],
  "enabled": true,
  "collection": "唐诗三百首",
