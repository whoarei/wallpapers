{
  "id": "poem-d4820c633ec04bb96f0a0ed4",
  "title": "回军行",
  "author": "李益",
  "dynasty": "唐",
  "verses": [
    "关城榆叶早疎黄，日暮沙云古战场。",
    "表请回军掩尘骨，莫教士卒哭龙荒。"
  ],
  "enabled": true,
