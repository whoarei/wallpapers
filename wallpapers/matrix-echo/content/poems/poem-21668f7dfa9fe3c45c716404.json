{
  "id": "poem-21668f7dfa9fe3c45c716404",
  "title": "风中琴",
  "author": "卢仝",
  "dynasty": "唐",
  "verses": [
    "五音六律十三徽，龙吟鹤响思庖羲。",
    "一弹流水一弹月，水月风生松树枝。"
  ],
  "enabled": true,
