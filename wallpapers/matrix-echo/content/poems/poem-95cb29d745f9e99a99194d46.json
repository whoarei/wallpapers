{
  "id": "poem-95cb29d745f9e99a99194d46",
  "title": "病马五首呈郑校书章三吴十五先辈 二",
  "author": "曹唐",
  "dynasty": "唐",
  "verses": [
    "陇上沙葱叶正齐，腾黄犹自跼羸蹄。",
    "尾蟠夜雨红丝脆，头捽秋风白练低。",
    "力惫未思金络脑，影寒空望锦障泥。",
    "阶前莫怪垂双泪，不遇孙阳不敢嘶。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
