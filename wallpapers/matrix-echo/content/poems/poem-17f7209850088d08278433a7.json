{
  "id": "poem-17f7209850088d08278433a7",
  "title": "子规",
  "author": "来鹄",
  "dynasty": "唐",
  "verses": [
    "月落空山闻数声，此时孤馆酒初醒。",
    "投人语若似伊泪，口畔血流应始听。"
  ],
  "enabled": true,
