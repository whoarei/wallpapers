{
  "id": "poem-e6392741db5a043836eaccb9",
  "title": "惠山归晚辞县斋小集",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "癯冰瘠雪凝霜澌，冻涩苔痕老更奇。",
    "旅雁退飞寒力劲，水边云冷出山迟。"
  ],
  "enabled": true,
  "collection": "宋诗选",
