{
  "id": "poem-c1bd1b5f25cf1bfa390ae027",
  "title": "晚春即事",
  "author": "王镃",
  "dynasty": "宋",
  "verses": [
    "云气不分明，天阴忽又晴。",
    "喜凉溪鹊浴，知雨沼蛙鸣。",
    "仙药黄精饭，斋蔬白蕈羹。",
    "惜春吟未就，闲踏落花行。"
  ],
  "enabled": true,
  "collection": "宋诗选",
