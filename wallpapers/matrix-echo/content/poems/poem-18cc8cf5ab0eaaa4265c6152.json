{
  "id": "poem-18cc8cf5ab0eaaa4265c6152",
  "title": "采莲",
  "author": "孙光宪",
  "dynasty": "宋",
  "verses": [
    "菡萏香连十顷陂，小姑贪戏采莲迟。",
    "晚来弄水船头湿，更脱红裙裹鸭儿。"
  ],
  "enabled": true,
  "collection": "宋诗选",
