{
  "id": "poem-034cf7973305c2601715e822",
  "title": "闻官军收河南河北",
  "author": "杜甫",
  "dynasty": "唐",
  "verses": [
    "劒外忽传收蓟北，初闻涕泪满衣裳。",
    "却看妻子愁何在，漫卷诗书喜欲狂。",
    "白日放歌须纵酒，青春作伴好还乡。",
    "即从巴峡穿巫峡，便下襄阳向洛阳。"
  ],
  "enabled": true,
