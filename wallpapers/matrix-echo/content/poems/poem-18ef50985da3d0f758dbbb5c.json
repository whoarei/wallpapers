{
  "id": "poem-18ef50985da3d0f758dbbb5c",
  "title": "吊卢殷 八",
  "author": "孟郊",
  "dynasty": "唐",
  "verses": [
    "前贤多哭酒，哭酒免哭心。",
    "后贤试衔之，哀至无不深。",
    "少年哭酒时，白发亦已侵。",
    "老年哭酒时，声韵随生沈。",
    "寄言哭酒宾，勿作登封音。",
    "登封徒放声，天地竟难寻。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
