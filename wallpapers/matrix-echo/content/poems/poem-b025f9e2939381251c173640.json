{
  "id": "poem-b025f9e2939381251c173640",
  "title": "题清彻上人院",
  "author": "张籍",
  "dynasty": "唐",
  "verses": [
    "古寺临坛久，松间别起堂。",
    "看添浴佛水，自合读经香。",
    "爱养无家客，多传得效方。",
    "过斋长不出，坐卧一绳床。"
  ],
  "enabled": true,
