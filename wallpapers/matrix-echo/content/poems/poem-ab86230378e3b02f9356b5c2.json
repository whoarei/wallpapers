{
  "id": "poem-ab86230378e3b02f9356b5c2",
  "title": "征怨",
  "author": "柳中庸",
  "dynasty": "唐",
  "verses": [
    "岁岁金河复玉关，朝朝马策与刀环。",
    "三春白雪归青冢，万里黄河遶黑山。"
  ],
  "enabled": true,
