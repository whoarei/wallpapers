{
  "id": "poem-26b77ec43d2e6a434a38ef31",
  "title": "暮春即事",
  "author": "叶采",
  "dynasty": "宋",
  "verses": [
    "双双瓦雀行书案，点点杨花入砚池。",
    "闲坐小窗读周易，不知春去几多时。"
  ],
  "enabled": true,
  "collection": "千家诗",
