{
  "id": "poem-4c07ffb4a3027bde90373486",
  "title": "送程秀才下第归蜀",
  "author": "姚鹄",
  "dynasty": "唐",
  "verses": [
    "莺迁与鶂退，十载泣岐分。",
    "蜀道重来老，巴猨此去闻。",
    "晓程侵岭雪，远栈入谿云。",
    "莫滞趋庭恋，荣亲祗待君。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
