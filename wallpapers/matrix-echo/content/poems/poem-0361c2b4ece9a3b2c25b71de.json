{
  "id": "poem-0361c2b4ece9a3b2c25b71de",
  "title": "采莲词",
  "author": "赵崇嶓",
  "dynasty": "宋",
  "verses": [
    "别浦潮生花梦寒，片红飞下粉痕干。",
    "预知妾面如花面，泣向西风不忍看。"
  ],
  "enabled": true,
