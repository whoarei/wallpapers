{
  "id": "poem-0f014b5796a3e29e67095512",
  "title": "题弋阳徐明府水亭",
  "author": "张祜",
  "dynasty": "唐",
  "verses": [
    "小邑不劳贤，心期胜地偏。",
    "树微青嶂耸，沙浅碧波旋。",
    "荡桨投昏岸，烧燔指湿烟。",
    "板簷傍眺寺，石路上登舡。",
    "水槛推衣浴，风轩侧枕眠。",
    "无因长寄此，吟和酒中仙。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
