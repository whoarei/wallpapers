{
  "id": "poem-ab6178426dd56f101f7a70c3",
  "title": "宿溪僧院",
  "author": "曹松",
  "dynasty": "唐",
  "verses": [
    "少年云溪里，禅心夜更闲。",
    "煎茶留静者，靠月坐苍山。",
    "露白钟寻定，萤多户未关。",
    "嵩阳大石室，何日译经还。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
