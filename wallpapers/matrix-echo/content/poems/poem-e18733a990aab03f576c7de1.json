{
  "id": "poem-e18733a990aab03f576c7de1",
  "title": "塞下曲四首 二",
  "author": "王昌龄",
  "dynasty": "唐",
  "verses": [
    "饮马渡秋水，水寒风似刀。",
    "平沙日未没，黯黯见临洮。",
    "昔日长城战，咸言意气高。",
    "黄尘足今古，白骨乱蓬蒿。"
  ],
  "enabled": true,
  "collection": "唐诗三百首",
