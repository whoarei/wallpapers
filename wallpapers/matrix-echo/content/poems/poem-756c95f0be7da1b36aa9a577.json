{
  "id": "poem-756c95f0be7da1b36aa9a577",
  "title": "宝峰亭",
  "author": "鲜于侁",
  "dynasty": "宋",
  "verses": [
    "舟航日上下，车马不少闲。",
    "近邑凑商贾，远峰自云烟。"
  ],
  "enabled": true,
  "collection": "宋诗选",
