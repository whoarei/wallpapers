{
  "id": "poem-bdb8e4e4a7edb0ac10d9ec57",
  "title": "酬秦系山人题赠",
  "author": "皎然",
  "dynasty": "唐",
  "verses": [
    "云林出空乌未归，松吹时飘雨浴衣。",
    "石语花愁徒自诧，吾心见境尽为非。"
  ],
