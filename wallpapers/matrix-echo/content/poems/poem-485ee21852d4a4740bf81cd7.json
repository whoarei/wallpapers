{
  "id": "poem-485ee21852d4a4740bf81cd7",
  "title": "新秋雨霁宿王处士东郊",
  "author": "马戴",
  "dynasty": "唐",
  "verses": [
    "夕阳逢一雨，夜木洗清阴。",
    "露气竹窗静，秋光云月深。",
    "煎尝灵药味，话及故山心。",
    "得意两不寐，微风生玉琴。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
