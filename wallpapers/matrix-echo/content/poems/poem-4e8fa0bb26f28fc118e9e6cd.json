{
  "id": "poem-4e8fa0bb26f28fc118e9e6cd",
  "title": "侍宴桃花园咏桃花应制",
  "author": "赵彦昭",
  "dynasty": "唐",
  "verses": [
    "红萼竞燃春苑曙，粉茸新吐御筵开。",
    "长年愿奉西王母，近侍惭无东朔才。"
  ],
  "enabled": true,
