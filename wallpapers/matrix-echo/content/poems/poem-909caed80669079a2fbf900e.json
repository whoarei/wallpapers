{
  "id": "poem-909caed80669079a2fbf900e",
  "title": "颂古三十一首  其七",
  "author": "释玿",
  "dynasty": "宋",
  "verses": [
    "是贼识贼精识精，南泉无过强惺惺。",
    "赵州礼拜归堂去，前箭犹轻后箭深。"
  ],
