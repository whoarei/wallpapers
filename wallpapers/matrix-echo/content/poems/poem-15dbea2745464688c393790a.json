{
  "id": "poem-15dbea2745464688c393790a",
  "title": "偈",
  "author": "释惟爽",
  "dynasty": "宋",
  "verses": [
    "今朝六月旦，一年已过半。",
    "奉报参玄人，识取娘生面。",
    "娘生面，荐不荐。",
    "鹭鸶飞入碧波中，抖擞一团银绣线。"
  ],
  "enabled": true,
  "collection": "宋诗选",
