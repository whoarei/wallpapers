{
  "id": "poem-3b9202c215756bfcb132a837",
  "title": "送乐平苗明府得家字",
  "author": "李端",
  "dynasty": "唐",
  "verses": [
    "本自求彭泽，谁云道里赊。",
    "山从石壁断，江向弋阳斜。",
    "暮色随枫树，阴云暗荻花。",
    "诸侯旧调鼎，应重宰臣家。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
