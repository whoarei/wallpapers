{
  "id": "poem-41763c30298f46d5a2e4628a",
  "title": "相和歌辞 江南曲",
  "author": "李益",
  "dynasty": "唐",
  "verses": [
    "嫁得瞿塘贾，朝朝误妾期。",
    "早知潮有信，嫁与弄潮儿。"
  ],
