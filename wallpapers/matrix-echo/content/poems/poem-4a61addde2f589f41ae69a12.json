{
  "id": "poem-4a61addde2f589f41ae69a12",
  "title": "元日",
  "author": "王安石",
  "dynasty": "宋",
  "verses": [
    "爆竹声中一岁除，春风送暖入屠苏。",
    "千门万户曈曈日，总把新桃换旧符。"
  ],
  "enabled": true,
  "collection": "千家诗",
