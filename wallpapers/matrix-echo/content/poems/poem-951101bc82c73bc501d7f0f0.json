{
  "id": "poem-951101bc82c73bc501d7f0f0",
  "title": "扶病春亭",
  "author": "刘言史",
  "dynasty": "唐",
  "verses": [
    "强梳稀发著纶巾，舍杖空行试病身。",
    "花间自欲裴回立，穉子牵衣不许人。"
  ],
  "enabled": true,
