{
  "id": "poem-b0d39553a90bf3d34fd9f0f0",
  "title": "朝阳洞",
  "author": "吕愿中",
  "dynasty": "宋",
  "verses": [
    "半世观山鬓已皤，欲求钓艇老渔蓑。",
    "杖藜又过烟霞洞，闻说当年烂斧柯。"
  ],
  "enabled": true,
  "collection": "宋诗选",
