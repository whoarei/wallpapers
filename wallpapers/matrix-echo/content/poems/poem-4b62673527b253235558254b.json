{
  "id": "poem-4b62673527b253235558254b",
  "title": "感怀呈所知",
  "author": "谭用之",
  "dynasty": "宋",
  "verses": [
    "十年流落赋归鸿，谁傍昏衢驾烛龙。",
    "竹屋乱烟思梓泽，酒家疏雨梦临邛。",
    "千年别恨调琴懒，一片年光览镜慵。",
    "早晚休歌白石烂，放教归去卧群峰。"
  ],
  "enabled": true,
  "collection": "宋诗选",
