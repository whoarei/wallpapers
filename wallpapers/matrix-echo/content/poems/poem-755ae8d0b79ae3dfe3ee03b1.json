{
  "id": "poem-755ae8d0b79ae3dfe3ee03b1",
  "title": "湖上",
  "author": "宋伯仁",
  "dynasty": "宋",
  "verses": [
    "一泓寒玉浸青山，粧点楼台夕照间。",
    "歌管满船春未嬾，惜无人伴白鸥闲。"
  ],
  "enabled": true,
  "collection": "宋诗选",
