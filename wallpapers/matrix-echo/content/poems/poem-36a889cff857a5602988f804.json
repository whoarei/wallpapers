{
  "id": "poem-36a889cff857a5602988f804",
  "title": "游仙词三十三首  其二五",
  "author": "王镃",
  "dynasty": "宋",
  "verses": [
    "灵液长流满地香，洞中多是散仙房。",
    "金炉煮就金精汁，欲献元君未敢尝。"
  ],
  "enabled": true,
