{
  "id": "poem-5b664c2f84cd705fda0e3b70",
  "title": "上巳",
  "author": "杨凝",
  "dynasty": "唐",
  "verses": [
    "帝京元巳足繁华，细管清弦七贵家。",
    "此日风光谁不共，纷纷皆是掖垣花。"
  ],
