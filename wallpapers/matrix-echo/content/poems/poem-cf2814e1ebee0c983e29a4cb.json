{
  "id": "poem-cf2814e1ebee0c983e29a4cb",
  "title": "舜城怀古",
  "author": "项斯",
  "dynasty": "唐",
  "verses": [
    "禅禹逊尧聪，巍巍盛此中。",
    "四隅咸启圣，万古赖成功。",
    "道德去弥远，山河势不穷。",
    "停车一再拜，帝业即今同。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
