{
  "id": "poem-a5631d0d6bd5a31a07bf795f",
  "title": "寒食日题杜鹃花",
  "author": "曹松",
  "dynasty": "唐",
  "verses": [
    "一朵又一朵，并开寒食时。",
    "谁家不禁火，总在此花枝。"
  ],
  "enabled": true,
