{
  "id": "poem-594c22bf3d7c460858e43324",
  "title": "天柱庵",
  "author": "陈岩",
  "dynasty": "宋",
  "verses": [
    "石壁参天驻冷云，一声幽鸟忽惊人。",
    "庵前庵后山如旧，朽柏年来不再春。"
  ],
  "enabled": true,
  "collection": "宋诗选",
