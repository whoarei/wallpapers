{
  "id": "poem-31cd35b1c8b0aeec2e9fb2c4",
  "title": "和元晦晚霞",
  "author": "张栻",
  "dynasty": "宋",
  "verses": [
    "早来雪意遮空碧，晚喜晴霞散绮红。",
    "便可悬知明旦事，一轮明月快哉风。"
  ],
