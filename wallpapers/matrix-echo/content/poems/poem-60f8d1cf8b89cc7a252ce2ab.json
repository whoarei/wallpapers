{
  "id": "poem-60f8d1cf8b89cc7a252ce2ab",
  "title": "陆川道中偶成",
  "author": "李纲",
  "dynasty": "宋",
  "verses": [
    "峤南江北本来同，往返纷纷一梦中。",
    "旧事销磨那复有，新愁缭绕亦成空。",
    "天边山色浮浓翠，溪上云光拂淡红。",
    "我把浮生如梦看，云山元是小屏风。"
  ],
  "enabled": true,
  "collection": "宋诗选",
