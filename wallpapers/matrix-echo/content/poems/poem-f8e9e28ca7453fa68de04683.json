{
  "id": "poem-f8e9e28ca7453fa68de04683",
  "title": "枫桥夜泊",
  "author": "张继",
  "dynasty": "唐",
  "verses": [
    "月落乌啼霜满天，江枫渔火对愁眠。",
    "姑苏城外寒山寺，夜半钟声到客船。"
  ],
  "enabled": true,
  "collection": "千家诗",
