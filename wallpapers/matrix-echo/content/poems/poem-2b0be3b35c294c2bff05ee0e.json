{
  "id": "poem-2b0be3b35c294c2bff05ee0e",
  "title": "送玄同真人李抱朴谒灊山仙祠",
  "author": "明皇帝",
  "dynasty": "唐",
  "verses": [
    "城阙天中近，蓬瀛海上遥。",
    "归期千载鹤，春至一来朝。",
    "采药逢三秀，餐霞卧九霄。",
    "参同如有旨，金鼎待君烧。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
