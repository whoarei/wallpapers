{
  "id": "poem-09cda831f4b1560e75c64062",
  "title": "题城南书院三十四咏  其二",
  "author": "张栻",
  "dynasty": "宋",
  "verses": [
    "新竹成林蕉叶青，隔篱深处有蝉鸣。",
    "晚凉更觉长堤静，自遶荷花待月明。"
  ],
  "enabled": true,
