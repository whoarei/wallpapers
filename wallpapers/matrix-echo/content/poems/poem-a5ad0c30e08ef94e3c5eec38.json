{
  "id": "poem-a5ad0c30e08ef94e3c5eec38",
  "title": "江中风",
  "author": "杨凌",
  "dynasty": "唐",
  "verses": [
    "白浪暗江中，南泠路不通。",
    "高樯帆自满，出浦莫呼风。"
  ],
  "enabled": true,
