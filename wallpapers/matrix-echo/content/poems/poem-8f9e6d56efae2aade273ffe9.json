{
  "id": "poem-8f9e6d56efae2aade273ffe9",
  "title": "答资道",
  "author": "刘跂",
  "dynasty": "宋",
  "verses": [
    "都尉声名后，篇章不乏才。",
    "谈高正始际，诗自建安来。",
    "险怪探龙颔，甘珍味豹胎。",
    "阴何长有思，郊岛漫相猜。",
    "白雪凭谁听，黄花入众咍。",
    "楚醒搴水薜，蜀兴动官梅。",
    "晚艇翩翩鸟，秋涛隠隠雷。",
    "水兼天浩荡，山为日崔嵬。",
    "丽藻烦三复，愁肠殆九回。",
    "自惭无世用，庄语笑迂骀。"
  ],
  "enabled": true,
  "collection": "宋诗选",
