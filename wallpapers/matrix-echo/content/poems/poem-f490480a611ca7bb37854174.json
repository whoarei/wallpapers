{
  "id": "poem-f490480a611ca7bb37854174",
  "title": "宿鄠郊赠罗处士",
  "author": "李洞",
  "dynasty": "唐",
  "verses": [
    "川静星高栎已枯，南山落石水声麤。",
    "白云钓客窗中宿，卧数嵩峰听五湖。"
  ],
  "enabled": true,
