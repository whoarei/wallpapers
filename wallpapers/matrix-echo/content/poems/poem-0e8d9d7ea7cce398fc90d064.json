{
  "id": "poem-0e8d9d7ea7cce398fc90d064",
  "title": "惠山斋中听雨",
  "author": "李详",
  "dynasty": "宋",
  "verses": [
    "云冷银蟾遯，香寒宝篆迟。",
    "轻雷新破梦，好雨故知时。",
    "池荇阴抽带，山茶暗展旗。",
    "空阶闻夜响，楚客起题诗。"
  ],
  "enabled": true,
  "collection": "宋诗选",
