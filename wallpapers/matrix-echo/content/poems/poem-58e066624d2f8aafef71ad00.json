{
  "id": "poem-58e066624d2f8aafef71ad00",
  "title": "酒泉子·小槛日斜",
  "author": "顾敻",
  "dynasty": "五代",
  "verses": [
    "小槛日斜，风度绿窗人悄悄。",
    "翠帷闲掩舞双鸾，旧香寒。",
    "别来情绪转难拚，韶颜看却老。",
    "依稀粉上有啼痕，暗销魂。"
  ],
  "enabled": true,
  "collection": "花间集",
