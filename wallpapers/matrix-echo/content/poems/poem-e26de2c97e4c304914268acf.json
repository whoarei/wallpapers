{
  "id": "poem-e26de2c97e4c304914268acf",
  "title": "南歌子·岸柳拖烟绿",
  "author": "张泌",
  "dynasty": "五代",
  "verses": [
    "岸柳拖烟绿，庭花照日红。",
    "数声蜀魄入帘栊，惊断碧窗残梦，画屏空。"
  ],
  "enabled": true,
