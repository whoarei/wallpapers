{
  "id": "poem-e79746cb8c54a78caae722d7",
  "title": "登楼",
  "author": "朱斌",
  "dynasty": "唐",
  "verses": [
    "白日依山尽，黄河入海流。",
    "欲穷千里目，更上一层楼。"
  ],
  "enabled": true,
