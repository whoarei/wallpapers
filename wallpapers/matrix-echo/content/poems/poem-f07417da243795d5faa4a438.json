{
  "id": "poem-f07417da243795d5faa4a438",
  "title": "题独醒小亭",
  "author": "王琮",
  "dynasty": "宋",
  "verses": [
    "退食多留此，翛然一散襟。",
    "凉从晓来觉，秋向雨中深。",
    "墙竹侵山色，簷茅杂柳阴。",
    "有谁能载酒，过我共幽寻。"
  ],
  "enabled": true,
  "collection": "宋诗选",
