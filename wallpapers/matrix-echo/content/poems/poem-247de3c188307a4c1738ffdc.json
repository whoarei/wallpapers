{
  "id": "poem-247de3c188307a4c1738ffdc",
  "title": "览镜",
  "author": "李崇嗣",
  "dynasty": "唐",
  "verses": [
    "岁去红颜尽，愁来白发新。",
    "今朝开镜匣，疑是别逢人。"
  ],
