{
  "id": "poem-6629a5dbcdd6f27a766f59fb",
  "title": "罢相作",
  "author": "李适之",
  "dynasty": "唐",
  "verses": [
    "避贤初罢相，乐圣且衔杯。",
    "为问门前客，今朝几个来。"
  ],
  "enabled": true,
