{
  "id": "poem-6f78be7fa60b46a53782bec2",
  "title": "漫书五首 三",
  "author": "司空图",
  "dynasty": "唐",
  "verses": [
    "海上昔闻麋爱鹤，山中今日鹿憎龟。",
    "爱憎止竟须关分，莫把微才望所知。"
  ],
  "enabled": true,
