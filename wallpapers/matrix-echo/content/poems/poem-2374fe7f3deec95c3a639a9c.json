{
  "id": "poem-2374fe7f3deec95c3a639a9c",
  "title": "谢所知",
  "author": "李咸用",
  "dynasty": "唐",
  "verses": [
    "狂歌狂舞慰风尘，心下多端亦嬾言。",
    "早是乱离轻岁月，谁能愁悴过朝昏。",
    "圣朝公道如长在，贱子谋身自有门。",
    "却愧此时叨厚遇，他年何以报深恩。"
  ],
  "enabled": true,
