{
  "id": "poem-233b5c413f5047e8b5a66b93",
  "title": "惠泉",
  "author": "李德裕",
  "dynasty": "唐",
  "verses": [
    "兹泉由太洁，终不畜纤鳞。",
    "到底清何益，含虚势自贫。",
    "明玑难秘彩，美玉讵潜珍。",
    "未及黄陂量，滔滔岂有津。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
