{
  "id": "poem-d630d14296f35fff6cc3df13",
  "title": "迎春乐·薄纱衫子裙腰匝",
  "author": "欧阳修",
  "dynasty": "宋",
  "verses": [
    "薄纱衫子裙腰匝。",
    "步轻轻、小罗靸。",
    "人前爱把眼儿札。",
    "香汗透、胭脂蜡。",
    "良夜永、幽期欢则洽。",
    "约重会、玉纤频插。",
    "执手临归，犹且更待留时霎。"
  ],
  "enabled": true,
  "collection": "宋词选",
  "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/宋词/ci.song.0.json#record-827",
