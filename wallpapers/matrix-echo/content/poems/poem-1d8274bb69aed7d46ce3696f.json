{
  "id": "poem-1d8274bb69aed7d46ce3696f",
  "title": "郊庙歌辞 五郊乐章 送神",
  "author": "不详",
  "dynasty": "唐",
  "verses": [
    "春末冬暮，徂夏杪秋。",
    "土王四月，时季一周。",
    "黍稷已享，笾豆宜收。",
    "送神有乐，神其赐休。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
