{
  "id": "poem-97cf38258065dc78a4760a81",
  "title": "律僧",
  "author": "张籍",
  "dynasty": "唐",
  "verses": [
    "苦行长不出，清羸最少年。",
    "持斋唯一食，讲律岂曾眠。",
    "避草每移径，滤虫还入泉。",
    "从来天竺法，到此几人传。"
  ],
  "enabled": true,
