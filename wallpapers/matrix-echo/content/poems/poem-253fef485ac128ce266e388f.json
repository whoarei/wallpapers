{
  "id": "poem-253fef485ac128ce266e388f",
  "title": "干旄",
  "author": "佚名",
  "dynasty": "先秦",
  "verses": [
    "孑孑干旄，在浚之郊。素丝纰之，良马四之。彼姝者子，何以畀之？",
    "孑孑干旟，在浚之都。素丝组之，良马五之。彼姝者子，何以予之？",
    "孑孑干旌，在浚之城。素丝祝之，良马六之。彼姝者子，何以告之？"
  ],
  "enabled": true,
  "collection": "诗经",
  "tags": [],
  "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/诗经/shijing.json#record-52"
