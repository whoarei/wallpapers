{
  "id": "poem-94cd46bdf5f71cd454646c48",
  "title": "蚕妇吟",
  "author": "谢枋得",
  "dynasty": "唐",
  "verses": [
    "子规啼彻四更时，起视蚕稠怕叶稀。",
    "不信楼头杨柳月，玉人歌舞未曾归。"
  ],
  "enabled": true,
  "collection": "千家诗",
