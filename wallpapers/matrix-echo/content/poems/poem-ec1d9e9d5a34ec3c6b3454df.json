{
  "id": "poem-ec1d9e9d5a34ec3c6b3454df",
  "title": "春秋战国门 管仲",
  "author": "周昙",
  "dynasty": "唐",
  "verses": [
    "美酒浓馨客要沽，门深谁敢强提壶。",
    "苟非贤主询贤士，肯信沽人畏子獹。"
  ],
