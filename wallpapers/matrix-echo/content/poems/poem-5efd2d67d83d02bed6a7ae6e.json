{
  "id": "poem-5efd2d67d83d02bed6a7ae6e",
  "title": "秋夕",
  "author": "杜牧",
  "dynasty": "唐",
  "verses": [
    "银烛秋光冷画屏，轻罗小扇扑流萤。",
    "天街夜色凉如水，卧看牵牛织女星。"
  ],
  "enabled": true,
  "collection": "千家诗",
