{
  "id": "poem-5b1cceb9c9b08cef9d7eeb8c",
  "title": "春宵",
  "author": "苏轼",
  "dynasty": "宋",
  "verses": [
    "春宵一刻值千金，花有清香月有阴。",
    "歌管楼台声细细，秋千院落夜沈沈。"
  ],
  "enabled": true,
  "collection": "千家诗",
