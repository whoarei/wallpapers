{
  "id": "poem-5a4cd502441754281a0dd279",
  "title": "昭君怨·拂晓拿舟东去",
  "author": "张镃",
  "dynasty": "宋",
  "verses": [
    "拂晓拿舟东去。",
    "细看荷花垂露。",
    "红绿总吹香。",
    "一般凉。",
    "会享人天清福。",
    "休把两眉轻蹙。",
    "谁道做神仙。",
    "戴貂蝉。"
  ],
  "enabled": true,
  "collection": "宋词选",
