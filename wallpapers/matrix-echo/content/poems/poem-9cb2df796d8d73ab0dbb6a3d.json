{
  "id": "poem-9cb2df796d8d73ab0dbb6a3d",
  "title": "贼警",
  "author": "吕从庆",
  "dynasty": "唐",
  "verses": [
    "兵火逾风疾，才西已及东。",
    "苍翁灾海内，赤子哭途中。",
    "城阙兼旬闭，邮书彻旦通。",
    "不知调国者，何以慰时匆？"
  ],
  "enabled": true,
  "collection": "全唐诗选",
