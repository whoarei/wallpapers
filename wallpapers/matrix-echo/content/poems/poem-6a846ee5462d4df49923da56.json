{
  "id": "poem-6a846ee5462d4df49923da56",
  "title": "花枕",
  "author": "杨凝",
  "dynasty": "唐",
  "verses": [
    "席上沈香枕，楼中荡子妻。",
    "那堪一夜里，长湿两行啼。"
  ],
  "enabled": true,
