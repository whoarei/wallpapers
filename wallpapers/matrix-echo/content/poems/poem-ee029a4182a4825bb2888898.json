{
  "id": "poem-ee029a4182a4825bb2888898",
  "title": "地僻",
  "author": "赵崇嶓",
  "dynasty": "宋",
  "verses": [
    "地僻逢迎少，吾生信杳冥。",
    "清谈养生论，兀坐太玄经。",
    "性拙贫逾乐，神清梦数灵。",
    "亭亭岁寒友，相对眼终青。"
  ],
  "enabled": true,
  "collection": "宋诗选",
