{
  "id": "poem-ae03feba21c501a1451fd4d5",
  "title": "煨芋",
  "author": "李纲",
  "dynasty": "宋",
  "verses": [
    "禅房夜坐腹半饥，寒炉拨火煨蹲鸱。",
    "冻肤傍煖渐舒畅，展转更觉鸣声悲。",
    "毳衣脱落丰肌滑，玉软酥香不劳啮。",
    "芳甘著颊自生津，多病文园正消渇。",
    "吾生老矣来荆蛮，得汝聊助癯儒餐。",
    "不学当年鬼谷子，粪土堆头拜懒残。"
  ],
  "enabled": true,
  "collection": "宋诗选",
