{
  "id": "poem-d3937ac988de35ef20ea5ce2",
  "title": "调笑・调笑令·翻翻绣袖上红茵",
  "author": "邵伯温",
  "dynasty": "宋",
  "verses": [
    "翻翻绣袖上红茵。",
    "舞姬犹是旧精神。",
    "坐中莫怪无欢意，我与将军是故人。"
  ],
  "enabled": true,
  "collection": "宋词选",
