{
  "id": "poem-2e7c1a3d1ea674ee12f0959f",
  "title": "除夜",
  "author": "曹松",
  "dynasty": "唐",
  "verses": [
    "残腊即又尽，东风应渐闻。",
    "一宵犹几许，两岁欲平分。",
    "燎暗倾时斗，春通绽处芬。",
    "明朝遥捧酒，先合祝尧君。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
