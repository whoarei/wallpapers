{
  "id": "poem-27b6c859893ae999d6552fdf",
  "title": "和韦兄春日南亭宴兄弟",
  "author": "孙逖",
  "dynasty": "唐",
  "verses": [
    "台阁升高位，园林隔旧乡。",
    "忽闻歌棣萼，还比报琼芳。",
    "门向宜春近，郊连御宿长。",
    "德星常有会，相望在文昌。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
