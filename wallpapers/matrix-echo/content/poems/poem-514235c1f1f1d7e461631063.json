{
  "id": "poem-514235c1f1f1d7e461631063",
  "title": "和秉国芙蓉五章  其五",
  "author": "司马光",
  "dynasty": "宋",
  "verses": [
    "但见涉江求水际，岂知胜木采霜中。",
    "微红未肯全衰歇，正似酡颜鸖髪翁。"
  ],
  "enabled": true,
  "collection": "宋诗选",
