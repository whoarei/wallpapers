{
  "id": "poem-1afdcbcf4192f8e85f745869",
  "title": "题武陵洞五首 三",
  "author": "曹唐",
  "dynasty": "唐",
  "verses": [
    "却恐重来路不通，殷勤回首谢春风。",
    "白鸡黄犬不将去，且寄桃花深洞中。"
  ],
  "enabled": true,
