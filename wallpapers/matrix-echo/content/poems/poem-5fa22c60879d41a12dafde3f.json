{
  "id": "poem-5fa22c60879d41a12dafde3f",
  "title": "陆别驾解组",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "不平容赴愬，无枉不相关。",
    "契托今州牧，官同旧笋班。",
    "骚情吟未尽，乐府载将还。",
    "况是平分手，新声课小蛮。"
  ],
  "enabled": true,
  "collection": "宋诗选",
