{
  "id": "poem-a5c75858955e17b57f025569",
  "title": "老人峰",
  "author": "陈岩",
  "dynasty": "宋",
  "verses": [
    "佝偻形容古貌浑，旁连众岭似儿孙。",
    "荒山太古万万古，眼见游人来几番。"
  ],
  "enabled": true,
  "collection": "宋诗选",
