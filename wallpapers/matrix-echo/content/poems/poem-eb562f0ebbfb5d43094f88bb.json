{
  "id": "poem-eb562f0ebbfb5d43094f88bb",
  "title": "御街行·街南绿树春饶絮",
  "author": "晏几道",
  "dynasty": "宋",
  "verses": [
    "街南绿树春饶絮。",
    "雪满游春路。",
    "树头花艳杂娇云，树底人家朱户。",
    "北楼闲上，疏帘高卷，直见街南树。",
    "阑干倚尽犹慵去。",
    "几度黄昏雨。",
    "晚春盘马踏青苔，曾傍绿阴深驻。",
    "落花犹在，香屏空掩，人面知何处。"
  ],
  "enabled": true,
