{
  "id": "poem-0dd2b66168a1993f2bc21b0e",
  "title": "江行无题一百首 七十九",
  "author": "钱珝",
  "dynasty": "唐",
  "verses": [
    "光阔重湖水，低斜远鴈行。",
    "未曾无兴咏，多谢沈东阳。"
  ],
  "enabled": true,
