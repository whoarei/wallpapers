{
  "id": "poem-f3196a995a4c395ea6f12eb0",
  "title": "至德中途中书事却寄李僴",
  "author": "卢纶",
  "dynasty": "唐",
  "verses": [
    "乱离无处不伤情，况复看碑对古城。",
    "路遶寒山人独去，月临秋水鴈空惊。",
    "颜衰重喜归乡国，身贱多惭问姓名。",
    "今日主人还共醉，应怜世故一儒生。"
  ],
  "enabled": true,
