{
  "id": "poem-42fe28cb79f02caa56876f68",
  "title": "送刘逖赴闽辟",
  "author": "贯休",
  "dynasty": "唐",
  "verses": [
    "离乱生涯尽，依刘是见机。",
    "从来吟太苦，不得力还稀。",
    "路入闽山熟，江浮瘴雨肥。",
    "何须折杨柳，相送已依依。"
  ],
  "enabled": true,
