{
  "id": "poem-0aa7bf11f5636ed6b790fac3",
  "title": "郊庙歌辞 享太庙乐章 和宁舞",
  "author": "牛僧孺",
  "dynasty": "唐",
  "verses": [
    "湜湜颀颀，融昭德辉。",
    "不纽不舒，贯成九围。",
    "武烈文经，敷施当宜。",
    "纂尧付启，亿万熙熙。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
