{
  "id": "poem-8cd8e89a17612724a0debe17",
  "title": "送张五𬤇归宣城",
  "author": "王维",
  "dynasty": "唐",
  "verses": [
    "五湖千万里，况复五湖西。",
    "渔浦南陵郭，人家春谷谿。",
    "欲归江淼淼，未到草萋萋。",
    "忆想兰陵镇，可宜猿更啼。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
