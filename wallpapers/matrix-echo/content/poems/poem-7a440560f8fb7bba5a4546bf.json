{
  "id": "poem-7a440560f8fb7bba5a4546bf",
  "title": "偈颂（幷序○序为南岳齐己撰） 四十二",
  "author": "居遁",
  "dynasty": "唐",
  "verses": [
    "昔生未了今须了，此生度取累此身。",
    "古佛未悟同今者，悟了今人即古人。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
