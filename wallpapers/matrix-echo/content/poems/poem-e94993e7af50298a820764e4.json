{
  "id": "poem-e94993e7af50298a820764e4",
  "title": "横吹曲辞 望行人",
  "author": "张籍",
  "dynasty": "唐",
  "verses": [
    "秋风窗下起，旅雁向南飞。",
    "日日出门望，家家行客归。",
    "无因见边使，空待寄寒衣。",
    "独闭青楼暮，烟深鸟雀稀。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
