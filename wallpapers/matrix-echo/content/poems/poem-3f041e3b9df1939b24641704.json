{
  "id": "poem-3f041e3b9df1939b24641704",
  "title": "赠孟浩然",
  "author": "李白",
  "dynasty": "唐",
  "verses": [
    "吾爱孟夫子，风流天下闻。",
    "红颜弃轩冕，白首卧松云。",
    "醉月频中圣，迷花不事君。",
    "高山安可仰，徒此揖清芬。"
  ],
  "enabled": true,
  "collection": "唐诗三百首",
