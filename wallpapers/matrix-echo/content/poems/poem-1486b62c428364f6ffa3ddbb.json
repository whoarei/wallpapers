{
  "id": "poem-1486b62c428364f6ffa3ddbb",
  "title": "玉连环影",
  "author": "纳兰性德",
  "dynasty": "清",
  "verses": [
    "何处几叶萧萧雨。",
    "湿尽檐花，花底人无语。",
    "掩屏山，玉炉寒。",
    "谁见两眉愁聚倚阑干。"
  ],
  "enabled": true,
  "collection": "纳兰词",
