{
  "id": "poem-05c42350cbc3037b600b8521",
  "title": "宋中十首 八",
  "author": "高适",
  "dynasty": "唐",
  "verses": [
    "五霸递征伐，宋人无战功。",
    "解围幸奇说，易子伤吾衷。",
    "唯见卢门外，萧条多转蓬。"
  ],
  "enabled": true,
