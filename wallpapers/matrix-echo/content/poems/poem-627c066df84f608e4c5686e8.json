{
  "id": "poem-627c066df84f608e4c5686e8",
  "title": "镜湖雪霁贻方干",
  "author": "崔道融",
  "dynasty": "唐",
  "verses": [
    "天外晓岚和雪望，月中归棹带冰行。",
    "相逢半醉吟诗苦，应抵寒猨褭树声。"
  ],
