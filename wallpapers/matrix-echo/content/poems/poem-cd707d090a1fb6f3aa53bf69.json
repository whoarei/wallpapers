{
  "id": "poem-cd707d090a1fb6f3aa53bf69",
  "title": "海边见罗邺",
  "author": "贯休",
  "dynasty": "唐",
  "verses": [
    "清世诗声出，谁人得似君。",
    "命通须有日，天未丧斯文。",
    "楚木寒连寺，修江碧入云。",
    "相思喜相见，庭叶正纷纷。"
  ],
  "enabled": true,
