{
  "id": "poem-bf346d90b773fd1099cd7b55",
  "title": "赠率子连  其一",
  "author": "王祜",
  "dynasty": "宋",
  "verses": [
    "下瞰虚空临绝涧，上排烟雾倚山颠。",
    "四边险绝无猿鸟，独卧深云三十年。"
  ],
  "enabled": true,
