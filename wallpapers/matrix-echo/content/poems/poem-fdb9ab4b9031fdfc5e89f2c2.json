{
  "id": "poem-fdb9ab4b9031fdfc5e89f2c2",
  "title": "小游仙诗九十八首 八",
  "author": "曹唐",
  "dynasty": "唐",
  "verses": [
    "风满涂山玉蕊稀，赤龙闲卧鹤东飞。",
    "紫棃烂尽无人吃，何事韩君去不归。"
  ],
  "enabled": true,
