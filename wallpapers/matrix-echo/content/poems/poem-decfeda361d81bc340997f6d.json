{
  "id": "poem-decfeda361d81bc340997f6d",
  "title": "谏堂山",
  "author": "陈岩",
  "dynasty": "宋",
  "verses": [
    "茸茸莎草褭风长，二百年前一谏堂。",
    "旧地几番新地主，谏堂名字愈辉光。"
  ],
  "enabled": true,
