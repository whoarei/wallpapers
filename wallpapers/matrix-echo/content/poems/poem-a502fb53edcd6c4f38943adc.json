{
  "id": "poem-a502fb53edcd6c4f38943adc",
  "title": "仁寿堂",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "阔开荡荡城中天，朝菌灵椿总大年。",
    "凿井耕田皆帝力，不知谁党复谁偏。"
  ],
