{
  "id": "poem-2eb78e73977cf89871a38f75",
  "title": "酬郑进士九江新居见寄",
  "author": "李咸用",
  "dynasty": "唐",
  "verses": [
    "蹑屐扣柴关，因成尽日闲。",
    "独听黄鸟语，深似白云间。",
    "萍沼宽于井，莎城绿当山。",
    "前期招我作，此景得吟还。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
