{
  "id": "poem-2999129309e7c173604f62a7",
  "title": "初夏戏题",
  "author": "徐夤",
  "dynasty": "唐",
  "verses": [
    "长养薰风拂晓吹，渐开荷芰落蔷薇。",
    "青虫也学庄周梦，化作南园蛱蝶飞。"
  ],
  "enabled": true,
