{
  "id": "poem-a8450e5fdecc48d62f2264be",
  "title": "寄冯使君",
  "author": "贯休",
  "dynasty": "唐",
  "verses": [
    "山风与霜气，浩浩满松枝。",
    "永日烧杉子，无人共此时。",
    "为文攀讽谏，得道在毫厘。",
    "唯有桐江守，常怜志不卑。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
