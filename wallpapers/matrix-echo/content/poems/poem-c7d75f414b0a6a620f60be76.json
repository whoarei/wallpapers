{
  "id": "poem-c7d75f414b0a6a620f60be76",
  "title": "得诸季书报薛克寅范茂载胡仲俨皆物故感怆有作",
  "author": "李纲",
  "dynasty": "宋",
  "verses": [
    "新故继凋丧，初非因荷戈。",
    "波惊川阅水，霜早叶辞柯。",
    "世上故人少，录中新鬼多。",
    "浮生端若此，伤感意如何。"
  ],
  "enabled": true,
  "collection": "宋诗选",
