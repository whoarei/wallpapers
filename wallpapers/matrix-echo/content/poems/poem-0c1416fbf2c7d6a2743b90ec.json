{
  "id": "poem-0c1416fbf2c7d6a2743b90ec",
  "title": "渡汉江",
  "author": "宋之问",
  "dynasty": "唐",
  "verses": [
    "岭外音书断，经冬复历春。",
    "近乡情更怯，不敢问来人。"
  ],
  "enabled": true,
