{
  "id": "poem-dec54a257dfa1726d2144f1b",
  "title": "闻春雷",
  "author": "司空曙",
  "dynasty": "唐",
  "verses": [
    "水国春雷早，阗阗若众车。",
    "自怜迁逐者，犹滞蛰藏余。"
  ],
  "enabled": true,
