{
  "id": "poem-8f63df291e3be64a39ef463c",
  "title": "采桑子·九日",
  "author": "纳兰性德",
  "dynasty": "清",
  "verses": [
    "深秋绝塞谁相忆，木叶萧萧。",
    "乡路迢迢。",
    "六曲屏山和梦遥。",
    "佳时倍惜风光别，不为登高。",
    "只觉魂销。",
    "南雁归时更寂寥。"
  ],
  "enabled": true,
  "collection": "纳兰词",
