{
  "id": "poem-03425745d358827b4d9f4194",
  "title": "再次韵  其一",
  "author": "陈造",
  "dynasty": "宋",
  "verses": [
    "咄咄嗟数奇，覤覤笑坐驰。",
    "超然达观士，显晦用一机。",
    "夫君抱器业，轩豁见奇姿。",
    "付我舟一叶，缗丝漾清漪。"
  ],
  "enabled": true,
  "collection": "宋诗选",
