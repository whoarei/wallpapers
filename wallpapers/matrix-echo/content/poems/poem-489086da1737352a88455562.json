{
  "id": "poem-489086da1737352a88455562",
  "title": "蕉园",
  "author": "纳兰性德",
  "dynasty": "清",
  "verses": [
    "见说斋坦闭，前朝大乙祠。",
    "莺边花树树，燕外柳丝丝。",
    "宫御人稀少，词臣例许窥。",
    "今朝陪豹尾，新长万年枝。"
  ],
  "enabled": true,
  "collection": "纳兰词",
  "tags": [],
