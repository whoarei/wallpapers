{
  "id": "poem-77e49d599e66db831db49ae4",
  "title": "赋月",
  "author": "李绅",
  "dynasty": "唐",
  "verses": [
    "月，光辉，皎洁。",
    "耀乾坤，静空阔。",
    "圆满中秋，玩争诗哲。",
    "玉兔镝难穿，桂枝人共折。",
    "万象照乃无私，琼台岂遮君谒。",
    "抱琴对弹别鹤声，不得知音声不切。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
