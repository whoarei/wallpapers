{
  "id": "poem-c2717d8897b01e323dfc5440",
  "title": "赠李司议",
  "author": "张籍",
  "dynasty": "唐",
  "verses": [
    "汉庭谁问投荒客，十载天南着白衣。",
    "秋草茫茫恶谿路，岭头遥送北人稀。"
  ],
  "enabled": true,
