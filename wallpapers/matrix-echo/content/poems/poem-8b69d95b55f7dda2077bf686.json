{
  "id": "poem-8b69d95b55f7dda2077bf686",
  "title": "送友人及第后归台州",
  "author": "贯休",
  "dynasty": "唐",
  "verses": [
    "得桂为边辟，翩翩颇合宜。",
    "嫖姚留不住，昼锦已归迟。",
    "岛侧花藏虎，湖心浪撼棋。",
    "终期华顶下，共礼渌身师。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
