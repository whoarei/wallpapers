{
  "id": "poem-45ba2581ccd7cc91dcf41402",
  "title": "失白鹰",
  "author": "郑繇",
  "dynasty": "唐",
  "verses": [
    "白锦文章乱，丹霄羽翮齐。",
    "云中呼暂下，雪里放还迷。",
    "梁苑惊池鹜，陈仓拂野鸡。"
  ],
  "enabled": true,
