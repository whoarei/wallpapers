{
  "id": "poem-2a5ccc7de45fb994215f0f84",
  "title": "山中寄梁判官",
  "author": "李山甫",
  "dynasty": "唐",
  "verses": [
    "归卧东林计偶谐，柴门深向翠微开。",
    "更无尘事心头起，还有诗情象外来。",
    "康乐公应频结社，寒山子亦患多才。",
    "星郎雅是道中侣，六艺拘牵在隗台。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
