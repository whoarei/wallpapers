{
  "id": "poem-fa0458ed668d75a8baf84bc3",
  "title": "林主簿明仲挽词  其一",
  "author": "王十朋",
  "dynasty": "宋",
  "verses": [
    "齿德尊乡党，匈中有古今。",
    "箕裘传蕴藻，臧否判崔林。",
    "呼佛知仁政，名轩见道心。",
    "扁舟欲访戴，仙去不容寻。"
  ],
  "enabled": true,
  "collection": "宋诗选",
