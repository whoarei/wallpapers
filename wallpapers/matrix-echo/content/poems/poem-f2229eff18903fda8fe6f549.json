{
  "id": "poem-f2229eff18903fda8fe6f549",
  "title": "游喷玉潭  其二",
  "author": "司马光",
  "dynasty": "宋",
  "verses": [
    "万木吼穹谷，驽骀屹不前。",
    "犹胜望尘客，伫立九衢边。"
  ],
  "enabled": true,
