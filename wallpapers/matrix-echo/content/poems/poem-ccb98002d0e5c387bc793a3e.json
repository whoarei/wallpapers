{
  "id": "poem-ccb98002d0e5c387bc793a3e",
  "title": "不食姑",
  "author": "张籍",
  "dynasty": "唐",
  "verses": [
    "几年山里住，已作绿毛身。",
    "护气常稀语，存思自见神。",
    "养龟同不食，留药任生尘。",
    "要问西王母，仙中第几人。"
  ],
  "enabled": true,
