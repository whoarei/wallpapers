{
  "id": "poem-e562b904912e09ef09c5a0eb",
  "title": "仙源即事三首  其一",
  "author": "王镃",
  "dynasty": "宋",
  "verses": [
    "鼎沸秦汤满世间，恨无凉雨洗松关。",
    "道人识破先天易，又欲携包过别山。"
  ],
