{
  "id": "poem-3591882e8f52f050a098fd71",
  "title": "腊后感怀和光道韵",
  "author": "华镇",
  "dynasty": "宋",
  "verses": [
    "达人蔑视千钟禄，曲士惊谈五石瓢。",
    "腊尽自怜春气近，月明谁念美人遥。",
    "铅华次第开梅萼，金色依稀著柳条。",
    "莫问阴山更阴处，数峰残雪未全销。"
  ],
  "enabled": true,
  "collection": "宋诗选",
