{
  "id": "poem-af5f057386027261e9acc7ec",
  "title": "溪村晚望",
  "author": "王镃",
  "dynasty": "宋",
  "verses": [
    "宿鹭分行落照边，村藏深树远吹烟。",
    "天然诗句无人识，划记寒沙抄一篇。"
  ],
  "enabled": true,
