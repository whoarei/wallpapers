{
  "id": "poem-9ec874e8e692c4200dcb55bf",
  "title": "浣溪沙·水北烟寒雪似梅",
  "author": "毛滂",
  "dynasty": "宋",
  "verses": [
    "水北烟寒雪似梅。",
    "水南梅闹雪千堆。",
    "月明南北两瑶台。",
    "云近恰如天上坐，魂清疑向斗边来。",
    "梅花多处载春回。"
  ],
  "enabled": true,
  "collection": "宋词选",
