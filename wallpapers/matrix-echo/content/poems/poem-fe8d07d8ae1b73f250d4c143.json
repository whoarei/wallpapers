{
  "id": "poem-fe8d07d8ae1b73f250d4c143",
  "title": "横吹曲辞 入塞曲 二",
  "author": "僧贯休",
  "dynasty": "唐",
  "verses": [
    "方见将军贵，分明对冕旒。",
    "圣恩如远被，狂虏不难收。",
    "臣节唯期死，功勋敢望侯。",
    "终辞修里第，从此出皇州。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
