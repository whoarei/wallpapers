{
  "id": "poem-b9b5813eae3d7f8ab0f48b69",
  "title": "题终南山隐者居",
  "author": "姚鹄",
  "dynasty": "唐",
  "verses": [
    "开门绝壑旁，蹑藓过花梁。",
    "路入峰峦影，风来芝术香。",
    "夜吟明雪牖，春梦闭云房。",
    "尽室更何有，一琴兼一觞。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
  "tags": [
    "终南山"
  ],
