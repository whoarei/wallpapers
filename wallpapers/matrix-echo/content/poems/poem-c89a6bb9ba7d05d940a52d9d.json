{
  "id": "poem-c89a6bb9ba7d05d940a52d9d",
  "title": "嘲燕",
  "author": "宋伯仁",
  "dynasty": "宋",
  "verses": [
    "年来乳燕亦堪羞，不学杨花得自由。",
    "飞过几家门户去，直须寻见最高楼。"
  ],
  "enabled": true,
