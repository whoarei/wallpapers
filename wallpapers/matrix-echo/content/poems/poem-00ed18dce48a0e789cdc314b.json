{
  "id": "poem-00ed18dce48a0e789cdc314b",
  "title": "郊庙歌辞 封泰山乐章 豫和 四",
  "author": "张说",
  "dynasty": "唐",
  "verses": [
    "高在上，道光明。",
    "物资始，德难名。",
    "承眷命，牧苍生。",
    "寰宇谧，太阶平。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
