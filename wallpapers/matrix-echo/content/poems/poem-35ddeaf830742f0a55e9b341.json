{
  "id": "poem-35ddeaf830742f0a55e9b341",
  "title": "明道颂",
  "author": "智闲",
  "dynasty": "唐",
  "verses": [
    "思思似有踪，明明不知处。",
    "借问示宗宾，徐徐暗回顾。",
    "。"
  ],
  "enabled": true,
