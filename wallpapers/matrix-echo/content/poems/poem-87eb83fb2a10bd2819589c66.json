{
  "id": "poem-87eb83fb2a10bd2819589c66",
  "title": "听弹琴",
  "author": "刘长卿",
  "dynasty": "唐",
  "verses": [
    "泠泠七丝上，静听松风寒。",
    "古调虽自爱，今人多不弹。"
  ],
  "enabled": true,
