{
  "id": "poem-477d681258fbff70fefc3a99",
  "title": "喜雨呈安国  其二",
  "author": "张栻",
  "dynasty": "宋",
  "verses": [
    "早秧出陇蚕已丝，眼中一雨正垂垂。",
    "农家辛苦渠能识，请诵周公七月诗。"
  ],
