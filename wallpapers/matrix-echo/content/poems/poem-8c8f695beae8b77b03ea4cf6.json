{
  "id": "poem-8c8f695beae8b77b03ea4cf6",
  "title": "喜入兰陵望紫阁峰呈宣上人",
  "author": "李益",
  "dynasty": "唐",
  "verses": [
    "薙草开三径，巢林喜一枝。",
    "地宽留种竹，泉浅欲开池。",
    "紫阁当疎牖，青松入坏篱。",
    "从今安僻陋，萧相是吾师。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
