{
  "id": "poem-78a86198997225870ecd3355",
  "title": "阮郎归·湘天风雨破寒初",
  "author": "秦观",
  "dynasty": "宋",
  "verses": [
    "湘天风雨破寒初。",
    "深沈庭院虚。",
    "丽谯吹罢《小单于》。",
    "迢迢清夜徂。",
    "乡梦断，旅魂孤。",
    "峥嵘岁又除。",
    "衡阳犹有雁传书。",
    "郴阳和雁无。"
  ],
  "enabled": true,
  "collection": "宋词三百首",
  "tags": [
    "宋词三百首"
