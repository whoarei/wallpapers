{
  "id": "poem-0ac223a8d0e9aff99e2f5b42",
  "title": "次韵提舶见招",
  "author": "王十朋",
  "dynasty": "宋",
  "verses": [
    "江梅初破一阳天，诗句清新欲鬭妍。",
    "呼我同来饮文字，定扶衰病到尊前。"
  ],
