{
  "id": "poem-c46daab946e532db28fcd97b",
  "title": "清平乐·才听夜雨",
  "author": "纳兰性德",
  "dynasty": "清",
  "verses": [
    "才听夜雨，便觉秋如许。",
    "绕砌蛩螀人不语，有梦转愁无据。",
    "乱山千叠横江，忆君游倦何方。",
    "知否小窗红烛。",
    "照人此夜凄凉。"
  ],
  "enabled": true,
  "collection": "纳兰词",
