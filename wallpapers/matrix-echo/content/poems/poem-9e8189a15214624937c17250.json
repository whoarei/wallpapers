{
  "id": "poem-9e8189a15214624937c17250",
  "title": "点绛唇·病卧秋风",
  "author": "向子𬤇",
  "dynasty": "宋",
  "verses": [
    "病卧秋风，懒寻杯酒追欢宴。",
    "梦游都甸。",
    "不改当年观。",
    "故旧雕零，天下今无半。",
    "烟尘远。",
    "泪珠零乱。",
    "怕问随阳雁。"
  ],
  "enabled": true,
  "collection": "宋词选",
