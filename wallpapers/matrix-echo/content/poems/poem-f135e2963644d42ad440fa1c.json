{
  "id": "poem-f135e2963644d42ad440fa1c",
  "title": "天池圣灯  其二",
  "author": "萧之敏",
  "dynasty": "宋",
  "verses": [
    "细如珠颗大如杯，照夜浮空去复来。",
    "神物戏人安可料，密移星斗下岩隈。"
  ],
  "enabled": true,
