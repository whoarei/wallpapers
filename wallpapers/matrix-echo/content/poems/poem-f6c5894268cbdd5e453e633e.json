{
  "id": "poem-f6c5894268cbdd5e453e633e",
  "title": "夜到渔家",
  "author": "张籍",
  "dynasty": "唐",
  "verses": [
    "渔家在江口，潮水入柴扉。",
    "行客欲投宿，主人犹未归。",
    "竹深村路远，月出钓船稀。",
    "遥见寻沙岸，春风动草衣。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
