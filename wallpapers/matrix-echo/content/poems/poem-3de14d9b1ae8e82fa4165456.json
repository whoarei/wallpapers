{
  "id": "poem-3de14d9b1ae8e82fa4165456",
  "title": "奉赠宣抚孟参政二首  其二",
  "author": "李纲",
  "dynasty": "宋",
  "verses": [
    "睢阳一别五经春，邂逅相逢瘴海滨。",
    "华髪知公因国事，苍颜顾我久埃尘。",
    "绨袍念旧故人意，药裹关心多病身。",
    "入觐从容见知旧，为言秪欲老垂纶。"
  ],
  "enabled": true,
  "collection": "宋诗选",
