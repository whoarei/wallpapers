{
  "id": "poem-905f8d4d92fdca2f5fbdfe4a",
  "title": "送韩绅卿",
  "author": "李端",
  "dynasty": "唐",
  "verses": [
    "春雨昨开花，秋霜忽沾草。",
    "荣枯催日夕，去住皆须老。",
    "君望汉家原，高坟渐成道。"
  ],
  "enabled": true,
