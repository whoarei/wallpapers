{
  "id": "poem-afe04ca19dc8f7bc0fe3c9b0",
  "title": "后宫词",
  "author": "白居易",
  "dynasty": "唐",
  "verses": [
    "泪湿罗巾梦不成，夜深前殿按歌声。",
    "红颜未老恩先断，斜倚薰笼坐到明。"
  ],
  "enabled": true,
  "collection": "唐诗三百首",
