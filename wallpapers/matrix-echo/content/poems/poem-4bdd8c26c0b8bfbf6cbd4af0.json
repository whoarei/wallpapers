{
  "id": "poem-4bdd8c26c0b8bfbf6cbd4af0",
  "title": "送梓州李使君",
  "author": "王维",
  "dynasty": "唐",
  "verses": [
    "万壑树参天，千山响杜鹃。",
    "山中一夜雨，树杪百重泉。",
    "汉女输橦布，巴人讼芋田。",
    "文翁翻教授，不敢倚先贤。"
  ],
  "enabled": true,
  "collection": "唐诗三百首",
