{
  "id": "poem-a649670d75f62cf58b95f417",
  "title": "奉和华清宫观行香应制",
  "author": "崔国辅",
  "dynasty": "唐",
  "verses": [
    "天子蘂珠宫，楼台碧落通。",
    "豫游皆汗漫，斋处即崆峒。",
    "云物三光里，君臣一气中。",
    "道言何所说，宝历自无穷。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
