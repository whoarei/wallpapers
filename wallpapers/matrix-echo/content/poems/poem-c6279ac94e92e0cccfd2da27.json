{
  "id": "poem-c6279ac94e92e0cccfd2da27",
  "title": "酬兵部李侍郎晚过东厅之作",
  "author": "包佶",
  "dynasty": "唐",
  "verses": [
    "酒礼慙先祭，刑书已旷官。",
    "诏驰黄纸速，身在绛纱安。",
    "圣位登堂静，生徒跪席寒。",
    "庭槐暂摇落，幸为入春看。"
  ],
  "enabled": true,
