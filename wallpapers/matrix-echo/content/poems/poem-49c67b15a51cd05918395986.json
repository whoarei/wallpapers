{
  "id": "poem-49c67b15a51cd05918395986",
  "title": "祀雨师乐章 亚献终献",
  "author": "包佶",
  "dynasty": "唐",
  "verses": [
    "奠既备，献将终。",
    "神行令，瑞飞空。",
    "迎干德，祈岁功。",
    "乘烟燎，俨从风。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
