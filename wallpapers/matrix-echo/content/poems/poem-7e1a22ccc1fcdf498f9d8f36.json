{
  "id": "poem-7e1a22ccc1fcdf498f9d8f36",
  "title": "横吹曲辞 折杨柳",
  "author": "卢照邻",
  "dynasty": "唐",
  "verses": [
    "倡楼启曙扉，园柳正依依。",
    "鸟鸣知岁隔，条变识春归。",
    "露叶疑啼脸，风花乱舞衣。",
    "攀折聊将寄，军中书信稀。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
