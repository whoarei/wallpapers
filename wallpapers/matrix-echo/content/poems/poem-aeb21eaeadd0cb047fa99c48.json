{
  "id": "poem-aeb21eaeadd0cb047fa99c48",
  "title": "夜宴安乐公主宅",
  "author": "武平一",
  "dynasty": "唐",
  "verses": [
    "王孙帝女下仙台，金牓珠帘入夜开。",
    "遽惜琼筵欢正洽，唯愁银箭晓相催。"
  ],
