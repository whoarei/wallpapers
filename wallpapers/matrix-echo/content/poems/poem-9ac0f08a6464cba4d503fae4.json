{
  "id": "poem-9ac0f08a6464cba4d503fae4",
  "title": "古栢",
  "author": "李洞",
  "dynasty": "唐",
  "verses": [
    "手植知何代，年齐偃盖松。",
    "结根生别树，吹子落邻峰。",
    "古干经龙嗅，高烟过雁冲。",
    "可佳繁叶尽，声不碍秋钟。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
