{
  "id": "poem-73760a2a2cf0d2d471446f2f",
  "title": "山居四景 松风",
  "author": "李纲",
  "dynasty": "宋",
  "verses": [
    "岁晚苍官鬓髪青，回风披拂自悲鸣。",
    "不容逐客多归梦，故作江湖波浪声。"
  ],
  "enabled": true,
