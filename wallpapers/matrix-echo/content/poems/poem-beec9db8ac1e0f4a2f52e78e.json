{
  "id": "poem-beec9db8ac1e0f4a2f52e78e",
  "title": "游越溪",
  "author": "郑绍",
  "dynasty": "唐",
  "verses": [
    "溪水碧悠悠，猨声断客愁。",
    "渔潭逢钓楫，月浦值孤舟。",
    "访泊随烟火，迷途视斗牛。",
    "今宵越乡意，还取醉忘忧。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
