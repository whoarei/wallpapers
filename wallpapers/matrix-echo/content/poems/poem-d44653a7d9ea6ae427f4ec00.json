{
  "id": "poem-d44653a7d9ea6ae427f4ec00",
  "title": "朱砂石",
  "author": "缪岛云",
  "dynasty": "唐",
  "verses": [
    "寒岩万丈陟崔嵬，只恐朱砂势便颓。",
    "采蘩客闻雷擘去，卧云僧见鸟衔来。",
    "丹霞迥烁嵌空片，红日斜分突兀堆。",
    "傥得神僊惠纤粟，便能轻举向瑶台。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
