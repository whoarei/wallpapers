{
  "id": "poem-5c6f0ea454293fa48cf65dd1",
  "title": "观邻老栽松",
  "author": "李端",
  "dynasty": "唐",
  "verses": [
    "虽过老人宅，不解老人心。",
    "何事残阳里，栽松欲待阴。"
  ],
  "enabled": true,
