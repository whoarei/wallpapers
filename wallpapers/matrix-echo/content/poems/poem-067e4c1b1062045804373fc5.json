{
  "id": "poem-067e4c1b1062045804373fc5",
  "title": "途中逢友人",
  "author": "李咸用",
  "dynasty": "唐",
  "verses": [
    "大道将穷阮籍哀，红尘深翳步迟回。",
    "皇天有意自寒暑，白日无情空往来。",
    "霄汉何年征赋客，烟花随处作愁媒。",
    "相逢且快眼前事，莫厌狂歌酒百杯。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
