{
  "id": "poem-751d0f8e586fb1ae696c80f8",
  "title": "渔人",
  "author": "宋伯仁",
  "dynasty": "宋",
  "verses": [
    "不求豪富不求官，衣钵相传一钓竿。",
    "醉展绿蓑眠便得，满城风雨自春寒。"
  ],
  "enabled": true,
  "collection": "宋诗选",
