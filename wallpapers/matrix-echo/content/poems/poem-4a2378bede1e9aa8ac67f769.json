{
  "id": "poem-4a2378bede1e9aa8ac67f769",
  "title": "诗品二十四则 超诣",
  "author": "司空图",
  "dynasty": "唐",
  "verses": [
    "匪神之灵，匪机之微。",
    "如将白云，清风与归。",
    "远引若至，临之已非。",
    "少有道契，终与俗违。",
    "乱山高木，碧苔芳晖。",
    "诵之思之，其声愈稀。"
  ],
  "enabled": true,
