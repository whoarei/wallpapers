{
  "id": "poem-bed23dff241c606bb0f8e664",
  "title": "次韵赵漕  其二",
  "author": "张栻",
  "dynasty": "宋",
  "verses": [
    "雨声历历来庭户，喜色津津到泽虞。",
    "击壤径思同野老，名亭讵敢学坡苏。"
  ],
  "enabled": true,
