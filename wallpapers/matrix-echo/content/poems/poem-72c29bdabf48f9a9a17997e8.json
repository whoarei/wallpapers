{
  "id": "poem-72c29bdabf48f9a9a17997e8",
  "title": "南歌子·脸上金霞细",
  "author": "温庭筠",
  "dynasty": "唐",
  "verses": [
    "脸上金霞细，眉间翠钿深。",
    "倚枕覆鸳衾，隔帘莺百啭，感君心。"
  ],
  "enabled": true,
  "collection": "花间集",
