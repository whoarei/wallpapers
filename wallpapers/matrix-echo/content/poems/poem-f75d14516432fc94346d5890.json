{
  "id": "poem-f75d14516432fc94346d5890",
  "title": "虞美人·荒城又见重阳到",
  "author": "晁补之",
  "dynasty": "宋",
  "verses": [
    "荒城又见重阳到。",
    "狂醉还吹帽。",
    "人生开口笑难逢。",
    "何况良辰一半，别离中。",
    "平台朱履登高处。",
    "犹自怀人否。",
    "且簪黄菊满头归。",
    "惟有此花风韵、似年时。"
  ],
  "enabled": true,
  "collection": "宋词选",
