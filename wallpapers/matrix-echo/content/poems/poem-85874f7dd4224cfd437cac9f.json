{
  "id": "poem-85874f7dd4224cfd437cac9f",
  "title": "夜送赵纵",
  "author": "杨炯",
  "dynasty": "唐",
  "verses": [
    "赵氏连城璧，由来天下传。",
    "送君还旧府，明月满前川。"
  ],
  "enabled": true,
