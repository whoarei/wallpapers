{
  "id": "poem-a53ddc1441a756ddc07e81b9",
  "title": "辞见闻颂",
  "author": "智闲",
  "dynasty": "唐",
  "verses": [
    "好住迳分离，幽宗人迹稀。",
    "从来未登陟，无许遣狐疑。"
  ],
  "enabled": true,
