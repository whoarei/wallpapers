{
  "id": "poem-720dc1e8febf8f5a9268fd6e",
  "title": "感旧三首  其二",
  "author": "王柏",
  "dynasty": "宋",
  "verses": [
    "交契绸缪事未磨，月窗再得共婆娑。",
    "君今有子全无恨，顾我伶俜奈老何。"
  ],
  "enabled": true,
