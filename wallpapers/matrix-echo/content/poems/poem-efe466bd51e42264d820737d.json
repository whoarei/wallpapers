{
  "id": "poem-efe466bd51e42264d820737d",
  "title": "好事近·日绎五千言",
  "author": "程大昌",
  "dynasty": "宋",
  "verses": [
    "日绎五千言，未说年龄可续。",
    "且得襟期萧散，远氛嚣宠辱。",
    "鬓须白尽秀眉生，来伴老眸绿。",
    "人道雪霜林里，有翠松鲜竹。"
  ],
  "enabled": true,
  "collection": "宋词选",
  "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/宋词/ci.song.2000.json#record-231",
