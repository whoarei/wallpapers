{
  "id": "poem-2cbe03dff686a4c41bf951c2",
  "title": "送邓器先赴罗田尉五首  其四",
  "author": "曾协",
  "dynasty": "宋",
  "verses": [
    "古郡有奇观，祖祖灯相传。",
    "子来后往哲，青山古依然。",
    "纷纷簿领中，深观常安然。",
    "但使内外尽，饥餐困须眠。"
  ],
  "enabled": true,
  "collection": "宋诗选",
