{
  "id": "poem-488fe749d4cad978f1e487a0",
  "title": "咏手二首 二",
  "author": "赵光远",
  "dynasty": "唐",
  "verses": [
    "撚玉搓琼软复圆，绿窗谁见上琴弦。",
    "慢笼彩笔闲书字，斜指瑶阶笑打钱。",
    "炉面试香添麝炷，舌头轻点贴金钿。",
    "象床珍簟宫棋处，拈定文楸占角边。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
