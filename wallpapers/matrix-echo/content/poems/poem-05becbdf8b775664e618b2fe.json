{
  "id": "poem-05becbdf8b775664e618b2fe",
  "title": "偶然五首 一",
  "author": "皎然",
  "dynasty": "唐",
  "verses": [
    "乐禅心似荡，吾道不相妨。",
    "独悟歌还笑，谁言老更狂。"
  ],
