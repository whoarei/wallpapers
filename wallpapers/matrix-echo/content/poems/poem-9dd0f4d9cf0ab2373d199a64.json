{
  "id": "poem-9dd0f4d9cf0ab2373d199a64",
  "title": "戏示语道",
  "author": "刘跂",
  "dynasty": "宋",
  "verses": [
    "御史青骢持望重，将军赤兔得勋多。",
    "乘黄騕褭今相见，垓下乌骓奈若何。"
  ],
  "enabled": true,
