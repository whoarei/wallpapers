{
  "id": "poem-66ec60ca219e0c68d7b2a357",
  "title": "谒金门·香乍起",
  "author": "曹勋",
  "dynasty": "宋",
  "verses": [
    "香乍起。",
    "满院垂垂岩桂。",
    "未卷珠帘香已至。",
    "酒杯言笑里。",
    "叶下茸金繁蕊。",
    "别是清妍风致。",
    "更远随人闻细细。",
    "月华天似水。"
  ],
  "enabled": true,
  "collection": "宋词选",
