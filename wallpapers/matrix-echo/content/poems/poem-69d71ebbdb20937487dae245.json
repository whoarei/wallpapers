{
  "id": "poem-69d71ebbdb20937487dae245",
  "title": "读庄子六绝句  其三",
  "author": "李纲",
  "dynasty": "宋",
  "verses": [
    "养生有主卫生经，神守全时岂废形。",
    "游刃有余刀不挫，解牛须是学庖丁。"
  ],
