{
  "id": "poem-c6b9c4043138299d78071756",
  "title": "喻道",
  "author": "李咸用",
  "dynasty": "唐",
  "verses": [
    "汉武秦皇漫苦辛，那思俗骨本含真。",
    "不知流水潜催老，未悟三山也是尘。",
    "牢落沙丘终古恨，寂寥函谷万年春。",
    "长生客待仙桃饵，月里婵娟笑煞人。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
