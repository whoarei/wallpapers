{
  "id": "poem-2228e01a0bbfbc38cccb1201",
  "title": "后潘",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "后潘水上竺仙家，领客来分竹里茶。",
    "明日归时须记取，白苹賸采半开花。"
  ],
