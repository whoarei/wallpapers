{
  "id": "poem-d91bfeb98b1e9f622502990d",
  "title": "秋浦歌",
  "author": "李白",
  "dynasty": "唐",
  "verses": [
    "白发三千丈，离愁似个长。",
    "不知明镜里，何处得秋霜。"
  ],
  "enabled": true,
  "collection": "千家诗",
