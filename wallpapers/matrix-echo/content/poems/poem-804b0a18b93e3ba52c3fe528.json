{
  "id": "poem-804b0a18b93e3ba52c3fe528",
  "title": "无衣",
  "author": "佚名",
  "dynasty": "先秦",
  "verses": [
    "岂曰无衣七兮？不如子之衣，安且吉兮！",
    "岂曰无衣六兮？不如子之衣，安且燠兮！"
  ],
