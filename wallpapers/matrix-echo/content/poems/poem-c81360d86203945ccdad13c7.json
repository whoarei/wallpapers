{
  "id": "poem-c81360d86203945ccdad13c7",
  "title": "和史侍郎游澹岩韵六首  其一",
  "author": "曾协",
  "dynasty": "宋",
  "verses": [
    "底叹兹岩省见稀，惯居故国看山围。",
    "应缘此日慰岑寂，聊遣清诗为发挥。"
  ],
  "enabled": true,
