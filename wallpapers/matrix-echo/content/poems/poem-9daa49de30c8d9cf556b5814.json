{
  "id": "poem-9daa49de30c8d9cf556b5814",
  "title": "送僧清演归山",
  "author": "李洞",
  "dynasty": "唐",
  "verses": [
    "毛褐斜肩背负经，晓思吟入窦山青。",
    "峰前野水横官道，踏着秋天三四星。"
  ],
  "enabled": true,
