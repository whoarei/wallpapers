{
  "id": "poem-089205f32f9aa6122c0a8c31",
  "title": "和王彦舟",
  "author": "米芾",
  "dynasty": "宋",
  "verses": [
    "混尘慵走俗，陟𪩘喜非期。",
    "漠漠江雨歇，溶深春水时。",
    "陶潜那寄傲，惠远更能诗。",
    "吏自成稀阔，言归心尚迟。"
  ],
  "enabled": true,
  "collection": "宋诗选",
