{
  "id": "poem-fdb452bd310ff5044ac11785",
  "title": "又景亮惠藜杖赋绝句以谢  其一",
  "author": "刘跂",
  "dynasty": "宋",
  "verses": [
    "藜根矫矫似枯松，扶我蹒跚病力穷。",
    "置几赐餐非所重，康宁愿学乐全翁。"
  ],
  "enabled": true,
  "collection": "宋诗选",
