{
  "id": "poem-7ad894198c740efc109d48eb",
  "title": "挽汪约叟  其一",
  "author": "王柏",
  "dynasty": "宋",
  "verses": [
    "幸有灵光在，天乎作么亡。",
    "生来最真实，病里亦康强。",
    "和气留丹鼎，清尘凝笔床。",
    "溪山呈秀处，风露悄凄凉。"
  ],
  "enabled": true,
  "collection": "宋诗选",
