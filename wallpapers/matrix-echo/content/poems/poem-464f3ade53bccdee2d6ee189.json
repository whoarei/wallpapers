{
  "id": "poem-464f3ade53bccdee2d6ee189",
  "title": "诫宗教接物颂",
  "author": "智闲",
  "dynasty": "唐",
  "verses": [
    "三句语，究人玄。",
    "迅面目，示豁然。",
    "开两路，备机缘。",
    "投不遇，说多年。"
  ],
  "enabled": true,
