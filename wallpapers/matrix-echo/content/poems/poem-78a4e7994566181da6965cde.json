{
  "id": "poem-78a4e7994566181da6965cde",
  "title": "宿疏山戏成一绝",
  "author": "李纲",
  "dynasty": "宋",
  "verses": [
    "疏山缘熟岂无由，暂到人人识故侯。",
    "临别慇勤语禅子，秪来托宿不来游。"
  ],
  "enabled": true,
