{
  "id": "poem-e819f77d8655d5eb3dab1252",
  "title": "番女怨·碛南沙上惊雁起",
  "author": "温庭筠",
  "dynasty": "唐",
  "verses": [
    "碛南沙上惊雁起，飞雪千里。",
    "玉连环，金镞箭，年年征战。",
    "画楼离恨锦屏空，杏花红。"
  ],
  "enabled": true,
  "collection": "花间集",
