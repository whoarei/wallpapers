{
  "id": "poem-7b30e2257d354c0f8cd7f474",
  "title": "寓意",
  "author": "李咸用",
  "dynasty": "唐",
  "verses": [
    "直道荆棘生，斜径红尘起。",
    "苍苍杳无言，麒麟回瑞趾。",
    "东风如未来，飞雪终不已。"
  ],
  "enabled": true,
