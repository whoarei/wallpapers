{
  "id": "poem-b1e671f4e5c24dd693db3170",
  "title": "晚秋 二",
  "author": "佚名",
  "dynasty": "唐",
  "verses": [
    "天涯地角一何长，雁塞龙塠万里疆。",
    "每恨沦流经数载，更嗟缧绁泣千行。"
  ],
