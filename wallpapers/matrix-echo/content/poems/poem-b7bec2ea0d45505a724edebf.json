{
  "id": "poem-b7bec2ea0d45505a724edebf",
  "title": "寄故人",
  "author": "张籍",
  "dynasty": "唐",
  "verses": [
    "静曲闲房病客居，蝉声满树槿花疎。",
    "故人祗在蓝田县，强半年来未得书。"
  ],
  "enabled": true,
