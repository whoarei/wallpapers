{
  "id": "poem-7f318ec3688ebb0fe5140264",
  "title": "渡汉江",
  "author": "李频",
  "dynasty": "唐",
  "verses": [
    "岭外音书绝，经年复历春。",
    "近乡情更怯，不敢问来人。"
  ],
  "enabled": true,
