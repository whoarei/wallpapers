{
  "id": "poem-8a9d43be4cabd4be13728847",
  "title": "赴彭州山行之作",
  "author": "高适",
  "dynasty": "唐",
  "verses": [
    "峭壁连崆峒，攒峰叠翠微。",
    "鸟声堪驻马，林色可忘机。",
    "怪石时侵径，轻萝乍拂衣。",
    "路长愁作客，年老更思归。",
    "且悦岩峦胜，宁嗟意绪违。",
    "山行应未尽，谁与玩芳菲。"
  ],
  "enabled": true,
