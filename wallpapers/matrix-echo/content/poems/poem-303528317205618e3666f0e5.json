{
  "id": "poem-303528317205618e3666f0e5",
  "title": "十二咏 花坞",
  "author": "李纲",
  "dynasty": "宋",
  "verses": [
    "收拾群英赖化工，嫣然红紫自成丛。",
    "四时不绝芳菲意，谁谓春归阆苑中。"
  ],
  "enabled": true,
