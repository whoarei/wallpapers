{
  "id": "poem-2be8a3700fc46ae7ae725ed6",
  "title": "霜月",
  "author": "李商隐",
  "dynasty": "唐",
  "verses": [
    "初闻征雁已无蝉，百尺楼台水接天。",
    "青女素娥俱耐冷，月中霜里斗婵娟。"
  ],
  "enabled": true,
  "collection": "千家诗",
