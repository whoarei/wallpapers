{
  "id": "poem-a09d6a4ec471a615b412584c",
  "title": "更漏子 其六",
  "author": "温庭筠",
  "dynasty": "唐",
  "verses": [
    "玉炉香，红蜡泪，偏照画堂秋思。",
    "眉黛薄，鬓云残，夜长衾枕寒。",
    "梧桐树，三更雨，不道离情正苦。",
    "一叶叶，一声声，空阶滴到明。"
  ],
  "enabled": true,
  "collection": "花间集",
  "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/五代诗词/huajianji/huajianji-1-juan.json#record-19",
