{
  "id": "poem-164788c66aaac37658a185bb",
  "title": "韦轩游山遇雨",
  "author": "王柏",
  "dynasty": "宋",
  "verses": [
    "踏碎羊山黄叶堆，天飞细雨相车回。",
    "二皇应讶来何晚，不忍听君话别杯。"
  ],
  "enabled": true,
