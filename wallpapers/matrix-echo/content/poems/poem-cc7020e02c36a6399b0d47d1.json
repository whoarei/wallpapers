{
  "id": "poem-cc7020e02c36a6399b0d47d1",
  "title": "客舍喜友人相访",
  "author": "贺兰朋吉",
  "dynasty": "唐",
  "verses": [
    "荒居无四隣，谁肯访来频。",
    "古树秋中叶，他乡病里身。",
    "鴈声风送急，萤影月流新。",
    "独为成名晚，多慙见友人。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
