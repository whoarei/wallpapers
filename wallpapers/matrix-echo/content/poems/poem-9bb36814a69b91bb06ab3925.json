{
  "id": "poem-9bb36814a69b91bb06ab3925",
  "title": "春秋战国门 臧孙",
  "author": "周昙",
  "dynasty": "唐",
  "verses": [
    "诸孟憎吾似犬狞，贤臧哭孟倍伤情。",
    "季孙爱我如甘疾，疾足亡身药故宁。"
  ],
  "enabled": true,
