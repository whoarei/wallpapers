{
  "id": "poem-1a49d42de547ab6931f248d0",
  "title": "题凌云寺",
  "author": "司空曙",
  "dynasty": "唐",
  "verses": [
    "春山古寺遶沧波，石磴盘空鸟道过。",
    "百丈金身开翠壁，万龛灯焰隔烟萝。",
    "云生客到侵衣湿，花落僧禅覆地多。",
    "不与方袍同结社，下归尘世竟如何。"
  ],
  "enabled": true,
