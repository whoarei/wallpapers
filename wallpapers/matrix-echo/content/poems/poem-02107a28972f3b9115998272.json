{
  "id": "poem-02107a28972f3b9115998272",
  "title": "辞世",
  "author": "释原妙",
  "dynasty": "宋",
  "verses": [
    "来不入死关，去不出死关。",
    "铁蛇钻入海，撞倒须弥山。"
  ],
  "enabled": true,
