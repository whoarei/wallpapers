{
  "id": "poem-e1f16ddaab04233c9cff4092",
  "title": "小游仙诗九十八首 五十三",
  "author": "曹唐",
  "dynasty": "唐",
  "verses": [
    "赤龙停步彩云飞，共道真王海上归。",
    "千岁红桃香破鼻，玉盘盛出与金妃。"
  ],
