{
  "id": "poem-48eb4a40f5957e2403333cd3",
  "title": "会景堂",
  "author": "鲜于侁",
  "dynasty": "宋",
  "verses": [
    "金城环雉堞，云屋瞰阛阓。",
    "双林耸江右，九陇觇天外。"
  ],
  "enabled": true,
