{
  "id": "poem-dfe9ec6fe827e3b6a994386b",
  "title": "题新安国寺",
  "author": "李洞",
  "dynasty": "唐",
  "verses": [
    "佛亦遇艰难，重兴叠废坛。",
    "偃松枝旧折，画竹粉新干。",
    "开讲宫娃听，抛生禁鸟餐。",
    "钟声入帝梦，天竺化长安。"
  ],
  "enabled": true,
