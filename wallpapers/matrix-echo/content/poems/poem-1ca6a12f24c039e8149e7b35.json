{
  "id": "poem-1ca6a12f24c039e8149e7b35",
  "title": "送别",
  "author": "李咸用",
  "dynasty": "唐",
  "verses": [
    "别意说难尽，离杯深莫辞。",
    "长歌终此席，一笑又何时。",
    "棹入寒潭急，帆当落照迟。",
    "远书如不寄，无以慰相思。"
  ],
  "enabled": true,
