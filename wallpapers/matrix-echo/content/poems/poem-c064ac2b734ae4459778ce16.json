{
  "id": "poem-c064ac2b734ae4459778ce16",
  "title": "云安公主出降杂咏催粧二首 一",
  "author": "陆畅",
  "dynasty": "唐",
  "verses": [
    "天上琼花不避秋，今宵织女嫁牵牛。",
    "万人惟待乘鸾出，乞巧齐登明月楼。"
  ],
  "enabled": true,
