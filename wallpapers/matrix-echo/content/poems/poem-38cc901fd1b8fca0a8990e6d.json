{
  "id": "poem-38cc901fd1b8fca0a8990e6d",
  "title": "悼陆秘读",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "诸老骑箕上太微，仲谋不似景升儿。",
    "废寻蹊隧千年古，光奋胸襟一段奇。",
    "直敢昧寻嗟枉尺，方宁适义不成规。",
    "泠然差早终无媿，安俟名垂竹帛为。"
  ],
  "enabled": true,
  "collection": "宋诗选",
