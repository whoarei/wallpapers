{
  "id": "poem-7efb3e15fea9745e31785bd5",
  "title": "冬日作",
  "author": "裴说",
  "dynasty": "唐",
  "verses": [
    "粝食拥败絮，苦吟吟过冬。",
    "稍寒人却健，太饱事多慵。",
    "树老生烟薄，墙阴贮雪重。",
    "安能只如此，公道会相容。"
  ],
  "enabled": true,
