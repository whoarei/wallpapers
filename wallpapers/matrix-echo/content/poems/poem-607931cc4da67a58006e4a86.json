{
  "id": "poem-607931cc4da67a58006e4a86",
  "title": "庄陵挽歌词三首 三",
  "author": "张籍",
  "dynasty": "唐",
  "verses": [
    "晓日龙车动，秋风阊阖开。",
    "行帷六宫出，执绋万方来。",
    "惨惨郊原暮，迟迟挽唱哀。",
    "空山烟雨夕，新陌遶陵台。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
