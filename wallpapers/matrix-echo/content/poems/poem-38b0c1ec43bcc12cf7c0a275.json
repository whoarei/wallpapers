{
  "id": "poem-38b0c1ec43bcc12cf7c0a275",
  "title": "扶南曲歌词五首 三",
  "author": "王维",
  "dynasty": "唐",
  "verses": [
    "香气传空满，妆华影箔通。",
    "歌闻天仗外，舞出御楼中。",
    "日暮归何处，花间长乐宫。"
  ],
  "enabled": true,
