{
  "id": "poem-4068ecdcd64ababbd386cf54",
  "title": "百舌鸟二首 二",
  "author": "无则",
  "dynasty": "唐",
  "verses": [
    "长截隣鸡叫五更，数般名字百般声。",
    "饶伊摇舌先知晓，也待青天明即鸣。"
  ],
  "enabled": true,
