{
  "id": "poem-14559c314e9f7a4ac7fab9c4",
  "title": "酒泉子·紫陌青门",
  "author": "张泌",
  "dynasty": "五代",
  "verses": [
    "紫陌青门，三十六宫春色。",
    "御沟辇路暗相通，杏园风。",
    "咸阳沽酒宝钗空，笑指未央归去。",
    "插花走马落残红，月明中。"
  ],
  "enabled": true,
  "collection": "花间集",
