{
  "id": "poem-d7363c22d6f643cf0812d60c",
  "title": "聚秀阁",
  "author": "王十朋",
  "dynasty": "宋",
  "verses": [
    "清源山远水流长，九日溪山更异常。",
    "高阁摩云聚秀气，禅僧秀气聚中藏。"
  ],
  "enabled": true,
  "collection": "宋诗选",
