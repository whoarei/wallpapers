{
  "id": "poem-3d9237a1cae1cfc7cd91c518",
  "title": "咏史",
  "author": "徐九臯",
  "dynasty": "唐",
  "verses": [
    "亡国秦韩代，荣身刘项年。",
    "金槌击政后，玉斗碎增前。",
    "圣主称三杰，明离保四贤。",
    "已申黄石祭，方慕赤松仙。"
  ],
  "enabled": true,
