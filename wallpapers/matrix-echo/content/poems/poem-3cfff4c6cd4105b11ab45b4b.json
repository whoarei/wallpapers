{
  "id": "poem-3cfff4c6cd4105b11ab45b4b",
  "title": "独坐敬亭山",
  "author": "李白",
  "dynasty": "唐",
  "verses": [
    "众鸟高飞尽，孤云独去闲。",
    "相看两不厌，只有敬亭山。"
  ],
  "enabled": true,
  "collection": "千家诗",
