{
  "id": "poem-ca4f6accf9cbb7a3cefb1dcb",
  "title": "村庄即事",
  "author": "宋伯仁",
  "dynasty": "宋",
  "verses": [
    "青旗猎猎又村庄，僊景还他是水乡。",
    "人近七旬头未白，山无重数叶初黄。",
    "稻畦明月家家酒，茅屋清歌处处霜。",
    "满地菊花秋欲老，客怀牢落愧重阳。"
  ],
  "enabled": true,
  "collection": "宋诗选",
