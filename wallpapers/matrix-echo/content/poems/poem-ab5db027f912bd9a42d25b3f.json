{
  "id": "poem-ab5db027f912bd9a42d25b3f",
  "title": "答卢虔故园见寄",
  "author": "孟郊",
  "dynasty": "唐",
  "verses": [
    "访旧无一人，独归清雒春。",
    "花闻哭声死，水见别容新。",
    "乱后故乡宅，多为行路尘。",
    "因悲楚左右，谤玉不知珉。"
  ],
  "enabled": true,
