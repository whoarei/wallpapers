{
  "id": "poem-3ada506cea8e245a33172e75",
  "title": "少年游·重阳过后",
  "author": "晏殊",
  "dynasty": "宋",
  "verses": [
    "重阳过后，西风渐紧，庭树叶纷纷。",
    "朱阑向晓，芙蓉妖艳，特地斗芳新。",
    "霜前月下，斜红淡蕊，明媚欲回春。",
    "莫将琼萼等闲分。",
    "留赠意中人。"
  ],
  "enabled": true,
  "collection": "宋词选",
