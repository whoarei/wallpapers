{
  "id": "poem-f9aaf507345873a6549c8dea",
  "title": "荷叶杯·记得那时相见",
  "author": "顾敻",
  "dynasty": "五代",
  "verses": [
    "记得那时相见，胆战。",
    "鬓乱四肢柔，泥人无语不抬头。",
    "羞么羞，羞么羞。"
  ],
  "enabled": true,
