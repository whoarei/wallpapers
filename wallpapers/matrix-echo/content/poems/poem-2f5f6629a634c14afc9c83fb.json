{
  "id": "poem-2f5f6629a634c14afc9c83fb",
  "title": "孤屿",
  "author": "张又新",
  "dynasty": "唐",
  "verses": [
    "碧水逶迤浮翠𪩘，绿萝蒙密媚晴江。",
    "不知谁与名孤屿，其实中川是一双。"
  ],
  "enabled": true,
