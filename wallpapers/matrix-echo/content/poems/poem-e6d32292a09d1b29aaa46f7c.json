{
  "id": "poem-e6d32292a09d1b29aaa46f7c",
  "title": "泛溪",
  "author": "项斯",
  "dynasty": "唐",
  "verses": [
    "溪船泛渺弥，渐觉灭炎辉。",
    "动水花连影，逢人鸟背飞。",
    "深犹见白石，凉好换生衣。",
    "未得多诗句，终须隔宿归。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
