{
  "id": "poem-6cd3553b10a0027fc9821dc4",
  "title": "观猎骑",
  "author": "司空曙",
  "dynasty": "唐",
  "verses": [
    "缠臂绣纶巾，貂裘窄称身。",
    "射禽风助箭，走马雪翻尘。",
    "金埒争开道，香车为驻轮。",
    "翩翩不知处，传是霍家亲。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
