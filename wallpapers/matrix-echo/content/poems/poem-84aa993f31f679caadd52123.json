{
  "id": "poem-84aa993f31f679caadd52123",
  "title": "考槃",
  "author": "佚名",
  "dynasty": "先秦",
  "verses": [
    "考槃在涧，硕人之宽。独寐寤言，永矢弗谖。",
    "考槃在阿，硕人之薖。独寐寤歌，永矢弗过。",
    "考槃在六，硕人之轴。独寐寤宿，永矢弗告。"
  ],
  "enabled": true,
  "collection": "诗经",
  "tags": [],
