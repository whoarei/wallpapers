{
  "id": "poem-4194100fc863933a49b4a3ee",
  "title": "塞下曲 三",
  "author": "李益",
  "dynasty": "唐",
  "verses": [
    "黄河东流流九折，沙场埋恨何时绝。",
    "蔡琰没去造胡笳，苏武归来持汉节。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
  "tags": [
    "黄河"
