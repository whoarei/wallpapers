{
  "id": "poem-4f53b3e7e5d6ad4d8784af89",
  "title": "春行",
  "author": "李益",
  "dynasty": "唐",
  "verses": [
    "侍臣朝谒罢，戚里自相过。",
    "落日青丝骑，春风白纻歌。",
    "恩承三殿近，猎向五陵多。",
    "归路南桥望，垂杨拂细波。"
  ],
  "enabled": true,
