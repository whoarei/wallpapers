{
  "id": "poem-be2a5b47c489e92cab27c4ad",
  "title": "春思",
  "author": "皇甫冉",
  "dynasty": "唐",
  "verses": [
    "莺啼燕语报新年，马邑龙堆路几千。",
    "家住秦城邻汉苑，心随明月到胡天。",
    "机中锦字论长恨，楼上花枝笑独眠。",
    "为问元戎窦车骑，何时反斾勒燕然。"
  ],
  "enabled": true,
