{
  "id": "poem-dc8b222f58842ed8d2332636",
  "title": "宫词  其六九",
  "author": "张公庠",
  "dynasty": "宋",
  "verses": [
    "圣主忧勤览万机，日高前殿步舆归。",
    "太官进膳传呼速，御合翩翩入禁扉。"
  ],
  "enabled": true,
