{
  "id": "poem-5ecbca53eef777aff532d116",
  "title": "即事寄人",
  "author": "杨凌",
  "dynasty": "唐",
  "verses": [
    "中禁鸣钟日欲高，北窗欹枕望频搔。",
    "相思寂寞青苔合，唯有春风啼伯劳。"
  ],
  "enabled": true,
