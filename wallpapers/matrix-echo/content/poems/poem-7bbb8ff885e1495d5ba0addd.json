{
  "id": "poem-7bbb8ff885e1495d5ba0addd",
  "title": "月下喜邢校书至自洛",
  "author": "李益",
  "dynasty": "唐",
  "verses": [
    "天河夜未央，漫漫复苍苍。",
    "重君远行至，及此明目光。",
    "华星暎衰柳，暗水入寒塘。",
    "客心定何似，余欢方自长。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
