{
  "id": "poem-8aad484e50a941316fc59dce",
  "title": "长门怨",
  "author": "袁晖",
  "dynasty": "唐",
  "verses": [
    "早知君爱歇，本自无萦妒。",
    "谁使恩情深，今来反相误。",
    "愁眠罗帐晓，泣坐金闺暮。",
    "独有梦中魂，犹言意如故。"
  ],
  "enabled": true,
