{
  "id": "poem-b9b3439b7ca9eae9b1242a13",
  "title": "途中",
  "author": "赵嘏",
  "dynasty": "唐",
  "verses": [
    "故园回首雁初来，马上千愁付一杯。",
    "惟有新诗似相识，暮山吟处共徘徊。"
  ],
