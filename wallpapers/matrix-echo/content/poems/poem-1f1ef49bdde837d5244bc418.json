{
  "id": "poem-1f1ef49bdde837d5244bc418",
  "title": "别卢纶",
  "author": "畅当",
  "dynasty": "唐",
  "verses": [
    "故交君独在，又欲与君离。",
    "我有新秋泪，非关宋玉悲。"
  ],
  "enabled": true,
