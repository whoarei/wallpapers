{
  "id": "poem-db08a81a7ba8fa8d38280c1f",
  "title": "发新安后途中寄卢中丞二首 二",
  "author": "赵嘏",
  "dynasty": "唐",
  "verses": [
    "晚树萧萧促织愁，风帘似水满床秋。",
    "千山不碍笙歌月，谁伴羊公上夜楼。"
  ],
  "enabled": true,
