{
  "id": "poem-6a9fda5d26ed706257acbce8",
  "title": "再和  其一",
  "author": "张栻",
  "dynasty": "宋",
  "verses": [
    "闭门谢客少过从，独倚修篁傲碧空。",
    "忽喜千条发琼蕊，纷如万鹤出樊笼。",
    "与君前日徘徊久，得句悬知惨淡中。",
    "胸次本无愁可著，何为苦要酒兵攻。"
  ],
  "enabled": true,
  "collection": "宋诗选",
