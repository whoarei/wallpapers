{
  "id": "poem-111d1ec9b4e91ad2e2719154",
  "title": "偈颂七十一首  其二一",
  "author": "释了惠",
  "dynasty": "宋",
  "verses": [
    "年去年来，年来年去。",
    "虽有去来年，且无来去路。",
    "既无来去路，实无有去来。"
  ],
  "enabled": true,
  "collection": "宋诗选",
