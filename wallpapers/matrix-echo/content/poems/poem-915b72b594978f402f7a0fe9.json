{
  "id": "poem-915b72b594978f402f7a0fe9",
  "title": "清明",
  "author": "高菊卿",
  "dynasty": "宋",
  "verses": [
    "南北山头多墓田，清明祭扫各纷然。",
    "纸灰飞作白蝴蝶，泪血染成红杜鹃。",
    "日落狐狸眠冢上，夜归儿女笑灯前。",
    "人生有酒须当醉，一滴何曾到九泉。"
  ],
  "enabled": true,
  "collection": "千家诗",
  "tags": [],
