{
  "id": "poem-0508c8f997aa4596f3580701",
  "title": "蜀道后期",
  "author": "张说",
  "dynasty": "唐",
  "verses": [
    "客心争日月，来往预期程。",
    "秋风不相待，先至洛阳城。"
  ],
  "enabled": true,
