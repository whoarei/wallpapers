{
  "id": "poem-4b5b878429cfa8890c2e8c5e",
  "title": "古乐府 燕歌行",
  "author": "张载",
  "dynasty": "宋",
  "verses": [
    "小雅废兮，东山不作。",
    "哀我人斯，皇心不乐。",
    "烝哉斯人，胡然而天兮，王师于铄。"
  ],
  "enabled": true,
  "collection": "宋诗选",
