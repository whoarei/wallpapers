{
  "id": "poem-51e956011081ddf3ca4b0829",
  "title": "古瑟怨",
  "author": "李益",
  "dynasty": "唐",
  "verses": [
    "破瑟悲秋已减弦，湘灵沈怨不知年。",
    "感君拂拭遗音在，更奏新声明月天。"
  ],
  "enabled": true,
