{
  "id": "poem-4a081b3d2d313830e8d61d5e",
  "title": "题水月台",
  "author": "李涉",
  "dynasty": "唐",
  "verses": [
    "平流白日无人爱，桥上闲行若个知。",
    "水似晴天天似水，两重星点碧琉璃。"
  ],
  "enabled": true,
