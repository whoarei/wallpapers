{
  "id": "poem-5dceca78a3e95066e74e022d",
  "title": "北山",
  "author": "王安石",
  "dynasty": "宋",
  "verses": [
    "北山输绿涨横陂，直堑回塘滟滟时。",
    "细数落花因坐久，缓寻芳草得归迟。"
  ],
  "enabled": true,
  "collection": "千家诗",
