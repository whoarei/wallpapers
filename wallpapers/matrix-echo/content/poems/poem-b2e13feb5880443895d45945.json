{
  "id": "poem-b2e13feb5880443895d45945",
  "title": "秋宿长安韦主簿厅",
  "author": "李洞",
  "dynasty": "唐",
  "verses": [
    "水木清凉夜直厅，愁人楼上唱寒更。",
    "坐劳同步帘前月，鼠动床头印锁声。"
  ],
  "enabled": true,
