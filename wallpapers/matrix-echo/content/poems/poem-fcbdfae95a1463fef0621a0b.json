{
  "id": "poem-fcbdfae95a1463fef0621a0b",
  "title": "送陆处士",
  "author": "张乔",
  "dynasty": "唐",
  "verses": [
    "樽前放浩歌，便起泛烟波。",
    "舟楫故人少，江湖明月多。",
    "孤峰经宿上，僻寺共云过。",
    "若向仙岩住，还应著薜萝。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
