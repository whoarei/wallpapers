{
  "id": "poem-a717a9bfa65b6d5facedec1b",
  "title": "班婕妤怨歌",
  "author": "纳兰性德",
  "dynasty": "清",
  "verses": [
    "团团望舒月，皓皓冰蚕绢。",
    "欲却炎天暑，比月裁成扇。",
    "望舒圆易缺，金风换炎节。",
    "风凉秋气寒，匣扇复谁看。",
    "扇弃何足道，感妾伤怀抱。",
    "对月泪如丝，君恩异旧时。"
  ],
  "enabled": true,
  "collection": "纳兰词",
