{
  "id": "poem-a95633cd1f4dc849ea235791",
  "title": "种桑",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "无衣可柰何，桑树百余窠。",
    "拙计不及此，瘠田谁种它。",
    "绿荷供楚制，白苎入吴歌。",
    "金谷虽佳丽，知谁所得多。"
  ],
  "enabled": true,
  "collection": "宋诗选",
