{
  "id": "poem-cae7e721da3f6db5a337cb7c",
  "title": "新亭",
  "author": "张栻",
  "dynasty": "宋",
  "verses": [
    "风景自今古，斯亭今是非。",
    "绝怜江水去，还有故山围。",
    "得失同千虑，成亏共一机。",
    "所思惟谢傅，不但胜淮淝。"
  ],
  "enabled": true,
