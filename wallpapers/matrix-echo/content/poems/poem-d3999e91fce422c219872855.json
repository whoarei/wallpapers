{
  "id": "poem-d3999e91fce422c219872855",
  "title": "过洛阳城",
  "author": "于邺",
  "dynasty": "唐",
  "verses": [
    "古来利与名，俱在洛阳城。",
    "九陌鼓初起，万车轮已行。",
    "周秦时几变，伊洛水犹清。",
    "二月中桥路，鸟啼春草生。"
  ],
  "enabled": true,
