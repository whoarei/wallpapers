{
  "id": "poem-11a2b4df64545e7feacfa68f",
  "title": "次韵柳郎中二咏  其一",
  "author": "苏颂",
  "dynasty": "宋",
  "verses": [
    "蒲条围坐雪添瓶，侧理糊窗炽炭明。",
    "常对图书堆四壁，却思裘褐胜双旌。",
    "道心生后安休息，事局闲来怕践更。",
    "睡足定应输杜守，穷愁何必学虞卿。"
  ],
  "enabled": true,
  "collection": "宋诗选",
