{
  "id": "poem-87fa771a21e63a245ba3373b",
  "title": "杂曲歌辞 渭城曲",
  "author": "王维",
  "dynasty": "唐",
  "verses": [
    "谓城朝雨浥轻尘，客舍青青柳色春。",
    "劝君更尽一杯酒，西出阳关无故人。"
  ],
