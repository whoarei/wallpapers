{
  "id": "poem-ab80726e3672a3ab2d4fab4d",
  "title": "渔父词・渔父·春入渭阳花气多",
  "author": "赵构",
  "dynasty": "宋",
  "verses": [
    "春入渭阳花气多。",
    "春归时节自清和。",
    "冲晓雾，弄沧波。",
    "载与俱归又若何。"
  ],
  "enabled": true,
  "collection": "宋词选",
