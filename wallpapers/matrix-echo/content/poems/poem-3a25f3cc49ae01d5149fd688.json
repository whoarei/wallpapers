{
  "id": "poem-3a25f3cc49ae01d5149fd688",
  "title": "渔家傲·青女霜前催得绽",
  "author": "欧阳修",
  "dynasty": "宋",
  "verses": [
    "青女霜前催得绽。",
    "金钿乱散枝头遍。",
    "落帽台高开雅宴。",
    "芳尊满。",
    "挼花吹在流霞面。",
    "桃李三春虽可羡。",
    "莺来蝶去芳心乱。",
    "争似仙潭秋水岸。",
    "香不断。",
    "年年自作茱萸伴。"
  ],
  "enabled": true,
  "collection": "宋词选",
