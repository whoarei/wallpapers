{
  "id": "poem-0b434a162cb317ecb2771138",
  "title": "试周郎・诉衷情·乔家深闭郁金堂",
  "author": "贺铸",
  "dynasty": "宋",
  "verses": [
    "乔家深闭郁金堂。",
    "朝镜事梅妆。",
    "云鬟翠钿浮动，微步拥钗梁。",
    "情尚秘，色犹庄。",
    "递瞻相。",
    "弄丝调管，时误新声，翻试周郎。"
  ],
  "enabled": true,
  "collection": "宋词选",
