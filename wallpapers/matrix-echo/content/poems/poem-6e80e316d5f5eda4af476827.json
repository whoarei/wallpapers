{
  "id": "poem-6e80e316d5f5eda4af476827",
  "title": "闲田",
  "author": "释了惠",
  "dynasty": "宋",
  "verses": [
    "秦不耕兮汉不耘，镢头边事杳无闻。",
    "年来也有秋成望，三合清风半合云。"
  ],
  "enabled": true,
