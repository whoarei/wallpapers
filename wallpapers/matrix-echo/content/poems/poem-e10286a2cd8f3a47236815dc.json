{
  "id": "poem-e10286a2cd8f3a47236815dc",
  "title": "和元晦赠上封长老",
  "author": "张栻",
  "dynasty": "宋",
  "verses": [
    "上方元自好，一榻有余清。",
    "祇趁晨钟起，宁闻山鸟声。",
    "高僧足幽事，野客富诗情。",
    "试问峰头景，今朝作么生。"
  ],
  "enabled": true,
  "collection": "宋诗选",
