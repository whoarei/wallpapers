{
  "id": "poem-99801d93edc5406cc1cbf8df",
  "title": "夏日  其二",
  "author": "宋伯仁",
  "dynasty": "宋",
  "verses": [
    "泓泓圆碧漾新荷，猎猎斜风颤绿莎。",
    "农事正忙三月后，野田齐唱插秧歌。"
  ],
  "enabled": true,
