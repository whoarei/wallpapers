{
  "id": "poem-860e5d6eef16106250ad790e",
  "title": "天仙子·怅望前回梦里期",
  "author": "韦庄",
  "dynasty": "五代",
  "verses": [
    "怅望前回梦里期，看花不语苦寻思。",
    "露桃花里小腰肢，眉眼细，鬓云垂，唯有多情宋玉知。"
  ],
  "enabled": true,
  "collection": "花间集",
