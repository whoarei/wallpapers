{
  "id": "poem-5dd7d30c6358c4d8ed948e00",
  "title": "南园十三首 三",
  "author": "李贺",
  "dynasty": "唐",
  "verses": [
    "竹里缲丝挑网车，青蝉独噪日光斜。",
    "桃胶迎夏香琥珀，自课越佣能种瓜。"
  ],
