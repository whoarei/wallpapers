{
  "id": "poem-bd100a195b90e9b0a1137c65",
  "title": "闻蝉",
  "author": "来鹄",
  "dynasty": "唐",
  "verses": [
    "绿槐阴里一声新，雾薄风轻力未匀。",
    "莫道闻时总惆怅，有愁人有不愁人。"
  ],
  "enabled": true,
