{
  "id": "poem-9e6b2d9721b19043b72ac526",
  "title": "和吕御史咏院中藂竹",
  "author": "张纮",
  "dynasty": "唐",
  "verses": [
    "闻君庭竹咏，幽意岁寒多。",
    "叹息为冠小，良工将奈何。"
  ],
  "enabled": true,
