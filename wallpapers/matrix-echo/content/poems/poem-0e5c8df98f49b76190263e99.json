{
  "id": "poem-0e5c8df98f49b76190263e99",
  "title": "虞美人·金闺平帖春云暖",
  "author": "周邦彦",
  "dynasty": "宋",
  "verses": [
    "金闺平帖春云暖。",
    "昼漏花前短。",
    "玉颜酒解艳红消。",
    "一面捧心啼困、不成娇。",
    "别来新翠迷行径。",
    "窗锁玲珑影。",
    "砑绫小字夜来封。",
    "斜倚曲栏凝睇、数归鸿。"
  ],
  "enabled": true,
  "collection": "宋词选",
