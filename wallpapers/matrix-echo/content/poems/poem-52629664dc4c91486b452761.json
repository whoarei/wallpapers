{
  "id": "poem-52629664dc4c91486b452761",
  "title": "报文成",
  "author": "张𬸦",
  "dynasty": "唐",
  "verses": [
    "他道愁胜死，儿言死胜愁。",
    "日夜悬心忆，知隔几年秋。"
  ],
  "enabled": true,
