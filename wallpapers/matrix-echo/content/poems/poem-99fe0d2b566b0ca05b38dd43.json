{
  "id": "poem-99fe0d2b566b0ca05b38dd43",
  "title": "赋帘",
  "author": "太宗皇帝",
  "dynasty": "唐",
  "verses": [
    "参差垂玉阙，舒卷映兰宫。",
    "珠光摇素月，竹影乱清风。",
    "彩散银钩上，文斜桂户中。",
    "惟当杂罗绮，相与媚房栊。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
