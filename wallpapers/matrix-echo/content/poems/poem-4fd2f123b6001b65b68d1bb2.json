{
  "id": "poem-4fd2f123b6001b65b68d1bb2",
  "title": "玩花五首 三",
  "author": "徐凝",
  "dynasty": "唐",
  "verses": [
    "朱霞燄燄山枝动，绿野声声杜宇来。",
    "谁为蜀王身作鸟，自啼还自有花开。"
  ],
  "enabled": true,
