{
  "id": "poem-a5c9bf783662a72a7f427f9b",
  "title": "赠道者",
  "author": "马戴",
  "dynasty": "唐",
  "verses": [
    "深居白云穴，静注赤松经。",
    "往往龙潭上，焚香礼斗星。"
  ],
