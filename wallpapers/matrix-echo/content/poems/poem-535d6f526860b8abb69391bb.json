{
  "id": "poem-535d6f526860b8abb69391bb",
  "title": "六叹 二",
  "author": "李涉",
  "dynasty": "唐",
  "verses": [
    "深院梧桐夹金井，上有辘轳青丝索。",
    "美人清昼汲寒泉，寒泉欲上银缾落。",
    "迢迢碧甃千余尺，竟日倚阑空叹息。",
    "惆怅不来照明镜，却掩洞房抱寂寂。"
  ],
  "enabled": true,
