{
  "id": "poem-45429e78d6352fe76027677b",
  "title": "谒大慈恩寺",
  "author": "高宗皇帝",
  "dynasty": "唐",
  "verses": [
    "日宫开万仞，月殿耸千寻。",
    "花盖飞团影，幡虹曳曲阴。",
    "绮霞遥笼帐，丛珠细网林。",
    "寥廓烟云表，超然物外心。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
