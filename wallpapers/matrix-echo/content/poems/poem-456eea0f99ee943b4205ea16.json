{
  "id": "poem-456eea0f99ee943b4205ea16",
  "title": "失调名·手把合欢彩索",
  "author": "张耒",
  "dynasty": "宋",
  "verses": [
    "手把合欢彩索，殷勤微笑𣨼檀郎。",
    "低低告，不图系腕，图系人肠。"
  ],
  "enabled": true,
