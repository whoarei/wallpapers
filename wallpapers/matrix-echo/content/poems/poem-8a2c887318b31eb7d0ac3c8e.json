{
  "id": "poem-8a2c887318b31eb7d0ac3c8e",
  "title": "悲秋",
  "author": "卢殷",
  "dynasty": "唐",
  "verses": [
    "秋空雁度青天远，疎树蝉嘶白露寒。",
    "阶下败兰犹有气，手中团扇渐无端。"
  ],
  "enabled": true,
