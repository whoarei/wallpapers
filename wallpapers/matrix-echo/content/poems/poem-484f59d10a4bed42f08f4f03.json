{
  "id": "poem-484f59d10a4bed42f08f4f03",
  "title": "姚宰行可和诗索墨酬以元韵  其二",
  "author": "王十朋",
  "dynasty": "宋",
  "verses": [
    "人生几丸墨，老病厌操持。",
    "好与贤明宰，研磨共救时。"
  ],
  "enabled": true,
