{
  "id": "poem-b5edf3d3a3bbfd19a7a6fe86",
  "title": "颂古三十一首  其七",
  "author": "释安永",
  "dynasty": "宋",
  "verses": [
    "石火光中验正邪，等闲拈却眼中沙。",
    "自从不曾少盐酱，敢保渠侬未到家。"
  ],
  "enabled": true,
