{
  "id": "poem-af9a3ebfec5c9bb607cc10c6",
  "title": "送人南归",
  "author": "李益",
  "dynasty": "唐",
  "verses": [
    "人言下江疾，君道下江迟。",
    "五月江路恶，南风惊浪时。",
    "应知近家喜，还有异乡悲。",
    "无奈孤舟夕，山歌闻竹枝。"
  ],
  "enabled": true,
