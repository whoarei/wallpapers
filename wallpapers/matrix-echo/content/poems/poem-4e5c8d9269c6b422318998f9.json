{
  "id": "poem-4e5c8d9269c6b422318998f9",
  "title": "咏怀古迹五首 二",
  "author": "杜甫",
  "dynasty": "唐",
  "verses": [
    "摇落深知宋玉悲，风流儒雅亦吾师。",
    "怅望千秋一洒泪，萧条异代不同时。",
    "江山故宅空文藻，云雨荒台岂梦思。",
    "最是楚宫俱泯灭，舟人指点到今疑。"
  ],
  "enabled": true,
