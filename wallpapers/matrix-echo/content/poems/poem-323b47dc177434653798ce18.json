{
  "id": "poem-323b47dc177434653798ce18",
  "title": "赠心上人",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "一抹新霜雁背寒，满庭疎雨客衣单。",
    "苦心莫负韦编绝，岁晚归来语夜阑。"
  ],
  "enabled": true,
  "collection": "宋诗选",
