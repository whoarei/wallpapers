{
  "id": "poem-8eaab9f0768acbe7efdd994c",
  "title": "颂古四首  其三",
  "author": "释行机",
  "dynasty": "宋",
  "verses": [
    "青蛇提起气腥臊，几个男儿有痛毛。",
    "直下血流犹未觉，举头还见铁山高。"
  ],
