{
  "id": "poem-6cedd19981632739b03eb082",
  "title": "送舍弟",
  "author": "李嘉祐",
  "dynasty": "唐",
  "verses": [
    "诸谢偏推永嘉守，三何独许水曹郎。",
    "老兄鄙思难俦匹，令弟清词堪比量。",
    "叠嶂入云藏古寺，高秋背月转南湘。",
    "定知马上多新句，早寄袁溪当八行。"
  ],
  "enabled": true,
