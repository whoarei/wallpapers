{
  "id": "poem-3444bce59a9e5e832dedffab",
  "title": "远寺钟",
  "author": "司空曙",
  "dynasty": "唐",
  "verses": [
    "杳杳疎钟发，因风清复引。",
    "中宵独听之，似与东林近。"
  ],
  "enabled": true,
