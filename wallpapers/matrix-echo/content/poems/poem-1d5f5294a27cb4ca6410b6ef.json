{
  "id": "poem-1d5f5294a27cb4ca6410b6ef",
  "title": "赠识古法师",
  "author": "栖白",
  "dynasty": "唐",
  "verses": [
    "重城深寺讲初休，却忆家山访旧游。",
    "对月与君相送夜，闻蛩教我独惊秋。",
    "云心杳杳难为别，鹤性萧萧不可留。",
    "遥想孤舟清渭上，飘然帆影起离愁。"
  ],
  "enabled": true,
