{
  "id": "poem-fc0c8178aa9d57d37e359d7f",
  "title": "相和歌辞 玉阶怨",
  "author": "李白",
  "dynasty": "唐",
  "verses": [
    "玉阶生白露，夜久侵罗袜。",
    "却下水精帘，玲珑望秋月。"
  ],
  "enabled": true,
