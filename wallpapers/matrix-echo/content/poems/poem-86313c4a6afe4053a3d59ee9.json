{
  "id": "poem-86313c4a6afe4053a3d59ee9",
  "title": "海庄观稼",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "东输三十六谿湍，海若谽谺不足吞。",
    "我有黄云连断岸，夜深随月看潮痕。"
  ],
  "enabled": true,
  "collection": "宋诗选",
