{
  "id": "poem-a4c8d3340452c3bdb36ef514",
  "title": "乌夜啼·雨馀风露凄然",
  "author": "赵鼎",
  "dynasty": "宋",
  "verses": [
    "雨馀风露凄然。",
    "月流天。",
    "还是年时今夜、照关山。",
    "收别泪。",
    "持杯起。",
    "问婵娟。",
    "问我扁舟流荡、几时还。"
  ],
  "enabled": true,
  "collection": "宋词选",
