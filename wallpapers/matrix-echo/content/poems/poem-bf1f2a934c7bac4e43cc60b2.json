{
  "id": "poem-bf1f2a934c7bac4e43cc60b2",
  "title": "乞宽禅师瘿山罍呈宣供奉",
  "author": "李益",
  "dynasty": "唐",
  "verses": [
    "石色凝秋藓，峰形若夏云。",
    "谁留秦苑地，好赠杏溪君。"
  ],
