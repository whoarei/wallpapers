{
  "id": "poem-add18324f99e0ed6bbacb9b7",
  "title": "游丝",
  "author": "张栻",
  "dynasty": "宋",
  "verses": [
    "游丝浩荡醉春光，倚頼微风故故长。",
    "几度鶑声留欲住，又随飞絮过东墙。"
  ],
  "enabled": true,
  "collection": "宋诗选",
