{
  "id": "poem-da8c7f86509d2826184547c0",
  "title": "题画鹰",
  "author": "华镇",
  "dynasty": "宋",
  "verses": [
    "高飞远走可人情，上蔡东青旧有名。",
    "谁在华堂餍鼎俎，自甘平野掠柴荆。",
    "心忧狐兔纷难尽，眼看豺狼恣不平。",
    "莫倚丝绳金縼美，弓藏鸟尽汝须惊。"
  ],
  "enabled": true,
  "collection": "宋诗选",
