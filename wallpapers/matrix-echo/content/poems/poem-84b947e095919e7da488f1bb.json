{
  "id": "poem-84b947e095919e7da488f1bb",
  "title": "题定武兰亭古本",
  "author": "米芾",
  "dynasty": "宋",
  "verses": [
    "翰墨风流冠古今，鹅池谁不赏山阴。",
    "此书虽向昭陵朽，刻石犹能易黄金。"
  ],
  "enabled": true,
