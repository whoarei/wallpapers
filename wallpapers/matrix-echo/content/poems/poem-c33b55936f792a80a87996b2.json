{
  "id": "poem-c33b55936f792a80a87996b2",
  "title": "病后作",
  "author": "澹交",
  "dynasty": "唐",
  "verses": [
    "未得忘身法，此身终未安。",
    "病肠犹可洗，瘦骨不禁寒。",
    "药少心情饵，经无气力看。",
    "悠悠片云质，独对夕阳残。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
