{
  "id": "poem-b0d0b777221302100bf0ce82",
  "title": "雪",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "集霰夜才分，缤霏晓更零。",
    "未乘风洒洒，先挟雨冥冥。",
    "窗失三更黑，山无一寸青。",
    "有船非剡櫂，谁去扣吟扃。"
  ],
  "enabled": true,
  "collection": "宋诗选",
