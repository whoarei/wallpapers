{
  "id": "poem-c8a2067876e45a23e3555845",
  "title": "桐柏观",
  "author": "任翻",
  "dynasty": "唐",
  "verses": [
    "飘飘云外者，𫏐宿聚仙堂。",
    "半夜人无语，中宵月送凉。",
    "鹤归高树静，萤过小池光。",
    "不得多时住，门开是事忙。"
  ],
  "enabled": true,
