{
  "id": "poem-4ad6183b015dad5663f173bf",
  "title": "秋日湖上",
  "author": "薛莹",
  "dynasty": "唐",
  "verses": [
    "落日五湖游，烟波处处愁。",
    "浮沉千古事，谁与问东流。"
  ],
  "enabled": true,
  "collection": "千家诗",
