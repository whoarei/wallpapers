{
  "id": "poem-10f110c103f5f0c01ce5bf2e",
  "title": "宫词  其八一",
  "author": "张公庠",
  "dynasty": "宋",
  "verses": [
    "冉冉残晖画阁西，宫人行乐恋芳时。",
    "遥闻索辇开黄繖，不尽花前半局棋。"
  ],
  "enabled": true,
