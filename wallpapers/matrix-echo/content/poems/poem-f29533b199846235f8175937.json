{
  "id": "poem-f29533b199846235f8175937",
  "title": "再次沈韵",
  "author": "曾协",
  "dynasty": "宋",
  "verses": [
    "独将春信报天涯，岂是无情定有知。",
    "巧占岁寒怜韵胜，冥搜诗句愧辞枝。",
    "松篁有约成三友，桃李争功彼一时。",
    "珍重休文三昧手，尽回佳处入清诗。"
  ],
  "enabled": true,
  "collection": "宋诗选",
