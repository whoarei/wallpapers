{
  "id": "poem-4541d8ffb5361449e43660b0",
  "title": "渔父",
  "author": "史卫卿",
  "dynasty": "宋",
  "verses": [
    "白头长是醉，湖海不知年。",
    "活业惟耕纲，全家衹住船。",
    "荷花同鹭宿，杨柳得鱼穿。",
    "一笛吹明月，朱门谩管弦。"
  ],
  "enabled": true,
  "collection": "宋诗选",
