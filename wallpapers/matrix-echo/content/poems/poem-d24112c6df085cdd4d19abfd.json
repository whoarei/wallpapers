{
  "id": "poem-d24112c6df085cdd4d19abfd",
  "title": "浣溪沙·寂寞流苏冷绣茵",
  "author": "阎选",
  "dynasty": "五代",
  "verses": [
    "寂寞流苏冷绣茵，倚屏山枕惹香尘，小庭花露泣浓香。",
    "刘阮信非仙洞客，嫦娥终是月中人，此生无路访东邻。"
  ],
  "enabled": true,
