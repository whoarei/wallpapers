{
  "id": "poem-034a2eee4b25f80ae271a1f7",
  "title": "京山行",
  "author": "孟郊",
  "dynasty": "唐",
  "verses": [
    "众䖟聚病马，流血不得行。",
    "后路起夜色，前山闻虎声。",
    "此时游子心，百尺风中旌。"
  ],
  "enabled": true,
