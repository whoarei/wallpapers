{
  "id": "poem-6eee50dae7ab081b200383cf",
  "title": "玉楼春·泥银四壁盘蜗篆",
  "author": "毛滂",
  "dynasty": "宋",
  "verses": [
    "泥银四壁盘蜗篆。",
    "明月一庭秋满院。",
    "不知陶菊总开无，但见杜苔新雨遍。",
    "去年醉倒云为簟。",
    "未尽百壶惊日短。",
    "小云今夜伴牢愁，好在凤凰春未晚。"
  ],
  "enabled": true,
