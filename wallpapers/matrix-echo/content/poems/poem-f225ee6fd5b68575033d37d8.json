{
  "id": "poem-f225ee6fd5b68575033d37d8",
  "title": "春秋战国门 郑相",
  "author": "周昙",
  "dynasty": "唐",
  "verses": [
    "郑相清贤慎有余，好鱼鱼至竟何如。",
    "退鱼留得终身禄，禄在何忧不得鱼。"
  ],
  "enabled": true,
