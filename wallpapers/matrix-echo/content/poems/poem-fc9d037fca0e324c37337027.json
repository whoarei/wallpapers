{
  "id": "poem-fc9d037fca0e324c37337027",
  "title": "和厉玄侍御题户部相公庐山草堂",
  "author": "刘得仁",
  "dynasty": "唐",
  "verses": [
    "白云居创毕，诏入凤池年。",
    "林长双峰树，潭分并寺泉。",
    "石溪盘鹤外，岳室闭猨前。",
    "柱史题诗后，松前更肃然。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
  "tags": [
    "庐山"
  ],
