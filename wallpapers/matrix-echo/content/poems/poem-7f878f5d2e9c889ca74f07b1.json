{
  "id": "poem-7f878f5d2e9c889ca74f07b1",
  "title": "送客游荆州",
  "author": "李嘉祐",
  "dynasty": "唐",
  "verses": [
    "草色随骢马，悠悠共出秦。",
    "水传云梦晓，山接洞庭春。",
    "帆影连三峡，猨声在四隣。",
    "青门一分首，难见杜陵人。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
  "tags": [
    "洞庭湖",
    "送别"
  ],
