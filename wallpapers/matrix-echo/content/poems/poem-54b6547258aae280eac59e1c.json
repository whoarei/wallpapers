{
  "id": "poem-54b6547258aae280eac59e1c",
  "title": "深上人见访忆李端",
  "author": "司空曙",
  "dynasty": "唐",
  "verses": [
    "雁稀秋色尽，落日对寒山。",
    "避事多称疾，留僧独闭关。",
    "心归尘俗外，道胜有无间。",
    "仍忆东林友，相期久不还。"
  ],
  "enabled": true,
