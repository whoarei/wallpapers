{
  "id": "poem-ff3f6924b19f1f7605950e86",
  "title": "楚江怀古三首 一",
  "author": "马戴",
  "dynasty": "唐",
  "verses": [
    "露气寒光集，微阳下楚丘。",
    "猨啼洞庭树，人在木兰舟。",
    "广泽生明月，苍山夹乱流。",
    "云中君不降，竟夕自悲秋。"
  ],
  "enabled": true,
  "collection": "唐诗三百首",
