{
  "id": "poem-1d4bd1ea14233c66f0be2af9",
  "title": "与卢象集朱家",
  "author": "王维",
  "dynasty": "唐",
  "verses": [
    "主人能爱客，终日有逢迎。",
    "贳得新丰酒，复闻秦女筝。",
    "柳条疎客舍，槐叶下秋城。",
    "语笑且为乐，吾将达此生。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
