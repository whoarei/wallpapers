{
  "id": "poem-f565c5659b13ff4f215f528f",
  "title": "减字木兰花·风鬟雾鬓",
  "author": "周邦彦",
  "dynasty": "宋",
  "verses": [
    "风鬟雾鬓。",
    "便觉蓬莱三岛近。",
    "水秀山明。",
    "缥缈仙姿画不成。",
    "广寒丹桂。",
    "岂是夭桃尘俗世。",
    "只恐乘风。",
    "飞上琼楼玉宇中。"
  ],
  "enabled": true,
  "collection": "宋词选",
