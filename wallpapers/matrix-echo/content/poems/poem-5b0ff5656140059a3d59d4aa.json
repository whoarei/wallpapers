{
  "id": "poem-5b0ff5656140059a3d59d4aa",
  "title": "泣姜贫乐谢长兴长赵可斋  其二",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "金尽骅骝死，交游散似云。",
    "五穷逐不去，百拙巧难分。",
    "竹唁梅疎友，鸥随鹭吊群。",
    "未铭先传散，勒徧霅川𣸣。"
  ],
  "enabled": true,
  "collection": "宋诗选",
