{
  "id": "poem-55ea821f42007434eba63c30",
  "title": "伤张玖秀才",
  "author": "唐求",
  "dynasty": "唐",
  "verses": [
    "铜梁剑阁几区区，十上探珠不见珠。",
    "卞玉影沈沙草暗，骅骝声断陇城孤。",
    "入关词客秋怀友，出户孀妻晓望夫。",
    "吴水楚山千万里，旅魂归到故乡无。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
