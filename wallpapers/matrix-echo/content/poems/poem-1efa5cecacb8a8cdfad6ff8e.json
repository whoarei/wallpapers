{
  "id": "poem-1efa5cecacb8a8cdfad6ff8e",
  "title": "咏史诗 马陵",
  "author": "胡曾",
  "dynasty": "唐",
  "verses": [
    "坠叶萧萧九月天，驱兵独过马陵前。",
    "路傍古木虫书处，记得将军破敌年。"
  ],
  "enabled": true,
