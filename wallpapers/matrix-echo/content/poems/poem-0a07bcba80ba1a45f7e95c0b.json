{
  "id": "poem-0a07bcba80ba1a45f7e95c0b",
  "title": "醉花间·休相问",
  "author": "毛文锡",
  "dynasty": "五代",
  "verses": [
    "休相问，怕相问，相问还添恨。",
    "春水满塘生，㶉𫛶正相趁。",
    "咋夜雨霏霏，临明寒一阵。",
    "偏忆戍楼人，久绝边庭信。"
  ],
  "enabled": true,
  "collection": "花间集",
  "tags": [],
