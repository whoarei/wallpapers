{
  "id": "poem-780aeac3fa734725865ee703",
  "title": "郊庙歌辞 祭神州乐章 送神",
  "author": "不详",
  "dynasty": "唐",
  "verses": [
    "神州阴祀，洪恩广济。",
    "草树沾和，飞沈沐惠。",
    "礼修鼎俎，奠歆瑶币。",
    "送乐有章，灵轩其逝。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
