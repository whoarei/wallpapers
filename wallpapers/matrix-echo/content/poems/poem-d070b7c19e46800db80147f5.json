{
  "id": "poem-d070b7c19e46800db80147f5",
  "title": "关山曲二首 一",
  "author": "马戴",
  "dynasty": "唐",
  "verses": [
    "金甲耀兜鍪，黄金拂紫骝。",
    "叛羌旗下戮，陷壁夜中收。",
    "霜霰戎衣月，关河碛气秋。",
    "箭疮殊未合，更遣击兰州。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
