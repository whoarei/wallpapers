{
  "id": "poem-9fa3086c261cb64729612f1b",
  "title": "题刘处士居",
  "author": "李咸用",
  "dynasty": "唐",
  "verses": [
    "压破岚光半亩余，竹轩兰砌共清虚。",
    "泉经小槛声长急，月过修篁影旋疎。",
    "溪鸟时时窥户牖，山云往往宿庭除。",
    "干戈谩道因天意，渭水高人自钓鱼。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
