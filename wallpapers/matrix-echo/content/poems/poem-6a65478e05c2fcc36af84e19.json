{
  "id": "poem-6a65478e05c2fcc36af84e19",
  "title": "江雪",
  "author": "柳宗元",
  "dynasty": "唐",
  "verses": [
    "千山鸟飞绝，万迳人踪灭。",
    "孤舟蓑笠翁，独钓寒江雪。"
  ],
