{
  "id": "poem-994ebf8495ff2571c046be8f",
  "title": "长门怨",
  "author": "张乔",
  "dynasty": "唐",
  "verses": [
    "御泉长绕凤皇楼，自是恩波别处流。",
    "闲揲舞衣归未得，夜来砧杵六宫秋。"
  ],
  "enabled": true,
