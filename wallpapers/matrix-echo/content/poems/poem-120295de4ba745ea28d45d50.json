{
  "id": "poem-120295de4ba745ea28d45d50",
  "title": "书边事",
  "author": "张乔",
  "dynasty": "唐",
  "verses": [
    "调角断清秋，征人倚戍楼。",
    "春风对青冢，白日落梁州。",
    "大汉无兵阻，穷边有客游。",
    "蕃情似此水，长愿向南流。"
  ],
  "enabled": true,
