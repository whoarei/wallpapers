{
  "id": "poem-2efb71f1c0019e8c1ad80c44",
  "title": "悬水",
  "author": "陈岩",
  "dynasty": "宋",
  "verses": [
    "日夜云间喷薄鸣，玉龙千尺绕山行。",
    "漏天泻下银河水，来作僧窗夜雨声。"
  ],
  "enabled": true,
  "collection": "宋诗选",
