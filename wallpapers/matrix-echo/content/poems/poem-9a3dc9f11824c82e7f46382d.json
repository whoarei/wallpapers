{
  "id": "poem-9a3dc9f11824c82e7f46382d",
  "title": "书匡山老僧庵",
  "author": "贯休",
  "dynasty": "唐",
  "verses": [
    "筼筜红实好鸟语，银髯瘦僧貌如祖。",
    "香烟蒙蒙衣上聚，冥心缥缈入铁圄。",
    "白麏作梦枕藤屦，东峰山媪贡瓜乳。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
  "tags": [
    "庐山"
  ],
