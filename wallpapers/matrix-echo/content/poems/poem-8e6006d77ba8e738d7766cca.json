{
  "id": "poem-8e6006d77ba8e738d7766cca",
  "title": "送冯温往河外",
  "author": "薛能",
  "dynasty": "唐",
  "verses": [
    "琴劒事行装，河关出北方。",
    "秦音尽河内，魏画自黎阳。",
    "野日村苗熟，秋霜馆叶黄。",
    "风沙问船处，应得立清漳。"
  ],
  "enabled": true,
