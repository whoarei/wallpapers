{
  "id": "poem-5f96007136f49e8c3b83b3ca",
  "title": "孤山彭高士借榻",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "万籁笙镛一枕秋，幌云垂地月痕收。",
    "偶然做得还乡梦，梦见鸿蒙与道游。"
  ],
  "enabled": true,
  "collection": "宋诗选",
