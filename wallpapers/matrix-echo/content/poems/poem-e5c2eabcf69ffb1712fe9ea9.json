{
  "id": "poem-e5c2eabcf69ffb1712fe9ea9",
  "title": "行田诗",
  "author": "张又新",
  "dynasty": "唐",
  "verses": [
    "白石岩前湖水春，湖边旧境有清尘。",
    "欲追谢守行田意，今古同忧是长人。"
  ],
