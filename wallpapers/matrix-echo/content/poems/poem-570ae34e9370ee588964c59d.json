{
  "id": "poem-570ae34e9370ee588964c59d",
  "title": "和公廙喜雪",
  "author": "司马光",
  "dynasty": "宋",
  "verses": [
    "向来河洛久愆阳，祷祀徒劳罄肃庄。",
    "林雪飞花欣暂白，麦田濡叶未全黄。",
    "城中稍觉桑薪贵，村外时闻社瓮香。",
    "八使孜孜悯惸独，斯民那复畏凶荒。"
  ],
  "enabled": true,
  "collection": "宋诗选",
  "tags": [],
