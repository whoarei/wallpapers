{
  "id": "poem-925ee4513abf3d5f6a20921e",
  "title": "玉华宫",
  "author": "杜甫",
  "dynasty": "唐",
  "verses": [
    "溪回松风长，苍鼠窜古瓦。",
    "不知何王殿，遗构绝壁下。",
    "阴房鬼火青，坏道哀湍泻。",
    "万籁真笙竽，秋色正萧洒。",
    "美人为黄土，况乃粉黛假。",
    "当时侍金舆，故物独石马。",
    "忧来藉草坐，浩歌泪盈把。",
    "冉冉征途间，谁是长年者。"
  ],
  "enabled": true,
