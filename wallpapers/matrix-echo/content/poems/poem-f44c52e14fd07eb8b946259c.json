{
  "id": "poem-f44c52e14fd07eb8b946259c",
  "title": "戏张道人不饮酒",
  "author": "颜荛",
  "dynasty": "唐",
  "verses": [
    "言自云山访我来，每闻奇秘觉叨陪。",
    "吾师不饮人间酒，应待流霞即举杯。"
  ],
  "enabled": true,
