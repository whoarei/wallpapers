{
  "id": "poem-38b14d3ce9b971e3846efc24",
  "title": "偈颂 五",
  "author": "文偃",
  "dynasty": "唐",
  "verses": [
    "太阳溢目极玄微，谁人说道我渠非。",
    "句中有路人皆响，觌面难遭第一机。"
  ],
