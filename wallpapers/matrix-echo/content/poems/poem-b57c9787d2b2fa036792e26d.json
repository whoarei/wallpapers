{
  "id": "poem-b57c9787d2b2fa036792e26d",
  "title": "柳枝词",
  "author": "纳兰性德",
  "dynasty": "清",
  "verses": [
    "池上闲房碧树围，帘纹如彀上斜晖。",
    "生憎飞絮吹难定，一出红窗便不归。"
  ],
  "enabled": true,
