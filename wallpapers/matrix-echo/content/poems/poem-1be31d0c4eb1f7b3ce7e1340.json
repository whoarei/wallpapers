{
  "id": "poem-1be31d0c4eb1f7b3ce7e1340",
  "title": "送从弟戴玄往苏州",
  "author": "张籍",
  "dynasty": "唐",
  "verses": [
    "杨柳阊门路，悠悠水岸斜。",
    "乘舟向山寺，着屐到渔家。",
    "夜月红柑树，秋风白藕花。",
    "江天诗景好，回日莫令赊。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
