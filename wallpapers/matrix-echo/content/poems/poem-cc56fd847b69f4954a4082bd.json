{
  "id": "poem-cc56fd847b69f4954a4082bd",
  "title": "瀑布",
  "author": "王镃",
  "dynasty": "宋",
  "verses": [
    "青天隠隠响晴雷，绝顶流来不知处。",
    "巨灵怒擘两山开，飞下玉龙归海去。"
  ],
  "enabled": true,
