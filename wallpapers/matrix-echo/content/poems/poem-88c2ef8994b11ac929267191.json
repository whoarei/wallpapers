{
  "id": "poem-88c2ef8994b11ac929267191",
  "title": "书灵筵手巾",
  "author": "后主煜",
  "dynasty": "唐",
  "verses": [
    "浮生共顦顇，壮岁失婵娟。",
    "汗手遗香渍，痕眉染黛烟。"
  ],
