{
  "id": "poem-d46c4f1ad02b290998818334",
  "title": "家兄有和再用韵  其二",
  "author": "艾可翁",
  "dynasty": "宋",
  "verses": [
    "故人在何处，清梦或逢之。",
    "老树秋声早，深窗曙色迟。",
    "湿萤粘露草，惊鸟徙风枝。",
    "琴破才支卧，知无钟子期。"
  ],
  "enabled": true,
  "collection": "宋诗选",
