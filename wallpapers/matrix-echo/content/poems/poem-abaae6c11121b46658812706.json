{
  "id": "poem-abaae6c11121b46658812706",
  "title": "观骑射",
  "author": "李益",
  "dynasty": "唐",
  "verses": [
    "边头射雕将，走马出中军。",
    "远见平原上，翻身向暮云。"
  ],
  "enabled": true,
