{
  "id": "poem-c6069bfdab9e1e3409b0f78b",
  "title": "阮郎归·天边金掌露成霜",
  "author": "晏几道",
  "dynasty": "宋",
  "verses": [
    "天边金掌露成霜。",
    "云随雁字长。",
    "绿杯红袖称重阳。",
    "人情似故乡。",
    "兰佩紫，菊簪黄。",
    "殷勤理旧狂。",
    "欲将沈醉换悲凉。",
    "清歌莫断肠。"
  ],
  "enabled": true,
