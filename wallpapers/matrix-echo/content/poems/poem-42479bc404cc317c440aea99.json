{
  "id": "poem-42479bc404cc317c440aea99",
  "title": "行思",
  "author": "杨凝",
  "dynasty": "唐",
  "verses": [
    "千里岂云去，欲归如路穷。",
    "人间无暇日，马上又秋风。",
    "破月衔高岳，流星拂晓空。",
    "此时皆在梦，行色独怱怱。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
