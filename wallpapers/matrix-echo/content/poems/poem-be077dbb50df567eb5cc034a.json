{
  "id": "poem-be077dbb50df567eb5cc034a",
  "title": "却望无锡芙蓉湖 五",
  "author": "李绅",
  "dynasty": "唐",
  "verses": [
    "翠崖幽谷分明处，倦鸟归云在眼前。",
    "惆怅白头为四老，远随尘土去伊川。"
  ],
