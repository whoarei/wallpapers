{
  "id": "poem-1308fa73d18583afcdb527bf",
  "title": "送李校书赴东川幕",
  "author": "卢纶",
  "dynasty": "唐",
  "verses": [
    "泥坂望青城，浮云与栈平。",
    "字形知国号，眉势识山名。",
    "编简尘封阁，戈鋋雪照营。",
    "男儿须聘用，莫信笔堪耕。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
