{
  "id": "poem-7fa009656d862520a18496c0",
  "title": "江南词",
  "author": "李益",
  "dynasty": "唐",
  "verses": [
    "嫁得瞿塘贾，朝朝悮妾期。",
    "早知潮有信，嫁与弄潮儿。"
  ],
