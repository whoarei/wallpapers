{
  "id": "poem-d2d212a832049db7056699ba",
  "title": "哭陈陶",
  "author": "张乔",
  "dynasty": "唐",
  "verses": [
    "先生抱衰疾，不起茂陵间。",
    "夕临诸孤少，荒居吊客还。",
    "遗文禅东岳，留语葬乡山。",
    "多雨铭旌故，残灯素帐闲。",
    "乐章谁与集，陇树即堪攀。",
    "神理今难问，予将呌帝关。"
  ],
  "enabled": true,
