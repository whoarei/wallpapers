{
  "id": "poem-c856d63edab68a7663623faf",
  "title": "郊庙歌辞 周朝飨乐章 福顺",
  "author": "不详",
  "dynasty": "唐",
  "verses": [
    "圣皇端拱，多士输忠。",
    "蛮觞共献，臣心毕同。",
    "声齐嵩岳，祝比华封。",
    "千龄万祀，常保时雍。"
  ],
  "enabled": true,
