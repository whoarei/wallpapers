{
  "id": "poem-cf6d5c4318689298c22bd116",
  "title": "崇阳道中作四首  其三",
  "author": "李纲",
  "dynasty": "宋",
  "verses": [
    "承平无事久，万里尽农桑。",
    "谁使干戈起，坐令民物疮。",
    "关河成阻绝，京洛亦凄凉。",
    "尚喜江湖外，斯民游乐康。"
  ],
  "enabled": true,
  "collection": "宋诗选",
