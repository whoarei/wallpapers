{
  "id": "poem-d254e0775b1a74ed18388262",
  "title": "减字木兰花·垂螺近额",
  "author": "张先",
  "dynasty": "宋",
  "verses": [
    "垂螺近额。",
    "走上红裀初趁拍。",
    "只恐轻飞。",
    "拟倩游丝惹住伊。",
    "文鸳绣履。",
    "去似杨花尘不起。",
    "舞彻伊州。",
    "头上宫花颤未休。"
  ],
  "enabled": true,
  "collection": "宋词选",
