{
  "id": "poem-094d2d3cd8906ad8e31c0ea8",
  "title": "洁泉",
  "author": "曾协",
  "dynasty": "宋",
  "verses": [
    "绝爱泓然一鉴渟，肯教尘土犯清泠。",
    "祇缘较德先生似，不为争名陆羽经。"
  ],
  "enabled": true,
