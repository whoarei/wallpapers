{
  "id": "poem-5b81cb82dfd4b4a92363d8d4",
  "title": "中峰亭",
  "author": "朱景玄",
  "dynasty": "唐",
  "verses": [
    "中峰上翠微，窗晓早霞飞。",
    "几引登山屐，春风踏雪归。"
  ],
  "enabled": true,
