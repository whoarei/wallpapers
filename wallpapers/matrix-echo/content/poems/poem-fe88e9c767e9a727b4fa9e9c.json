{
  "id": "poem-fe88e9c767e9a727b4fa9e9c",
  "title": "点绛唇·罗幕重重",
  "author": "张纲",
  "dynasty": "宋",
  "verses": [
    "罗幕重重，画堂迎腊和风转。",
    "玳筵高展。",
    "知是群仙宴。",
    "银鸭香浮，红袖翻歌扇。",
    "金杯劝。",
    "深深祝愿。",
    "争把蟠桃献。"
  ],
  "enabled": true,
  "collection": "宋词选",
