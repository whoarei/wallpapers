{
  "id": "poem-e683814263d559af4be27f99",
  "title": "吕元直得书天台郭外治园林作退老堂求诗为赋两章  其二",
  "author": "李纲",
  "dynasty": "宋",
  "verses": [
    "周遭叠嶂俯清流，卜筑园林事事幽。",
    "春日莺花随衮绣，秋来松菊照林丘。",
    "谢公终为苍生起，裴相聊成绿野谋。",
    "圣主思贤方仄席，未应长伴赤松游。"
  ],
  "enabled": true,
  "collection": "宋诗选",
