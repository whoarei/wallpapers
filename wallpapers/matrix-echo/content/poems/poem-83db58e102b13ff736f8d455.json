{
  "id": "poem-83db58e102b13ff736f8d455",
  "title": "深春  其一",
  "author": "王镃",
  "dynasty": "宋",
  "verses": [
    "夹泥花上燕巢边，翠箔桑空蚕又眠。",
    "天气才晴风候别，坐看盆藕出双钱。"
  ],
  "enabled": true,
