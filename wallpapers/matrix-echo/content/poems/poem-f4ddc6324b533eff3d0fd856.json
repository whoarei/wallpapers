{
  "id": "poem-f4ddc6324b533eff3d0fd856",
  "title": "浣溪沙·雨点春山入翠眉",
  "author": "向子𬤇",
  "dynasty": "宋",
  "verses": [
    "雨点春山入翠眉。",
    "一ь杨柳作腰肢。",
    "语音娇软带儿痴。",
    "犹省当来求识面，隔帘清唱倒琼彝。",
    "真成相见说当时。"
  ],
  "enabled": true,
  "collection": "宋词选",
