{
  "id": "poem-439ab52ef2ce6c768921421c",
  "title": "寓北山小阁因事偶作",
  "author": "释了惠",
  "dynasty": "宋",
  "verses": [
    "老去将贫买得闲，十层梯下是人间。",
    "忽因送客闻新事，又嘱山童紧著关。"
  ],
