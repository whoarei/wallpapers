{
  "id": "poem-fcbe71d08e1b15adc96090ec",
  "title": "虞美人·飞梁石径关山路",
  "author": "蔡伸",
  "dynasty": "宋",
  "verses": [
    "飞梁石径关山路。",
    "惨淡秋容暮。",
    "一行新雁破寒空。",
    "肠断碧云千里、水溶溶。",
    "鸾衾欲展谁堪共。",
    "帘幕霜华重。",
    "鸭炉香尽锦屏中。",
    "幽梦今宵何许、与君同。"
  ],
  "enabled": true,
  "collection": "宋词选",
