{
  "id": "poem-12cd5e368387cfc909f7dd5f",
  "title": "偈颂 七",
  "author": "文偃",
  "dynasty": "唐",
  "verses": [
    "玩古松高云不齐，鸿鸧鹤抱几年栖。",
    "剖㲉同时殊有异，羽张腾汉碧霄低。"
  ],
  "enabled": true,
