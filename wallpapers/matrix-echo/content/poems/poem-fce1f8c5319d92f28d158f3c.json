{
  "id": "poem-fce1f8c5319d92f28d158f3c",
  "title": "将去广陵别史员外南斋",
  "author": "徐铉",
  "dynasty": "宋",
  "verses": [
    "家声曾与金张辈，官署去居何宋间。",
    "起得高斋临静曲，种成奇树学他山。",
    "鸳鸾终日同醒醉，萝薜常时共往还。",
    "贱子今朝独南去，不堪回首望清闲。"
  ],
  "enabled": true,
  "collection": "宋诗选",
