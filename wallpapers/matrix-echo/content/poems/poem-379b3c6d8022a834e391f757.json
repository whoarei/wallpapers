{
  "id": "poem-379b3c6d8022a834e391f757",
  "title": "偶诗五首 二",
  "author": "司空图",
  "dynasty": "唐",
  "verses": [
    "芙蓉骚客空留怨，芍药诗家只寄情。",
    "谁似天才李山甫，牡丹属思亦纵横。"
  ],
  "enabled": true,
