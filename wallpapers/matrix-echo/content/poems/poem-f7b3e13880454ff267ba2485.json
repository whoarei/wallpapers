{
  "id": "poem-f7b3e13880454ff267ba2485",
  "title": "览史",
  "author": "皎然",
  "dynasty": "唐",
  "verses": [
    "黄绮皆皓发，秦时隐商山。",
    "嘉谋匡帝道，高步游天关。",
    "不爱珪组绁，却思林壑还。",
    "放歌长松下，日与孤云闲。"
  ],
  "enabled": true,
