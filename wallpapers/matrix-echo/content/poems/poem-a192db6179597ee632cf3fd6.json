{
  "id": "poem-a192db6179597ee632cf3fd6",
  "title": "赠内人",
  "author": "张祜",
  "dynasty": "唐",
  "verses": [
    "禁门宫树月痕过，媚眼唯看宿燕窠。",
    "斜拔玉钗灯影畔，剔开红焰救飞蛾。"
  ],
  "enabled": true,
