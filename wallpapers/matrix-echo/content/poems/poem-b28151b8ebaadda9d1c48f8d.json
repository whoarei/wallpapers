{
  "id": "poem-b28151b8ebaadda9d1c48f8d",
  "title": "新楼诗二十首 海棠",
  "author": "李绅",
  "dynasty": "唐",
  "verses": [
    "海边佳树生奇彩，知是仙山取得栽。",
    "琼蘂籍中闻阆苑，紫芝图上见蓬莱。",
    "浅深芳萼通宵换，委积红英报晓开。",
    "寄语春园百花道，莫争颜色泛金杯。"
  ],
  "enabled": true,
