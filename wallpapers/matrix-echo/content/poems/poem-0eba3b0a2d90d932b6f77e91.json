{
  "id": "poem-0eba3b0a2d90d932b6f77e91",
  "title": "咏史诗 华亭",
  "author": "胡曾",
  "dynasty": "唐",
  "verses": [
    "陆机西没洛阳城，吴国春风草又青。",
    "惆怅月中千岁鹤，夜来犹为唳华亭。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
