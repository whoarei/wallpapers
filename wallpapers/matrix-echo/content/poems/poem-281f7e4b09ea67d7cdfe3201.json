{
  "id": "poem-281f7e4b09ea67d7cdfe3201",
  "title": "杂诗",
  "author": "李端",
  "dynasty": "唐",
  "verses": [
    "主第辞高饮，石家赴宵会。",
    "金谷走车来，玉人骑马待。"
  ],
