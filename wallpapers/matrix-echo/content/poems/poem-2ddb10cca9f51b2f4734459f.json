{
  "id": "poem-2ddb10cca9f51b2f4734459f",
  "title": "宫词  其二八",
  "author": "张公庠",
  "dynasty": "宋",
  "verses": [
    "影娥池面碧溶溶，荡桨佳人夕照中。",
    "云髻不饶荷叶绿，罗裙未减石榴红。"
  ],
  "enabled": true,
  "collection": "宋诗选",
