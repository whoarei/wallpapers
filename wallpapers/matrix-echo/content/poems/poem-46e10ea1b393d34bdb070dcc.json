{
  "id": "poem-46e10ea1b393d34bdb070dcc",
  "title": "书雨",
  "author": "孙嵩",
  "dynasty": "宋",
  "verses": [
    "阴谷幽林热似焚，阿香鸣鼓骤殷殷。",
    "天公作雨须臾事，用得东山一片云。"
  ],
  "enabled": true,
  "collection": "宋诗选",
