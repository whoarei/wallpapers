{
  "id": "poem-a0b9cd72f5a6e7943a8f8232",
  "title": "更漏子·雪肌轻",
  "author": "杜安世",
  "dynasty": "宋",
  "verses": [
    "雪肌轻，花脸薄。",
    "愁困不忺梳掠。",
    "眉翠袅，眼波长。",
    "偎人言语香。",
    "看难厌，怜不足。",
    "苦恨别离何速。",
    "珠树远，彩鸾孤。",
    "今生重见无。"
  ],
  "enabled": true,
  "collection": "宋词选",
