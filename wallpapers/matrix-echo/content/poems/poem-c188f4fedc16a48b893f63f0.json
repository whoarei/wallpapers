{
  "id": "poem-c188f4fedc16a48b893f63f0",
  "title": "经隐叟",
  "author": "鲍溶",
  "dynasty": "唐",
  "verses": [
    "行蹋门外泉，坐披床上云。",
    "谁将许由事，万古留与君。",
    "虚洞闭金鏁，蠹简藏鸟文。",
    "萝景深的的，蕙风闲薰薰。",
    "余有世上心，此来未及群。",
    "殷勤讳姓名，莫遣樵客闻。"
  ],
  "enabled": true,
