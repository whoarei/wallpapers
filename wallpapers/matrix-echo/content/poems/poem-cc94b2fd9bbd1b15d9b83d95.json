{
  "id": "poem-cc94b2fd9bbd1b15d9b83d95",
  "title": "丰干闾丘虎赞",
  "author": "释了惠",
  "dynasty": "宋",
  "verses": [
    "虎怕人心恶，人欺虎太慈。",
    "虽逢贤太守，难打者官司。"
  ],
  "enabled": true,
