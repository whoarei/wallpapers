{
  "id": "poem-df4260a5a084d21c55dd4d0e",
  "title": "早春旬假独直寄江舍人",
  "author": "徐铉",
  "dynasty": "宋",
  "verses": [
    "省署皆归沐，西垣公事稀。",
    "咏诗前砌立，听漏向申归。",
    "远思风醒酒，余寒雨湿衣。",
    "春光已堪探，芝盖共谁飞。"
  ],
  "enabled": true,
  "collection": "宋诗选",
