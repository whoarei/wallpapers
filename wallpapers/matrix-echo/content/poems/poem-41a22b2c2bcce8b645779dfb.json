{
  "id": "poem-41a22b2c2bcce8b645779dfb",
  "title": "前腔",
  "author": "施惠《幽闺记》",
  "dynasty": "元",
  "verses": [
    "(生、旦)区区，山行路宿，粥食无觅处。",
    "有盘缠肯相推阻？(众)穷酸饿儒，模样须寻俗。",
    "随行所有，疾忙分付。"
  ],
  "enabled": true,
  "collection": "元曲选",
