{
  "id": "poem-32773c1509a7eeb8f2e08473",
  "title": "女冠子·星冠霞帔",
  "author": "牛峤",
  "dynasty": "五代",
  "verses": [
    "星冠霞帔，住在蕊珠宫里。佩玎珰。",
    "明翠摇蝉翼，纤珪理宿妆。",
    "醮坛春草绿，药院杏花香。",
    "青鸟传心事，寄刘郎。"
  ],
  "enabled": true,
  "collection": "花间集",
