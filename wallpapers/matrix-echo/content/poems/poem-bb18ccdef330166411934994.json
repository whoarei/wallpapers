{
  "id": "poem-bb18ccdef330166411934994",
  "title": "化城寺",
  "author": "陈岩",
  "dynasty": "宋",
  "verses": [
    "匝径茸茸菜甲青，透池艳艳藕花明。",
    "四方衲子寻幽践，多少空山振锡声。"
  ],
  "enabled": true,
  "collection": "宋诗选",
