{
  "id": "poem-3a19ca40e68ccd64ced9bf96",
  "title": "郊庙歌辞 禅社首乐章 顺和",
  "author": "贺知章、源乾曜",
  "dynasty": "唐",
  "verses": [
    "至哉含柔德，万物资以生。",
    "常顺称厚载，流谦通变盈。",
    "圣心事能察，增广陈厥诚。",
    "黄祇僾如在，泰折俟咸亨。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
  "tags": [
    "抒情",
    "叙事",
    "写景"
  ],
