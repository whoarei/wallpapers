{
  "id": "poem-0f62e4afe7a016dc79ce6378",
  "title": "送恒操上人归江外觐省",
  "author": "卢纶",
  "dynasty": "唐",
  "verses": [
    "依佛不违亲，高堂与寺邻。",
    "问安双树晓，求膳一僧贫。",
    "持呪过龙庙，翻经化海人。",
    "还同惠休去，儒者亦沾巾。"
  ],
  "enabled": true,
