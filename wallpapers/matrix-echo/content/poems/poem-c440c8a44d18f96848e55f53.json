{
  "id": "poem-c440c8a44d18f96848e55f53",
  "title": "平江太守李宝谟移漕荆湘  其一",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "荆溪溪上传，接畛使君贤。",
    "行旅归如市，羁游亟受廛。",
    "丰储优郡计，薄歛裕民天。",
    "谁似山阴叟，临行赠一钱。"
  ],
  "enabled": true,
  "collection": "宋诗选",
