{
  "id": "poem-7c46abb27aed0425e756d93d",
  "title": "扶南曲歌词五首 二",
  "author": "王维",
  "dynasty": "唐",
  "verses": [
    "堂上青弦动，堂前绮席陈。",
    "齐歌卢女曲，双舞洛阳人。",
    "倾国徒相看，宁知心所亲。"
  ],
  "enabled": true,
