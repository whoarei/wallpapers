{
  "id": "poem-5313d9dab08dead69669253d",
  "title": "耒阳杜工部祠堂",
  "author": "孟宾于",
  "dynasty": "宋",
  "verses": [
    "南游何感思，更甚叶缤纷。",
    "一夜耒江雨，百年工部文。",
    "青山当日见，白酒至今闻。",
    "惟有为诗者，经过时吊君。"
  ],
  "enabled": true,
