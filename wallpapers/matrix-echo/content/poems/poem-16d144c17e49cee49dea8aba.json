{
  "id": "poem-16d144c17e49cee49dea8aba",
  "title": "溪行",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "夭夭拍拍涨桃花，葑未全青荻已芽。",
    "两行若无杨柳树，看来无处著韶华。"
  ],
  "enabled": true,
  "collection": "宋诗选",
