{
  "id": "poem-f8c90b1ba7be5cb05829999e",
  "title": "帝京篇十首 七",
  "author": "太宗皇帝",
  "dynasty": "唐",
  "verses": [
    "落日双阙昏，回舆九重暮。",
    "长烟散初碧，皎月澄轻素。",
    "搴幌玩琴书，开轩引云雾。",
    "斜汉耿层阁，清风摇玉树。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
