{
  "id": "poem-4a90a250155b650ad1ecccac",
  "title": "悼汪舍人养源",
  "author": "王十朋",
  "dynasty": "宋",
  "verses": [
    "襆被周庐日，寅缘识伟人。",
    "节因辞辟著，志向得言伸。",
    "伯仲同持橐，声名压缙绅。",
    "人亡邦国瘁，可赎百其身。"
  ],
  "enabled": true,
  "collection": "宋诗选",
