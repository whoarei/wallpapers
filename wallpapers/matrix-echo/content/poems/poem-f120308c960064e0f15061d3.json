{
  "id": "poem-f120308c960064e0f15061d3",
  "title": "生查子·霜寒月满窗",
  "author": "蔡伸",
  "dynasty": "宋",
  "verses": [
    "霜寒月满窗，夜永人无寐。",
    "绛腊有馀情，偏照鸳鸯被。",
    "看尽旧时书，洒尽今生泪。",
    "衙鼓已三更，还是和衣睡。"
  ],
  "enabled": true,
  "collection": "宋词选",
  "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/宋词/ci.song.6000.json#record-967",
