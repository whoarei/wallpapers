{
  "id": "poem-f4909075343516dd492ae302",
  "title": "度破讷沙二首 一",
  "author": "李益",
  "dynasty": "唐",
  "verses": [
    "眼见风来沙旋移，经年不省草生时。",
    "莫言塞北无春到，总有春来何处知。"
  ],
  "enabled": true,
