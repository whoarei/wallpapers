{
  "id": "poem-fa0e221605f4435d4381eb47",
  "title": "苦雪四首 一",
  "author": "高适",
  "dynasty": "唐",
  "verses": [
    "二月犹北风，天阴雪冥冥。",
    "寥落一室中，怅然慙百龄。",
    "苦愁正如此，门柳复青青。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
