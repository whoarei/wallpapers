{
  "id": "poem-98838c07f4689d8f5d489f59",
  "title": "怀智体道人",
  "author": "贯休",
  "dynasty": "唐",
  "verses": [
    "栖碧思吾友，庭莺百啭时。",
    "唯应一处住，方得不相思。",
    "云水淹门阃，春雷在树枝。",
    "平生无限事，不独白云知。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
