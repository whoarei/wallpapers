{
  "id": "poem-238a52a4bd520f94ae8e8ab4",
  "title": "句",
  "author": "徐凝",
  "dynasty": "唐",
  "verses": [
    "青山旧路在，白首醉还乡。",
    "试到第三桥，便入千顷花。",
    "乱后见淮水，归心忽迢遥。",
    "乍疑鲸喷浪，忽似鹢凌风。",
    "呀呷汀洲动，喧阗里巷空。"
  ],
  "enabled": true,
