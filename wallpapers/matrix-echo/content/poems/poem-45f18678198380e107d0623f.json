{
  "id": "poem-45f18678198380e107d0623f",
  "title": "登巾山",
  "author": "陈知柔",
  "dynasty": "宋",
  "verses": [
    "司马胸中著云梦，杜陵眼底盖乾坤。",
    "吾衰不复论兹事，饱看孤帆落远村。"
  ],
  "enabled": true,
