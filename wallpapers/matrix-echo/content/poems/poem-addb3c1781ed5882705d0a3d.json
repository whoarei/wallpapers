{
  "id": "poem-addb3c1781ed5882705d0a3d",
  "title": "蕉叶",
  "author": "徐夤",
  "dynasty": "唐",
  "verses": [
    "绿绮新裁织女机，摆风摇日影离披。",
    "只应青帝行春罢，闲倚东墙卓翠旗。"
  ],
  "enabled": true,
