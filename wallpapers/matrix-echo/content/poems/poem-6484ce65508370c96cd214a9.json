{
  "id": "poem-6484ce65508370c96cd214a9",
  "title": "寄淮海惠泽上人",
  "author": "李洞",
  "dynasty": "唐",
  "verses": [
    "海涛痕满旧征衣，长忆初程宿翠微。",
    "竹里桥鸣知马过，塔中灯露见鸿飞。",
    "眉毫别后应盈尺，嵒木居来定几围。",
    "他日愿师容一榻，煎茶埽地学忘机。"
  ],
  "enabled": true,
