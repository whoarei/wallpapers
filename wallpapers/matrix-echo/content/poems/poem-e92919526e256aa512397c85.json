{
  "id": "poem-e92919526e256aa512397c85",
  "title": "题曾氏山园十一咏 吟风桥",
  "author": "张栻",
  "dynasty": "宋",
  "verses": [
    "桥边风月佳，俯仰有余思。",
    "无忘履冰心，方识吟风意。"
  ],
  "enabled": true,
  "collection": "宋诗选",
