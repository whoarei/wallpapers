{
  "id": "poem-6cc06f4ef5b784c2443f3d28",
  "title": "将入匡山别芳昼二公二首 二",
  "author": "贯休",
  "dynasty": "唐",
  "verses": [
    "红豆树间滴红雨，恋师不得依师住。",
    "世情世界愁杀人，锦绣谷中归舍去。"
  ],
  "enabled": true,
