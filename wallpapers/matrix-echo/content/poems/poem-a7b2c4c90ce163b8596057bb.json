{
  "id": "poem-a7b2c4c90ce163b8596057bb",
  "title": "海眼光赞",
  "author": "释了惠",
  "dynasty": "宋",
  "verses": [
    "海眼为香饵，悲心作钓钩。",
    "鱼龙知几许，贪者自擡头。"
  ],
  "enabled": true,
