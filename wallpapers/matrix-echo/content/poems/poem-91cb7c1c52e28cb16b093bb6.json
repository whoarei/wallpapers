{
  "id": "poem-91cb7c1c52e28cb16b093bb6",
  "title": "送表姪达师归鄱阳",
  "author": "徐铉",
  "dynasty": "宋",
  "verses": [
    "故乡禾黍世亲稀，中表相寻只有师。",
    "惆怅离怀向何许，鄱阳湖上叶飞时。"
  ],
  "enabled": true,
