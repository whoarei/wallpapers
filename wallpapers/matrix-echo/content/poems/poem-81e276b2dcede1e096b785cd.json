{
  "id": "poem-81e276b2dcede1e096b785cd",
  "title": "巢乌行",
  "author": "鲍溶",
  "dynasty": "唐",
  "verses": [
    "乌生几子林萧条，雄乌求食雌守巢。",
    "夜愁风雨巢倾覆，常见一乌巢下宿。",
    "日长雏饥雄未回，雌鸟下巢去哀哀。",
    "野田春尽少遗谷，寻食不得饥飞来。",
    "黄雀亦引数青雀，雀飞未远乌惊落。",
    "既分青雀噉尔雏，尔雏虽长心何如。",
    "将飞不飞犹未忍，古瑟写哀哀不尽。"
  ],
  "enabled": true,
