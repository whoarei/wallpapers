{
  "id": "poem-36db1a919ed37664c8745f7f",
  "title": "宴左山二首  其一",
  "author": "刘跂",
  "dynasty": "宋",
  "verses": [
    "闰冬节物晏，十月犹素秋。",
    "招提阳冈路，宛在岘山头。",
    "史君有高致，尊酒擅一丘。",
    "欢颜动长啸，松菊含春柔。",
    "风清宿雾断，地迥行潦收。",
    "时令将凛落，飞光为谁留。"
  ],
  "enabled": true,
  "collection": "宋诗选",
