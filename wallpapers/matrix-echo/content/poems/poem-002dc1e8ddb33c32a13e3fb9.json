{
  "id": "poem-002dc1e8ddb33c32a13e3fb9",
  "title": "送马廿七秀才归小枯村",
  "author": "宋伯仁",
  "dynasty": "宋",
  "verses": [
    "轻轻飞絮扑花枝，喜傍兰亭说旧诗。",
    "君去小枯应为我，细看山带晚晴时。"
  ],
  "enabled": true,
