{
  "id": "poem-3d1c689ea8bc32ac03bad430",
  "title": "岁暮归南山",
  "author": "孟浩然",
  "dynasty": "唐",
  "verses": [
    "北阙休上书，南山归敝庐。",
    "不才明主弃，多病故人疎。",
    "白发催年老，青阳逼岁除。",
    "永怀愁不寐，松月夜窗虚。"
  ],
  "enabled": true,
