{
  "id": "poem-23f3a3df89c6d887989e9014",
  "title": "水亭夜坐赋得晓雾",
  "author": "李益",
  "dynasty": "唐",
  "verses": [
    "月落寒雾起，沈思浩通川。",
    "宿禽啭木散，山泽一苍然。",
    "漠漠沙上路，沄沄洲外田。",
    "犹当依远树，断续欲穷天。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
