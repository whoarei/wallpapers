{
  "id": "poem-00b96692a6251ccc3870b797",
  "title": "郊庙歌辞 雩祀乐章 豫和",
  "author": "不详",
  "dynasty": "唐",
  "verses": [
    "鸟纬迁序，龙星见辰。",
    "纯阳在律，明德崇禋。",
    "五方降帝，万宇安人。",
    "恭以致享，肃以迎神。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
