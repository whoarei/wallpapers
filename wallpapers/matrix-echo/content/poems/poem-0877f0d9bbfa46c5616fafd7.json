{
  "id": "poem-0877f0d9bbfa46c5616fafd7",
  "title": "菩萨蛮 其十一",
  "author": "温庭筠",
  "dynasty": "唐",
  "verses": [
    "南园满地堆轻絮，愁闻一霎清明雨。",
    "雨后却斜阳，杏花零落香。",
    "无言匀睡脸，枕上屏山掩。",
    "时节欲黄昏，无聊独倚门。"
  ],
  "enabled": true,
  "collection": "花间集",
  "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/五代诗词/huajianji/huajianji-1-juan.json#record-10",
