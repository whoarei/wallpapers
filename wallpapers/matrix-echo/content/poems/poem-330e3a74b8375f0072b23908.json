{
  "id": "poem-330e3a74b8375f0072b23908",
  "title": "归嵩山作",
  "author": "王维",
  "dynasty": "唐",
  "verses": [
    "清川带长薄，车马去闲闲。",
    "流水如有意，暮禽相与还。",
    "荒城临古渡，落日满秋山。",
    "迢递嵩高下，归来且闭关。"
  ],
  "enabled": true,
  "collection": "唐诗三百首",
