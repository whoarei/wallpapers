{
  "id": "poem-b645359e54d7376a859a4219",
  "title": "叶西庐惠冬菊三绝  其一",
  "author": "王柏",
  "dynasty": "宋",
  "verses": [
    "风紧东篱长旧荄，主人杖屦日徘徊。",
    "后时独立应无恨，少待梅花相伴开。"
  ],
  "enabled": true,
