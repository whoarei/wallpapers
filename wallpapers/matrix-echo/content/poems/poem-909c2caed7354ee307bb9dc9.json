{
  "id": "poem-909c2caed7354ee307bb9dc9",
  "title": "最胜亭",
  "author": "陈岩",
  "dynasty": "宋",
  "verses": [
    "烟收雾敛翠成围，来助幽亭眼界奇。",
    "衲子苦于山索句，棱棱瘦骨不禁诗。"
  ],
  "enabled": true,
  "collection": "宋诗选",
