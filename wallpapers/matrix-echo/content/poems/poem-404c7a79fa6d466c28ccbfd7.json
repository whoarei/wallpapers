{
  "id": "poem-404c7a79fa6d466c28ccbfd7",
  "title": "送春",
  "author": "王令",
  "dynasty": "宋",
  "verses": [
    "三月残花落更开，小檐日日燕飞来。",
    "子规夜半犹啼血，不信东风唤不回。"
  ],
  "enabled": true,
  "collection": "千家诗",
