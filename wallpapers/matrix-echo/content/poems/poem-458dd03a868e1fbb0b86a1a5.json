{
  "id": "poem-458dd03a868e1fbb0b86a1a5",
  "title": "酬贺四赠葛巾之作",
  "author": "王维",
  "dynasty": "唐",
  "verses": [
    "野巾传惠好，兹贶重兼金。",
    "嘉此幽栖物，能齐隐吏心。",
    "早朝方暂挂，晚沐复来簪。",
    "坐觉嚣尘远，思君共入林。"
  ],
  "enabled": true,
