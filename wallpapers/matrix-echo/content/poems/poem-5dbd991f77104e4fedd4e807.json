{
  "id": "poem-5dbd991f77104e4fedd4e807",
  "title": "赠长安毕郎中",
  "author": "李洞",
  "dynasty": "唐",
  "verses": [
    "高门寒沼水连云，鹭识朱衣傍主人。",
    "地肺半边晴带雪，天街一面静无尘。",
    "朝回座客酬琴价，衙退留僧写鹤真。",
    "从此几迁为计相，蓬莱三刻奏东巡。"
  ],
  "enabled": true,
