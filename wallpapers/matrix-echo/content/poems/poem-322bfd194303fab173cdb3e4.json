{
  "id": "poem-322bfd194303fab173cdb3e4",
  "title": "墨藕花  其二",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "西子湖阴锦掞云，水风池阁度晴熏。",
    "影窥明王生绡薄，分外精神一两分。"
  ],
  "enabled": true,
  "collection": "宋诗选",
  "tags": [
    "西湖"
