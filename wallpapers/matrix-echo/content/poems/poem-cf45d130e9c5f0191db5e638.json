{
  "id": "poem-cf45d130e9c5f0191db5e638",
  "title": "柳堤 梅堤",
  "author": "张栻",
  "dynasty": "宋",
  "verses": [
    "亭亭堤上梅，历历波间影。",
    "岁晚忆夫君，寂寞烟渚静。"
  ],
  "enabled": true,
