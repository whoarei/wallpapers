{
  "id": "poem-481d28f9ac3594b2bd37e5af",
  "title": "鹧鸪天·池上红衣伴倚阑",
  "author": "吴文英",
  "dynasty": "宋",
  "verses": [
    "池上红衣伴倚阑。",
    "栖鸦常带夕阳还。",
    "殷云度雨疏桐落，明月生凉宝扇闲。",
    "乡梦窄，水天宽。",
    "小窗愁黛澹秋山。",
    "吴鸿好为传归信，杨柳阊门屋数间。"
  ],
  "enabled": true,
