{
  "id": "poem-fd81986add05fe7fa0ccff2d",
  "title": "下第出春明门",
  "author": "李山甫",
  "dynasty": "唐",
  "verses": [
    "曾和秋雨驱愁入，却向春风领恨回。",
    "深谢灞陵堤畔柳，与人头上拂尘埃。"
  ],
  "enabled": true,
