{
  "id": "poem-9620075e4fd0dcb784153142",
  "title": "赠宿将",
  "author": "李山甫",
  "dynasty": "唐",
  "verses": [
    "校猎燕山经几春，雕弓白羽不离身。",
    "年来马上浑无力，望见飞鸿指似人。"
  ],
  "enabled": true,
