{
  "id": "poem-7cb1c881288969430508b6b8",
  "title": "调笑令·双绿",
  "author": "李邴",
  "dynasty": "宋",
  "verses": [
    "双绿。",
    "淡匀拂。",
    "两脸春融光透玉。",
    "起来却怕东风触。",
    "本是一团香玉。",
    "飞鸾台上看未足。",
    "贮向阿娇金屋。"
  ],
  "enabled": true,
  "collection": "宋词选",
