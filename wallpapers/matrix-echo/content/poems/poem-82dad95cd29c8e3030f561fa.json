{
  "id": "poem-82dad95cd29c8e3030f561fa",
  "title": "题清远峡观音院二首 二",
  "author": "卢肇",
  "dynasty": "唐",
  "verses": [
    "风入古松添急雨，月临虚槛背残灯。",
    "老猨啸狖还欺客，来撼窗前百尺藤。"
  ],
  "enabled": true,
