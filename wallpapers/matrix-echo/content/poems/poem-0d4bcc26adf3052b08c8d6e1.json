{
  "id": "poem-0d4bcc26adf3052b08c8d6e1",
  "title": "山居八咏 二",
  "author": "常达",
  "dynasty": "唐",
  "verses": [
    "晚望虚庭物，心心见祖情。",
    "烟开分岳色，雨雾减泉声。",
    "远树猨长啸，层岩日乍明。",
    "更堪论的意，林下笋新生。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
