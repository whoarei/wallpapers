{
  "id": "poem-c9f42690c521da71d99badcf",
  "title": "送法镜上人归上元",
  "author": "张祜",
  "dynasty": "唐",
  "verses": [
    "南国僧游二十年，却因无任访生缘。",
    "风回建业秋归寺，月满秦淮夜到舡。",
    "故老尽成双鬓雪，旧房深鏁一林烟。",
    "莫言了悟为真理，不叹兴亡在眼前。"
  ],
  "enabled": true,
