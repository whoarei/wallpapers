{
  "id": "poem-17f9967a10ca59e790ccb660",
  "title": "荷叶杯·我忆君诗最苦",
  "author": "顾敻",
  "dynasty": "五代",
  "verses": [
    "我忆君诗最苦，知否。",
    "字字尽关心，红笺写寄表情深。",
    "吟么吟，吟么吟。"
  ],
  "enabled": true,
