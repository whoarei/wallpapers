{
  "id": "poem-9430248724276775925d4fe5",
  "title": "咏史诗 滹沱河",
  "author": "胡曾",
  "dynasty": "唐",
  "verses": [
    "光武经营业未兴，王郎兵革正凭陵。",
    "须知后汉功臣力，不及滹沱一片冰。"
  ],
  "enabled": true,
