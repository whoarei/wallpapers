{
  "id": "poem-684abe382db06b50977672f7",
  "title": "奉纪",
  "author": "綦崇礼",
  "dynasty": "宋",
  "verses": [
    "八座近黄扉，三公宜黑发。",
    "用舍岂自谋，机缄何翕忽。",
    "一麾遽出守，双溪厌风月。",
    "江海今就闲，议论犹英发。",
    "大厦终须材，虚舟聊应物。",
    "胜览莫辞频，君驺宁久歇。"
  ],
  "enabled": true,
  "collection": "宋诗选",
