{
  "id": "poem-e8b675eb9810796ea94b59dd",
  "title": "再次韵  其二",
  "author": "陈造",
  "dynasty": "宋",
  "verses": [
    "覆觞课五升，秘诀不待传。",
    "百里三万家，优主师帅权。",
    "坐肉荒岁骨，岂但医十全。",
    "高郎径刺史，况论担弛肩。"
  ],
  "enabled": true,
  "collection": "宋诗选",
