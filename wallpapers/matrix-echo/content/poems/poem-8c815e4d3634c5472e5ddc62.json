{
  "id": "poem-8c815e4d3634c5472e5ddc62",
  "title": "早过湖",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "唤得航船傍采菱，柳桥竹榭曙烟深。",
    "船头惊起蜻蜓睡，欲立还飞到涌金。"
  ],
  "enabled": true,
  "collection": "宋诗选",
