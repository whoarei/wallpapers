{
  "id": "poem-0a3db373c0a293b88648faab",
  "title": "赠邵尧夫",
  "author": "司马光",
  "dynasty": "宋",
  "verses": [
    "家虽在城阙，萧瑟似荒郊。",
    "远去名利窟，自称安乐巢。",
    "云归白石洞，鹤立碧松梢。",
    "得丧非吾事，何须更解嘲。"
  ],
  "enabled": true,
  "collection": "宋诗选",
