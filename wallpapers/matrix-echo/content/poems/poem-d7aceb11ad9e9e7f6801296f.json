{
  "id": "poem-d7aceb11ad9e9e7f6801296f",
  "title": "和钱秘监旅居秋怀二首  其一",
  "author": "徐铉",
  "dynasty": "宋",
  "verses": [
    "秘监疏朝谒，门前长绿苔。",
    "未愁玄鬓改，且喜素秋来。",
    "独坐翻棋势，闲行绕药栽。",
    "凉风入书幌，时动水沉灰。"
  ],
  "enabled": true,
  "collection": "宋诗选",
