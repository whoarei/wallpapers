{
  "id": "poem-0129470cd8453499b9c4c7d6",
  "title": "故南阳夫人樊氏挽歌",
  "author": "王维",
  "dynasty": "唐",
  "verses": [
    "石窌恩荣重，金吾车骑盛。",
    "将朝每赠言，入室还相敬。",
    "叠鼓秋城动，悬旌寒日映。",
    "不言长不归，环珮犹将听。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
