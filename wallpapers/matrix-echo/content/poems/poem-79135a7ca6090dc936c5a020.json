{
  "id": "poem-79135a7ca6090dc936c5a020",
  "title": "送狄参军赴杭州",
  "author": "马戴",
  "dynasty": "唐",
  "verses": [
    "新官非次受，圣主宠前勋。",
    "关雪发车晚，风涛挂席闻。",
    "海门山叠翠，湖岸郡藏云。",
    "执简从公后，髯参岂胜君。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
