{
  "id": "poem-674518177bd60a4259ca19c4",
  "title": "仲春有怀  其四",
  "author": "张栻",
  "dynasty": "宋",
  "verses": [
    "楚翠亭边花正开，道乡台下石崔嵬。",
    "主人今有此客否，客亦思君日百回。"
  ],
  "enabled": true,
