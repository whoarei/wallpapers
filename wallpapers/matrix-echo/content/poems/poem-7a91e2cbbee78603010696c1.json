{
  "id": "poem-7a91e2cbbee78603010696c1",
  "title": "李舍人山园送庞邵",
  "author": "沈佺期",
  "dynasty": "唐",
  "verses": [
    "符传有光辉，諠諠出帝畿。",
    "东隣借山水，南陌驻骖𬴂。",
    "握手凉风至，当歌秋日微。",
    "高幨去勿缓，人吏待霜威。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
