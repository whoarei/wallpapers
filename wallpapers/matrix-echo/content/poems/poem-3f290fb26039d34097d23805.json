{
  "id": "poem-3f290fb26039d34097d23805",
  "title": "击瓯楼",
  "author": "邵叶",
  "dynasty": "宋",
  "verses": [
    "驻旌元帅遗风在，击缶高人逸兴酣。",
    "水转巴文清溜急，山连蒙岫翠光涵。"
  ],
  "enabled": true,
  "collection": "宋诗选",
