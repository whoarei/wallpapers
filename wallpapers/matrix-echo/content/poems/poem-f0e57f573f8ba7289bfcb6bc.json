{
  "id": "poem-f0e57f573f8ba7289bfcb6bc",
  "title": "近试上张籍水部",
  "author": "朱庆余",
  "dynasty": "唐",
  "verses": [
    "洞房昨夜停红烛，待晓堂前拜舅姑。",
    "[妆]罢低声问夫壻，画眉深浅入时无。"
  ],
  "enabled": true,
