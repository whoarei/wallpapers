{
  "id": "poem-08510d329943573aea06d374",
  "title": "闲居拟齐梁四首 一",
  "author": "贯休",
  "dynasty": "唐",
  "verses": [
    "夜雨山草滋，爽籁生古木。",
    "闲吟竹仙偈，清于嚼金玉。",
    "蟋蟀啼坏墙，苟免悲局促。",
    "道人优昙花，迢迢远山绿。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
