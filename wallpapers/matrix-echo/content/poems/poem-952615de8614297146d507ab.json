{
  "id": "poem-952615de8614297146d507ab",
  "title": "时兴",
  "author": "杨贲",
  "dynasty": "唐",
  "verses": [
    "贵人昔未贵，咸愿顾寒微。",
    "及自登枢要，何曾问布衣。",
    "平明登紫阁，日晏下彤闱。",
    "扰扰路傍子，无劳歌是非。"
  ],
  "enabled": true,
