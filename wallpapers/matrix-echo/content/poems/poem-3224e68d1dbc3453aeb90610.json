{
  "id": "poem-3224e68d1dbc3453aeb90610",
  "title": "咏史诗 细柳营",
  "author": "胡曾",
  "dynasty": "唐",
  "verses": [
    "文帝銮舆劳北征，条侯此地整严兵。",
    "辕门不峻将军令，今日争知细柳营。"
  ],
  "enabled": true,
