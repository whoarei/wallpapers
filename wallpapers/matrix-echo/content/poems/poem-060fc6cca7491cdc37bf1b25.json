{
  "id": "poem-060fc6cca7491cdc37bf1b25",
  "title": "过剡  其一",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "曹娥泪血点江潮，百里都无绿半篙。",
    "剡水迎潮须款曲，小分清莹洗浑涛。"
  ],
  "enabled": true,
  "collection": "宋诗选",
