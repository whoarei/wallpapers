{
  "id": "poem-83253c4a1979cbce31345058",
  "title": "早起",
  "author": "王十朋",
  "dynasty": "宋",
  "verses": [
    "老欲投闲尚未成，胶胶扰扰厌余生。",
    "方成枕上游仙梦，忽听窗前唤起声。"
  ],
  "enabled": true,
  "collection": "宋诗选",
