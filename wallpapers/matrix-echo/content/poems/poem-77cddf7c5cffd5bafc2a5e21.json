{
  "id": "poem-77cddf7c5cffd5bafc2a5e21",
  "title": "白鹤禅寺",
  "author": "王十朋",
  "dynasty": "宋",
  "verses": [
    "闲上箫台顶，山深喜路通。",
    "人家烟色里，古寺水声中。",
    "金溅星犹在，丹成灶已空。",
    "神仙何处觅，千载想遗风。"
  ],
  "enabled": true,
  "collection": "宋诗选",
