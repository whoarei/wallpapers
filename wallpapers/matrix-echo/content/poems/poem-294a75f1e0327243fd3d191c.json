{
  "id": "poem-294a75f1e0327243fd3d191c",
  "title": "送越僧元瑞",
  "author": "项斯",
  "dynasty": "唐",
  "verses": [
    "静中无伴侣，今亦独随缘。",
    "昨夜离空室，焚香净去船。"
  ],
  "enabled": true,
