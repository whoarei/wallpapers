{
  "id": "poem-d69a10a6b5faf4cfe72ccc11",
  "title": "好事近·马首望青山",
  "author": "纳兰性德",
  "dynasty": "清",
  "verses": [
    "马首望青山，零落繁华如此。",
    "再向断烟衰草，认藓碑题字。",
    "休寻折载话当年，只洒悲秋泪。",
    "斜日十三陵下，过新丰猎骑。"
  ],
  "enabled": true,
  "collection": "纳兰词",
  "tags": [],
