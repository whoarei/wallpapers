{
  "id": "poem-7c3f4bdaadfcb9dc1078f851",
  "title": "商于逢友人",
  "author": "喻坦之",
  "dynasty": "唐",
  "verses": [
    "行役何时了，年年骨肉分。",
    "春风来汉棹，雪路入商云。",
    "水险溪难定，林寒鸟异群。",
    "相逢聊坐石，啼狖语中闻。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
