{
  "id": "poem-d0f029cd5159ea53da24099a",
  "title": "送陆侍御余庆北使",
  "author": "沈佺期",
  "dynasty": "唐",
  "verses": [
    "古人贵将命，之子出𬨎轩。",
    "受委当不辱，随时敢赠言。",
    "朔途际辽海，春思绕轘辕。",
    "安得回白日，留欢尽绿樽。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
