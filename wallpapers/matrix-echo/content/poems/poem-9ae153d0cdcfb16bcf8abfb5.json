{
  "id": "poem-9ae153d0cdcfb16bcf8abfb5",
  "title": "东郊",
  "author": "韦应物",
  "dynasty": "唐",
  "verses": [
    "吏舍跼终年，出郊旷清曙。",
    "杨柳散和风，青山澹吾虑。",
    "依丛适自憩，缘涧还复去。",
    "微雨霭芳原，春鸠鸣何处？乐幽心屡止，遵事迹犹遽。",
    "终罢斯结庐，慕陶真可庶。"
  ],
  "enabled": true,
