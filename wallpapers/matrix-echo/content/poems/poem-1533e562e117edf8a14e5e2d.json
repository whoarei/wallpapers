{
  "id": "poem-1533e562e117edf8a14e5e2d",
  "title": "醉公子·漠漠秋云淡",
  "author": "顾敻",
  "dynasty": "五代",
  "verses": [
    "漠漠秋云淡，红耦香侵槛。",
    "枕欹小山屏，金铺向晚扃。",
    "睡起横波慢，独望情何限。",
    "衰柳数声蝉，魂消似去年。"
  ],
  "enabled": true,
  "collection": "花间集",
