{
  "id": "poem-f947815fd958ff8871962eee",
  "title": "江南杂题三十首 其六",
  "author": "张祜",
  "dynasty": "唐",
  "verses": [
    "远郭浸烟波，村桥入薜萝。",
    "水虵惊去疾，山鸟自来多。",
    "夜月倾壶酒，春风就榜歌。"
  ],
  "enabled": true,
