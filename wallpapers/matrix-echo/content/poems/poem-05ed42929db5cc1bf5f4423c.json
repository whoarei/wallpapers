{
  "id": "poem-05ed42929db5cc1bf5f4423c",
  "title": "又绝句寄题毗陵驿",
  "author": "徐铉",
  "dynasty": "宋",
  "verses": [
    "曾持使节驻毗陵，长与州人有旧情。",
    "为向驿桥风月道，舍人髭鬓白千茎。"
  ],
  "enabled": true,
