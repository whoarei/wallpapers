{
  "id": "poem-8cc9d8abcf6d596893e12b63",
  "title": "浣溪沙·叶底青青杏子垂",
  "author": "欧阳修",
  "dynasty": "宋",
  "verses": [
    "叶底青青杏子垂。",
    "枝头薄薄柳绵飞。",
    "日高深院晚莺啼。",
    "堪恨风流成薄幸，断无消息道归期。",
    "托腮无语翠眉低。"
  ],
  "enabled": true,
  "collection": "宋词选",
