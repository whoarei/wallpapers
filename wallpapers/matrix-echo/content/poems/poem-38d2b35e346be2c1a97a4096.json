{
  "id": "poem-38d2b35e346be2c1a97a4096",
  "title": "陈情上知己",
  "author": "刘得仁",
  "dynasty": "唐",
  "verses": [
    "性与才俱拙，名场迹甚微。",
    "久居颜亦厚，独立事多非。",
    "刻骨搜新句，无人悯白衣。",
    "明时自堪恋，不是不知机。"
  ],
  "enabled": true,
