{
  "id": "poem-a914e6ff28b99a475bad90fe",
  "title": "十二咏 磬塘",
  "author": "李纲",
  "dynasty": "宋",
  "verses": [
    "乔木森森借绿阴，曲塘波影漾疏林。",
    "龟鱼不用愁清浅，藻荇菰蒲隐映深。"
  ],
  "enabled": true,
  "collection": "宋诗选",
