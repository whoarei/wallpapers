{
  "id": "poem-aae3b1f62c7093d4d61cba8f",
  "title": "残雪",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "前水花新霁，暾云日未升。",
    "簷声都是雨，笕溜半成冰。",
    "幌冷疑眠月，窗虚罢续灯。",
    "独余林杪塔，犹自隠觚棱。"
  ],
  "enabled": true,
  "collection": "宋诗选",
