{
  "id": "poem-ea225a8821d012e4dfb7678b",
  "title": "句",
  "author": "李绅",
  "dynasty": "唐",
  "verses": [
    "君咏风月夕，余当童稚年。",
    "闲窗读书罢，偷咏左司篇。"
  ],
