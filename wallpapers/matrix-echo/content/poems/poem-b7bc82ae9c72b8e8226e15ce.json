{
  "id": "poem-b7bc82ae9c72b8e8226e15ce",
  "title": "江行无题一百首 六十",
  "author": "钱珝",
  "dynasty": "唐",
  "verses": [
    "景夕残霞落，秋寒细雨晴。",
    "短缨何用濯，舟在月中行。"
  ],
  "enabled": true,
