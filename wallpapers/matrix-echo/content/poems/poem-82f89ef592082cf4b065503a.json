{
  "id": "poem-82f89ef592082cf4b065503a",
  "title": "无生庵",
  "author": "华镇",
  "dynasty": "宋",
  "verses": [
    "大士今何在，空山旧隠存。",
    "百年闲藓径，终日敞尘阍。",
    "砌暖晴添草，窗寒暝叫猿。",
    "当时团坐客，相顾竟何言。"
  ],
  "enabled": true,
  "collection": "宋诗选",
