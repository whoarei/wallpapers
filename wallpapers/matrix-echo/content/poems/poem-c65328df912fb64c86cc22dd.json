{
  "id": "poem-c65328df912fb64c86cc22dd",
  "title": "杨柳枝·织锦机边莺语频",
  "author": "温庭筠",
  "dynasty": "唐",
  "verses": [
    "织锦机边莺语频，停梭垂泪忆征人。",
    "塞门三月犹萧索，纵有垂杨未觉春。"
  ],
  "enabled": true,
  "collection": "花间集",
