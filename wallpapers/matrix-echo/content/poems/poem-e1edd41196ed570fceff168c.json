{
  "id": "poem-e1edd41196ed570fceff168c",
  "title": "了语",
  "author": "雍裕之",
  "dynasty": "唐",
  "verses": [
    "扫却烟尘寇初勦，深水高林放鱼鸟。",
    "鸡人唱绝残漏晓，仙乐拍终天悄悄。"
  ],
  "enabled": true,
