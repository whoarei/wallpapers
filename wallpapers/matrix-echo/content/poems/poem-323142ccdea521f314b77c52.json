{
  "id": "poem-323142ccdea521f314b77c52",
  "title": "海棠",
  "author": "苏轼",
  "dynasty": "宋",
  "verses": [
    "东风袅袅泛崇光，香雾空蒙月转廊。",
    "只恐夜深花睡去，故烧高烛照红妆。"
  ],
  "enabled": true,
  "collection": "千家诗",
