{
  "id": "poem-39e351296230cb8654bf27c1",
  "title": "秦望山",
  "author": "王镃",
  "dynasty": "宋",
  "verses": [
    "祖龙痴欲望长年，却遣君房渡海船。",
    "枉去蓬山觅丹药，桃源亦自有神仙。"
  ],
  "enabled": true,
  "collection": "宋诗选",
