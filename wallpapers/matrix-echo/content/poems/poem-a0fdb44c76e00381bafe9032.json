{
  "id": "poem-a0fdb44c76e00381bafe9032",
  "title": "句",
  "author": "明皇帝",
  "dynasty": "唐",
  "verses": [
    "昔见漳滨卧，言将人事违。",
    "今逢庆诞日，犹谓学仙归。",
    "棠棣花重发，鸰原鸟再飞。",
    "德比代云布，心如晋水清。"
  ],
  "enabled": true,
