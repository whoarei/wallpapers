{
  "id": "poem-cb54b070d3916a6c80517fc2",
  "title": "寒食日献郡守",
  "author": "伍唐珪",
  "dynasty": "唐",
  "verses": [
    "入门堪笑复堪怜，三径苔荒一钓船。",
    "慙愧四隣教断火，不知厨里久无烟。"
  ],
  "enabled": true,
