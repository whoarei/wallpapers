{
  "id": "poem-97cdc06326cc46ab6ccbe374",
  "title": "咏屏风",
  "author": "袁恕己",
  "dynasty": "唐",
  "verses": [
    "绮阁云霞满，芳林草树新。",
    "鸟惊疑欲曙，花笑不关春。",
    "山对弹琴客，谿留垂钓人。",
    "请看车马客，行处有风尘。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
