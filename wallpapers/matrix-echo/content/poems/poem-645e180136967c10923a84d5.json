{
  "id": "poem-645e180136967c10923a84d5",
  "title": "行园树",
  "author": "徐铉",
  "dynasty": "宋",
  "verses": [
    "松节凌霜久，蓬根逐吹频。",
    "群生各有性，桃李但争春。"
  ],
  "enabled": true,
