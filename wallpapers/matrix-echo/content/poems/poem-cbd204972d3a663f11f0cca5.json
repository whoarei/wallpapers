{
  "id": "poem-cbd204972d3a663f11f0cca5",
  "title": "望秦川",
  "author": "李颀",
  "dynasty": "唐",
  "verses": [
    "秦川朝望迥，日出正东峰。",
    "远近山河净，逶迤城阙重。",
    "秋声万户竹，寒色五陵松。",
    "有客归欤叹，凄其霜露浓。"
  ],
  "enabled": true,
  "collection": "千家诗",
  "tags": [],
