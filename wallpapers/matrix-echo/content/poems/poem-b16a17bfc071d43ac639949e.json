{
  "id": "poem-b16a17bfc071d43ac639949e",
  "title": "逍遥台",
  "author": "陈岩",
  "dynasty": "宋",
  "verses": [
    "拂面溪风洒洒清，轻衫短帽御风行。",
    "逍遥自是天游乐，不结沙鸥水石盟。"
  ],
  "enabled": true,
