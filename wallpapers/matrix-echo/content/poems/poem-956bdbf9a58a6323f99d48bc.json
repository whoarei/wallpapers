{
  "id": "poem-956bdbf9a58a6323f99d48bc",
  "title": "发成都  其二",
  "author": "刘望之",
  "dynasty": "宋",
  "verses": [
    "欲洗羁愁只自醒，郫筒酒好信虚名。",
    "江阳春色论千户，价比西州却未轻。"
  ],
  "enabled": true,
