{
  "id": "poem-2cdc91b8314dba7a5a526044",
  "title": "人日剪彩",
  "author": "徐延寿",
  "dynasty": "唐",
  "verses": [
    "闺妇持刀坐，自怜裁剪新。",
    "叶催情缀色，花寄手成春。",
    "帖燕留妆户，黏鸡待饷人。",
    "擎来问夫壻，何处不如真。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
