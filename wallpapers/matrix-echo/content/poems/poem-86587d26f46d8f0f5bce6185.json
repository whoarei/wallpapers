{
  "id": "poem-86587d26f46d8f0f5bce6185",
  "title": "湖南运使程大卿寿",
  "author": "华镇",
  "dynasty": "宋",
  "verses": [
    "时来嘉会一阳新，庆属高门诞哲人。",
    "杞梓挺材周世用，珪璋含德足天纯。",
    "酒熏爱日凝和气，香触寒梅发早春。",
    "密运阴功方寸地，默增遐算有明神。"
  ],
  "enabled": true,
  "collection": "宋诗选",
