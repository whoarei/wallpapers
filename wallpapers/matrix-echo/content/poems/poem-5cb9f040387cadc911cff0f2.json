{
  "id": "poem-5cb9f040387cadc911cff0f2",
  "title": "盘隠瘗猿",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "寸土如寸金，恩殊帷盖深。",
    "病思罹穽日，死恨出林心。",
    "残橡停朝赋，空樊绝夜吟。",
    "六窗呼不应，云冷月沉沉。"
  ],
  "enabled": true,
  "collection": "宋诗选",
