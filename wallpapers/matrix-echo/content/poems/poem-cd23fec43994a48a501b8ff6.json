{
  "id": "poem-cd23fec43994a48a501b8ff6",
  "title": "双劝酒",
  "author": "无名氏《张协状元》",
  "dynasty": "元",
  "verses": [
    "阿爹阿娘，教我传语：些儿酒米，担来与你。",
    "要时你便留住，不要我便将去。"
  ],
  "enabled": true,
