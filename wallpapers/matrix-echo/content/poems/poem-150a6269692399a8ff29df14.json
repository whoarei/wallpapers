{
  "id": "poem-150a6269692399a8ff29df14",
  "title": "题龙门寺",
  "author": "陆海",
  "dynasty": "唐",
  "verses": [
    "窗灯林霭里，闻磬水声中。",
    "更与龙华会，炉烟满夕风。"
  ],
  "enabled": true,
