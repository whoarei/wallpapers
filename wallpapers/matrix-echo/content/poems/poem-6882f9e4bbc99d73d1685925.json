{
  "id": "poem-6882f9e4bbc99d73d1685925",
  "title": "思君恩",
  "author": "令狐楚",
  "dynasty": "唐",
  "verses": [
    "小苑莺歌歇，长门蝶舞多。",
    "眼看春又去，翠辇不曾过。"
  ],
  "enabled": true,
  "collection": "千家诗",
