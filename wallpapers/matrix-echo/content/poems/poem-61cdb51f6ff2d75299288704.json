{
  "id": "poem-61cdb51f6ff2d75299288704",
  "title": "读杜紫微集",
  "author": "崔道融",
  "dynasty": "唐",
  "verses": [
    "紫微才调复知兵，长觉风雷笔下生。",
    "还有枉抛心力处，多于五柳赋闲情。"
  ],
  "enabled": true,
