{
  "id": "poem-387190173a393b7d3fe82394",
  "title": "送南客",
  "author": "张籍",
  "dynasty": "唐",
  "verses": [
    "行路雨修修，青山尽海头。",
    "天涯人去远，岭北水空流。",
    "夜市连铜柱，巢居属象州。",
    "来时旧相识，谁向日南游。"
  ],
  "enabled": true,
