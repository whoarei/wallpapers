{
  "id": "poem-434dc70e59e8fe2dd4851f7b",
  "title": "秋日送河北从事",
  "author": "裴说",
  "dynasty": "唐",
  "verses": [
    "北风沙漠地，吾子远从军。",
    "官路虽非远，诗名要且闻。",
    "蝉悲欲落日，雕下拟阴云。",
    "此去难相恋，前山掺袂分。"
  ],
  "enabled": true,
