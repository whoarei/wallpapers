{
  "id": "poem-35682a19affd54f950a92883",
  "title": "生查子·东风不解愁",
  "author": "纳兰性德",
  "dynasty": "清",
  "verses": [
    "东风不解愁，偷展湘裙衩。",
    "独夜背纱笼，影著纤腰画。",
    "𦶟尽水沉烟，露滴鸳鸯瓦。",
    "花骨冷宜香，小立樱桃下。"
  ],
  "enabled": true,
  "collection": "纳兰词",
  "tags": [],
