{
  "id": "poem-e39cfa5b3f79fb208fc0dc0c",
  "title": "书云后三日游致道观",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "九日同游柱史家，野英羞涩未成花。",
    "重来又是书云后，刚德才抽四日芽。"
  ],
