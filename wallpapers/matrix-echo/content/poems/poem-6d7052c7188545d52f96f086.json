{
  "id": "poem-6d7052c7188545d52f96f086",
  "title": "右军墨池",
  "author": "刘言史",
  "dynasty": "唐",
  "verses": [
    "永嘉人事尽归空，逸少遗居蔓草中。",
    "至今池水涵余墨，犹共诸泉色不同。"
  ],
  "enabled": true,
