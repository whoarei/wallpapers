{
  "id": "poem-0aa096e53f7e83a410049fb3",
  "title": "寄流人",
  "author": "项斯",
  "dynasty": "唐",
  "verses": [
    "毒草不曾枯，长添客健无。",
    "雾开蛮市合，船散海城孤。",
    "象迹频藏齿，龙涎远蔽珠。",
    "家人秦地老，泣对日南图。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
