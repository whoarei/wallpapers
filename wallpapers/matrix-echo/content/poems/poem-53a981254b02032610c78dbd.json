{
  "id": "poem-53a981254b02032610c78dbd",
  "title": "颂古三十一首  其一六",
  "author": "释玿",
  "dynasty": "宋",
  "verses": [
    "明日大悲院里斋，铁围山岳尽冲开。",
    "猪头象鼻，乌觜鱼腮。",
    "石人抚掌呵呵笑，寒山拾得在天台。"
  ],
  "enabled": true,
  "collection": "宋诗选",
