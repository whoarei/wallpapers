{
  "id": "poem-d62cd301a0684b589a4c60c5",
  "title": "使青夷军入居庸三首 一",
  "author": "高适",
  "dynasty": "唐",
  "verses": [
    "匹马行将久，征途去转难。",
    "不知边地别，秪讶客衣单。",
    "谿冷泉声苦，山空木叶干。",
    "莫言关塞极，云雪尚漫漫。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
