{
  "id": "poem-aeaf0878cb80fba7fc01d55e",
  "title": "杏殇 一",
  "author": "孟郊",
  "dynasty": "唐",
  "verses": [
    "冻手莫弄珠，弄珠珠易飞。",
    "惊霜莫翦春，翦春无光辉。",
    "零落小花乳，斓斑昔婴衣。",
    "拾之不盈把，日暮空悲归。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
