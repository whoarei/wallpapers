{
  "id": "poem-d64e369bb81f790d0b64fcca",
  "title": "江南曲五首 五",
  "author": "丁仙芝",
  "dynasty": "唐",
  "verses": [
    "始下芙蓉楼，言发瑯琊岸。",
    "急为打船开，恶许傍人见。"
  ],
