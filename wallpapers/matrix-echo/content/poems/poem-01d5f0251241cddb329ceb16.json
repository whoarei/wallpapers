{
  "id": "poem-01d5f0251241cddb329ceb16",
  "title": "宫词  其四○",
  "author": "张公庠",
  "dynasty": "宋",
  "verses": [
    "清晓传宣赐御题，日华初动露华晞。",
    "集英殿上天香散，飞入千人白纻衣。"
  ],
