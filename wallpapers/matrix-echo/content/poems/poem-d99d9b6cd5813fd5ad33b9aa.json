{
  "id": "poem-d99d9b6cd5813fd5ad33b9aa",
  "title": "龙安院",
  "author": "陈岩",
  "dynasty": "宋",
  "verses": [
    "蔓草丛生伴棘薪，古藤直上绕松身。",
    "寺前寺后清幽处，山鸟飞来不避人。"
  ],
  "enabled": true,
  "collection": "宋诗选",
