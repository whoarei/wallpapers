{
  "id": "poem-f54114ef4fdfdaff853ff914",
  "title": "长安晓望寄崔补阙",
  "author": "包何",
  "dynasty": "唐",
  "verses": [
    "迢递山河拥帝京，参差宫殿接云平。",
    "风吹晓漏经长乐，柳带晴烟出禁城。",
    "天净笙歌临路发，日高车马隔尘行。",
    "自怜久滞诸生列，未得金闺籍姓名。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
