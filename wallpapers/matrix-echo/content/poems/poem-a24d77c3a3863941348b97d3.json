{
  "id": "poem-a24d77c3a3863941348b97d3",
  "title": "宿瓜州",
  "author": "李绅",
  "dynasty": "唐",
  "verses": [
    "烟昏水郭津亭晚，回望金陵若动摇。",
    "冲浦回风翻宿浪，照沙低月歛残潮。",
    "柳经寒露看萧索，人改衰容自寂寥。",
    "官冷旧谙唯旅馆，岁阴轻薄是凉飙。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
