{
  "id": "poem-ff09b9b1ae206ca2f8f48f95",
  "title": "怀京国",
  "author": "李德裕",
  "dynasty": "唐",
  "verses": [
    "海上东风犯雪来，腊前先折镜湖梅。",
    "遥思禁苑青春夜，坐待宫人画诏回。"
  ],
  "enabled": true,
