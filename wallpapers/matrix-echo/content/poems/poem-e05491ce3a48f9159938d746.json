{
  "id": "poem-e05491ce3a48f9159938d746",
  "title": "双溪",
  "author": "陈岩",
  "dynasty": "宋",
  "verses": [
    "二水来从翠岭头，相逢涧谷却同流。",
    "冷光如镜清人骨，探借山间六月秋。"
  ],
  "enabled": true,
