{
  "id": "poem-a8a3bb82fe131b8fb41d50e2",
  "title": "宫怨",
  "author": "任翻",
  "dynasty": "唐",
  "verses": [
    "泪乾红落脸，心尽白垂头。",
    "自此方知怨，从来岂信愁。"
  ],
