{
  "id": "poem-7ee0dc6cd65489e00b007809",
  "title": "咏萤",
  "author": "周繇",
  "dynasty": "唐",
  "verses": [
    "熠熠与娟娟，池塘竹树边。",
    "乱飞同曳火，成聚却无烟。",
    "微雨洒不灭，清风吹欲燃。",
    "旧曾书按上，频把作囊悬。"
  ],
  "enabled": true,
