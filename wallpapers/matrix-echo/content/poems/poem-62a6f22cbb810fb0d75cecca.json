{
  "id": "poem-62a6f22cbb810fb0d75cecca",
  "title": "出峡",
  "author": "李纲",
  "dynasty": "宋",
  "verses": [
    "出峡日将暮，绮霞连水明。",
    "山遥欣野阔，海近觉江平。",
    "稍稍洲渚转，霏霏烟霭生。",
    "舟人喜风便，时发櫂讴声。"
  ],
  "enabled": true,
  "collection": "宋诗选",
