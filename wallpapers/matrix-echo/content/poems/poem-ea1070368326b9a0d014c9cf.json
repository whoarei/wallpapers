{
  "id": "poem-ea1070368326b9a0d014c9cf",
  "title": "永明山居诗（六十九首） 五",
  "author": "延寿",
  "dynasty": "唐",
  "verses": [
    "心地须教合死灰，藏机泯迹绝梯媒。",
    "芳兰祇为因香折，良木多从被直摧。",
    "寒逼花枝红未吐，日融水面绿全开。",
    "支颐独坐经窗下，一片云闲入户来。"
  ],
  "enabled": true,
