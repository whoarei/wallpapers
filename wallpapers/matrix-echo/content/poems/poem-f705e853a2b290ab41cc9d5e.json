{
  "id": "poem-f705e853a2b290ab41cc9d5e",
  "title": "颂 二",
  "author": "绍修",
  "dynasty": "唐",
  "verses": [
    "欲识解脱道，诸法不相到。",
    "眼耳绝见闻，声色闹浩浩。"
  ],
