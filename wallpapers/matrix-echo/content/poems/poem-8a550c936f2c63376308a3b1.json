{
  "id": "poem-8a550c936f2c63376308a3b1",
  "title": "三君咏 郭代公",
  "author": "高适",
  "dynasty": "唐",
  "verses": [
    "代公实英迈，津涯浩难识。",
    "拥兵抗矫征，仗节归有德。",
    "纵横负才智，顾盻安社稷。",
    "流落勿重陈，怀哉为凄恻。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
