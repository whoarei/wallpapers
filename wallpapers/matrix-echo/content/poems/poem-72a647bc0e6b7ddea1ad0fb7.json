{
  "id": "poem-72a647bc0e6b7ddea1ad0fb7",
  "title": "东平路作三首 三",
  "author": "高适",
  "dynasty": "唐",
  "verses": [
    "清旷凉夜月，裴回孤客舟。",
    "渺然风波上，独爱前山秋。",
    "秋至复摇落，空令行者愁。"
  ],
  "enabled": true,
