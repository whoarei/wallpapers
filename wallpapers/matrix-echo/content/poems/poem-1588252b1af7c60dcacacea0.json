{
  "id": "poem-1588252b1af7c60dcacacea0",
  "title": "夏日樊川别业即事",
  "author": "刘得仁",
  "dynasty": "唐",
  "verses": [
    "无事称无才，柴门亦罕开。",
    "脱巾吟永日，著屐步荒台。",
    "风卷微尘上，霆将暴雨来。",
    "终南云渐合，咫尺失崔嵬。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
