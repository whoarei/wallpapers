{
  "id": "poem-7c8ae7c35100474cea00bc53",
  "title": "又和内院海棠",
  "author": "苏颂",
  "dynasty": "宋",
  "verses": [
    "华萼相辉采翠重，几番浓艳九春中。",
    "根盘省闼偏含润，影拂邻墙暗逐风。",
    "繁若百枝然宝炷，深于三入染𫄸红。",
    "诸君赏咏时连属，珍重多才好事同。"
  ],
  "enabled": true,
  "collection": "宋诗选",
