{
  "id": "poem-e3fc1c147c6b1f68c2f4abec",
  "title": "山中秋夜",
  "author": "张籍",
  "dynasty": "唐",
  "verses": [
    "寂寂山景静，幽人归去迟。",
    "横琴当月下，压酒及花时。",
    "冷露湿茆屋，暗泉冲竹篱。",
    "西峰采药伴，此夕恨无期。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
