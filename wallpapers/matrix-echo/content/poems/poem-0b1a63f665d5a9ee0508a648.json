{
  "id": "poem-0b1a63f665d5a9ee0508a648",
  "title": "题空山人石室",
  "author": "崔峒",
  "dynasty": "唐",
  "verses": [
    "早晚悟无生，头陀不到城。",
    "云山知夏腊，猨鸟见修行。",
    "地僻无溪路，人寻逐水声。",
    "年年深谷里，谁识远公名。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
