{
  "id": "poem-dea6dcb392790dfbbd41f9cc",
  "title": "古别离",
  "author": "聂夷中",
  "dynasty": "唐",
  "verses": [
    "欲别牵郎衣，问郎游何处。",
    "不恨归日迟，莫向临邛去。"
  ],
  "enabled": true,
