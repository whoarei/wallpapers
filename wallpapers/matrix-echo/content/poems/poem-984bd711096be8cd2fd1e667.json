{
  "id": "poem-984bd711096be8cd2fd1e667",
  "title": "白府真君",
  "author": "赵杰之",
  "dynasty": "宋",
  "verses": [
    "卓茂当年政术优，治声终不似贤侯。",
    "显幽一致施仁化，庙食中山卒未休。"
  ],
  "enabled": true,
