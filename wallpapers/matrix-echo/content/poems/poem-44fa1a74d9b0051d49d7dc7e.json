{
  "id": "poem-44fa1a74d9b0051d49d7dc7e",
  "title": "更漏子·小窗前",
  "author": "向子𬤇",
  "dynasty": "宋",
  "verses": [
    "小窗前，疏影下。",
    "鸾镜弄妆初罢。",
    "梅似雪，雪如人。",
    "都无一点尘。",
    "暮江寒，人响绝。",
    "更着朦胧微月。",
    "山似玉，玉如君。",
    "相看一笑温。"
  ],
  "enabled": true,
  "collection": "宋词选",
