{
  "id": "poem-bfd5b2077e82e0a49ff5b6a9",
  "title": "陪致政开府太师留守相公致政内翰燕集輙歌盛美为三公寿皆用公字为韵 内翰",
  "author": "司马光",
  "dynasty": "宋",
  "verses": [
    "眉似高僧秀，颜如童子红。",
    "忠纯汲长孺，高洁夏黄公。",
    "矫矫辽东鸖，冥冥塞北鸿。",
    "自夸新酒量，像想百分空。"
  ],
  "enabled": true,
  "collection": "宋诗选",
