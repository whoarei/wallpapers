{
  "id": "poem-0e2344993e6faca49c5ac0eb",
  "title": "枫桥夜泊",
  "author": "张继",
  "dynasty": "唐",
  "verses": [
    "月落乌啼霜满天，江枫渔父对愁眠。",
    "姑苏城外寒山寺，夜半钟声到客船。"
  ],
  "enabled": true,
