{
  "id": "poem-c6e46207e6f9f06e08d4109e",
  "title": "鹳雀楼晴望",
  "author": "马戴",
  "dynasty": "唐",
  "verses": [
    "尧女楼西望，人怀太古时。",
    "海波通禹凿，山木闭虞祠。",
    "鸟道残虹挂，龙潭返照移。",
    "行云如可驭，万里赴心期。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
