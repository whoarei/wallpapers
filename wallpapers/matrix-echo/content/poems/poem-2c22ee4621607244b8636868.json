{
  "id": "poem-2c22ee4621607244b8636868",
  "title": "赠祠部令狐郎中",
  "author": "马戴",
  "dynasty": "唐",
  "verses": [
    "官初执宪称雄才，省转为郎雅望催。",
    "待制松阴移玉殿，分宵露气静天台。",
    "算棋默向孤云坐，随鹤闲穷片水回。",
    "忽忆十年相识日，小儒新自海边来。"
  ],
  "enabled": true,
