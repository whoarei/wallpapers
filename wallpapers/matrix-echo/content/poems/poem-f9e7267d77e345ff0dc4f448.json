{
  "id": "poem-f9e7267d77e345ff0dc4f448",
  "title": "马嵬感事",
  "author": "唐求",
  "dynasty": "唐",
  "verses": [
    "冷气生深殿，狼星渡远关。",
    "九城鼙鼓内，千骑道途间。",
    "凤髻随秋草，銮舆入暮山。",
    "恨多留不得，悲泪满龙颜。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
