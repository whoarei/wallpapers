{
  "id": "poem-0eb674dc12b6db2c7f670311",
  "title": "桂",
  "author": "王镃",
  "dynasty": "宋",
  "verses": [
    "金虫镂月影玲珑，璧叶将秋锁翠栊。",
    "昨夜楼台风露冷，几人魂梦入林中。"
  ],
  "enabled": true,
  "collection": "宋诗选",
