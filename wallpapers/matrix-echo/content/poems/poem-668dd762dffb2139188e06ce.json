{
  "id": "poem-668dd762dffb2139188e06ce",
  "title": "颂古三十一首  其一七",
  "author": "释原妙",
  "dynasty": "宋",
  "verses": [
    "吞而复吐冷烟浮，月落寒山犹未休。",
    "重把丝纶轻一掣，岂知元只在钩头。"
  ],
  "enabled": true,
