{
  "id": "poem-7b1373950b424194fe7f2c84",
  "title": "题故僧影堂",
  "author": "张籍",
  "dynasty": "唐",
  "verses": [
    "香消云锁旧僧家，僧刹残形半壁斜。",
    "日暮松烟寒漠漠，秋风吹破纸莲花。"
  ],
  "enabled": true,
