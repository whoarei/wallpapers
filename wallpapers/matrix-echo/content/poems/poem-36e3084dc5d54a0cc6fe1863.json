{
  "id": "poem-36e3084dc5d54a0cc6fe1863",
  "title": "别石泉",
  "author": "李绅",
  "dynasty": "唐",
  "verses": [
    "素沙见底空无色，青石潜流暗有声。",
    "微渡竹风涵淅沥，细浮松月透轻明。",
    "桂凝秋露添灵液，茗折香芽泛玉英。",
    "应是梵宫连洞府，浴池今化醒泉清。"
  ],
  "enabled": true,
