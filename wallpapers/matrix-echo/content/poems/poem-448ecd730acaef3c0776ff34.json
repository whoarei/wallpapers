{
  "id": "poem-448ecd730acaef3c0776ff34",
  "title": "柳枝·腻粉琼妆透碧纱",
  "author": "张泌",
  "dynasty": "五代",
  "verses": [
    "腻粉琼妆透碧纱，雪休夸。",
    "金凤搔头堕鬓斜，发交加。",
    "倚着云屏新睡觉，思梦笑。",
    "红腮隐出枕函花，有些些。"
  ],
  "enabled": true,
  "collection": "花间集",
