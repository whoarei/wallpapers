{
  "id": "poem-02faced93051b7c02ab9d206",
  "title": "示如法禅人  其一",
  "author": "释原妙",
  "dynasty": "宋",
  "verses": [
    "识得根源认得伊，全身犹堕在尘围。",
    "纵然和座都掀倒，尚有烟霞遶翠微。"
  ],
  "enabled": true,
