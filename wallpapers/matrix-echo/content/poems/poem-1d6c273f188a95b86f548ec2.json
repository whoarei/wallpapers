{
  "id": "poem-1d6c273f188a95b86f548ec2",
  "title": "舂陵登望",
  "author": "皎然",
  "dynasty": "唐",
  "verses": [
    "西底空流水，东垣但聚云。",
    "最伤梅岭望，花雪正纷纷。"
  ],
  "enabled": true,
