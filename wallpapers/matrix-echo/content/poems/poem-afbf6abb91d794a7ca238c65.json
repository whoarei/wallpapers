{
  "id": "poem-afbf6abb91d794a7ca238c65",
  "title": "山居夏日",
  "author": "高骈",
  "dynasty": "唐",
  "verses": [
    "绿树阴浓夏日长，楼台倒影入池塘。",
    "水晶帘动微风起，满架蔷薇一院香。"
  ],
  "enabled": true,
  "collection": "千家诗",
