{
  "id": "poem-7a12b77292d5043caacc995b",
  "title": "终南山",
  "author": "王维",
  "dynasty": "唐",
  "verses": [
    "太乙近天都，连山到海隅。",
    "白云回望合，青霭入看无。",
    "分野中峰变，阴晴众壑殊。",
    "欲投何处宿，隔水问樵夫。"
  ],
  "enabled": true,
  "collection": "千家诗",
  "tags": [],
