{
  "id": "poem-6ffd020fbce3a4457b9bfaae",
  "title": "乌栖曲",
  "author": "李端",
  "dynasty": "唐",
  "verses": [
    "白马逐朱车，黄昏入狭斜。",
    "狭斜柳树乌争宿，争枝未得飞上屋。",
    "东房少妇壻从军，每听乌啼知夜分。"
  ],
  "enabled": true,
