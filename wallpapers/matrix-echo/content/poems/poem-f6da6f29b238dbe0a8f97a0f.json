{
  "id": "poem-f6da6f29b238dbe0a8f97a0f",
  "title": "舟过孤山",
  "author": "王琮",
  "dynasty": "宋",
  "verses": [
    "寂寞梅花处士坟，竹围岩脚一泉深。",
    "隃瞻翠辇曾游处，水钥年年护绿阴。"
  ],
  "enabled": true,
  "collection": "宋诗选",
