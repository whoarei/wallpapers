{
  "id": "poem-6a06cf0f66c7a0974e7353a0",
  "title": "资圣寺送甘二",
  "author": "王维",
  "dynasty": "唐",
  "verses": [
    "浮生信如寄，薄宦夫何有。",
    "来往本无归，别离方此受。",
    "柳色蔼春余，槐阴清夏首。",
    "不觉御沟上，衔悲执桮酒。"
  ],
  "enabled": true,
