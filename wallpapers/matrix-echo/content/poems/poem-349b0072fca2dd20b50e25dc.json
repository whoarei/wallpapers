{
  "id": "poem-349b0072fca2dd20b50e25dc",
  "title": "梁谿八咏 怡亭",
  "author": "李纲",
  "dynasty": "宋",
  "verses": [
    "缥缈危亭枕曲池，红粧翠羽自参差。",
    "晚凉小饮谁同醉，定把圆荷当屈巵。"
  ],
  "enabled": true,
  "collection": "宋诗选",
