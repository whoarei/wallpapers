{
  "id": "poem-ad41ab3de52fd681887cb809",
  "title": "故行宫",
  "author": "王建",
  "dynasty": "唐",
  "verses": [
    "寥落古行宫，宫花寂寞红。",
    "白头宫女在，闲坐说玄宗。"
  ],
  "enabled": true,
