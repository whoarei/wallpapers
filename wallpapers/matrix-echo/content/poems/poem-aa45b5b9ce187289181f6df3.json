{
  "id": "poem-aa45b5b9ce187289181f6df3",
  "title": "春江夕望",
  "author": "卢纶",
  "dynasty": "唐",
  "verses": [
    "洞庭芳草遍，楚客莫思归。",
    "经难人空老，逢春鴈自飞。",
    "东西兄弟远，存没友朋稀。",
    "独立还垂泪，天南一布衣。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
  "tags": [
    "洞庭湖"
  ],
