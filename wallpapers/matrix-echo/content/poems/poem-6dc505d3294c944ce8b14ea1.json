{
  "id": "poem-6dc505d3294c944ce8b14ea1",
  "title": "秋原野望",
  "author": "杨凌",
  "dynasty": "唐",
  "verses": [
    "客鴈秋来次第逢，家书频寄两三封。",
    "夕阳天外云归尽，乱见青山无数峰。"
  ],
