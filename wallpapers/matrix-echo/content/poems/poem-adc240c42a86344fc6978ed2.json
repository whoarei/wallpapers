{
  "id": "poem-adc240c42a86344fc6978ed2",
  "title": "九歌·礼魂",
  "author": "屈原",
  "dynasty": "先秦",
  "verses": [
    "成礼兮会鼓，传芭兮代舞。",
    "姱女倡兮容与。",
    "春兰兮秋菊，长无绝兮终古。"
  ],
  "enabled": true,
  "collection": "楚辞",
