{
  "id": "poem-19c2c2823df5c4434f594afa",
  "title": "始为奉礼忆昌谷山居",
  "author": "李贺",
  "dynasty": "唐",
  "verses": [
    "扫断马蹄痕，衙回自闭门。",
    "长鎗江米熟，小树枣花春。",
    "向壁悬如意，当帘阅角巾。",
    "犬书曾去洛，鹤病悔游秦。",
    "土甑封茶叶，山杯锁竹根。",
    "不知船上月，谁櫂满溪云。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
