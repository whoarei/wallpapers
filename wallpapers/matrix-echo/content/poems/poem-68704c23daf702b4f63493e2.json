{
  "id": "poem-68704c23daf702b4f63493e2",
  "title": "思远人",
  "author": "王建",
  "dynasty": "唐",
  "verses": [
    "妾思常悬悬，君行复绵绵。",
    "征途向何处，碧海与青天。",
    "岁久自有念，谁令长在边。",
    "少年若不归，兰室如黄泉。"
  ],
  "enabled": true,
