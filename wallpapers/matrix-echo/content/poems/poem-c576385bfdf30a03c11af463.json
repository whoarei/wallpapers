{
  "id": "poem-c576385bfdf30a03c11af463",
  "title": "劝人 二",
  "author": "义存",
  "dynasty": "唐",
  "verses": [
    "若切老婆心，劝君莫掠虚。",
    "忽遇明眼人，相逢笑杀渠。"
  ],
  "enabled": true,
