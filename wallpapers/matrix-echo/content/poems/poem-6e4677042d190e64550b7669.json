{
  "id": "poem-6e4677042d190e64550b7669",
  "title": "圣恩顾问独游月磴阁直书其事应制",
  "author": "广宣",
  "dynasty": "唐",
  "verses": [
    "禅居河畔无多地，来往寻春物正华。",
    "磴道上盘千亩竹，栏干低压万人家。",
    "簷前施饭来飞鸟，林下行香踏落花。",
    "自解刹那知佛性，不劳更喻几尘沙。"
  ],
  "enabled": true,
