{
  "id": "poem-c7f8ffd2bc4c40f385c8aaeb",
  "title": "千叶桃花",
  "author": "杨凭",
  "dynasty": "唐",
  "verses": [
    "千叶桃花胜百花，孤荣春晚驻年华。",
    "若教避俗秦人见，知向河源旧侣夸。"
  ],
  "enabled": true,
