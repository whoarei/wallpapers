{
  "id": "poem-b89d758aaebf86f32d367021",
  "title": "甘州子·每逢清夜与良晨",
  "author": "顾敻",
  "dynasty": "五代",
  "verses": [
    "每逢清夜与良晨，多怅望，足伤神。",
    "云迷水隔意中人，寂寞绣罗茵。",
    "山枕上，几点泪痕新。"
  ],
  "enabled": true,
  "collection": "花间集",
