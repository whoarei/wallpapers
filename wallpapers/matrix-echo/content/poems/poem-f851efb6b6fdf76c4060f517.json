{
  "id": "poem-f851efb6b6fdf76c4060f517",
  "title": "潭上作",
  "author": "张乔",
  "dynasty": "唐",
  "verses": [
    "竹岛残阳映翠微，雪翎禽过碧潭飞。",
    "人间未有关身事，每到渔家不欲归。"
  ],
  "enabled": true,
