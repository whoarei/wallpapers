{
  "id": "poem-b5a84288368d2358a36b5940",
  "title": "客行",
  "author": "唐求",
  "dynasty": "唐",
  "verses": [
    "上山下山去，千里万里愁。",
    "树色野桥暝，雨声孤馆秋。",
    "南北眼前道，东西江畔舟。",
    "世人重金玉，无金徒远游。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
