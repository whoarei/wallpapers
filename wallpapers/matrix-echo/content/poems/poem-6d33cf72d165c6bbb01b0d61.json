{
  "id": "poem-6d33cf72d165c6bbb01b0d61",
  "title": "贞元八年十二月谒先主庙绝句三首 三",
  "author": "张俨",
  "dynasty": "唐",
  "verses": [
    "雄名垂竹帛，荒陵压阡陌。",
    "终古更何闻，悲风入松栢。"
  ],
  "enabled": true,
