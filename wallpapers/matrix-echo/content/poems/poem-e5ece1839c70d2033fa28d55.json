{
  "id": "poem-e5ece1839c70d2033fa28d55",
  "title": "边上行",
  "author": "贯休",
  "dynasty": "唐",
  "verses": [
    "黑松林外路，风角远嗈嗈。",
    "朔气生荒堡，秋尘满病容。",
    "豺掊沙底骨，人上月边烽。",
    "休作西行计，西行地渐凶。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
