{
  "id": "poem-483e382dc38daf4366c6f67f",
  "title": "山居四感 噪蝉",
  "author": "李纲",
  "dynasty": "宋",
  "verses": [
    "修竹茂林山寺幽，蝉声如沸满清秋。",
    "吸风饮露无求世，嘒嘒何为噪不休。"
  ],
  "enabled": true,
  "collection": "宋诗选",
