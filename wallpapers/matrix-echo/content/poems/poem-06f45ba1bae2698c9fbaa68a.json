{
  "id": "poem-06f45ba1bae2698c9fbaa68a",
  "title": "寄王侍御",
  "author": "张籍",
  "dynasty": "唐",
  "verses": [
    "爱君紫阁峰前好，新作书堂药灶成。",
    "见欲移居相近住，有田多与种黄精。"
  ],
