{
  "id": "poem-d81fd4cc07bfc026dab5ec35",
  "title": "挽令人",
  "author": "王十朋",
  "dynasty": "宋",
  "verses": [
    "糟糠情味饱相谙，我事耕耘尔力蚕。",
    "误走迷途半天下，忽惊魂梦断泉南。",
    "二年旅榇悲无奈，千里途车涕不堪。",
    "预卜黄华晚秋节，佳城归祔白岩庵。"
  ],
  "enabled": true,
  "collection": "宋诗选",
