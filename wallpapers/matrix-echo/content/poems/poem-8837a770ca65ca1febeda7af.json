{
  "id": "poem-8837a770ca65ca1febeda7af",
  "title": "题终南山白鹤观",
  "author": "张乔",
  "dynasty": "唐",
  "verses": [
    "上彻炼丹峰，求玄意未穷。",
    "古坛青草合，往事白云空。",
    "仙境日月外，帝乡烟雾中。",
    "人间足烦署，欲去恋松风。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
  "tags": [
    "终南山"
  ],
