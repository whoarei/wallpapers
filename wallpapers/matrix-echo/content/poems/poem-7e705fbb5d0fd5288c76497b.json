{
  "id": "poem-7e705fbb5d0fd5288c76497b",
  "title": "石桥",
  "author": "陶谷",
  "dynasty": "唐",
  "verses": [
    "重重翠嶂耸云端，玉殿金楼缥缈间。",
    "圣境不容凡俗到，故将飞瀑隔尘寰。",
    "（见《天台续集》卷中。",
    "）。"
  ],
  "enabled": true,
