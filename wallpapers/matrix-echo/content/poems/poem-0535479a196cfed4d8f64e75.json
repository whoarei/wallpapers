{
  "id": "poem-0535479a196cfed4d8f64e75",
  "title": "游仙词三十三首  其二七",
  "author": "王镃",
  "dynasty": "宋",
  "verses": [
    "飞佩乘风海上游，麟洲有路透炎州。",
    "仙人养就千年鼠，时采长毛织火裘。"
  ],
  "enabled": true,
