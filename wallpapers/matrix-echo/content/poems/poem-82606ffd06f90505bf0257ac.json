{
  "id": "poem-82606ffd06f90505bf0257ac",
  "title": "秋晚度废关",
  "author": "李行言",
  "dynasty": "唐",
  "verses": [
    "秦郊平旧险，周德眷遗黎。",
    "始闻清夜柝，俄见落封泥。",
    "物色来无限，津途去不迷。",
    "空亭谁问马，闲戍但鸣鸡。",
    "山月寒弥净，河风晓更凄。",
    "赠言杨伯起，非复是关西。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
