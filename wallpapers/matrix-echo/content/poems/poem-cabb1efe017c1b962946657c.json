{
  "id": "poem-cabb1efe017c1b962946657c",
  "title": "送从翁中丞奉使黠戛斯六首 四",
  "author": "赵嘏",
  "dynasty": "唐",
  "verses": [
    "牢山望断绝尘氛，滟滟河西拂地云。",
    "谁见鲁儒持汉节，玉关降尽可汗军。"
  ],
  "enabled": true,
