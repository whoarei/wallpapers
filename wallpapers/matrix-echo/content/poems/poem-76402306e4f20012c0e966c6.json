{
  "id": "poem-76402306e4f20012c0e966c6",
  "title": "叙事献同州侍御三首 一",
  "author": "赵嘏",
  "dynasty": "唐",
  "verses": [
    "青云席中罗袜尘，白首江上吟诗人。",
    "登龙不及三千士，虚度膺门二十春。"
  ],
  "enabled": true,
