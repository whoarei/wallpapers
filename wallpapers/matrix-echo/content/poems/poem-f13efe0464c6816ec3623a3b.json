{
  "id": "poem-f13efe0464c6816ec3623a3b",
  "title": "扶南曲歌词五首 一",
  "author": "王维",
  "dynasty": "唐",
  "verses": [
    "翠羽流苏帐，春眠曙不开。",
    "羞从面色起，娇逐语声来。",
    "早向昭阳殿，君王中使催。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
