{
  "id": "poem-5e70e492bd95f237b5d20427",
  "title": "驺虞",
  "author": "佚名",
  "dynasty": "先秦",
  "verses": [
    "彼茁者葭，壹发五豝，于嗟乎驺虞！",
    "彼茁者蓬，壹发五豵，于嗟乎驺虞！"
  ],
