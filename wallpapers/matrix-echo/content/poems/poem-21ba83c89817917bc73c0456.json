{
  "id": "poem-21ba83c89817917bc73c0456",
  "title": "杂怨 一",
  "author": "聂夷中",
  "dynasty": "唐",
  "verses": [
    "生在绮罗下，岂识渔阳道。",
    "良人自戍来，夜夜梦中到。",
    "渔阳万里远，近于中门限。",
    "中门逾有时，渔阳常在眼。"
  ],
  "enabled": true,
