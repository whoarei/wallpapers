{
  "id": "poem-f6b2947a130e85806550d43b",
  "title": "京口江际弄水",
  "author": "徐铉",
  "dynasty": "宋",
  "verses": [
    "退公求静独临川，扬子江南二月天。",
    "百尺翠屏甘露阁，数帆晴日海门船。",
    "波澄濑石寒如玉，草接汀苹绿似烟。",
    "安得乘槎更东去，十洲风外弄潺湲。"
  ],
  "enabled": true,
  "collection": "宋诗选",
