{
  "id": "poem-9c0ff6007641ddec63f2f3e7",
  "title": "绮霞峰",
  "author": "陈岩",
  "dynasty": "宋",
  "verses": [
    "欲识晴岚态度奇，直须待到夕阳时。",
    "回光倒影山如染，状出余霞散绮诗。"
  ],
  "enabled": true,
