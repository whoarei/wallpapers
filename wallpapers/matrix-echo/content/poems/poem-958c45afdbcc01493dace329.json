{
  "id": "poem-958c45afdbcc01493dace329",
  "title": "山友赠藓花冠",
  "author": "项斯",
  "dynasty": "唐",
  "verses": [
    "尘污出华发，慙君青藓冠。",
    "此身闲未得，终日戴应难。",
    "好就松阴挂，宜当枕石看。",
    "会须寻道士，簪去绕霜坛。"
  ],
  "enabled": true,
