{
  "id": "poem-7174b17886a5337a0deaa9c0",
  "title": "早春雪中",
  "author": "杨凌",
  "dynasty": "唐",
  "verses": [
    "新年雨雪少晴时，屡失寻梅看柳期。",
    "乡信忆随回鴈早，江春寒带故阴迟。"
  ],
  "enabled": true,
