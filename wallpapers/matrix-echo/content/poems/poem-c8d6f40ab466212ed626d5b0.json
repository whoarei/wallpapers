{
  "id": "poem-c8d6f40ab466212ed626d5b0",
  "title": "望江南・忆江南·柯山瑞",
  "author": "廖刚",
  "dynasty": "宋",
  "verses": [
    "柯山瑞，云路玉桥横。",
    "六月天香琼蕊秀，千年人瑞昂星明。",
    "风露湿麒麟。",
    "廊庙器，冰雪照精神。",
    "妙世文章凌贾马，致君事业富姬衡。",
    "松桧倚青青。"
  ],
  "enabled": true,
  "collection": "宋词选",
