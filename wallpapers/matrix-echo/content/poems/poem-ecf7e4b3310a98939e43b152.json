{
  "id": "poem-ecf7e4b3310a98939e43b152",
  "title": "渔夫舞·济涉还渠渔父子",
  "author": "史浩",
  "dynasty": "宋",
  "verses": [
    "济涉还渠渔父子。",
    "生涯只在烟波里。",
    "练静忽然风又起。",
    "赢得底。",
    "吹来别浦看桃李。"
  ],
  "enabled": true,
  "collection": "宋词选",
