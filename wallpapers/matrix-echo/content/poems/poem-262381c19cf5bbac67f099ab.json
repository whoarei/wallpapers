{
  "id": "poem-262381c19cf5bbac67f099ab",
  "title": "漫书五首 四",
  "author": "司空图",
  "dynasty": "唐",
  "verses": [
    "世路快心无好事，恩门嘉话合书绅。",
    "神藏鬼伏能千变，亦胜忘机避要津。"
  ],
  "enabled": true,
