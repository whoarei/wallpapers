{
  "id": "poem-e3e39467d8290909bcc3373c",
  "title": "春宫曲",
  "author": "王昌龄",
  "dynasty": "唐",
  "verses": [
    "昨夜风开露井桃，未央前殿月轮高。",
    "平阳歌舞新承宠，帘外春寒赐锦袍。"
  ],
  "enabled": true,
