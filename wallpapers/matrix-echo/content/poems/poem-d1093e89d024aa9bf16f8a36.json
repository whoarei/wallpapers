{
  "id": "poem-d1093e89d024aa9bf16f8a36",
  "title": "葛无怀讣至  其二",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "静胜知天定，虚明悟物齐。",
    "略伸嗟屈蠖，欲吐丧晴霓。",
    "夜雨灯侵幌，春风柳竝堤。",
    "漫天吹絮尽，一点不沾泥。"
  ],
  "enabled": true,
  "collection": "宋诗选",
