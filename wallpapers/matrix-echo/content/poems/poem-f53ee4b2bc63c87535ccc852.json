{
  "id": "poem-f53ee4b2bc63c87535ccc852",
  "title": "润州水楼",
  "author": "杨凌",
  "dynasty": "唐",
  "verses": [
    "归心不可留，雪桂一丛秋。",
    "叶雨空江月，萤飞白露洲。",
    "野蝉依独树，水郭带孤楼。",
    "遥望山川路，相思万里游。"
  ],
  "enabled": true,
