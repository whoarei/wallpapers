{
  "id": "poem-f1ba681b8f557f3cc2e2c78e",
  "title": "行都饯岁",
  "author": "孙嵩",
  "dynasty": "宋",
  "verses": [
    "插架余残历，挑灯忆故乡。",
    "年光蛇赴壑，羁旅雁随阳。",
    "禁阙迎傩鼓，邻街祭灶香。",
    "英雄须自力，容易鬓毛苍。"
  ],
  "enabled": true,
  "collection": "宋诗选",
