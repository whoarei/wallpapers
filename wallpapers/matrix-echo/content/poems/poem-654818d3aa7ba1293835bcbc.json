{
  "id": "poem-654818d3aa7ba1293835bcbc",
  "title": "春秋战国门 苏厉",
  "author": "周昙",
  "dynasty": "唐",
  "verses": [
    "百步穿杨箭不移，养由堪教听弘规。",
    "身隆业著未知退，勿遣功名一旦隳。"
  ],
  "enabled": true,
