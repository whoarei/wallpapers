{
  "id": "poem-7bb7756c372ee6e90846344e",
  "title": "美人宫棋",
  "author": "张籍",
  "dynasty": "唐",
  "verses": [
    "红烛台前出翠娥，海沙铺局巧相和。",
    "趂行移手巡收尽，数数看谁得最多。"
  ],
