{
  "id": "poem-18692adc81055f15176394c9",
  "title": "扬州怀古",
  "author": "李益",
  "dynasty": "唐",
  "verses": [
    "故国歌钟地，长桥车马尘。",
    "彭城阁边柳，偏似不胜春。"
  ],
