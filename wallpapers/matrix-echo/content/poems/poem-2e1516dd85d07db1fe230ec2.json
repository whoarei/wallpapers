{
  "id": "poem-2e1516dd85d07db1fe230ec2",
  "title": "西池清晖亭",
  "author": "许抗",
  "dynasty": "宋",
  "verses": [
    "亭号清晖阚碧涟，半连村落半神仙。",
    "青山剩得云间日，明月饶分水底天。"
  ],
  "enabled": true,
