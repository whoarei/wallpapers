{
  "id": "poem-37c73a5dcaaac79a01fb4cf8",
  "title": "缕缕金",
  "author": "徐田臣《杀狗记》",
  "dynasty": "元",
  "verses": [
    "你平白地将咱赶出门，杀人来唤我去埋形。",
    "你今打些不干净，须要对证。",
    "(生、旦作慌介。",
    "小生)唬得他夫妇战兢兢，一个个胆丧心惊。"
  ],
  "enabled": true,
  "collection": "元曲选",
  "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/元曲/yuanqu.json#record-1917",
