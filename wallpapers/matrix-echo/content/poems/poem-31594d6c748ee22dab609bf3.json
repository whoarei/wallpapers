{
  "id": "poem-31594d6c748ee22dab609bf3",
  "title": "诉衷情令·阿房废址汉荒丘",
  "author": "康与之",
  "dynasty": "宋",
  "verses": [
    "阿房废址汉荒丘。",
    "狐兔又群游。",
    "豪华尽成春梦，留下古今愁。",
    "君莫上，古原头。",
    "泪难收。",
    "夕阳西下，塞雁南飞，渭水东流。"
  ],
  "enabled": true,
  "collection": "宋词选",
