{
  "id": "poem-bed0198fd78253de27457fd3",
  "title": "祀雨师乐章 奠币登歌",
  "author": "包佶",
  "dynasty": "唐",
  "verses": [
    "岁正朱明，礼布玄制。",
    "惟乐能感，与神合契。",
    "阴雾离披，灵驭摇裔。",
    "膏泽之庆，期于稔岁。"
  ],
  "enabled": true,
