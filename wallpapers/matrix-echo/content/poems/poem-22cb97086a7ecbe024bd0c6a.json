{
  "id": "poem-22cb97086a7ecbe024bd0c6a",
  "title": "岸花",
  "author": "张籍",
  "dynasty": "唐",
  "verses": [
    "可怜岸边树，红蘂发青条。",
    "东风吹渡水，冲着木兰桡。"
  ],
  "enabled": true,
