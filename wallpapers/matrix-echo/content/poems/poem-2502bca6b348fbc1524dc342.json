{
  "id": "poem-2502bca6b348fbc1524dc342",
  "title": "风雨",
  "author": "佚名",
  "dynasty": "先秦",
  "verses": [
    "风雨凄凄，鸡鸣喈喈，既见君子。云胡不夷？",
    "风雨潇潇，鸡鸣胶胶。既见君子，云胡不瘳？",
    "风雨如晦，鸡鸣不已。既见君子，云胡不喜？"
  ],
  "enabled": true,
  "collection": "诗经",
  "tags": [],
  "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/诗经/shijing.json#record-89"
