{
  "id": "poem-a07f1a373d2d16ed8b5e6f6e",
  "title": "浣溪沙·睡起惺忪强自支",
  "author": "纳兰性德",
  "dynasty": "清",
  "verses": [
    "睡起惺忪强自支。",
    "绿倾蝉鬓下帘时。",
    "夜来愁损小腰肢。",
    "远信不归空伫望，幽期细数却参差。",
    "更兼何事耐寻思。"
  ],
  "enabled": true,
