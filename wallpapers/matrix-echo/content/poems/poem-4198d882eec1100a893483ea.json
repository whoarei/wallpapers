{
  "id": "poem-4198d882eec1100a893483ea",
  "title": "关下",
  "author": "崔道融",
  "dynasty": "唐",
  "verses": [
    "百二山河壮帝畿，关门何事更开迟。",
    "应从漏却田文后，每度闻鸡不免疑。"
  ],
  "enabled": true,
