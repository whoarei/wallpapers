{
  "id": "poem-7559bb128526973c4f8efdf2",
  "title": "江行无题一百首 三十四",
  "author": "钱珝",
  "dynasty": "唐",
  "verses": [
    "睡稳叶舟轻，风微浪不惊。",
    "人居芦苇岸，终夜动秋声。"
  ],
