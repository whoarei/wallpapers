{
  "id": "poem-4dd0b8f23e18aaf49e6185c1",
  "title": "浣沙溪·春水轻波浸绿苔",
  "author": "毛文锡",
  "dynasty": "五代",
  "verses": [
    "春水轻波浸绿苔，楷杷洲上紫檀开。",
    "晴天眠沙㶉𫛶稳，暖相偎。",
    "罗袜生尘游女过，有人逢着弄珠回。",
    "兰麝飘香初解佩，忘归来。"
  ],
  "enabled": true,
  "collection": "花间集",
