{
  "id": "poem-0d8d48126a099eee1e68b4bc",
  "title": "送缙云苗太守",
  "author": "王维",
  "dynasty": "唐",
  "verses": [
    "手疏谢明主，腰章为长吏。",
    "方从会稽邸，更发汝南骑。",
    "按节下松阳，清江响铙吹。",
    "露冕见三吴，方知百城贵。"
  ],
  "enabled": true,
