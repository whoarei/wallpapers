{
  "id": "poem-3f71348a9ff07f7adc421301",
  "title": "浣溪沙·花样风流柳样娇",
  "author": "向子𬤇",
  "dynasty": "宋",
  "verses": [
    "花样风流柳样娇。",
    "雪中微步过溪桥。",
    "心期春色到梅梢。",
    "折得一枝归绿鬓，冰容玉艳不相饶。",
    "索人同去醉金蕉。"
  ],
  "enabled": true,
  "collection": "宋词选",
