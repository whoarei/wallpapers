{
  "id": "poem-56ca986a6ef78a58a625ad5b",
  "title": "南乡子·兰棹举",
  "author": "李珣",
  "dynasty": "五代",
  "verses": [
    "兰棹举，水纹开，竞携藤笼采莲来。",
    "回塘深处遥相见，邀同宴，绿酒一卮红上面。"
  ],
  "enabled": true,
