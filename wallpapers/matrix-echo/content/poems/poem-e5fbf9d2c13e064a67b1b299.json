{
  "id": "poem-e5fbf9d2c13e064a67b1b299",
  "title": "青㠗山",
  "author": "张又新",
  "dynasty": "唐",
  "verses": [
    "灵海泓澄匝翠峰，昔贤心赏已成空。",
    "今朝亭馆无遗制，积水沧浪一望中。"
  ],
  "enabled": true,
