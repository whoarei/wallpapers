{
  "id": "poem-f3f53f6ef986f012f58fae8c",
  "title": "上平江徐侍郎十绝句  其九",
  "author": "曾协",
  "dynasty": "宋",
  "verses": [
    "拥麾仗节往来频，抚字澄清处处新。",
    "想见兹辰介眉寿，遥应驩动几州人。"
  ],
  "enabled": true,
