{
  "id": "poem-745abe692f4a33715adde6b6",
  "title": "踏雪寻梅",
  "author": "王镃",
  "dynasty": "宋",
  "verses": [
    "探春绕遍玉阑干，香暗冰痕屐齿寒。",
    "怕有花头遭冻损，枝枝呵手掐来看。"
  ],
  "enabled": true,
