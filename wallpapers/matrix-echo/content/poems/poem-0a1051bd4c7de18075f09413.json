{
  "id": "poem-0a1051bd4c7de18075f09413",
  "title": "春怨",
  "author": "刘方平",
  "dynasty": "唐",
  "verses": [
    "纱窗日落渐黄昏，金屋无人见泪痕。",
    "寂寞空庭春欲晚，梨花满地不开门。"
  ],
  "enabled": true,
  "collection": "唐诗三百首",
