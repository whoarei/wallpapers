{
  "id": "poem-9812ac35d8d845ada0b08316",
  "title": "游仙词三十三首  其一二",
  "author": "王镃",
  "dynasty": "宋",
  "verses": [
    "珊瑚老树百花开，玉色灵泉滴翠崖。",
    "弹罢瑶琴黄鹤至，紫泥湿透藕丝鞋。"
  ],
