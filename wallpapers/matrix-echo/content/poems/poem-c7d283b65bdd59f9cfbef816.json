{
  "id": "poem-c7d283b65bdd59f9cfbef816",
  "title": "和黄漕雪中将至长沙",
  "author": "张栻",
  "dynasty": "宋",
  "verses": [
    "吾道元如砥，人间谩畏途。",
    "未容舟溯峡，且泛雪平湖。",
    "子孝宁投杼，天回看脱弧。",
    "不应从我懒，欲老豆麻区。"
  ],
  "enabled": true,
  "collection": "宋诗选",
