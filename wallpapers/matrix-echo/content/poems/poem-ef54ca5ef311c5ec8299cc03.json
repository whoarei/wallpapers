{
  "id": "poem-ef54ca5ef311c5ec8299cc03",
  "title": "偈颂 三",
  "author": "文偃",
  "dynasty": "唐",
  "verses": [
    "康氏圆形滞不明，魔深虚丧击寒冰。",
    "凤羽展时超碧汉，晋锋八博拟何凭。"
  ],
  "enabled": true,
