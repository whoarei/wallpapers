{
  "id": "poem-7e465ce486ef70756df4d6e9",
  "title": "上平江徐侍郎十绝句  其四",
  "author": "曾协",
  "dynasty": "宋",
  "verses": [
    "并列西京侍从多，吾丘司马岂同科。",
    "孤忠祇有囊书在，独见丁宁为偃戈。"
  ],
