{
  "id": "poem-99cdf20ef4c19c9029f983b3",
  "title": "山云",
  "author": "曾协",
  "dynasty": "宋",
  "verses": [
    "自耸干霄势，应怜望岁心。",
    "试将肤寸泽，来作济时霖。"
  ],
  "enabled": true,
