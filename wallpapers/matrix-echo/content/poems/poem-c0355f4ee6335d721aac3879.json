{
  "id": "poem-c0355f4ee6335d721aac3879",
  "title": "浣溪沙·肠断班骓去未还",
  "author": "纳兰性德",
  "dynasty": "清",
  "verses": [
    "肠断班骓去未还，绣屏深锁凤箫寒。",
    "一春幽梦有无间。",
    "逗雨疏花浓淡改，关心芳草浅深难。",
    "不成风月转摧残。"
  ],
  "enabled": true,
  "collection": "纳兰词",
