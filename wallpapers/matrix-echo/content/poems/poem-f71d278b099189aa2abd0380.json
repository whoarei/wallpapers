{
  "id": "poem-f71d278b099189aa2abd0380",
  "title": "题净名院二绝  其二",
  "author": "王十朋",
  "dynasty": "宋",
  "verses": [
    "谷中有月露蛾眉，水织珠帘更绝奇。",
    "满目峰峦观未尽，有僧携纸觅题诗。"
  ],
