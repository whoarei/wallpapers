{
  "id": "poem-046720588defcfe00282bc9b",
  "title": "咏史诗 秦庭",
  "author": "胡曾",
  "dynasty": "唐",
  "verses": [
    "楚国君臣草莽间，吴王戈甲未东还。",
    "包胥不动咸阳哭，争得秦兵出武关。"
  ],
  "enabled": true,
