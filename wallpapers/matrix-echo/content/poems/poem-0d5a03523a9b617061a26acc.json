{
  "id": "poem-0d5a03523a9b617061a26acc",
  "title": "朱槿花",
  "author": "李绅",
  "dynasty": "唐",
  "verses": [
    "瘴烟长暖无霜雪，槿艳繁花满树红。",
    "每叹芳菲四时厌，不知开落有春风。"
  ],
  "enabled": true,
