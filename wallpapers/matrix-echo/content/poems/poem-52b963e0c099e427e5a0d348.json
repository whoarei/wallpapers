{
  "id": "poem-52b963e0c099e427e5a0d348",
  "title": "立秋",
  "author": "刘言史",
  "dynasty": "唐",
  "verses": [
    "兹晨戒流火，商飇早已惊。",
    "云天收夏色，木叶动秋声。"
  ],
  "enabled": true,
