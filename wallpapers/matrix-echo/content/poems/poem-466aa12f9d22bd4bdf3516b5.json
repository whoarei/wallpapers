{
  "id": "poem-466aa12f9d22bd4bdf3516b5",
  "title": "燕堂诗",
  "author": "蔡兹",
  "dynasty": "宋",
  "verses": [
    "世情日浅道情深，悔不林泉早脱簪。",
    "一世简编贻后叶，百年香火奉先心。",
    "诗缘好句须亲录，酒到浓时辄倩斟。",
    "于此更无关意事，时携诸幼步花阴。"
  ],
  "enabled": true,
