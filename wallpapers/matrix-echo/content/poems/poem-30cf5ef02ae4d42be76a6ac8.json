{
  "id": "poem-30cf5ef02ae4d42be76a6ac8",
  "title": "寒食",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "才见茅簷插柳条，便知寒食是今朝。",
    "春应不恨相寻晚，应恨常阴一半消。"
  ],
  "enabled": true,
  "collection": "宋诗选",
