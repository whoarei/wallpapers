{
  "id": "poem-14acfac279f71c5e3d600847",
  "title": "王寺丞后圃",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "不独甘棠茂午阴，浄如止水照人心。",
    "楼通阊阖天垂斗，云锁蜿蜒鼎篆金。",
    "袖里有春还自乐，尊前无客不能吟。",
    "古菱花里青青鬓，半点吴霜不敢侵。"
  ],
  "enabled": true,
  "collection": "宋诗选",
