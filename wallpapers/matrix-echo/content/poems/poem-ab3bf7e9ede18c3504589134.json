{
  "id": "poem-ab3bf7e9ede18c3504589134",
  "title": "秋暮言志",
  "author": "太宗皇帝",
  "dynasty": "唐",
  "verses": [
    "朝光浮烧野，霜华净碧空。",
    "结浪冰初镜，在迳菊方丛。",
    "约岭烟深翠，分旗霞散红。",
    "抽思滋泉侧，飞想傅岩中。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
