{
  "id": "poem-28277076f08192128b6252fa",
  "title": "北青萝",
  "author": "李商隐",
  "dynasty": "唐",
  "verses": [
    "残阳西入崦，茅屋访孤僧。",
    "落叶人何在，寒云路几层。",
    "独敲初夜磬，闲倚一枝藤。",
    "世界微尘里，吾宁爱与憎。"
  ],
  "enabled": true,
  "collection": "唐诗三百首",
