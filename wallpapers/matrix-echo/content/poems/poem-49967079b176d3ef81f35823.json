{
  "id": "poem-49967079b176d3ef81f35823",
  "title": "二使者游东山酒后寄诗走笔次韵  其一",
  "author": "张栻",
  "dynasty": "宋",
  "verses": [
    "颇闻东山盛行乐，坐想风前酒兴豪。",
    "领略正应胸次别，吟哦更觉笔端高。"
  ],
  "enabled": true,
