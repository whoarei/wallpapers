{
  "id": "poem-3fa8d935cd2d29bd46ec98f0",
  "title": "留题兴唐寺",
  "author": "赵嘏",
  "dynasty": "唐",
  "verses": [
    "满水楼台满寺山，七年今日共跻攀。",
    "月高对菊问行客，去折芳枝早晚还。"
  ],
