{
  "id": "poem-15368a073435b174a6349d46",
  "title": "问刘十九",
  "author": "白居易",
  "dynasty": "唐",
  "verses": [
    "绿螘新醅酒，红泥小火垆。",
    "晚来天欲雪，能饮一杯无。"
  ],
  "enabled": true,
