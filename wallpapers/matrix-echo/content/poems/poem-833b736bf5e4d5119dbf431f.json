{
  "id": "poem-833b736bf5e4d5119dbf431f",
  "title": "酬李元叔察院见寄",
  "author": "綦崇礼",
  "dynasty": "宋",
  "verses": [
    "书到山中手自披，炎凉不改似君稀。",
    "术穷五技缘何事，巢穏一枝聊可依。",
    "扫迹径须休去好，冥心深觉向来非。",
    "缓赓清唱缄题罢，却对松窗静掩扉。"
  ],
  "enabled": true,
  "collection": "宋诗选",
