{
  "id": "poem-ee4b281c564484042820d5df",
  "title": "偈颂六十七首  其二九",
  "author": "释原妙",
  "dynasty": "宋",
  "verses": [
    "低头觅天，仰面寻地。",
    "波波挈挈，远之远矣。",
    "蓦然撞著徐十三郎，嗄，元来只在遮里。",
    "在遮里，腊月三十日到来，也是开眼见鬼。"
  ],
  "enabled": true,
  "collection": "宋诗选",
