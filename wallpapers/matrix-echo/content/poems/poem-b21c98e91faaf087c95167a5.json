{
  "id": "poem-b21c98e91faaf087c95167a5",
  "title": "送杨法曹按括州",
  "author": "孙逖",
  "dynasty": "唐",
  "verses": [
    "东海天台山，南方缙云驿。",
    "溪澄问人隐，岩险烦登陟。",
    "潭壑随星使，轩车绕春色。",
    "傥寻琪树人，为报长相忆。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
