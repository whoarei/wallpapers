{
  "id": "poem-e8d2557ec347d854cb6fd8f9",
  "title": "移梅",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "雪消时候带花移，花笑移迟不振奇。",
    "今岁弗须嫌早计，趁它一点未开时。"
  ],
  "enabled": true,
