{
  "id": "poem-3b0476f83dd622a7cbbe5fa6",
  "title": "听琴",
  "author": "苏替",
  "dynasty": "唐",
  "verses": [
    "弦中恨起湘山远，指下情多楚峡流。",
    "危槛曲终云影曙，高楼风定烛光秋。"
  ],
