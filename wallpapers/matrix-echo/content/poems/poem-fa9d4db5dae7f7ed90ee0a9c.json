{
  "id": "poem-fa9d4db5dae7f7ed90ee0a9c",
  "title": "送远使",
  "author": "张籍",
  "dynasty": "唐",
  "verses": [
    "扬旌过陇头，陇水向西流。",
    "塞路依山远，戍城逢笛秋。",
    "寒沙阴漫漫，疲马去悠悠。",
    "为问征行将，谁封定远侯。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
