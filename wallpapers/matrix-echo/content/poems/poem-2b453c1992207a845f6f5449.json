{
  "id": "poem-2b453c1992207a845f6f5449",
  "title": "病中客散复言怀",
  "author": "刘言史",
  "dynasty": "唐",
  "verses": [
    "华发离披卧满头，暗虫衰草入乡愁。",
    "枕前人去空庭暮，又见芭蕉白露秋。"
  ],
  "enabled": true,
