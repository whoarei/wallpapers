{
  "id": "poem-b2ca4d590481f8b827a17632",
  "title": "柳十首 五",
  "author": "李山甫",
  "dynasty": "唐",
  "verses": [
    "弱带低垂可自由，傍他门户倚他楼。",
    "金风不解相擡举，露压烟欺直到秋。"
  ],
  "enabled": true,
