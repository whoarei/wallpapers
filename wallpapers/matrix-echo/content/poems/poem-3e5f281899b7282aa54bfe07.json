{
  "id": "poem-3e5f281899b7282aa54bfe07",
  "title": "九江琵琶亭",
  "author": "宋敏求",
  "dynasty": "宋",
  "verses": [
    "夜泊浔阳宿酒楼，琵琶亭畔荻花秋。",
    "云沈鸟没事已往，月白风清江自流。"
  ],
  "enabled": true,
  "collection": "宋诗选",
