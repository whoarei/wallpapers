{
  "id": "poem-f1579247aed5c46e47f8cd44",
  "title": "江亭赠别",
  "author": "马戴",
  "dynasty": "唐",
  "verses": [
    "长亭晚送君，秋色渡江𣸣。",
    "衰柳风难定，寒涛雪不分。",
    "猨声离楚峡，帆影入湘云。",
    "独泛扁舟夜，山钟可卧闻。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
