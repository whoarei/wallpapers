{
  "id": "poem-097887f792976963ed1abd7c",
  "title": "别李谱",
  "author": "赵嘏",
  "dynasty": "唐",
  "verses": [
    "尊前路映暮尘红，池上琴横醉席风。",
    "今日别君如别鹤，声容长在楚弦中。"
  ],
  "enabled": true,
