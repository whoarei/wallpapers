{
  "id": "poem-d9eadad9919e51490ed8de27",
  "title": "南歌子·似带如丝柳",
  "author": "温庭筠",
  "dynasty": "唐",
  "verses": [
    "似带如丝柳，团酥握雪花。",
    "帘卷玉钩斜，九衢尘欲暮，逐香车。"
  ],
  "enabled": true,
  "collection": "花间集",
