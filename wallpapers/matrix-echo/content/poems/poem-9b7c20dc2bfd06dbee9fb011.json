{
  "id": "poem-9b7c20dc2bfd06dbee9fb011",
  "title": "从军",
  "author": "刘庭琦",
  "dynasty": "唐",
  "verses": [
    "朔风吹寒塞，胡沙千万里。",
    "阵云出岱山，孤月生海水。",
    "决胜方求敌，衔恩本轻死。",
    "萧萧牧马鸣，中夜拔劒起。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
  "tags": [
    "泰山"
  ],
