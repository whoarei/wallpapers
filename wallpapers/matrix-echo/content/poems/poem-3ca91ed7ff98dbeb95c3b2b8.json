{
  "id": "poem-3ca91ed7ff98dbeb95c3b2b8",
  "title": "哭亦周  其二",
  "author": "赵文",
  "dynasty": "宋",
  "verses": [
    "堂上华颠泣欲枯，哭声那解到黄垆。",
    "千般欲解郄公意，难得嘉宾一箧书。"
  ],
  "enabled": true,
