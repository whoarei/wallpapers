{
  "id": "poem-e427657039c116567ef66927",
  "title": "山阁晚秋",
  "author": "太宗皇帝",
  "dynasty": "唐",
  "verses": [
    "山亭秋色满，岩牖凉风度。",
    "疎兰尚染烟，残菊犹承露。",
    "古石衣新苔，新巢封古树。",
    "历览情无极，咫尺输光暮。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
