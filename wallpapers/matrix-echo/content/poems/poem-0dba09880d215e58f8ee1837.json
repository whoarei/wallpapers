{
  "id": "poem-0dba09880d215e58f8ee1837",
  "title": "旅行",
  "author": "孟郊",
  "dynasty": "唐",
  "verses": [
    "楚水结冰薄，楚云为雨微。",
    "野梅参差发，旅榜逍遥归。"
  ],
