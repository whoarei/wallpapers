{
  "id": "poem-53d66125abb0e94704b6de2b",
  "title": "题柳郎中故居",
  "author": "李德裕",
  "dynasty": "唐",
  "verses": [
    "下马荒堦日欲曛，潺潺石溜静中闻。",
    "鸟啼花发人声绝，寂寞山窗掩白云。"
  ],
  "enabled": true,
