{
  "id": "poem-5dfb2f49efde68b585dbe90d",
  "title": "中山别墅",
  "author": "俞瑊",
  "dynasty": "宋",
  "verses": [
    "村居何所乐，我爱读书堂。",
    "阶草侵窗润，瓶花落砚香。",
    "凭栏看水活，出岫笑云忙。",
    "野客时相过，联吟坐夕阳。"
  ],
  "enabled": true,
  "collection": "宋诗选",
