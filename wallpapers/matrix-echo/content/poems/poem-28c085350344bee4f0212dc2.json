{
  "id": "poem-28c085350344bee4f0212dc2",
  "title": "又一首",
  "author": "张𬸦",
  "dynasty": "唐",
  "verses": [
    "梦中疑是实，觉后忽非真。",
    "诚知肠欲继，穷鬼故调人。"
  ],
  "enabled": true,
