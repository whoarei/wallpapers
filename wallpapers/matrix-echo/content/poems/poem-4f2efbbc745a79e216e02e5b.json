{
  "id": "poem-4f2efbbc745a79e216e02e5b",
  "title": "药轩",
  "author": "司马光",
  "dynasty": "宋",
  "verses": [
    "雨余条甲绕阶生，往往桐君昔未名。",
    "采贮不须勤暴篲，秋阳日日满簷楹。"
  ],
  "enabled": true,
  "collection": "宋诗选",
