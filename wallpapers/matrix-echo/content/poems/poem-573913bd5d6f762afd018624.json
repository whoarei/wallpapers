{
  "id": "poem-573913bd5d6f762afd018624",
  "title": "贝母",
  "author": "张载",
  "dynasty": "宋",
  "verses": [
    "贝母阶前蔓百寻，双桐盘绕叶森森。",
    "刚强顾我蹉跎甚，时欲低柔警寸心。"
  ],
  "enabled": true,
  "collection": "宋诗选",
