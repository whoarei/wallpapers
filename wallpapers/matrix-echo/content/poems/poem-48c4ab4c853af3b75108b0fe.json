{
  "id": "poem-48c4ab4c853af3b75108b0fe",
  "title": "水红花",
  "author": "施惠《幽闺记》",
  "dynasty": "元",
  "verses": [
    "(旦)忆昔歌舞宴楼台，会金钗。",
    "欢娱难再。",
    "(生)思之诗酒看书斋，命多乖，风光难再。"
  ],
  "enabled": true,
  "collection": "元曲选",
