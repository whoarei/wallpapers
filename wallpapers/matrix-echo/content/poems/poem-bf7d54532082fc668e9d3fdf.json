{
  "id": "poem-bf7d54532082fc668e9d3fdf",
  "title": "淡黄柳·咏柳",
  "author": "纳兰性德",
  "dynasty": "清",
  "verses": [
    "三眠未歇，乍到秋时节。",
    "一树料阳蝉更咽，曾绾灞陵离别。",
    "絮己为萍风卷叶，空凄切。",
    "长条莫轻折，苏小恨，倩他说。",
    "尽飘零、游冶章台客。",
    "红板桥空，湔裙人去，依旧晓风残月。"
  ],
  "enabled": true,
  "collection": "纳兰词",
