{
  "id": "poem-431343e77b7915a8b735ac75",
  "title": "游襄阳山寺",
  "author": "张籍",
  "dynasty": "唐",
  "verses": [
    "秋色江边路，烟霞若有期。",
    "寺贫无利施，僧老足慈悲。",
    "薜荔侵禅窟，虾蟆占浴池。",
    "闲游殊未徧，即是下山时。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
