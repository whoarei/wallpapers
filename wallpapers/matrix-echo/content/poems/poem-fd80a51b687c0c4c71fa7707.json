{
  "id": "poem-fd80a51b687c0c4c71fa7707",
  "title": "新柳",
  "author": "司空曙",
  "dynasty": "唐",
  "verses": [
    "全欺芳蕙晚，似妬寒梅疾。",
    "撩乱发青条，春风来几日。"
  ],
  "enabled": true,
