{
  "id": "poem-ae57f272bb352683ca5a1dbf",
  "title": "岐王山亭",
  "author": "张谔",
  "dynasty": "唐",
  "verses": [
    "王家傍绿池，春色正相宜。",
    "岂有楼台好，兼看草树奇。",
    "石榴天上叶，椰子日南枝。",
    "出入千门里，年年乐未移。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
