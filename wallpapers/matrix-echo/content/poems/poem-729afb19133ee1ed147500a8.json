{
  "id": "poem-729afb19133ee1ed147500a8",
  "title": "句",
  "author": "嗣主璟",
  "dynasty": "唐",
  "verses": [
    "灵槎思浩荡，老鹤倚崆峒。",
    "苍苔迷古道，红叶乱朝霞。",
    "栖凤枝梢犹輭弱，化龙形状已依稀。"
  ],
  "enabled": true,
