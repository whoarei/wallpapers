{
  "id": "poem-e2e53accc3983ccfe4f33a4c",
  "title": "湖上",
  "author": "王镃",
  "dynasty": "宋",
  "verses": [
    "万红飞尽雨如烟，心事伤春哭杜鹃。",
    "游子不来弦管歇，画船空系柳丝边。"
  ],
  "enabled": true,
  "collection": "宋诗选",
