{
  "id": "poem-d98ed30d425ea4a09b0849af",
  "title": "次韵感旧",
  "author": "赵文",
  "dynasty": "宋",
  "verses": [
    "人间岁月如江波，欢乐苦少哀情多。",
    "千曲箜篌弹不尽，公无渡河公渡河。"
  ],
  "enabled": true,
