{
  "id": "poem-6a38de643ad3b5733cfd10d7",
  "title": "青雀歌",
  "author": "卢象",
  "dynasty": "唐",
  "verses": [
    "啾啾青雀儿，飞来飞去仰天池。",
    "逍遥饮啄安涯分，何假扶摇九万为。"
  ],
  "enabled": true,
