{
  "id": "poem-6d9d7c13ffbbebb8d3b17143",
  "title": "豪家夏冰咏",
  "author": "雍裕之",
  "dynasty": "唐",
  "verses": [
    "金错银盘贮赐冰，清光如耸玉山棱。",
    "无论尘客闲停扇，直到消时不见蝇。"
  ],
  "enabled": true,
