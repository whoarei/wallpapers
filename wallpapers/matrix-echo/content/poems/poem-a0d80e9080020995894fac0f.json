{
  "id": "poem-a0d80e9080020995894fac0f",
  "title": "赋罗汉果",
  "author": "张栻",
  "dynasty": "宋",
  "verses": [
    "黄实累累本自芳，西湖名字著诸方。",
    "里称胜母吾常避，珍重山僧自煮汤。"
  ],
  "enabled": true,
  "collection": "宋诗选",
  "tags": [
    "西湖"
  ],
