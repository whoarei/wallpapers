{
  "id": "poem-9aa1fadb532c0fd9c75dbee4",
  "title": "绝句漫兴",
  "author": "杜甫",
  "dynasty": "唐",
  "verses": [
    "肠断春江欲尽头，杖藜徐步立芳洲。",
    "颠狂柳絮随风舞，轻薄桃花逐水流。"
  ],
  "enabled": true,
  "collection": "千家诗",
