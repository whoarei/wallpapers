{
  "id": "poem-1070b459082e5e59f673f74f",
  "title": "新晴爱月",
  "author": "陆畅",
  "dynasty": "唐",
  "verses": [
    "野性平生惟爱月，新晴半夜覩婵娟。",
    "起来自擘纱窗破，恰漏清光落枕前。"
  ],
  "enabled": true,
