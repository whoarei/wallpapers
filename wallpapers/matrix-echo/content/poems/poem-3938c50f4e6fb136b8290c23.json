{
  "id": "poem-3938c50f4e6fb136b8290c23",
  "title": "春堤曲",
  "author": "张籍",
  "dynasty": "唐",
  "verses": [
    "野塘䴔䴖飞树头，绿蒲紫菱盖碧流。",
    "狂客谁家爱云水，日日独来城下游。"
  ],
  "enabled": true,
