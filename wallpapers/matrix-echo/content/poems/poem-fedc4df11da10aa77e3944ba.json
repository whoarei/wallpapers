{
  "id": "poem-fedc4df11da10aa77e3944ba",
  "title": "天仙子·月落城乌啼未了",
  "author": "纳兰性德",
  "dynasty": "清",
  "verses": [
    "月落城乌啼未了，起来翻为无眠早。",
    "薄霜庭院怯生衣，心悄悄，红阑绕。",
    "此情待共谁人晓。"
  ],
  "enabled": true,
