{
  "id": "poem-ccf50e4555e156c01e41f48d",
  "title": "峨眉",
  "author": "杨徽之",
  "dynasty": "宋",
  "verses": [
    "嘉州山水地，二蜀最为美。",
    "翠岭叠峨眉，长澜涌锦水。"
  ],
  "enabled": true,
