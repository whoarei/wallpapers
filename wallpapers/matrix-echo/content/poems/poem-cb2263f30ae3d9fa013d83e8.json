{
  "id": "poem-cb2263f30ae3d9fa013d83e8",
  "title": "悲长安",
  "author": "子兰",
  "dynasty": "唐",
  "verses": [
    "何事天时祸未回，生灵愁悴苦寒灰。",
    "岂知万倾繁华地，强半今为瓦砾堆。"
  ],
  "enabled": true,
