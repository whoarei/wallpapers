{
  "id": "poem-4152e1ce9db65f4dc95da13a",
  "title": "菩萨蛮·鸳鸯枕上云堆绿",
  "author": "蔡伸",
  "dynasty": "宋",
  "verses": [
    "鸳鸯枕上云堆绿。",
    "兰膏微润知新沐。",
    "开帐对华灯。",
    "见郎双眼明。",
    "锦衾香馥郁。",
    "槛竹敲寒玉。",
    "何物最无情。",
    "晓鸡咿喔声。"
  ],
  "enabled": true,
  "collection": "宋词选",
