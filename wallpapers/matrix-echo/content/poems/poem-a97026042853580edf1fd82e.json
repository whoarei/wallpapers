{
  "id": "poem-a97026042853580edf1fd82e",
  "title": "望海",
  "author": "周繇",
  "dynasty": "唐",
  "verses": [
    "苍茫空泛日，四顾绝人烟。",
    "半浸中华岸，旁通异域船。",
    "岛间应有国，波外恐无天。",
    "欲作乘槎客，翻愁去隔年。"
  ],
  "enabled": true,
