{
  "id": "poem-19fdda1a561bfdadf2e04c95",
  "title": "调笑・调笑令·芳草",
  "author": "毛滂",
  "dynasty": "宋",
  "verses": [
    "芳草。",
    "恨春老。",
    "自是寻春来不早。",
    "落花风起红多少。",
    "记得一枝春小。",
    "绿阴青子空相恼。",
    "此恨平生怀抱。"
  ],
  "enabled": true,
  "collection": "宋词选",
