{
  "id": "poem-a00462fe2ee731cf2ccd50b7",
  "title": "江行纪事二首 一",
  "author": "席豫",
  "dynasty": "唐",
  "verses": [
    "飘飖任舟楫，回合傍江津。",
    "后浦情犹在，前山赏更新。",
    "树深烟幂幂，滩浅石磷磷。",
    "川路南行远，淹留惜此辰。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
