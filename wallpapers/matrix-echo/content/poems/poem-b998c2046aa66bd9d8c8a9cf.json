{
  "id": "poem-b998c2046aa66bd9d8c8a9cf",
  "title": "上巳日陪齐相公花楼宴",
  "author": "卢纶",
  "dynasty": "唐",
  "verses": [
    "钟陵暮春月，飞观延群英。",
    "晨霞耀中轩，满席罗金琼。",
    "持杯凝远睇，触物结幽情。",
    "树色参差绿，湖光潋滟明。",
    "礼卑瞻绛帐，恩浃厕华缨。",
    "徒记山阴兴，祓禊乃为荣。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
