{
  "id": "poem-ccc47a0d78e53cdd3064482d",
  "title": "怀尹真人",
  "author": "鲍溶",
  "dynasty": "唐",
  "verses": [
    "万里叠嶂翠，一心浮云闲。",
    "羽人杏花发，倚树红琼颜。",
    "流水杳冥外，女萝阴荫间。",
    "却思人间世，多恐不可还。",
    "青鸟飞难远，春云晴不闲。",
    "但恐五云车，山上复有山。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
