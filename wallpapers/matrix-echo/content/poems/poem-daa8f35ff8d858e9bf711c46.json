{
  "id": "poem-daa8f35ff8d858e9bf711c46",
  "title": "度关山",
  "author": "李端",
  "dynasty": "唐",
  "verses": [
    "雁塞日初晴，狐关雪复平。",
    "危楼缘广漠，古窦傍长城。",
    "拂剑金星出，弯弧玉羽鸣。",
    "谁知系虏者，贾谊是书生。"
  ],
  "enabled": true,
