{
  "id": "poem-25adaba231f916089d8aded4",
  "title": "秋闺  其三",
  "author": "王同祖",
  "dynasty": "宋",
  "verses": [
    "入秋情思可曾忺，深琐朱扉怯卷帘。",
    "书几无人尘不扫，一钩蛛网挂牙签。"
  ],
  "enabled": true,
