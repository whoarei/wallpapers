{
  "id": "poem-0365a32167ed3b698eba7397",
  "title": "小师智广请赞",
  "author": "释了惠",
  "dynasty": "宋",
  "verses": [
    "泽广藏山，理能伏豹。",
    "父既不慈，子亦不孝。",
    "吉凶影象自分明，不用烧香求卦兆。"
  ],
  "enabled": true,
  "collection": "宋诗选",
