{
  "id": "poem-a8fdf0f988640b232e1e333b",
  "title": "苑中人日遇雪应制",
  "author": "赵彦昭",
  "dynasty": "唐",
  "verses": [
    "始见青云干律吕，俄逢瑞雪应阳春。",
    "今日回看上林树，梅花柳絮一时新。"
  ],
  "enabled": true,
