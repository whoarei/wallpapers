{
  "id": "poem-a4a7839546af59593649862b",
  "title": "邓隠峰赞",
  "author": "释了惠",
  "dynasty": "宋",
  "verses": [
    "金锡一震，虚空退听。",
    "百万雄兵，难破此阵。",
    "一时游戏神通，未免旁观者哂。"
  ],
  "enabled": true,
  "collection": "宋诗选",
