{
  "id": "poem-992ea83195c2bc55285910e4",
  "title": "白纻辞二首 一",
  "author": "崔国辅",
  "dynasty": "唐",
  "verses": [
    "洛阳梨花落如霰，河阳桃叶生复齐。",
    "坐惜玉楼春欲尽，红绵粉絮裛妆啼。"
  ],
  "enabled": true,
