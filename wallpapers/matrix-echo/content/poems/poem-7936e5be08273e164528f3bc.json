{
  "id": "poem-7936e5be08273e164528f3bc",
  "title": "村居即事",
  "author": "范成大",
  "dynasty": "宋",
  "verses": [
    "绿遍山原白满川，子规声里雨如烟。",
    "乡村四月闲人少，才了蚕桑又插田。"
  ],
  "enabled": true,
  "collection": "千家诗",
