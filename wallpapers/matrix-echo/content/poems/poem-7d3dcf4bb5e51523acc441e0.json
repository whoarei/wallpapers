{
  "id": "poem-7d3dcf4bb5e51523acc441e0",
  "title": "八拍蛮·愁锁黛眉烟易惨",
  "author": "阎选",
  "dynasty": "五代",
  "verses": [
    "愁锁黛眉烟易惨，泪飘红脸粉难匀。",
    "憔悴不知缘底事，遇人推道不宜春。"
  ],
  "enabled": true,
