{
  "id": "poem-8f7955f19f39d4e42e8bb825",
  "title": "十无诗寄桂府杨中丞 十",
  "author": "赵嘏",
  "dynasty": "唐",
  "verses": [
    "膺门不避额逢珠，绝境由来卷轴须。",
    "早忝阿戎诗友契，趋庭曾荐祢生无。"
  ],
  "enabled": true,
