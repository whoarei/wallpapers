{
  "id": "poem-d44710e8a97d1d306537cf15",
  "title": "偈 六",
  "author": "契此",
  "dynasty": "唐",
  "verses": [
    "由贪沦堕世波中，拾却贪嗔礼大雄。",
    "直截凡情无所得，圆明寂照汝心宗。"
  ],
