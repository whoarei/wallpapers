{
  "id": "poem-45888b4d6edbb5645c80667d",
  "title": "寓兴",
  "author": "宋伯仁",
  "dynasty": "宋",
  "verses": [
    "又近重阳节，伤心事可嗟。",
    "塞鸿河洛志，篱菊古今花。",
    "苦雨床俱漏，颠风扇莫遮。",
    "渔船如一叶，快活似侬家。"
  ],
  "enabled": true,
  "collection": "宋诗选",
