{
  "id": "poem-0f98b840b966d0b90f399571",
  "title": "同吕缙叔诸君寄怀希用师",
  "author": "苏颂",
  "dynasty": "宋",
  "verses": [
    "方袍为佛者，学术以儒兼。",
    "迹慕山林逸，心从典籍潜。",
    "白云中寄趣，浮世外安恬。",
    "遐想观书室，焚香正下帘。"
  ],
  "enabled": true,
  "collection": "宋诗选",
