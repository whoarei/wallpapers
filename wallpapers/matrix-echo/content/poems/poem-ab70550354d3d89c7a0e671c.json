{
  "id": "poem-ab70550354d3d89c7a0e671c",
  "title": "点绛唇·清夜沈沈",
  "author": "王十朋",
  "dynasty": "宋",
  "verses": [
    "清夜沈沈，携来深院柔枝小。",
    "俪兰开巧。",
    "雪里乘风袅。",
    "温室寒祛，旖旎仙姿早。",
    "看成好。",
    "花仙欢笑。",
    "不管年华老。"
  ],
  "enabled": true,
  "collection": "宋词选",
