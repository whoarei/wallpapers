{
  "id": "poem-e60e061e8b4529892bd0832f",
  "title": "煎茶峰",
  "author": "陈岩",
  "dynasty": "宋",
  "verses": [
    "缓火烘来活水煎，山头卓锡取清泉。",
    "品茶嬾检茶经看，舌本无非有味禅。"
  ],
  "enabled": true,
