{
  "id": "poem-d37b493d676bdd98ff2e35a5",
  "title": "秋日",
  "author": "耿𣲗",
  "dynasty": "唐",
  "verses": [
    "返照入闾巷，忧来谁共语。",
    "古道少人行，秋风动禾黍。"
  ],
  "enabled": true,
