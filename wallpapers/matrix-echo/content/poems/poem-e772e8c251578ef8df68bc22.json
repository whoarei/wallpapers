{
  "id": "poem-e772e8c251578ef8df68bc22",
  "title": "赋残雪",
  "author": "释干康",
  "dynasty": "宋",
  "verses": [
    "六出奇花已住开，郡城相次见楼台。",
    "时人莫把和泥看，一片飞从天上来。"
  ],
