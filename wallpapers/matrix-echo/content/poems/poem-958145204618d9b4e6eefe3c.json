{
  "id": "poem-958145204618d9b4e6eefe3c",
  "title": "花犯·小娉婷",
  "author": "吴文英",
  "dynasty": "宋",
  "verses": [
    "小娉婷，清铅素靥，蜂黄暗偷晕。",
    "翠翘敧鬓。",
    "昨夜冷中庭，月下相认。",
    "睡浓更苦凄风紧。",
    "惊回心未稳。",
    "送晓色、一壶葱蒨，才知花梦准。",
    "湘娥化作此幽芳，凌波路，古岸云沙遗恨。",
    "临砌影，寒香乱、冻梅藏韵。",
    "熏炉畔、旋移傍枕，还又见、玉人垂绀鬒。",
    "料唤赏、清华池馆，台杯须满引。"
  ],
  "enabled": true,
  "collection": "宋词选",
