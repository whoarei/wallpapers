{
  "id": "poem-f87e671e4623524100549369",
  "title": "塞上曲",
  "author": "裴说",
  "dynasty": "唐",
  "verses": [
    "极目望空阔，马羸程又赊。",
    "月生方见树，风定始无沙。",
    "楚水辞鱼窟，燕山到雁家。",
    "如斯名利役，争不老天涯。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
  "tags": [
    "边塞"
  ],
