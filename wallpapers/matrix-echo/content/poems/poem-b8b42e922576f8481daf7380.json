{
  "id": "poem-b8b42e922576f8481daf7380",
  "title": "樵谷",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "谷口云横草不生，弗容斤斧弗容耕。",
    "呼童尽拾风前叶，自去提撕折脚铛。"
  ],
  "enabled": true,
