{
  "id": "poem-92debc240c5b2f2e9311f704",
  "title": "赵康州徐夫子庙",
  "author": "苗仲渊",
  "dynasty": "宋",
  "verses": [
    "世惟忠与孝，训俗知所止。",
    "杀身赵康州，锡类徐夫子。",
    "虽非萃一门，死葬同闾里。"
  ],
  "enabled": true,
  "collection": "宋诗选",
