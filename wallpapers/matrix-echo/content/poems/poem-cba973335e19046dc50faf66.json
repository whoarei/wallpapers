{
  "id": "poem-cba973335e19046dc50faf66",
  "title": "适南亭",
  "author": "华镇",
  "dynasty": "宋",
  "verses": [
    "子真埋照地，千载委榛莽。",
    "知音久未会，遗踪寂谁赏。",
    "华堂始基搆，皂盖日来往。",
    "高风邈已远，兹焉竞长想。"
  ],
  "enabled": true,
  "collection": "宋诗选",
