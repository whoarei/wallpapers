{
  "id": "poem-ada996dda8fda57f679b473c",
  "title": "南乡子·拢云髻",
  "author": "李珣",
  "dynasty": "五代",
  "verses": [
    "拢云髻，背犀梳，焦红衫映绿罗裙。",
    "越王台下春风暖，药盈岸，游赏每邀邻女伴。"
  ],
  "enabled": true,
  "collection": "花间集",
