{
  "id": "poem-3d7c3af95e6c2355c040617f",
  "title": "守岁",
  "author": "太宗皇帝",
  "dynasty": "唐",
  "verses": [
    "暮景斜芳殿，年华丽绮宫。",
    "寒辞去冬雪，暖带入春风。",
    "阶馥舒梅素，盘花卷烛红。",
    "共欢新故岁，迎送一宵中。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
  "tags": [
    "闲适",
    "春节"
  ],
