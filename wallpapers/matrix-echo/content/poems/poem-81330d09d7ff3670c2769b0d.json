{
  "id": "poem-81330d09d7ff3670c2769b0d",
  "title": "偈颂七十一首  其三○",
  "author": "释了惠",
  "dynasty": "宋",
  "verses": [
    "旧岁已去，去不可追。",
    "新岁当来，来不可拒。"
  ],
