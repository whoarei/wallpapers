{
  "id": "poem-222fb002a6082dfc13c0603f",
  "title": "对月二首 二",
  "author": "张乔",
  "dynasty": "唐",
  "verses": [
    "盈缺青冥外，东风万古吹。",
    "何人种丹桂，不长出轮枝。"
  ],
