{
  "id": "poem-3b08c4510561c026f90c55e9",
  "title": "同前",
  "author": "无名氏《张协状元》",
  "dynasty": "元",
  "verses": [
    "要你须着这秀才。",
    "(净)我着它伊休要来。",
    "(末)你两个贫胎苦肥。",
    "(生)没紧要休得要系怀。"
  ],
  "enabled": true,
  "collection": "元曲选",
