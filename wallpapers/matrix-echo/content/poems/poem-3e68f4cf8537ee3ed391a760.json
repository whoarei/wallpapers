{
  "id": "poem-3e68f4cf8537ee3ed391a760",
  "title": "山居八咏 六",
  "author": "常达",
  "dynasty": "唐",
  "verses": [
    "古寺凭栏危，时闻举妙机。",
    "庭空月色净，夜迥磬声移。",
    "漏转寒更急，灯残冷焰微。",
    "太虚同万象，相谓话玄微。"
  ],
  "enabled": true,
