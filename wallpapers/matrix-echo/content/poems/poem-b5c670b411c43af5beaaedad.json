{
  "id": "poem-b5c670b411c43af5beaaedad",
  "title": "柏梯寺",
  "author": "司马光",
  "dynasty": "宋",
  "verses": [
    "凿石开蹊峻，登崖置阁危。",
    "笑谈空谷应，步武白云随。",
    "众壑如翻浪，邻州若布棋。",
    "何当遂栖隐，身世两相遗。"
  ],
  "enabled": true,
  "collection": "宋诗选",
