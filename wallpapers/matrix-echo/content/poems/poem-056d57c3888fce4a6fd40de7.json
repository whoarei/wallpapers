{
  "id": "poem-056d57c3888fce4a6fd40de7",
  "title": "述怀  其二",
  "author": "王镃",
  "dynasty": "宋",
  "verses": [
    "心如冰静已无波，劫世虚言莫问他。",
    "老眼易昏书字大，醉言难谨忤人多。",
    "山厨烟火烧红叶，水国衣裳制绿蓑。",
    "浊富清贫分两路，高眠不管吏征科。"
  ],
  "enabled": true,
  "collection": "宋诗选",
