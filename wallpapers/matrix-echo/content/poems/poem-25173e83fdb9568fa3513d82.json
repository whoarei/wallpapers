{
  "id": "poem-25173e83fdb9568fa3513d82",
  "title": "立秋日",
  "author": "刘言史",
  "dynasty": "唐",
  "verses": [
    "商风动叶初，萧索一贫居。",
    "老性容茶少，羸肌与簟疎。",
    "旧醅难重漉，新菜未胜鉏。",
    "才薄无潘兴，便便画偃庐。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
