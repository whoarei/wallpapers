{
  "id": "poem-d793fed53a7b12bcf96bff0d",
  "title": "猗嗟",
  "author": "佚名",
  "dynasty": "先秦",
  "verses": [
    "猗嗟昌兮，颀而长兮。抑若扬兮，美目扬兮。巧趋跄兮，射则臧兮。",
    "猗嗟名兮，美目清兮。仪既成兮，终日射侯，不出正兮，展我甥兮。",
    "猗嗟娈兮，清扬婉兮。舞则选兮，射则贯兮，四矢反兮，以御乱兮。"
  ],
  "enabled": true,
  "collection": "诗经",
  "tags": [],
