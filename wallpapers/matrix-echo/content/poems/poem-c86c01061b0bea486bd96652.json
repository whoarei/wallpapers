{
  "id": "poem-c86c01061b0bea486bd96652",
  "title": "南乡子·相见处",
  "author": "李珣",
  "dynasty": "五代",
  "verses": [
    "相见处，晚晴天，斜桐花下越台前。",
    "暗里回眸深属意，遗双翠，骑象背人先过水。"
  ],
  "enabled": true,
  "collection": "花间集",
