{
  "id": "poem-67868c7846e6f70e93168473",
  "title": "集灵台二首 二",
  "author": "张祜",
  "dynasty": "唐",
  "verses": [
    "虢国夫人承主恩，平明骑马入宫门。",
    "却嫌脂粉汚颜色，淡扫蛾眉朝至尊。"
  ],
  "enabled": true,
