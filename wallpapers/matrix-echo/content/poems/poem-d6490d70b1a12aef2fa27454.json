{
  "id": "poem-d6490d70b1a12aef2fa27454",
  "title": "洛阳行",
  "author": "张籍",
  "dynasty": "唐",
  "verses": [
    "洛阳宫阙当中州，城上峨峨十二楼。",
    "翠华西去几时返，枭巢乳鸟藏蛰燕。",
    "御门空锁五十年，税彼农夫修玉殿。",
    "六街朝暮鼓冬冬，禁兵持戟守空宫。",
    "百官月月拜章表，驿使相续长安道。",
    "上阳宫树黄复绿，野豺入苑食麋鹿。",
    "陌上老翁双泪垂，共说武皇巡幸时。"
  ],
  "enabled": true,
