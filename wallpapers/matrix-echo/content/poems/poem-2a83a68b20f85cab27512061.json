{
  "id": "poem-2a83a68b20f85cab27512061",
  "title": "江村即事",
  "author": "司空曙",
  "dynasty": "唐",
  "verses": [
    "钓罢归来不系船，江村月落正堪眠。",
    "纵然一夜风吹去，只在芦花浅水边。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
