{
  "id": "poem-84f25acf0b34c750ba4668bd",
  "title": "横吹曲辞 出塞曲 二",
  "author": "于鹄",
  "dynasty": "唐",
  "verses": [
    "单于骄爱猎，放火到军城。",
    "待月调新弩，防秋置远营。",
    "空山朱戟影，寒碛铁衣声。",
    "逢著降胡说，阴山有伏兵。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
