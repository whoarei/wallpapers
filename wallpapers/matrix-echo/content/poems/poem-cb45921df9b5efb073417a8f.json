{
  "id": "poem-cb45921df9b5efb073417a8f",
  "title": "君子行",
  "author": "李咸用",
  "dynasty": "唐",
  "verses": [
    "君子慎所履，小人多所疑。",
    "尼甫至圣贤，犹为匡所縻。"
  ],
  "enabled": true,
