{
  "id": "poem-c296503edea1d898b647c613",
  "title": "送韩玉汝太博出守洋州",
  "author": "苏颂",
  "dynasty": "宋",
  "verses": [
    "州封繁会逼梁嶓，继世为藩盛事多。",
    "遗德在人棠蔽芾，旧游经眼树婆娑。",
    "春生剑外壶浆溢，花满褒中驷马过。",
    "父老逢迎应善祝，缁衣将入郑风歌。"
  ],
  "enabled": true,
  "collection": "宋诗选",
  "tags": [],
