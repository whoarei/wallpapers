{
  "id": "poem-a59206bcf739bdf56ad9316d",
  "title": "一斛珠·风流太守",
  "author": "王质",
  "dynasty": "宋",
  "verses": [
    "风流太守。",
    "未春先试回春手。",
    "天寒修竹斜阳后。",
    "翠袖中间，忽有人红袖。",
    "天香国色浓如酒。",
    "且教青女休僝僽。",
    "梅花元是群花首。",
    "细细商量，只怕梅花瘦。"
  ],
  "enabled": true,
  "collection": "宋词选",
