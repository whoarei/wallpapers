{
  "id": "poem-6a5d9ab7b020f584bf8bc905",
  "title": "感物",
  "author": "司马光",
  "dynasty": "宋",
  "verses": [
    "朝看新燕飞，暮聼子规啼。",
    "尺蠖身藏叶，神龟尾曳泥。",
    "鞲鹰何用掣，枥马不当嘶。",
    "自伐憎狙巧，颓然忧木鸡。"
  ],
  "enabled": true,
  "collection": "宋诗选",
