{
  "id": "poem-038b30602c080dd137d7d140",
  "title": "清谿馆作",
  "author": "谈戭",
  "dynasty": "唐",
  "verses": [
    "指途清谿里，左右唯深林。",
    "云蔽望乡处，雨愁为客心。",
    "遇人多物役，听鸟时幽音。",
    "何必沧浪水，庶兹浣尘襟。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
