{
  "id": "poem-bbc3b502f67b81d0379b1ea8",
  "title": "月",
  "author": "张南史",
  "dynasty": "唐",
  "verses": [
    "月，月。",
    "暂盈，还缺。",
    "上虚空，生溟渤。",
    "散彩无际，移轮不歇。",
    "桂殿入西秦，菱歌映南越。",
    "正看云雾秋卷，莫待关山晓没。",
    "天涯地角不可寻，清光永夜何超忽。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
