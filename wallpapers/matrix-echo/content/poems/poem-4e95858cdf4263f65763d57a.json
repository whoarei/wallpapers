{
  "id": "poem-4e95858cdf4263f65763d57a",
  "title": "三代门 太公",
  "author": "周昙",
  "dynasty": "唐",
  "verses": [
    "昌猎关西纣猎东，纣怜崇虎弃非熊。",
    "危邦自谓多麟凤，肯把王纲取钓翁。"
  ],
  "enabled": true,
