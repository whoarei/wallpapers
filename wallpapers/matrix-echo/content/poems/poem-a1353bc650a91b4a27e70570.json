{
  "id": "poem-a1353bc650a91b4a27e70570",
  "title": "庐山独夜",
  "author": "徐凝",
  "dynasty": "唐",
  "verses": [
    "寒空五老雪，斜月九江云。",
    "钟声知何处，苍苍树里闻。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
  "tags": [
    "庐山"
