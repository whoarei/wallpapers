{
  "id": "poem-d76a25b87c48650287e0afb4",
  "title": "送丘二十二之苏州",
  "author": "崔峒",
  "dynasty": "唐",
  "verses": [
    "积水与寒烟，嘉禾路几千。",
    "孤猨啼海岛，群雁起湖田。",
    "曾见长洲苑，尝闻大雅篇。",
    "却将封事去，知尔爱闲眠。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
