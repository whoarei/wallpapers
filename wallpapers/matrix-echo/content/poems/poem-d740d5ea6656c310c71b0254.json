{
  "id": "poem-d740d5ea6656c310c71b0254",
  "title": "浣溪沙·灯尽垂花月似霜",
  "author": "欧阳修",
  "dynasty": "宋",
  "verses": [
    "灯尽垂花月似霜。",
    "薄帘映月两交光。",
    "酒醺红粉自生香。",
    "双手舞馀拖翠袖，一声歌已釂金觞。",
    "休回娇眼断人肠。"
  ],
  "enabled": true,
  "collection": "宋词选",
