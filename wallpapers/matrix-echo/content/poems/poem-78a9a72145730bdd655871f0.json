{
  "id": "poem-78a9a72145730bdd655871f0",
  "title": "春草池",
  "author": "张又新",
  "dynasty": "唐",
  "verses": [
    "谢公梦草一差微，谪宦当时道不机。",
    "且谓飞霞游赏地，池塘烟柳亦依依。"
  ],
  "enabled": true,
