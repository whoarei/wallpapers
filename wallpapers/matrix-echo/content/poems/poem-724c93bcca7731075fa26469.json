{
  "id": "poem-724c93bcca7731075fa26469",
  "title": "江南杂题三十首 其二十七",
  "author": "张祜",
  "dynasty": "唐",
  "verses": [
    "卜筑寄云阳，穿池面草堂。",
    "寻常登峻岭，丈六得奇彊。",
    "井鲋依颓甃，隣花出败墙。"
  ],
  "enabled": true,
