{
  "id": "poem-6eccbe98a3ecf78d3536a3e5",
  "title": "海南黎人作过据临臯县惊刼傍近因小留海康十一月望闻官军破贼二十日戒行戏作两绝句  其一",
  "author": "李纲",
  "dynasty": "宋",
  "verses": [
    "海上群黎亦弄兵，征车数月旅山城。",
    "稽留谪命兢惶甚，正坐绯巾惩沸羮。"
  ],
  "enabled": true,
  "collection": "宋诗选",
