{
  "id": "poem-a465b205a832afc9d5dff3e1",
  "title": "前腔",
  "author": "徐田臣《杀狗记》",
  "dynasty": "元",
  "verses": [
    "(末)东人富室豪门，论结交须谨慎。",
    "他人怎比得亲骨肉？久久见假和真。",
    "寻思及早回头省，莫把亲人如陌路人。",
    "(合前)。"
  ],
  "enabled": true,
