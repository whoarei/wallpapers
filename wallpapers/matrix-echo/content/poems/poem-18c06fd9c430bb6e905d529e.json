{
  "id": "poem-18c06fd9c430bb6e905d529e",
  "title": "西江月·识贯事中枢纽",
  "author": "叶适",
  "dynasty": "宋",
  "verses": [
    "识贯事中枢纽，笔开象外精神。",
    "传观弓力异常钧。",
    "衣我六铢羞问。",
    "周后数茎命粒，鲁儒一点芳心。",
    "啄残栖老付谁论。",
    "谩要睡馀支枕。"
  ],
  "enabled": true,
  "collection": "宋词选",
