{
  "id": "poem-8627f90d5935c9ea41504b97",
  "title": "寄法堂颂",
  "author": "智闲",
  "dynasty": "唐",
  "verses": [
    "东间里入寂，西间里语话。",
    "中间里睡眠，通间里行道。",
    "向前即捡校，向后即隐形。",
    "。"
  ],
  "enabled": true,
