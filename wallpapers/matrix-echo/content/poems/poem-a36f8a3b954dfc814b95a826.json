{
  "id": "poem-a36f8a3b954dfc814b95a826",
  "title": "弼公院问病",
  "author": "刘言史",
  "dynasty": "唐",
  "verses": [
    "一头细发两分丝，卧见芭蕉白露滋。",
    "欲令居士身无病，直待众生苦尽时。"
  ],
