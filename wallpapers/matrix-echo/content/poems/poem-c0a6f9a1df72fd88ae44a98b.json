{
  "id": "poem-c0a6f9a1df72fd88ae44a98b",
  "title": "赠别",
  "author": "赵嘏",
  "dynasty": "唐",
  "verses": [
    "水边秋草暮萋萋，欲驻残阳恨马蹄。",
    "曾是管弦同醉伴，一声歌尽各东西。"
  ],
  "enabled": true,
