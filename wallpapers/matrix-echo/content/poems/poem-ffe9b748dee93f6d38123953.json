{
  "id": "poem-ffe9b748dee93f6d38123953",
  "title": "无题",
  "author": "林敏功",
  "dynasty": "宋",
  "verses": [
    "琵琶起舞换新声，总是关山旧客情。",
    "撩乱边愁弹不尽，高高秋月照长城。"
  ],
  "enabled": true,
  "collection": "宋诗选",
