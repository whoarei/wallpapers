{
  "id": "poem-61d3357d7f1ac1fc066992df",
  "title": "南歌子·扑蕊添黄子",
  "author": "温庭筠",
  "dynasty": "唐",
  "verses": [
    "扑蕊添黄子，呵花满翠鬟。",
    "鸳枕映屏山，明月三五夜，对芳颜。"
  ],
  "enabled": true,
