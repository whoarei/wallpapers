{
  "id": "poem-cde4cca35a2e42aaaf37da1f",
  "title": "四睡赞  其二",
  "author": "释了惠",
  "dynasty": "宋",
  "verses": [
    "无固无必，挨肩促膝。",
    "人梦不祥，虎梦大吉。",
    "世上有谁知，天台云羃羃。"
  ],
  "enabled": true,
