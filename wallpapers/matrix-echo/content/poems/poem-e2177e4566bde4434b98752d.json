{
  "id": "poem-e2177e4566bde4434b98752d",
  "title": "柳絮",
  "author": "杨凝",
  "dynasty": "唐",
  "verses": [
    "河畔多杨柳，追游尽狭斜。",
    "春风一回送，乱入莫愁家。"
  ],
  "enabled": true,
