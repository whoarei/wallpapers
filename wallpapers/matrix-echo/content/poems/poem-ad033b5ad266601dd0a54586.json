{
  "id": "poem-ad033b5ad266601dd0a54586",
  "title": "十二时偈 二",
  "author": "文偃",
  "dynasty": "唐",
  "verses": [
    "鸡鸣丑，一岁孙儿大哮吼。",
    "实相圆明不思议，三世法身藏北斗。"
  ],
