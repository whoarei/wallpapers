{
  "id": "poem-33f77ed6af6a9a300bdb4f2c",
  "title": "横吹曲辞 陇头水 一",
  "author": "僧皎然",
  "dynasty": "唐",
  "verses": [
    "陇头心欲绝，陇水不堪闻。",
    "碎影摇枪垒，寒声咽帐军。",
    "素从盐海积，绿带柳城分。",
    "日落天边望，逶迤入塞云。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
