{
  "id": "poem-d9e912fa1510b8ab735c9039",
  "title": "调笑・调笑令·南土",
  "author": "洪适",
  "dynasty": "宋",
  "verses": [
    "南土。",
    "贤铜虎。",
    "黄木湾头腾好语。",
    "骑羊执穗神仙五。",
    "拭目摩肩争睹。",
    "无双治行今犹古。",
    "嘉瑞流传乐府。"
  ],
  "enabled": true,
  "collection": "宋词选",
