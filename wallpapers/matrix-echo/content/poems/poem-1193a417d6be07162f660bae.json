{
  "id": "poem-1193a417d6be07162f660bae",
  "title": "题水弄山",
  "author": "杨筠",
  "dynasty": "宋",
  "verses": [
    "曲曲溪流叠叠山，稻塍高下路回环。",
    "晓暾初射林霏落，一道炊烟紫翠间。"
  ],
  "enabled": true,
  "collection": "宋诗选",
