{
  "id": "poem-4b74e14c620e481365bbf3ed",
  "title": "寄弟",
  "author": "吕从庆",
  "dynasty": "唐",
  "verses": [
    "函罢家音又拆看，添书绝句报平安。",
    "丰溪渔叟生涯定，明月清风一钓竿。"
  ],
