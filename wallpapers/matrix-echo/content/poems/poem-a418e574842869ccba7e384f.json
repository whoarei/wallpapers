{
  "id": "poem-a418e574842869ccba7e384f",
  "title": "中书相公谿亭闲宴依韵",
  "author": "徐铉",
  "dynasty": "宋",
  "verses": [
    "雨霁秋光晚，亭空野兴回。",
    "沙鸥掠岸去，谿水上阶来。",
    "客傲风欺帻，筵香菊在杯。",
    "东山长许醉，何事忆天台。"
  ],
  "enabled": true,
  "collection": "宋诗选",
