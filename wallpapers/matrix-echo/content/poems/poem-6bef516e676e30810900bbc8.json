{
  "id": "poem-6bef516e676e30810900bbc8",
  "title": "白雪曲",
  "author": "贯休",
  "dynasty": "唐",
  "verses": [
    "列鼎佩金章，泪眼看风枝。",
    "却思食藜藿，身作屠沽儿。",
    "负米无远近，所希升斗归。",
    "为人无贵贱，莫学鸡狗肥。",
    "斯言如不忘，别更无光辉。",
    "斯言如或忘，即安用人为。"
  ],
  "enabled": true,
