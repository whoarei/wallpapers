{
  "id": "poem-6b2afc0a09631e6fad18a70c",
  "title": "李化文书堂",
  "author": "陈岩",
  "dynasty": "宋",
  "verses": [
    "世路嵚崎两鬓丝，山中留客且伸眉。",
    "竹林胜践虽相似，犹恨前贤所欠诗。"
  ],
  "enabled": true,
  "collection": "宋诗选",
