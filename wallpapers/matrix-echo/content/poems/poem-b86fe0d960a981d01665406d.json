{
  "id": "poem-b86fe0d960a981d01665406d",
  "title": "捣练子令·深院静",
  "author": "李煜",
  "dynasty": "五代",
  "verses": [
    "深院静，小庭空，断续寒砧断续风。",
    "无奈夜长人不寐，数声和月到帘栊。"
  ],
  "enabled": true,
  "collection": "南唐二主词",
