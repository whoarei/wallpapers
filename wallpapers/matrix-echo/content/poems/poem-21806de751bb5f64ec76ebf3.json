{
  "id": "poem-21806de751bb5f64ec76ebf3",
  "title": "里社",
  "author": "柴元彪",
  "dynasty": "宋",
  "verses": [
    "涤灶炮牲献腯肥，一巵滴酹纸钱飞。",
    "提壶挈馌分肴酒，村北村南祭社归。"
  ],
  "enabled": true,
