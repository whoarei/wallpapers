{
  "id": "poem-bdd24b409479c9d476046e38",
  "title": "次韵无为使君尊兄见寄之什",
  "author": "张栻",
  "dynasty": "宋",
  "verses": [
    "江山接境相望近，风雨一春音问疎。",
    "安得从公苕霅上，幅巾一叶卧看书。"
  ],
  "enabled": true,
