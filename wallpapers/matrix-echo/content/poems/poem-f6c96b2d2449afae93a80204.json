{
  "id": "poem-f6c96b2d2449afae93a80204",
  "title": "清平乐·金风细细",
  "author": "晏殊",
  "dynasty": "宋",
  "verses": [
    "金风细细。",
    "叶叶梧桐坠。",
    "绿酒初尝人易醉。",
    "一枕小窗浓睡。",
    "紫微朱槿花残。",
    "斜阳却照阑干。",
    "双燕欲归时节，银屏昨夜微寒。"
  ],
  "enabled": true,
