{
  "id": "poem-cd1222f2816773137bbf6bb8",
  "title": "江上逢故人",
  "author": "崔道融",
  "dynasty": "唐",
  "verses": [
    "故里琴樽侣，相逢近腊梅。",
    "江村买一醉，破泪却成咍。"
  ],
  "enabled": true,
