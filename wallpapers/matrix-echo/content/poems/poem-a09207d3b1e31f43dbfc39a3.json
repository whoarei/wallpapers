{
  "id": "poem-a09207d3b1e31f43dbfc39a3",
  "title": "和修睦上人听猿",
  "author": "李咸用",
  "dynasty": "唐",
  "verses": [
    "禅客闻犹苦，是声应是啼。",
    "自然无稳梦，何必到巴溪。",
    "疎雨洒不歇，回风吹暂低。",
    "此宵秋欲半，山在二林西。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
