{
  "id": "poem-724638919bb0ef543b071690",
  "title": "浣溪沙·细雨萧萧变作秋",
  "author": "王质",
  "dynasty": "宋",
  "verses": [
    "细雨萧萧变作秋。",
    "晚风杨柳冷飕飕。",
    "无言有泪洒西楼。",
    "眼共云山昏惨惨，心随烟水去悠悠。",
    "一蓑一笠任孤舟。"
  ],
  "enabled": true,
  "collection": "宋词选",
