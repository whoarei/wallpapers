{
  "id": "poem-3d1ebe46b8a626f464f770b3",
  "title": "西溪冬夜",
  "author": "曾协",
  "dynasty": "宋",
  "verses": [
    "并堤松柏与云齐，月夜青山一望低。",
    "山鸟不惊人迹绝，步随流水到前溪。"
  ],
  "enabled": true,
