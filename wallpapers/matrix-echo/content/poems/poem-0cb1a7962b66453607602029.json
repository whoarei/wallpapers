{
  "id": "poem-0cb1a7962b66453607602029",
  "title": "和友人喜相遇十首 三",
  "author": "李咸用",
  "dynasty": "唐",
  "verses": [
    "惠子休惊学五车，沛公方起斩长蛇。",
    "六雄互欲吞诸国，四海终须作一家。",
    "自古经纶成世务，暂时朱绿比朝霞。",
    "人生心口宜相副，莫使尧阶草势斜。"
  ],
  "enabled": true,
