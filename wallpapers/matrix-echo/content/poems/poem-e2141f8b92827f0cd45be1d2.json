{
  "id": "poem-e2141f8b92827f0cd45be1d2",
  "title": "岳州晚景",
  "author": "张籍",
  "dynasty": "唐",
  "verses": [
    "晚景寒鸦集，秋声旅雁归。",
    "水光浮日去，霞彩暎江飞。",
    "洲白芦花吐，园红柿叶稀。",
    "长沙卑湿地，九月未成衣。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
