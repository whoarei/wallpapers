{
  "id": "poem-d463b0e03d147ccb031bcfaf",
  "title": "山居四卉 拒霜",
  "author": "李纲",
  "dynasty": "宋",
  "verses": [
    "道人多种木芙蓉，晓着清霜分外红。",
    "万叶千花本何有，因空成色色成空。"
  ],
  "enabled": true,
