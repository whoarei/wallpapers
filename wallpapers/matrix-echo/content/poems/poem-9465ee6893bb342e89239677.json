{
  "id": "poem-9465ee6893bb342e89239677",
  "title": "题城南书院三十四咏  其二六",
  "author": "张栻",
  "dynasty": "宋",
  "verses": [
    "拍堤水满草茸茸，尽日野航西复东。",
    "欲去未须愁日暮，月明波面更溶溶。"
  ],
  "enabled": true,
