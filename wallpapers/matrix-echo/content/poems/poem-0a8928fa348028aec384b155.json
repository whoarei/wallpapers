{
  "id": "poem-0a8928fa348028aec384b155",
  "title": "赋尚书",
  "author": "太宗皇帝",
  "dynasty": "唐",
  "verses": [
    "崇文时驻步，东观还停辇。",
    "辍膳玩三坟，晖灯披五典。",
    "寒心覩肉林，飞魄看沈湎。",
    "纵情昏主多，克己明君鲜。",
    "灭身资累恶，成名由积善。",
    "既承百王末，战兢随岁转。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
