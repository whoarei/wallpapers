{
  "id": "poem-88d8d39d60d1f736904bd318",
  "title": "湘妃庙",
  "author": "李涉",
  "dynasty": "唐",
  "verses": [
    "班竹林边有古祠，鸟啼花发尽堪悲。",
    "当时惆怅同今日，南北行人可得知。"
  ],
