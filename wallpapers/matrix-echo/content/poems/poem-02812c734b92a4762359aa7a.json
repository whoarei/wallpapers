{
  "id": "poem-02812c734b92a4762359aa7a",
  "title": "古寺",
  "author": "唐求",
  "dynasty": "唐",
  "verses": [
    "路傍古时寺，寥落藏金容。",
    "破塔有寒草，坏楼无晓钟。",
    "乱纸失经偈，断碑分篆踪。",
    "日暮月光吐，绕门千树松。"
  ],
  "enabled": true,
