{
  "id": "poem-66fda7bc4df32cbeb27440b6",
  "title": "浣溪沙·无恙年年汴水流",
  "author": "纳兰性德",
  "dynasty": "清",
  "verses": [
    "无恙年年汴水流。",
    "一声水调短亭秋。",
    "旧时明月照扬州。",
    "曾是长堤牵锦缆，绿杨清瘦至今愁。",
    "玉钩斜路近迷楼。"
  ],
  "enabled": true,
  "collection": "纳兰词",
