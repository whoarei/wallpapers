{
  "id": "poem-ca7eec030bbfdf85c9fadedc",
  "title": "因僧看经颂",
  "author": "文益",
  "dynasty": "唐",
  "verses": [
    "今人看古教，不免心中闹。",
    "欲免心中闹，但知看古教。"
  ],
