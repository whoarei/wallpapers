{
  "id": "poem-d125c563729a563f00e70f83",
  "title": "浄名  其二",
  "author": "米芾",
  "dynasty": "宋",
  "verses": [
    "旧对湘西雪，迟迟忆故关。",
    "水云资老景，吟引谢江山。"
  ],
  "enabled": true,
