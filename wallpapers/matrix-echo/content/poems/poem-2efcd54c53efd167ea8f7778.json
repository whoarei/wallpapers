{
  "id": "poem-2efcd54c53efd167ea8f7778",
  "title": "临滹沱见蕃使列名",
  "author": "李益",
  "dynasty": "唐",
  "verses": [
    "漠南春色到滹沱，碧柳青青塞马多。",
    "万里关山今不闭，汉家频许郅支和。"
  ],
  "enabled": true,
