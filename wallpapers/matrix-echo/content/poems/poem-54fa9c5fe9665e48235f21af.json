{
  "id": "poem-54fa9c5fe9665e48235f21af",
  "title": "诗一首",
  "author": "张𬸦",
  "dynasty": "唐",
  "verses": [
    "忽然心里爱，不觉眼中怜。",
    "未关双眼曲，直是寸心偏。"
  ],
