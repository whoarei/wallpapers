{
  "id": "poem-905e13a0cf83ab805f0b763c",
  "title": "清平调 三",
  "author": "李白",
  "dynasty": "唐",
  "verses": [
    "名花倾国两相欢，常得君王带笑看。",
    "解得春风无限恨，沈香亭北倚阑干。"
  ],
  "enabled": true,
