{
  "id": "poem-2d685cd7581c9f7c8473e9c4",
  "title": "横吹曲辞 出塞",
  "author": "耿[𣲗]",
  "dynasty": "唐",
  "verses": [
    "汉家边事重，窦宪出临戎。",
    "绝漠秋山在，阳关旧路通。",
    "列营依茂草，吹角向高风。",
    "更就燕然石，看铭破虏功。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
