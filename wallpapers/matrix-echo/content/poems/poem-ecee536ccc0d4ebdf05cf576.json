{
  "id": "poem-ecee536ccc0d4ebdf05cf576",
  "title": "铜雀妓",
  "author": "郑愔",
  "dynasty": "唐",
  "verses": [
    "日斜漳浦望，风起邺台寒。",
    "玉座平生晚，金尊妓吹阑。",
    "舞余依帐泣，歌罢向陵看。",
    "萧索松风暮，愁烟入井阑。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
