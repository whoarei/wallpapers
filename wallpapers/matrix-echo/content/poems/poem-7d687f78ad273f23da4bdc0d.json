{
  "id": "poem-7d687f78ad273f23da4bdc0d",
  "title": "送客往鄜州",
  "author": "杨凝",
  "dynasty": "唐",
  "verses": [
    "新参将相事营平，锦带骍弓结束轻。",
    "晓上关城吟画角，暗驰羗马发支兵。",
    "回中地近风常急，鄜畤年多草自生。",
    "近喜扶阳系戎相，从来衞霍笑长缨。"
  ],
  "enabled": true,
