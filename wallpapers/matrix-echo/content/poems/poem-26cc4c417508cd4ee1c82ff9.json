{
  "id": "poem-26cc4c417508cd4ee1c82ff9",
  "title": "稼穑",
  "author": "汪宗臣",
  "dynasty": "宋",
  "verses": [
    "稼穑病多雨，芜菁种待晴。",
    "垒空惊燕去，池净衬鸥明。",
    "野碓鸣秋杵，风簷响夜筝。",
    "山中凉意早，蚊蚋已无声。"
  ],
  "enabled": true,
  "collection": "宋诗选",
