{
  "id": "poem-94555214c2b93801cfcff902",
  "title": "对月了残经赞  其一",
  "author": "释了惠",
  "dynasty": "宋",
  "verses": [
    "破微尘出大经卷，一弹指顷千百遍。",
    "只因错认月为灯，至今展卷遮羞面。"
  ],
