{
  "id": "poem-1e80d213ad2ab22349aafe72",
  "title": "终南望余雪",
  "author": "祖咏",
  "dynasty": "唐",
  "verses": [
    "终南阴岭秀，积雪浮云端。",
    "林表明霁色，城中增暮寒。"
  ],
  "enabled": true,
