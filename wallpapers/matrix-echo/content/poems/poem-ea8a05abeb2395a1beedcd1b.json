{
  "id": "poem-ea8a05abeb2395a1beedcd1b",
  "title": "更漏子·锦筵红",
  "author": "张先",
  "dynasty": "宋",
  "verses": [
    "锦筵红，罗幕翠。",
    "侍宴美人姝丽。",
    "十五六，解怜才。",
    "劝人深酒杯。",
    "黛眉长，檀口小。",
    "耳畔向人轻道。",
    "柳阴曲，是儿家。",
    "门前红杏花。"
  ],
  "enabled": true,
  "collection": "宋词选",
