{
  "id": "poem-7538c6c8fca1118598e569bb",
  "title": "题金华宫",
  "author": "蜀太妃徐氏",
  "dynasty": "唐",
  "verses": [
    "碧烟红雾漾人衣，宿雾苍苔石径危。",
    "风巧解吹松上曲，蝶娇频采脸边脂。",
    "同寻僻境思携手，暗指遥山学画眉。",
    "好把身心清净处，角冠霞帔事希夷。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
