{
  "id": "poem-27e0b8211c87652deb8d697b",
  "title": "戏赠友人",
  "author": "杨凝",
  "dynasty": "唐",
  "verses": [
    "湘阴直与地阴连，此日相逢忆醉年。",
    "美酒非如平乐贵，十升不用一千钱。"
  ],
