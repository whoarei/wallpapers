{
  "id": "poem-c9ff9ef43ecd247395cc4cb6",
  "title": "寄令狐郎中",
  "author": "李商隐",
  "dynasty": "唐",
  "verses": [
    "嵩云秦树久离居，双鲤迢迢一纸书。",
    "休问梁园旧宾客，茂陵秋雨病相如。"
  ],
  "enabled": true,
