{
  "id": "poem-4f2d666e48119ef5510282c1",
  "title": "元日领客登北高",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "云绕簷楹扫不开，阑干直下是飞来。",
    "笑看白玉芬陁利，领略风烟又一回。"
  ],
  "enabled": true,
