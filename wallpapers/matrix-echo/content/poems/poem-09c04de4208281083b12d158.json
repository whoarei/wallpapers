{
  "id": "poem-09c04de4208281083b12d158",
  "title": "江南春",
  "author": "杜牧",
  "dynasty": "唐",
  "verses": [
    "千里莺啼绿映红，水村山郭酒旗风。",
    "南朝四百八十寺，多少楼台烟雨中。"
  ],
  "enabled": true,
  "collection": "千家诗",
