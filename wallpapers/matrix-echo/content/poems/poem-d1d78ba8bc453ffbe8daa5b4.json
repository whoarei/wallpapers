{
  "id": "poem-d1d78ba8bc453ffbe8daa5b4",
  "title": "玉阶怨",
  "author": "李白",
  "dynasty": "唐",
  "verses": [
    "玉阶生白露，夜久侵罗袜。",
    "却下水晶帘，玲珑望秋月。"
  ],
  "enabled": true,
