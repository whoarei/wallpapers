{
  "id": "poem-31322c57f5667309be1a7e50",
  "title": "送南陵尉李频",
  "author": "张乔",
  "dynasty": "唐",
  "verses": [
    "重作东南尉，生涯尚似僧。",
    "客程淮馆月，乡思海船灯。",
    "晚雾看春毂，晴天见朗陵。",
    "不应三考足，先授诏书征。"
  ],
  "enabled": true,
