{
  "id": "poem-f53071d1e51636963eaed454",
  "title": "春日思景仁",
  "author": "司马光",
  "dynasty": "宋",
  "verses": [
    "去歳洛城中，嬉游处处同。",
    "从离崿岭北，常梦潩泉东。",
    "草遶春街碧，花繁夕市红。",
    "临风默惆怅，想像白眉翁。"
  ],
  "enabled": true,
  "collection": "宋诗选",
