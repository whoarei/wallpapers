{
  "id": "poem-8b37abf9dff6150b47bcbe9b",
  "title": "玉簪花和希纯  其八",
  "author": "刘跂",
  "dynasty": "宋",
  "verses": [
    "蓝田故有他山错，瑶旆琼旒碧玉干。",
    "左紫姚黄满金谷，野人留取伴鸡冠。"
  ],
  "enabled": true,
