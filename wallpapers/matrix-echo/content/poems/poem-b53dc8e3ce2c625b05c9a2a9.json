{
  "id": "poem-b53dc8e3ce2c625b05c9a2a9",
  "title": "望岳",
  "author": "杜甫",
  "dynasty": "唐",
  "verses": [
    "岱宗夫如何，齐鲁青未了。",
    "造化钟神秀，阴阳割昏晓。",
    "荡胷生曾云，决眦入归鸟。",
    "会当凌绝顶，一览众山小。"
  ],
  "enabled": true,
