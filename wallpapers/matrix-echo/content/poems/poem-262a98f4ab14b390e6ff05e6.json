{
  "id": "poem-262a98f4ab14b390e6ff05e6",
  "title": "感兴临蕃驯雁",
  "author": "佚名",
  "dynasty": "唐",
  "verses": [
    "感兹驯雁色苍苍，徘徊顾步貌昂昂。",
    "不见衔芦避缯缴，空闻落翮困堤塘。",
    "差池为失衡（原作「冲」）阳伴，邂逅飘零虏塞傍。",
    "引颈长鸣望云路，何时刷羽接归行。"
  ],
  "enabled": true,
