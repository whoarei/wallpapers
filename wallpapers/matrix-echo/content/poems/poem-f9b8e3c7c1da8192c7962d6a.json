{
  "id": "poem-f9b8e3c7c1da8192c7962d6a",
  "title": "和吴可权长官",
  "author": "廖正一",
  "dynasty": "宋",
  "verses": [
    "士元应展骥，百里聊尔绊。",
    "函继三异声，江述凭东观。"
  ],
