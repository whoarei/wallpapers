{
  "id": "poem-a89c434c94965f4f78bf0db2",
  "title": "传婆井",
  "author": "吕从庆",
  "dynasty": "唐",
  "verses": [
    "古井无渊源，千秋自涵养。",
    "日暮汲人来，洞然发清响。"
  ],
  "enabled": true,
