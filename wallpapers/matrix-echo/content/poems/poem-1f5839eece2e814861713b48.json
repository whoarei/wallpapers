{
  "id": "poem-1f5839eece2e814861713b48",
  "title": "浣溪沙·雨歇梧桐泪乍收",
  "author": "纳兰性德",
  "dynasty": "清",
  "verses": [
    "雨歇梧桐泪乍收，遣怀翻自忆从头。",
    "摘花销恨旧风流。",
    "帘影碧桃人已去，屧痕苍藓径空留。",
    "两眉何处月如钩。"
  ],
  "enabled": true,
  "collection": "纳兰词",
