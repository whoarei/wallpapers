{
  "id": "poem-35481a79644a729c21856e03",
  "title": "和令狐侍郎郭郎中题项羽庙",
  "author": "孟郊",
  "dynasty": "唐",
  "verses": [
    "碧草凌古庙，清尘锁秋窗。",
    "当时独宰割，猛志谁能降。",
    "鼓气雷作敌，劒光电为双。",
    "新悲徒自起，旧恨空浮江。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
