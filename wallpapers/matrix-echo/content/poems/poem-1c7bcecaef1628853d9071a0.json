{
  "id": "poem-1c7bcecaef1628853d9071a0",
  "title": "王昭君",
  "author": "崔国辅",
  "dynasty": "唐",
  "verses": [
    "一回望月一回悲，望月月移人不移。",
    "何时得见汉朝使，为妾传书斩画师。"
  ],
  "enabled": true,
