{
  "id": "poem-7d66769b6aeb183360e23d83",
  "title": "正月十五日",
  "author": "熊孺登",
  "dynasty": "唐",
  "verses": [
    "汉家遗事今宵见，楚郭明灯几处张。",
    "深夜行歌声绝后，紫姑神下月苍苍。"
  ],
  "enabled": true,
