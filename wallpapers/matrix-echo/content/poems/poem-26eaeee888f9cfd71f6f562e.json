{
  "id": "poem-26eaeee888f9cfd71f6f562e",
  "title": "追和贾浪仙古镜",
  "author": "徐夤",
  "dynasty": "唐",
  "verses": [
    "谁开黄帝桥山冢，明月飞光出九泉。",
    "狼藉藓痕磨不尽，黑云残点污秋天。"
  ],
  "enabled": true,
