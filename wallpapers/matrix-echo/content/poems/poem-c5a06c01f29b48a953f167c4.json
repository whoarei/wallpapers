{
  "id": "poem-c5a06c01f29b48a953f167c4",
  "title": "登游齐山",
  "author": "许坚",
  "dynasty": "宋",
  "verses": [
    "星使南驰入楚重，此山偏得驻行踪。",
    "落花满地月华冷，寂寞旧山三四峰。"
  ],
  "enabled": true,
  "collection": "宋诗选",
