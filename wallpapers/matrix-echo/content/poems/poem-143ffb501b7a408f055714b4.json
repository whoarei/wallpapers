{
  "id": "poem-143ffb501b7a408f055714b4",
  "title": "粤俗",
  "author": "谢景初",
  "dynasty": "宋",
  "verses": [
    "粤俗嗜海物，鳞介无一遗。",
    "虾蠃味已厚，况乃蟹与蜞。",
    "潮来浦屿涨，遮捕张藩篱。",
    "潮去沙满滩，拾掇盈篱箕。",
    "杀烹数莫记，琐碎臭且奇。",
    "苟务贪咀嚼，宁识暴殄悲。",
    "蛟蜃吐云气，腹以人为饴。",
    "呀口日肥大，洪波谁敢窥。"
  ],
  "enabled": true,
  "collection": "宋诗选",
