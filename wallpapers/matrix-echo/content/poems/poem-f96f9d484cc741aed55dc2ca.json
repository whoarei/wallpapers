{
  "id": "poem-f96f9d484cc741aed55dc2ca",
  "title": "扈从登封途中作",
  "author": "宋之问",
  "dynasty": "唐",
  "verses": [
    "帐殿郁崔嵬，仙游实壮哉！",
    "晓云连幕卷，夜火杂星回。",
    "谷暗千旗出，山鸣万乘来。",
    "扈从良可赋，终乏掞天才。"
  ],
  "enabled": true,
  "collection": "千家诗",
  "tags": [],
