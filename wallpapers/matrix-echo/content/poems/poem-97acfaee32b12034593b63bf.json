{
  "id": "poem-97acfaee32b12034593b63bf",
  "title": "发刘郎浦",
  "author": "杜甫",
  "dynasty": "唐",
  "verses": [
    "挂帆早发刘郎浦，疾风飒飒昏亭午。",
    "舟中无日不沙尘，岸上空村尽豺虎。",
    "十日北风风未回，客行岁晚晚相催。",
    "白头厌伴渔人宿，黄帽青鞋归去来。"
  ],
  "enabled": true,
