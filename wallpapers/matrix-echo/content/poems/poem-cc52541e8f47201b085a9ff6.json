{
  "id": "poem-cc52541e8f47201b085a9ff6",
  "title": "和李舍人直中书对月见寄",
  "author": "李端",
  "dynasty": "唐",
  "verses": [
    "名卿步月正淹留，上客裁诗怨别游。",
    "素魄近成班女扇，清光远似庾公楼。",
    "婵娟更称凭高望，皎洁能传自古愁。",
    "盈手入怀皆不见，阳春曲丽转难酬。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
