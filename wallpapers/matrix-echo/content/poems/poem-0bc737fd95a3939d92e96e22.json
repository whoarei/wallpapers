{
  "id": "poem-0bc737fd95a3939d92e96e22",
  "title": "竹枝歌  其九",
  "author": "孙嵩",
  "dynasty": "宋",
  "verses": [
    "峡山削出青嵯峨，峡水匀成绿不波。",
    "顿平山林未能得，奈此猿声朝夕何。"
  ],
  "enabled": true,
  "collection": "宋诗选",
