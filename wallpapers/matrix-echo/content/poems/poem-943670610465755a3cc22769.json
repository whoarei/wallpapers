{
  "id": "poem-943670610465755a3cc22769",
  "title": "山中酬人",
  "author": "张籍",
  "dynasty": "唐",
  "verses": [
    "山中日暖春鸠鸣，逐水看花任意行。",
    "向晚归来石窗下，菖蒲叶上见题名。"
  ],
  "enabled": true,
