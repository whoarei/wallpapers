{
  "id": "poem-f770414e54f454a2c158f90d",
  "title": "千里思",
  "author": "李端",
  "dynasty": "唐",
  "verses": [
    "凉州风月美，遥望居延路。",
    "泛泛下天云，青青缘塞树。",
    "燕山苏武上，海岛田横住。",
    "更是草生时，行人出门去。"
  ],
  "enabled": true,
