{
  "id": "poem-9fbfc6c4e389216ec011f011",
  "title": "送宣州丘判官",
  "author": "徐铉",
  "dynasty": "宋",
  "verses": [
    "宪署游从阻，平台道路赊。",
    "喜君驰后乘，于此会仙槎。",
    "缓酌迟飞盖，微吟望绮霞。",
    "相迎在春渚，暂别莫咨嗟。"
  ],
  "enabled": true,
  "collection": "宋诗选",
