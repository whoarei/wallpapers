{
  "id": "poem-fa9d344ae0b60e9aec21c5cb",
  "title": "送朱大入秦",
  "author": "王维",
  "dynasty": "唐",
  "verses": [
    "避人五陵去，宝剑值千金。",
    "分手脱相赠，平生一片心。"
  ],
  "enabled": true,
