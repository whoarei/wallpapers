{
  "id": "poem-93c0f237d312731d5d70f800",
  "title": "偈",
  "author": "丰禅师",
  "dynasty": "唐",
  "verses": [
    "骏马机前异，游人肘后悬。",
    "既参云外客，试为老僧看。",
    "（《景德传灯录》卷二十三、《五灯会元》卷十五）。"
  ],
