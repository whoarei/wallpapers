{
  "id": "poem-9ff1ec882ea8fa6220dd23d7",
  "title": "春梦",
  "author": "王镃",
  "dynasty": "宋",
  "verses": [
    "东风敲碎玉阑干，蝴蝶纷飞梦欲残。",
    "翠被压床银烛暗，夜深谁问海棠寒。"
  ],
  "enabled": true,
  "collection": "宋诗选",
