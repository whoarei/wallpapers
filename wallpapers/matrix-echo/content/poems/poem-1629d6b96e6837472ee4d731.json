{
  "id": "poem-1629d6b96e6837472ee4d731",
  "title": "寄贯休",
  "author": "裴说",
  "dynasty": "唐",
  "verses": [
    "忆昔与吾师，山中静论时。",
    "总无方是法，难得始为诗。",
    "冻犬眠干叶，饥禽啄病梨。",
    "他年白莲社，犹许重相期。"
  ],
  "enabled": true,
