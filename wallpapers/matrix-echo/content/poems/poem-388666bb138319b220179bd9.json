{
  "id": "poem-388666bb138319b220179bd9",
  "title": "敦煌廿咏（并序） 二十、分流泉咏",
  "author": "敦煌人作品[一]",
  "dynasty": "唐",
  "verses": [
    "地涌澄泉美，环城本自奇。",
    "一源分异派，两道入汤池。",
    "波上青苹合，洲前翠柳垂。",
    "况逢佳景处，从此遂忘疲。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
