{
  "id": "poem-7941d60d40250738c89b5780",
  "title": "遇边使",
  "author": "卢殷",
  "dynasty": "唐",
  "verses": [
    "累年无的信，每夜梦边城。",
    "袖掩千行泪，书封一尺情。"
  ],
  "enabled": true,
