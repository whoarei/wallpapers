{
  "id": "poem-961646d112cbb268c37d759c",
  "title": "移梅",
  "author": "赵崇嶓",
  "dynasty": "宋",
  "verses": [
    "邻家争乞丽春栽，玉手轻分带月培。",
    "窗下老翁迂入骨，清斋三日为移梅。"
  ],
  "enabled": true,
  "collection": "宋诗选",
