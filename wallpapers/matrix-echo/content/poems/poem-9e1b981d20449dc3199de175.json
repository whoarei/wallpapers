{
  "id": "poem-9e1b981d20449dc3199de175",
  "title": "送裘父姪还乡二首  其二",
  "author": "曾协",
  "dynasty": "宋",
  "verses": [
    "尘外情怀得自由，便携琴鹤上归舟。",
    "露寒月白关心夜，山瘦江清满意秋。",
    "却背京城无眷恋，去寻古迹有迟留。",
    "奚奴莫厌诗囊满，重纪山川烂漫游。"
  ],
  "enabled": true,
  "collection": "宋诗选",
