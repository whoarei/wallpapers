{
  "id": "poem-0f22fa38d1c959776199a1e2",
  "title": "易水送别",
  "author": "骆宾王",
  "dynasty": "唐",
  "verses": [
    "此地别燕丹，壮士发冲冠。",
    "昔时人已没，今日水犹寒。"
  ],
  "enabled": true,
  "collection": "千家诗",
