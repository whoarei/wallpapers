{
  "id": "poem-8fc9ae9f5b24ab3d750ed6c6",
  "title": "酬王哦松八景  其七",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "雨后双螺对绾青，采毫曾此蘸中泠。",
    "冩成九派分流势，不冩当年瘗鹤铭。"
  ],
  "enabled": true,
  "collection": "宋诗选",
