{
  "id": "poem-75d61446895512ea1c6cdf16",
  "title": "麟之趾",
  "author": "佚名",
  "dynasty": "先秦",
  "verses": [
    "麟之趾，振振公子，于嗟麟兮。",
    "麟之定，振振公姓，于嗟麟兮。",
    "麟之角，振振公族，于嗟麟兮。"
  ],
  "enabled": true,
  "collection": "诗经",
