{
  "id": "poem-8771d2e3f3ee235a26a7d946",
  "title": "冬尽",
  "author": "吕从庆",
  "dynasty": "唐",
  "verses": [
    "一年惟腊在，忽忽又将央。",
    "雪重庭枝折，风轻径蘂香。",
    "感时空有恨，留岁竟无方。",
    "老矣当樽客，他乡作故乡。"
  ],
  "enabled": true,
