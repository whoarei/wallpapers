{
  "id": "poem-f67812ef8448671d1849fc7d",
  "title": "闺怨",
  "author": "王昌龄",
  "dynasty": "唐",
  "verses": [
    "闺中少妇不曾愁，春日凝妆上翠楼。",
    "忽见陌头杨柳色，悔教夫壻觅封侯。"
  ],
  "enabled": true,
