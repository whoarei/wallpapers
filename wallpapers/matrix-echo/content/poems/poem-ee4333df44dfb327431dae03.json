{
  "id": "poem-ee4333df44dfb327431dae03",
  "title": "侍宴赋得归雁",
  "author": "徐铉",
  "dynasty": "宋",
  "verses": [
    "夜静群动息，翩翩一雁归。",
    "清音天际远，寒影月中微。",
    "何处云同宿，长空雪共飞。",
    "阳和常借便，免与素心违。"
  ],
  "enabled": true,
  "collection": "宋诗选",
