{
  "id": "poem-bca3c402c7bd282880ccd5f4",
  "title": "扬州",
  "author": "鲜于侁",
  "dynasty": "宋",
  "verses": [
    "金山一拳石，出髻如溟涨。",
    "天外辨两潮，江南分列嶂。"
  ],
  "enabled": true,
