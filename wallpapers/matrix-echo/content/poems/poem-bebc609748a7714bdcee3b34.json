{
  "id": "poem-bebc609748a7714bdcee3b34",
  "title": "漫书五首 一",
  "author": "司空图",
  "dynasty": "唐",
  "verses": [
    "长拟求闲未得闲，又劳行役出秦关。",
    "逢人渐觉乡音异，却恨莺声似故山。"
  ],
  "enabled": true,
