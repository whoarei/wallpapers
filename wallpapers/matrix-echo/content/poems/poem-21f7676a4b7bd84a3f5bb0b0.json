{
  "id": "poem-21f7676a4b7bd84a3f5bb0b0",
  "title": "酬谢寺丞",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "厥月维良庆佛生，诞弥随佛际昌明。",
    "循良既负剑南最，枉直暂丞天下平。",
    "池草自随新句好，砌兰长傍故家荣。",
    "当年骈俪归弹压，今日丝纶要老成。"
  ],
  "enabled": true,
  "collection": "宋诗选",
