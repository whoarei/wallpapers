{
  "id": "poem-9089becaa2d23c5666dfd435",
  "title": "贫交行",
  "author": "杜甫",
  "dynasty": "唐",
  "verses": [
    "飜手作云覆手雨，纷纷轻薄何须数。",
    "不见管鲍贫时交，此道今人弃如土。"
  ],
  "enabled": true,
