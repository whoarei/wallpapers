{
  "id": "poem-6dfad5ed004ff985df88f12a",
  "title": "效古",
  "author": "澹交",
  "dynasty": "唐",
  "verses": [
    "荣辱又荣辱，一何翻与覆。",
    "人生百岁中，孰肯死前足。",
    "玄鬓忽如丝，青丛不再绿。",
    "自古争名徒，黄金是谁禄。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
