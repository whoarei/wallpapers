{
  "id": "poem-f9d98d0eb88520a6fb2b061a",
  "title": "乌夜啼",
  "author": "聂夷中",
  "dynasty": "唐",
  "verses": [
    "众鸟各归枝，乌乌尔不栖。",
    "还应知妾恨，故向绿窗啼。"
  ],
  "enabled": true,
