{
  "id": "poem-7f49fe4630f9aef163779ec6",
  "title": "塞下曲 四",
  "author": "李益",
  "dynasty": "唐",
  "verses": [
    "为报如今都护雄，匈奴且莫下云中。",
    "请书塞北阴山石，愿比燕然车骑功。"
  ],
