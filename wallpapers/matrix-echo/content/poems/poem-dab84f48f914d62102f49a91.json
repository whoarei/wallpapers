{
  "id": "poem-dab84f48f914d62102f49a91",
  "title": "送雍郢州",
  "author": "李端",
  "dynasty": "唐",
  "verses": [
    "厌郎思出守，遂领汉东军。",
    "望月逢殷浩，缘江送范云。",
    "城闲烟草遍，浦逈雪林分。",
    "谁伴楼中宿，吟诗估客闻。"
  ],
  "enabled": true,
