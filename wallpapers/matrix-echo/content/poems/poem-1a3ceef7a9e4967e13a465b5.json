{
  "id": "poem-1a3ceef7a9e4967e13a465b5",
  "title": "送崔判官还扬子",
  "author": "皎然",
  "dynasty": "唐",
  "verses": [
    "轻传祗远役，依依下姑亭。",
    "秋声满杨柳，暮色绕郊坰。",
    "烟水摇归思，山当楚驿青。"
  ],
  "enabled": true,
