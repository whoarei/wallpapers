{
  "id": "poem-0c72570783d6432228955820",
  "title": "寄所知",
  "author": "李咸用",
  "dynasty": "唐",
  "verses": [
    "曾将俎豆为儿戏，争奈干戈阻素心。",
    "遁去不同秦客逐，病来还作越人吟。",
    "名流古集典衣买，僻寺奇花贳酒寻。",
    "从道趣时身计拙，如非所好肯开襟。"
  ],
  "enabled": true,
