{
  "id": "poem-aaace12baf10b4b0b2e3f0b0",
  "title": "过宋州",
  "author": "李端",
  "dynasty": "唐",
  "verses": [
    "睢阳陷虏日，外绝救兵来。",
    "世乱忠臣死，时清明主哀。",
    "荒郊春草徧，故垒野花开。",
    "欲为将军哭，东流水不回。"
  ],
  "enabled": true,
