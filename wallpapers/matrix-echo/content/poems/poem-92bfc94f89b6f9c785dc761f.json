{
  "id": "poem-92bfc94f89b6f9c785dc761f",
  "title": "横吹曲辞 折杨柳",
  "author": "张祜",
  "dynasty": "唐",
  "verses": [
    "红粉青楼曙，垂杨仲月春。",
    "怀君重攀折，非妾妒腰身。",
    "舞带萦丝断，娇娥向叶嚬。",
    "横吹凡几曲，独自最愁人。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
