{
  "id": "poem-9aafdc2fcde71a8e000451e2",
  "title": "边城听角",
  "author": "李咸用",
  "dynasty": "唐",
  "verses": [
    "戍楼鸣画角，寒露滴金枪。",
    "细引云成阵，高催雁著行。",
    "唤回边将梦，吹薄晓蟾光。",
    "未遂终军志，何劳思故乡。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
