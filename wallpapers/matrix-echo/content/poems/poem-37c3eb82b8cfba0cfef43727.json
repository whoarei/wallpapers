{
  "id": "poem-37c3eb82b8cfba0cfef43727",
  "title": "同皇甫冉登重玄阁",
  "author": "李嘉祐",
  "dynasty": "唐",
  "verses": [
    "高阁朱栏不厌游，蒹葭白水遶长洲。",
    "孤云独鸟川光暮，万井千山海色秋。",
    "清梵林中人转静，夕阳城上角偏愁。",
    "谁怜远作秦吴别，离恨归心双泪流。"
  ],
  "enabled": true,
