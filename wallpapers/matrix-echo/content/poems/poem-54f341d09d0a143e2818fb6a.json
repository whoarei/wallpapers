{
  "id": "poem-54f341d09d0a143e2818fb6a",
  "title": "资圣院",
  "author": "孙谔",
  "dynasty": "宋",
  "verses": [
    "四山藏一寺，方丈压诸峰。",
    "回首坐禅处，白云深几重。"
  ],
