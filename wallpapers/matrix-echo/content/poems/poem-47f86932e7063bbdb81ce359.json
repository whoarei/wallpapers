{
  "id": "poem-47f86932e7063bbdb81ce359",
  "title": "咏𡱈",
  "author": "张𬸦",
  "dynasty": "唐",
  "verses": [
    "勒腰须巧快，捺脚更风流。",
    "但令细眼合，人自分轮筹。"
  ],
  "enabled": true,
