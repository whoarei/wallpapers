{
  "id": "poem-26708cd3c0c3e966a6898e9b",
  "title": "赠边将",
  "author": "张乔",
  "dynasty": "唐",
  "verses": [
    "将军夸胆气，功在杀人多。",
    "对酒擎钟饮，临风拔劒歌。",
    "翻师平碎叶，掠地取交河。",
    "应笑孔门客，年年羡四科。"
  ],
  "enabled": true,
