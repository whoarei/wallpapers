{
  "id": "poem-e15ced2fbde693e6643bcf1f",
  "title": "椀柏",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "土入花甆浅，林疏雪操鲜。",
    "后凋非地力，独秀是天年。",
    "老我不谐俗，惜才如养贤。",
    "明明千古意，渠自指庭前。"
  ],
  "enabled": true,
  "collection": "宋诗选",
