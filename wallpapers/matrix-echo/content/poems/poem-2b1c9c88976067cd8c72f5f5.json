{
  "id": "poem-2b1c9c88976067cd8c72f5f5",
  "title": "南轩木犀",
  "author": "张栻",
  "dynasty": "宋",
  "verses": [
    "不随秋月閟天香，冰雪丛中见缕黄。",
    "却得清寒惜花地，少须梅影慰孤芳。"
  ],
  "enabled": true,
