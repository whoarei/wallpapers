{
  "id": "poem-e46574bc9a53f7598d3ea520",
  "title": "赠乔侍郎",
  "author": "陈子昂",
  "dynasty": "唐",
  "verses": [
    "汉廷荣巧宦，云阁薄边功。",
    "可怜骢马使，白首为谁雄。"
  ],
