{
  "id": "poem-9039ea784d9c1b8fa8bc3d2e",
  "title": "赠野僧",
  "author": "吕从庆",
  "dynasty": "唐",
  "verses": [
    "有客逃禅住北冈，昔年支许意相当。",
    "清如细竹迎风洒，洁似孤松冒雪张。",
    "锡杖倚雪看远岫，铜瓶汲月煑新汤。",
    "只今石畔双扉掩，静阅琅函日几章。",
    "。"
  ],
  "enabled": true,
