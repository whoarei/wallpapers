{
  "id": "poem-fc0dc2c1557773a2264191af",
  "title": "秋夜寄丘二十二员外",
  "author": "韦应物",
  "dynasty": "唐",
  "verses": [
    "怀君属秋夜，散步咏凉天。",
    "山空松子落，幽人应未眠。"
  ],
  "enabled": true,
