{
  "id": "poem-32ababce88ee8e8fe65414ff",
  "title": "春怨",
  "author": "金昌绪",
  "dynasty": "唐",
  "verses": [
    "打起黄莺儿，莫教枝上啼。",
    "啼时惊妾梦，不得到辽西。"
  ],
  "enabled": true,
