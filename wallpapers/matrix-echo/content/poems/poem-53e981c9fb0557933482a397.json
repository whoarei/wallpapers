{
  "id": "poem-53e981c9fb0557933482a397",
  "title": "听夜泉",
  "author": "刘得仁",
  "dynasty": "唐",
  "verses": [
    "静里层层石，潺湲到鹤林。",
    "流回出几洞，源远历千岑。",
    "寒助空山月，清兼此夜心。",
    "幽人听达曙，相和藓床吟。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
