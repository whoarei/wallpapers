{
  "id": "poem-bab084e8229974492c47f557",
  "title": "早春",
  "author": "白玉蟾",
  "dynasty": "宋",
  "verses": [
    "南枝才放两三花，雪里吟香弄粉些。",
    "淡淡著烟浓著月，深深笼水浅笼沙。"
  ],
  "enabled": true,
  "collection": "千家诗",
