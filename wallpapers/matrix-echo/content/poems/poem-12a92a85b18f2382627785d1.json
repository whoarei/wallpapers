{
  "id": "poem-12a92a85b18f2382627785d1",
  "title": "上冯使君五首 三",
  "author": "贯休",
  "dynasty": "唐",
  "verses": [
    "樵叟无忧苦，地仙亦何别。",
    "茆屋岸花中，弄孙头似雪。"
  ],
  "enabled": true,
