{
  "id": "poem-7cbd202dcc70de553bb919cc",
  "title": "谢侯彦明惠白莲栽  其二",
  "author": "张栻",
  "dynasty": "宋",
  "verses": [
    "青鞋不踏远公社，偶共濂溪嗜好同。",
    "少待薰风开玉镜，与君来赋月明中。"
  ],
