{
  "id": "poem-8f84b1e9fd3de78607edf710",
  "title": "古歌",
  "author": "沈佺期",
  "dynasty": "唐",
  "verses": [
    "落叶流风向玉台，夜寒秋思洞房开。",
    "水晶帘外金波下，云母窗前银汉回。",
    "玉阶阴阴苔藓色，君王屡綦难再得。",
    "璇闺窈窕秋夜长，绣户徘徊明月光。",
    "燕姬彩帐芙蓉色，秦女金炉兰麝香。",
    "北斗七星横夜半，清歌一曲断君肠。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
