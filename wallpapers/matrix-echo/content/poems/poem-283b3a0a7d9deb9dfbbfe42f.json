{
  "id": "poem-283b3a0a7d9deb9dfbbfe42f",
  "title": "哭亦周  其三",
  "author": "赵文",
  "dynasty": "宋",
  "verses": [
    "擢第君王与袍笏，盖棺丞相办深衣。",
    "江南仕宦堪车载，如此全归似汝稀。"
  ],
  "enabled": true,
