{
  "id": "poem-861694da998445e408adff3d",
  "title": "江楼旧感",
  "author": "赵嘏",
  "dynasty": "唐",
  "verses": [
    "独上江楼思渺然，月光如水水如天。",
    "同来望月人何处，风景依稀似去年。"
  ],
  "enabled": true,
