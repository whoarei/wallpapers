{
  "id": "poem-9a36039d4497e5a9a800cef4",
  "title": "上宋使君",
  "author": "贯休",
  "dynasty": "唐",
  "verses": [
    "折桂文如锦，分忧力若春。",
    "位高空倚命，诗妙古无人。",
    "有感禾争熟，无私吏尽贫。",
    "野人如有幸，应得见陶钧。"
  ],
  "enabled": true,
