{
  "id": "poem-9577db15d7ae01202fa269d6",
  "title": "送禀上人游越",
  "author": "皎然",
  "dynasty": "唐",
  "verses": [
    "云泉谁不赏，独见尔情高。",
    "投石轻龙窟，临流笑鹭涛。",
    "折荷为片席，洒水净方袍。",
    "剡路逢禅侣，多应问我曹。"
  ],
  "enabled": true,
