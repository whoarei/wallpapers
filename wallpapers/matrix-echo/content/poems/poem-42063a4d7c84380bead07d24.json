{
  "id": "poem-42063a4d7c84380bead07d24",
  "title": "经王处士原居",
  "author": "张籍",
  "dynasty": "唐",
  "verses": [
    "旧宅谁相近，唯僧近竹关。",
    "庭闲云满井，窗晓雪通山。",
    "来客半留宿，借书多寄还。",
    "明时未中岁，莫便一生闲。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
