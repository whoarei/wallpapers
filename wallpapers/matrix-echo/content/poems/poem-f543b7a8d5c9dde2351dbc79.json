{
  "id": "poem-f543b7a8d5c9dde2351dbc79",
  "title": "含笑花五首  其二",
  "author": "李纲",
  "dynasty": "宋",
  "verses": [
    "玉质犹披翡翠裳，温泉浴罢蔼天香。",
    "回眸百媚嫣然处，羞死三千红粉粧。"
  ],
  "enabled": true,
