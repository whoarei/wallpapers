{
  "id": "poem-1d002cc41d90c65b98cb680f",
  "title": "颂古三十一首  其二六",
  "author": "释安永",
  "dynasty": "宋",
  "verses": [
    "独向沧溟截众流，等闲舞棹掷金钩。",
    "白云不露烟波阔，横笛一声天地秋。"
  ],
  "enabled": true,
