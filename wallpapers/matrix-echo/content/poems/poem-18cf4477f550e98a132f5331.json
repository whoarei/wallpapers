{
  "id": "poem-18cf4477f550e98a132f5331",
  "title": "夜月独坐二绝句  其一",
  "author": "李纲",
  "dynasty": "宋",
  "verses": [
    "冰轮杳杳碾层空，独坐凄然秋色中。",
    "深院无人共清景，静闻金井落梧桐。"
  ],
  "enabled": true,
  "collection": "宋诗选",
