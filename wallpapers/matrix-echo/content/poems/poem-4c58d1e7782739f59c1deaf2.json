{
  "id": "poem-4c58d1e7782739f59c1deaf2",
  "title": "湖上",
  "author": "王同祖",
  "dynasty": "宋",
  "verses": [
    "湖头春水千丈碧，湖堤袅柳不盈尺。",
    "唱歌女儿棹船回，惊起沙鸥对对立。"
  ],
  "enabled": true,
  "collection": "宋诗选",
