{
  "id": "poem-cfe006a00a13137999094d66",
  "title": "盛山十二诗 流桮渠",
  "author": "韦处厚",
  "dynasty": "唐",
  "verses": [
    "激曲萦飞箭，浮沟泛满巵。",
    "将来山太守，早向习家池。"
  ],
