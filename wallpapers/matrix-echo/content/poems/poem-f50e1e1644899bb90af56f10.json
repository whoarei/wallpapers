{
  "id": "poem-f50e1e1644899bb90af56f10",
  "title": "过庆宝寺",
  "author": "司空曙",
  "dynasty": "唐",
  "verses": [
    "黄叶前朝寺，无僧寒殿开。",
    "池晴龟出曝，松暮鹤飞回。",
    "古井碑横草，阴廊画杂苔。",
    "禅宫亦销歇，尘世转堪哀。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
