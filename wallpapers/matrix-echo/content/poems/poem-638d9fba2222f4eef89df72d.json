{
  "id": "poem-638d9fba2222f4eef89df72d",
  "title": "春秋战国门 哀公",
  "author": "周昙",
  "dynasty": "唐",
  "verses": [
    "贤为邻用国忧危，庙算无非委艳奇。",
    "两叶翠娥春乍展，一毛须去不难吹。"
  ],
  "enabled": true,
