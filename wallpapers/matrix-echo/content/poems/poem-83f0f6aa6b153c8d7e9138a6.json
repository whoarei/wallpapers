{
  "id": "poem-83f0f6aa6b153c8d7e9138a6",
  "title": "旅兴",
  "author": "王琮",
  "dynasty": "宋",
  "verses": [
    "经年客食向京华，懒对春风祇忆家。",
    "觉道近来全俗了，略无一语及梅花。"
  ],
  "enabled": true,
