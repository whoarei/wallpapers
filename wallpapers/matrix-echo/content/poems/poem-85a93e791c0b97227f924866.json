{
  "id": "poem-85a93e791c0b97227f924866",
  "title": "子衿",
  "author": "佚名",
  "dynasty": "先秦",
  "verses": [
    "青青子衿，悠悠我心。纵我不往，子宁不嗣音？",
    "青青子佩，悠悠我思。纵我不往，子宁不来？",
    "挑兮达兮，在城阙兮。一日不见，如三月兮。"
  ],
  "enabled": true,
  "collection": "诗经",
  "tags": [],
  "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/诗经/shijing.json#record-90"
