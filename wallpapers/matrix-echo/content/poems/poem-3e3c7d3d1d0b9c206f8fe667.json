{
  "id": "poem-3e3c7d3d1d0b9c206f8fe667",
  "title": "春恨三首 三",
  "author": "钱珝",
  "dynasty": "唐",
  "verses": [
    "永巷频闻小苑游，旧恩如泪亦难收。",
    "君前愿报新颜色，团扇须防白露秋。"
  ],
