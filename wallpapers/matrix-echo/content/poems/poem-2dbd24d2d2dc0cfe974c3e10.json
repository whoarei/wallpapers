{
  "id": "poem-2dbd24d2d2dc0cfe974c3e10",
  "title": "宿严陵钓台",
  "author": "神颖",
  "dynasty": "唐",
  "verses": [
    "寒谷荒台七里洲，贤人永逐水东流。",
    "独猿叫断青天月，千古冥冥潭树秋。"
  ],
  "enabled": true,
