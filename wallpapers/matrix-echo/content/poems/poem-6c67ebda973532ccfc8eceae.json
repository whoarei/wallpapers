{
  "id": "poem-6c67ebda973532ccfc8eceae",
  "title": "吊建州李员外",
  "author": "曹松",
  "dynasty": "唐",
  "verses": [
    "铭旌归故里，猿鸟亦凄然。",
    "已葬桐江月，空廻建水船。",
    "客传为郡日，僧说读书年。",
    "恐有吟魂在，深山古木边。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
