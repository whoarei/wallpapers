{
  "id": "poem-999a7e8f868030eba83b46e4",
  "title": "登兖州城楼",
  "author": "杜甫",
  "dynasty": "唐",
  "verses": [
    "东郡趋庭日，南楼纵目初。",
    "浮云连海岳，平野入青徐。",
    "孤嶂秦碑在，荒城鲁殿余。",
    "从来多古意，临眺独踌躇。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
