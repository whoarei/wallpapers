{
  "id": "poem-2ed1fac1a5f612cfe359be44",
  "title": "清平乐·风光紧急",
  "author": "朱淑真",
  "dynasty": "宋",
  "verses": [
    "风光紧急。",
    "三月俄三十。",
    "拟欲留连计无及。",
    "绿野烟愁露泣。",
    "倩谁寄语春宵。",
    "城头画鼓轻敲。",
    "缱绻临歧嘱付，来年早到梅梢。"
  ],
  "enabled": true,
  "collection": "宋词选",
  "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/宋词/ci.song.8000.json#record-868",
