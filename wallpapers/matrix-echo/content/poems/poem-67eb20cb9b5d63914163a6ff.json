{
  "id": "poem-67eb20cb9b5d63914163a6ff",
  "title": "三月过行宫",
  "author": "李贺",
  "dynasty": "唐",
  "verses": [
    "渠水红繁拥御墙，风娇小叶学娥妆。",
    "垂帘几度青春老，堪锁千年白日长。"
  ],
