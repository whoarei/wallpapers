{
  "id": "poem-adcece87b15367ccfac8f85a",
  "title": "冬晚对雪忆胡居士家",
  "author": "王维",
  "dynasty": "唐",
  "verses": [
    "寒更传晓箭，清镜览衰颜。",
    "隔牖风惊竹，开门雪满山。",
    "洒空深巷静，积素广庭闲。",
    "借问袁安舍，翛然尚闭关。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
  "tags": [
    "思念",
    "写雪",
    "冬天",
    "雪"
  ],
