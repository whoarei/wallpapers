{
  "id": "poem-f9e8015f681c113a7387befa",
  "title": "暮春即事",
  "author": "王镃",
  "dynasty": "宋",
  "verses": [
    "卖花声断雨蒙蒙，怯酒情怀易得中。",
    "燕子自来还自去，胭脂吹老海棠风。"
  ],
  "enabled": true,
