{
  "id": "poem-7dde1e8ae467dfa19001a67f",
  "title": "寄旧友二首  其二",
  "author": "宋伯仁",
  "dynasty": "宋",
  "verses": [
    "微官宁得似穷儒，俛首逢迎气不舒。",
    "便是伐薪能煮海，何如烧叶自观书。",
    "半蓬寒雨苕溪酒，一线西风震泽鱼。",
    "但得此身无系束，江南有地著顽疎。"
  ],
  "enabled": true,
  "collection": "宋诗选",
