{
  "id": "poem-57dcbd690ff358d189b2641f",
  "title": "初食荔枝  其二",
  "author": "张栻",
  "dynasty": "宋",
  "verses": [
    "照水依山祇自奇，晞风沐雨借光辉。",
    "冰肌不受红尘涴，赪颊从教酒晕肥。"
  ],
  "enabled": true,
  "collection": "宋诗选",
