{
  "id": "poem-de9c79005eb3dfb3a216b690",
  "title": "重题",
  "author": "李德裕",
  "dynasty": "唐",
  "verses": [
    "晚日临寒渚，微风发櫂讴。",
    "凤池波自阔，鱼水运难留。",
    "亭古思宏栋，川长忆夜舟。",
    "想公高世志，祗似冶城游。"
  ],
  "enabled": true,
