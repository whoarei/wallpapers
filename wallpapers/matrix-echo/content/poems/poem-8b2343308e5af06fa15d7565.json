{
  "id": "poem-8b2343308e5af06fa15d7565",
  "title": "咏史诗 居延",
  "author": "胡曾",
  "dynasty": "唐",
  "verses": [
    "漠漠平沙际碧天，问人云此是居延。",
    "停骖一顾犹魂断，苏武争禁十九年。"
  ],
  "enabled": true,
