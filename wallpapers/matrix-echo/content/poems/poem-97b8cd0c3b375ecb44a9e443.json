{
  "id": "poem-97b8cd0c3b375ecb44a9e443",
  "title": "宿广德寺寄从舅",
  "author": "张籍",
  "dynasty": "唐",
  "verses": [
    "古寺客堂空，开帘四面风。",
    "移床动栖鹤，停烛聚飞虫。",
    "闲卧逐凉处，远愁生静中。",
    "林西微月色，思与宁家同。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
