{
  "id": "poem-028dcb2d1a6cf9cd3cce2025",
  "title": "郡斋宴坐",
  "author": "张公庠",
  "dynasty": "宋",
  "verses": [
    "为州容散诞，真慰野人情。",
    "撼膝禅初悟，摇头句未成。",
    "试香秋院静，斗墨午窗明。",
    "已有东归计，柴扉掩姓名。"
  ],
  "enabled": true,
  "collection": "宋诗选",
