{
  "id": "poem-6627f082080d3251a07c5b41",
  "title": "书琵琶背",
  "author": "后主煜",
  "dynasty": "唐",
  "verses": [
    "侁自肩如削，难胜数缕绦。",
    "天香留凤尾，余煖在檀槽。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
