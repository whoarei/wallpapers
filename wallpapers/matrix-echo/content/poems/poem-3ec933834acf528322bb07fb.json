{
  "id": "poem-3ec933834acf528322bb07fb",
  "title": "送人归黔府",
  "author": "司空曙",
  "dynasty": "唐",
  "verses": [
    "伏波箫鼓水云中，长戟如霜大斾红。",
    "油幕晓开飞鸟绝，翩翩上将独趋风。"
  ],
  "enabled": true,
