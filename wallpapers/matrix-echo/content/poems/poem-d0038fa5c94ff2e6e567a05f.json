{
  "id": "poem-d0038fa5c94ff2e6e567a05f",
  "title": "颂古三十一首  其六",
  "author": "释玿",
  "dynasty": "宋",
  "verses": [
    "大雄山下老狐精，千古丛林恼杀人。",
    "若遇金毛师子子，看伊无处著浑身。"
  ],
