{
  "id": "poem-8f2ed26906bcc51dced05fc4",
  "title": "终南别业",
  "author": "王维",
  "dynasty": "唐",
  "verses": [
    "中岁颇好道，晚家南山陲。",
    "兴来每独往，胜事空自知。",
    "行到水穷处，坐看云起时。",
    "偶然值林叟，谈笑无还期。"
  ],
  "enabled": true,
