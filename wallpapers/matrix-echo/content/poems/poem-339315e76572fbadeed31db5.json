{
  "id": "poem-339315e76572fbadeed31db5",
  "title": "听晓角",
  "author": "李益",
  "dynasty": "唐",
  "verses": [
    "边霜昨夜堕关榆，吹角当城汉月孤。",
    "无限塞鸿飞不度，秋风卷入小单于。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
