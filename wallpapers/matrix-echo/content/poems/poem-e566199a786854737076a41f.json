{
  "id": "poem-e566199a786854737076a41f",
  "title": "回中夜访独孤从事",
  "author": "刘得仁",
  "dynasty": "唐",
  "verses": [
    "满庭霜月魄，风静绝纤闻。",
    "边境时无事，州城夜访君。",
    "拥裘听塞角，酌醴话湘云。",
    "赞佐元戎美，恩齐十万军。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
