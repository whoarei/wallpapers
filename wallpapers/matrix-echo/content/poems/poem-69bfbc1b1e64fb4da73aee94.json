{
  "id": "poem-69bfbc1b1e64fb4da73aee94",
  "title": "婕妤怨",
  "author": "皇甫冉",
  "dynasty": "唐",
  "verses": [
    "花枝出建章，凤管发昭阳。",
    "借问承恩者，双蛾几许长？"
  ],
  "enabled": true,
