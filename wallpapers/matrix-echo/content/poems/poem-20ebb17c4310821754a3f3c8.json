{
  "id": "poem-20ebb17c4310821754a3f3c8",
  "title": "南海子·红桥夹岸柳平分",
  "author": "纳兰性德",
  "dynasty": "清",
  "verses": [
    "红桥夹岸柳平分，雉兔年年不掩群。",
    "飞放何须烦海户，郊南新置羽林军。"
  ],
  "enabled": true,
