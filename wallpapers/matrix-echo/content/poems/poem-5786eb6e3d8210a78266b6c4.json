{
  "id": "poem-5786eb6e3d8210a78266b6c4",
  "title": "芣苡",
  "author": "佚名",
  "dynasty": "先秦",
  "verses": [
    "采采芣苡，薄言采之。采采芣苡，薄言有之。",
    "采采芣苡，薄言掇之。采采芣苡，薄言捋之。",
    "采采芣苡，薄言袺之。采采芣苡，薄言襭之。"
  ],
  "enabled": true,
  "collection": "诗经",
  "tags": [],
