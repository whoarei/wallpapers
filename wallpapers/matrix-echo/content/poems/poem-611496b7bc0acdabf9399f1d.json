{
  "id": "poem-611496b7bc0acdabf9399f1d",
  "title": "春秋战国门 鬻拳",
  "author": "周昙",
  "dynasty": "唐",
  "verses": [
    "鬻拳强谏惧威刑，退省怀慙不顾生。",
    "双刖忍行留痛恨，惟君适足见忠诚。"
  ],
  "enabled": true,
