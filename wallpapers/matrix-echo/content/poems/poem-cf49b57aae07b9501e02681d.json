{
  "id": "poem-cf49b57aae07b9501e02681d",
  "title": "和谢舍人雪夜寓直",
  "author": "皇甫曾",
  "dynasty": "唐",
  "verses": [
    "禁省夜沈沈，春风雪满林。",
    "沧洲归客梦，青琐近臣心。",
    "挥翰宣鸣玉，承恩在赐金。",
    "建章寒漏起，更助掖垣深。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
