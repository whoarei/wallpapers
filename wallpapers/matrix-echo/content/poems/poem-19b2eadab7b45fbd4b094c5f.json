{
  "id": "poem-19b2eadab7b45fbd4b094c5f",
  "title": "菩萨蛮 其一",
  "author": "温庭筠",
  "dynasty": "唐",
  "verses": [
    "小山重叠金明灭，鬓云欲度香腮雪。",
    "懒起画蛾眉，弄妆梳洗迟。",
    "照花前后镜，花面交相映。",
    "新帖绣罗襦，双双金鹧鸪。"
  ],
  "enabled": true,
  "collection": "花间集",
  "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/五代诗词/huajianji/huajianji-1-juan.json#record-0",
