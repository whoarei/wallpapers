{
  "id": "poem-1978360758bb7fefcee1c563",
  "title": "浪淘沙·帘外微风",
  "author": "杜安世",
  "dynasty": "宋",
  "verses": [
    "帘外微风。",
    "云雨回踪。",
    "银釭烬冷锦帏中。",
    "枕上深盟，年少心事，陡顿成空。",
    "岭外白头翁。",
    "到没由逢。",
    "一床鸳被叠香红。",
    "明月满庭花似绣，闷不见虫虫。"
  ],
  "enabled": true,
  "collection": "宋词选",
