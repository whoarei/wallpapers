{
  "id": "poem-a7c4d2469a86decf289e0ce3",
  "title": "送曾裘父",
  "author": "张栻",
  "dynasty": "宋",
  "verses": [
    "交旧间何阔，能来浃日留。",
    "还寻佳橘颂，惜别仲宣楼。",
    "探古书盈屋，忧时雪满头。",
    "绝思黄阁老，招隠意绸缪。"
  ],
  "enabled": true,
  "collection": "宋诗选",
