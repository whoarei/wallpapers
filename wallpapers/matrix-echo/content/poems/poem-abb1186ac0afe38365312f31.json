{
  "id": "poem-abb1186ac0afe38365312f31",
  "title": "仙源即事  其二",
  "author": "王镃",
  "dynasty": "宋",
  "verses": [
    "避世移家入乱山，松风杉雨打窗寒。",
    "床头一卷麻衣易，自点松明尽夜看。"
  ],
  "enabled": true,
