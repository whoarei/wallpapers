{
  "id": "poem-539f847096b24d1d5c2c2b47",
  "title": "奉和御制茱萸",
  "author": "徐铉",
  "dynasty": "宋",
  "verses": [
    "台畔西风御果新，芳香精彩丽萧辰。",
    "柔条细叶妆治好，紫蔕红芳点缀匀。",
    "几朵得陪天上宴，千株长作洞中春。",
    "今朝圣藻偏流咏，黄菊无由更敢邻。"
  ],
  "enabled": true,
  "collection": "宋诗选",
