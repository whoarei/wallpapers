{
  "id": "poem-b22a0c71f5db422c6a7d0729",
  "title": "题翠蛟亭",
  "author": "李斗南",
  "dynasty": "宋",
  "verses": [
    "壮士传观山石间，腰头宝剑祥光吐。",
    "摩挲醉眼叱海神，嫌杀蛟龙作妖舞。"
  ],
  "enabled": true,
  "collection": "宋诗选",
