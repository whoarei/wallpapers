{
  "id": "poem-9eb3cc0d367a758c92ec18f6",
  "title": "白藕花寄袁状元仓使",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "澄练彻山脉，玉透山池沙。",
    "老火奋残烁，凛姿炖不瑕。",
    "方方秋一奁，弹压红万葩。",
    "安得濂溪叟，来赋东林花。"
  ],
  "enabled": true,
  "collection": "宋诗选",
