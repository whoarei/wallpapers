{
  "id": "poem-297f51ccfc977996825ff662",
  "title": "寄白司马",
  "author": "徐凝",
  "dynasty": "唐",
  "verses": [
    "三条九陌花时节，万户千车看牡丹。",
    "争遣江州白司马，五年风景忆长安。"
  ],
  "enabled": true,
