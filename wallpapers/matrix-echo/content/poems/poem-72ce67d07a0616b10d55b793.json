{
  "id": "poem-72ce67d07a0616b10d55b793",
  "title": "玉楼春·小园半夜东风转",
  "author": "毛滂",
  "dynasty": "宋",
  "verses": [
    "小园半夜东风转。",
    "吹皱冰池云母面。",
    "晓披阊阖见朝阳，知向碧阶添几线。",
    "小烟弄柳晴先暖。",
    "残雪禁梅香尚浅。",
    "殷勤洗拂旧东君，多少韶华聊借看。"
  ],
  "enabled": true,
  "collection": "宋词选",
