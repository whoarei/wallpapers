{
  "id": "poem-9c46ff99a536930db9342b3d",
  "title": "颂古三十一首  其一二",
  "author": "释安永",
  "dynasty": "宋",
  "verses": [
    "臭口未开经万劫，丝毫才犯铁轮随。",
    "雨散云收明月夜，反动江波说向谁。"
  ],
  "enabled": true,
