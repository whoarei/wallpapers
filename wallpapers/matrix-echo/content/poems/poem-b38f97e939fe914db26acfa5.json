{
  "id": "poem-b38f97e939fe914db26acfa5",
  "title": "茅山续志",
  "author": "张颉",
  "dynasty": "宋",
  "verses": [
    "步虚声起绕玄云，石乳烟销夜半分。",
    "怪得瑶笙吹鹤过，碧坛夜醮玉宸君。"
  ],
  "enabled": true,
  "collection": "宋诗选",
