{
  "id": "poem-c4de37d7587820f70193f283",
  "title": "宫词  其九四",
  "author": "张公庠",
  "dynasty": "宋",
  "verses": [
    "雪罢严寒殆不禁，紫宸朝退禁门深。",
    "君恩委曲人知否，数盏香醪抵百金。"
  ],
