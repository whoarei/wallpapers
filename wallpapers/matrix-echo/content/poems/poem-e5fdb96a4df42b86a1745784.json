{
  "id": "poem-e5fdb96a4df42b86a1745784",
  "title": "点绛唇·秩秩宾筵",
  "author": "张孝祥",
  "dynasty": "宋",
  "verses": [
    "秩秩宾筵，玉潭春涨玻璃满。",
    "旆霞风卷。",
    "可但长安远。",
    "夏木成阴，路袅薰风转。",
    "空留恋。",
    "细吹银管。",
    "别意随声缓。"
  ],
  "enabled": true,
  "collection": "宋词选",
  "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/宋词/ci.song.2000.json#record-385",
