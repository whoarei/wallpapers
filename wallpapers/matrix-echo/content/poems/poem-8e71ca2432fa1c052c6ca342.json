{
  "id": "poem-8e71ca2432fa1c052c6ca342",
  "title": "途中口号",
  "author": "卢僎",
  "dynasty": "唐",
  "verses": [
    "抱玉三朝楚，怀书十上秦。",
    "年年洛阳陌，花鸟弄归人。"
  ],
