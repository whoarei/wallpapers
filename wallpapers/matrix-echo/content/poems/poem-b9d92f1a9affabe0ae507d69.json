{
  "id": "poem-b9d92f1a9affabe0ae507d69",
  "title": "春社",
  "author": "王同祖",
  "dynasty": "宋",
  "verses": [
    "廉纤雾雨四山昏，寂寂茅簷半掩门。",
    "客里不知今日社，偶过野庙见分膰。"
  ],
  "enabled": true,
  "collection": "宋诗选",
