{
  "id": "poem-032b28eefd2928c90dc41e65",
  "title": "清平乐·露花烟柳",
  "author": "李邴",
  "dynasty": "宋",
  "verses": [
    "露花烟柳。",
    "春思浓如酒。",
    "几阵狂风新雨后。",
    "满地落红铺绣。",
    "风流何处疏狂。",
    "厌厌恨结柔肠。",
    "又是危阑独倚，一川烟草斜阳。"
  ],
  "enabled": true,
  "collection": "宋词选",
