{
  "id": "poem-4a0aed449483401c5322a490",
  "title": "从军行",
  "author": "崔国辅",
  "dynasty": "唐",
  "verses": [
    "塞北胡霜下，营州索兵救。",
    "夜里偷道行，将军马亦瘦。",
    "刀光照塞月，阵色明如昼。",
    "传闻贼满山，已共前锋鬬。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
