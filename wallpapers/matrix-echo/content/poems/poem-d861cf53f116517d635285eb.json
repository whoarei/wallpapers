{
  "id": "poem-d861cf53f116517d635285eb",
  "title": "寄刘员外长卿",
  "author": "皇甫曾",
  "dynasty": "唐",
  "verses": [
    "南忆新安郡，千山带夕阳。",
    "断猨知夜久，秋草助江长。",
    "疎发应成素，青松独耐霜。",
    "爱才称汉主，题柱待回乡。"
  ],
  "enabled": true,
