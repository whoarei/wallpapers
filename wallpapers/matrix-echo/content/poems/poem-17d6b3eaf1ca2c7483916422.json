{
  "id": "poem-17d6b3eaf1ca2c7483916422",
  "title": "寄左省杜拾遗",
  "author": "岑参",
  "dynasty": "唐",
  "verses": [
    "联步趋丹陛，分曹限紫微。",
    "晓随天仗入，暮惹御香归。",
    "白发悲花落，青云羡鸟飞。",
    "圣朝无阙事，自觉谏书稀。"
  ],
  "enabled": true,
  "collection": "唐诗三百首",
