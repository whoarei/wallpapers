{
  "id": "poem-dfe0c89f04c1c39fd540872e",
  "title": "和元晦林间残雪之韵",
  "author": "张栻",
  "dynasty": "宋",
  "verses": [
    "眼中光洁尽琼瑶，未觉鬰蓝宫殿遥。",
    "石壁长林冰筯落，锵然玉佩响层霄。"
  ],
  "enabled": true,
  "collection": "宋诗选",
