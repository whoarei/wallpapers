{
  "id": "poem-f5738fb8fb68af599245a3be",
  "title": "偈颂（幷序○序为南岳齐己撰） 五十六",
  "author": "居遁",
  "dynasty": "唐",
  "verses": [
    "杉松直拔映峰峦，一色长青道者看。",
    "四气盛衰无变异，岂同凡木有多般。"
  ],
  "enabled": true,
