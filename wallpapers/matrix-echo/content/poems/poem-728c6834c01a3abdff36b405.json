{
  "id": "poem-728c6834c01a3abdff36b405",
  "title": "送杜御史还广陵",
  "author": "李嘉祐",
  "dynasty": "唐",
  "verses": [
    "慙君从弱岁，顾我比诸昆。",
    "同事元戎久，俱承国士恩。",
    "随莺过淮水，看柳向辕门。",
    "草色金陵岸，思心那可论。"
  ],
  "enabled": true,
