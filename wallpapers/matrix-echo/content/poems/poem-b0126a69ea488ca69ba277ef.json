{
  "id": "poem-b0126a69ea488ca69ba277ef",
  "title": "梅",
  "author": "王淇",
  "dynasty": "宋",
  "verses": [
    "不受尘埃半点侵，竹篱茅舍自甘心。",
    "只因误识林和靖，惹得诗人说到今。"
  ],
  "enabled": true,
