{
  "id": "poem-1ddf01326aa55a75c60f5ed5",
  "title": "九日送人",
  "author": "司空曙",
  "dynasty": "唐",
  "verses": [
    "送人冠獬豸，值节佩茱萸。",
    "均覆征三壤，登车出五湖。",
    "水风凄落日，岸叶飒衰芜。",
    "自恨尘中使，何因在路隅。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
