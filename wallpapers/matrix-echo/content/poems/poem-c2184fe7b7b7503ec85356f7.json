{
  "id": "poem-c2184fe7b7b7503ec85356f7",
  "title": "赠南陵李主簿",
  "author": "曹松",
  "dynasty": "唐",
  "verses": [
    "外邑官同隐，宁劳短吏趋。",
    "看云情自足，爱酒逸应无。",
    "簟席弹碁子，衣裳惹印朱。",
    "仍闻陂水近，亦拟掉菰蒲。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
