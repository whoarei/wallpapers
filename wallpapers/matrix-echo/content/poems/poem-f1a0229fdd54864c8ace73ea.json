{
  "id": "poem-f1a0229fdd54864c8ace73ea",
  "title": "首春",
  "author": "太宗皇帝",
  "dynasty": "唐",
  "verses": [
    "寒随穷律变，春逐鸟声开。",
    "初风飘带柳，晚雪间花梅。",
    "碧林青旧竹，绿沼翠新苔。",
    "芝田初雁去，绮树巧鸎来。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
