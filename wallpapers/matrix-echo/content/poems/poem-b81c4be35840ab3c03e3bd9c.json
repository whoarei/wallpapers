{
  "id": "poem-b81c4be35840ab3c03e3bd9c",
  "title": "帝京篇十首 五",
  "author": "太宗皇帝",
  "dynasty": "唐",
  "verses": [
    "芳辰追逸趣，禁苑信多奇。",
    "桥形通汉上，峰势接云危。",
    "烟霞交隐映，花鸟自参差。",
    "何如肆辙迹？万里赏瑶池。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
