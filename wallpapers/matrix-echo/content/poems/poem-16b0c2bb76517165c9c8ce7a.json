{
  "id": "poem-16b0c2bb76517165c9c8ce7a",
  "title": "卜算子·云破月高悬",
  "author": "吕渭老",
  "dynasty": "宋",
  "verses": [
    "云破月高悬，照我双双泪。",
    "人在朱桥转曲西，翠幕重重闭。",
    "要见索商量，见了还无计。",
    "心似长檠一点灯，到晓清清地。"
  ],
  "enabled": true,
  "collection": "宋词选",
  "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/宋词/ci.song.6000.json#record-88",
