{
  "id": "poem-8d25be3a255e759f771a426f",
  "title": "五祖栽松六祖担柴赞  其一",
  "author": "释了惠",
  "dynasty": "宋",
  "verses": [
    "恨杀老头陀，山移恨不磨。",
    "吾今担头重，为汝种松多。"
  ],
  "enabled": true,
