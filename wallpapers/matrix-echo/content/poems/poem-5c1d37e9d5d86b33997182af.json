{
  "id": "poem-5c1d37e9d5d86b33997182af",
  "title": "题山桥十首  其一",
  "author": "王柏",
  "dynasty": "宋",
  "verses": [
    "轧轧飞车入翠微，人于妙处未深知。",
    "自从标榜新拈掇，碎却山桥一段奇。"
  ],
  "enabled": true,
