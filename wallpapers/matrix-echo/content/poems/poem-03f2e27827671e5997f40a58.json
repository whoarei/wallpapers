{
  "id": "poem-03f2e27827671e5997f40a58",
  "title": "道林寺",
  "author": "裴说",
  "dynasty": "唐",
  "verses": [
    "独立凭危阑，高低落照间。",
    "寺分一派水，僧锁半房山。",
    "对面浮世隔，垂帘到老闲。",
    "烟云与尘土，寸步不相关。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
