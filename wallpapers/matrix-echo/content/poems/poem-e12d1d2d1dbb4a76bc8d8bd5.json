{
  "id": "poem-e12d1d2d1dbb4a76bc8d8bd5",
  "title": "送陈元龙赴封州教官",
  "author": "王十朋",
  "dynasty": "宋",
  "verses": [
    "温陵尊酒偶相逢，记得同年旧日容。",
    "书读短檠游太学，经传绛帐适临封。",
    "清新得句肠生锦，瘦硬通神笔吐锋。",
    "莫向炎州叹官冷，行看胡海起元龙。"
  ],
  "enabled": true,
  "collection": "宋诗选",
