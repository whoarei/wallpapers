{
  "id": "poem-c464e3fc9edabe43fca6de2e",
  "title": "杨叛儿",
  "author": "徐凝",
  "dynasty": "唐",
  "verses": [
    "哀怨杨叛儿，骀荡郎知否。",
    "香死博山炉，烟生白门柳。"
  ],
