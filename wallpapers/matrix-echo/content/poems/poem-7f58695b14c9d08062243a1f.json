{
  "id": "poem-7f58695b14c9d08062243a1f",
  "title": "终南山",
  "author": "王维",
  "dynasty": "唐",
  "verses": [
    "太乙近天都，连山接海隅。",
    "白云回望合，青霭入看无。",
    "分野中峰变，阴晴众壑殊。",
    "欲投人处宿，隔水问樵夫。"
  ],
  "enabled": true,
