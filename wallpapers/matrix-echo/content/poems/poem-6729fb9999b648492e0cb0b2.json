{
  "id": "poem-6729fb9999b648492e0cb0b2",
  "title": "示二子",
  "author": "陈俊卿",
  "dynasty": "宋",
  "verses": [
    "兴来文字三杯酒，老去生涯万卷书。",
    "遗汝子孙清白在，不须厦屋太渠渠。"
  ],
