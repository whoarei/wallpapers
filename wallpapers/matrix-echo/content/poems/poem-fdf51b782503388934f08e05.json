{
  "id": "poem-fdf51b782503388934f08e05",
  "title": "春怨",
  "author": "杨凝",
  "dynasty": "唐",
  "verses": [
    "花满帘栊欲度春，此时夫壻在咸秦。",
    "绿窗孤寝难成寐，紫燕双飞似弄人。"
  ],
  "enabled": true,
