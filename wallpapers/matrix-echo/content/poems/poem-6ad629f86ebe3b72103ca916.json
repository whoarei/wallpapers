{
  "id": "poem-6ad629f86ebe3b72103ca916",
  "title": "章华台  其二",
  "author": "李纲",
  "dynasty": "宋",
  "verses": [
    "章华夜饮晓从糜，翠被天寒雨雪霏。",
    "马足车尘竟何往，空令子革诵招祈。"
  ],
  "enabled": true,
  "collection": "宋诗选",
