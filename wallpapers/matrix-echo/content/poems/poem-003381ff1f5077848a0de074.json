{
  "id": "poem-003381ff1f5077848a0de074",
  "title": "隋宫",
  "author": "鲍溶",
  "dynasty": "唐",
  "verses": [
    "柳塘烟起日西斜，竹浦风回鴈弄沙。",
    "炀帝春游古城在，坏宫芳草满人家。"
  ],
  "enabled": true,
