{
  "id": "poem-639e6ed7f0c44b5c69231cdd",
  "title": "常娥",
  "author": "李商隐",
  "dynasty": "唐",
  "verses": [
    "云母屏风烛影深，长河渐落晓星沈。",
    "常娥应悔偷灵药，碧海青天夜夜心。"
  ],
  "enabled": true,
