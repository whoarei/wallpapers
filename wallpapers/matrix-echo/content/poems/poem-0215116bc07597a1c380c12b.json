{
  "id": "poem-0215116bc07597a1c380c12b",
  "title": "荅客",
  "author": "鲍溶",
  "dynasty": "唐",
  "verses": [
    "竹间深路马惊嘶，独入蓬门半似迷。",
    "劳问圃人终岁事，桔槔声里雨春畦。"
  ],
  "enabled": true,
