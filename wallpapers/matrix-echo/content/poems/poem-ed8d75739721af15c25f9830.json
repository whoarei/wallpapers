{
  "id": "poem-ed8d75739721af15c25f9830",
  "title": "送李侍御入茅山采药",
  "author": "张南史",
  "dynasty": "唐",
  "verses": [
    "苦县家风在，茅山道录传。",
    "聊听骢马使，却就紫阳仙。",
    "江海生岐路，云霞入洞天。",
    "莫令千岁鹤，飞到草堂前。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
