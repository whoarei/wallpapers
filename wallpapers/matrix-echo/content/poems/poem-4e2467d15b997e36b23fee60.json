{
  "id": "poem-4e2467d15b997e36b23fee60",
  "title": "浣溪沙·过隙光阴还自催",
  "author": "张纲",
  "dynasty": "宋",
  "verses": [
    "过隙光阴还自催。",
    "生朝又送一年来。",
    "宴堂深处强追陪。",
    "眼眩岂堪花里笑，眉攒聊向酒边开。",
    "与君同醉莫辞杯。"
  ],
  "enabled": true,
  "collection": "宋词选",
