{
  "id": "poem-be8c4209d39c51cda307795f",
  "title": "苦战行",
  "author": "杜甫",
  "dynasty": "唐",
  "verses": [
    "苦战身死马将军，自云伏波之子孙。",
    "干戈未定失壮士，使我叹恨伤精魂。",
    "去年江南讨狂贼，临江把臂再难得。",
    "别时孤云今不飞，时独看云泪横臆。"
  ],
  "enabled": true,
