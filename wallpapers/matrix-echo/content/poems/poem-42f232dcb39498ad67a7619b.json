{
  "id": "poem-42f232dcb39498ad67a7619b",
  "title": "又一首",
  "author": "张𬸦",
  "dynasty": "唐",
  "verses": [
    "旧来心使眼，心思眼剩（《唐人小说》本作即。",
    "）传。",
    "由心使眼见，眼亦共心怜。"
  ],
