{
  "id": "poem-65bbe65987aea4fcaf9fa8ef",
  "title": "环翠亭",
  "author": "陈知柔",
  "dynasty": "宋",
  "verses": [
    "当年把臂入龙山，犹记相逢醉梦间。",
    "君似孤云了无碍，我如倦翼早知还。",
    "茅簷负日真成算，竹榻论诗整破颜。",
    "欲问太平真气象，夜来风月到松关。"
  ],
  "enabled": true,
