{
  "id": "poem-375be0a80eb9d7fd41759c3c",
  "title": "白菊三首 三",
  "author": "司空图",
  "dynasty": "唐",
  "verses": [
    "为报繁霜且莫催，穷秋须到自低垂。",
    "横拖长袖招人别，只待春风却舞来。"
  ],
  "enabled": true,
