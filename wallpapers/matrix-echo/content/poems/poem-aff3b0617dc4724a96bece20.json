{
  "id": "poem-aff3b0617dc4724a96bece20",
  "title": "雨后",
  "author": "孙介",
  "dynasty": "宋",
  "verses": [
    "呼童卷帘收架书，簷溜忽断云萧疎。",
    "山光水影净如拭，一川秋意生芙蕖。"
  ],
  "enabled": true,
