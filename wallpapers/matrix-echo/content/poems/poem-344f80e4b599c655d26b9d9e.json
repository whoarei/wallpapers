{
  "id": "poem-344f80e4b599c655d26b9d9e",
  "title": "千秋岁·郁葱佳气",
  "author": "黄公度",
  "dynasty": "宋",
  "verses": [
    "郁葱佳气。",
    "天降麒麟瑞。",
    "回首处，江城外。",
    "一麾遗爱在，万口欢声沸。",
    "人乍远，危楼目断天无际。",
    "五马徘徊地。",
    "春色随归旆。",
    "寿水绿，壶山翠。",
    "风轻香篆直，日暖歌喉脆。",
    "椒觞举，人人尽祝千秋岁。"
  ],
  "enabled": true,
  "collection": "宋词选",
