{
  "id": "poem-2b0427508223d8073100db28",
  "title": "杪秋夜直",
  "author": "郑畋",
  "dynasty": "唐",
  "verses": [
    "蘂宫裁诏与宵分，虽在青云忆白云。",
    "待报君恩了归去，山翁何急草移文。"
  ],
  "enabled": true,
