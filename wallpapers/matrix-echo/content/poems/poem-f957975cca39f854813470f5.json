{
  "id": "poem-f957975cca39f854813470f5",
  "title": "郊庙歌辞 德明兴圣庙乐章 迎神",
  "author": "李舒",
  "dynasty": "唐",
  "verses": [
    "元尊九德，佐尧光宅。",
    "烈祖太宗，方周作伯。",
    "响怀霜露，乐变金石。",
    "白云清风，髣髴来格。"
  ],
  "enabled": true,
