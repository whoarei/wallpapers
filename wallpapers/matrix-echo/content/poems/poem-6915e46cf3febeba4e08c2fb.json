{
  "id": "poem-6915e46cf3febeba4e08c2fb",
  "title": "物情",
  "author": "李咸用",
  "dynasty": "唐",
  "verses": [
    "谁分万类二仪间，禀性高卑各自然。",
    "野鹤不栖葱蒨树，流莺长喜艳阳天。",
    "李斯溷鼠心应动，庄叟泥龟意已坚。"
  ],
  "enabled": true,
