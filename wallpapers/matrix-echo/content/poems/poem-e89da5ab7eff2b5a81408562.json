{
  "id": "poem-e89da5ab7eff2b5a81408562",
  "title": "横吹曲辞 折杨柳",
  "author": "韦承庆",
  "dynasty": "唐",
  "verses": [
    "万里边城地，三春杨柳节。",
    "叶似镜中眉，花如关外雪。",
    "征人远乡思，倡妇高楼别。",
    "不忍掷年华，含情寄攀折。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
