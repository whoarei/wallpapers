{
  "id": "poem-13aed2d8833c1af174e3cc5f",
  "title": "颂古七十六首  其四三",
  "author": "释士珪",
  "dynasty": "宋",
  "verses": [
    "雷火光中休草草，剑轮锋上莫忉忉。",
    "等闲放却全身入，终不当头犯一毫。"
  ],
  "enabled": true,
