{
  "id": "poem-e94d7e346c918026abb8d5e3",
  "title": "题曾氏山园十一咏 北山",
  "author": "张栻",
  "dynasty": "宋",
  "verses": [
    "南山烟雨霏，北山风露多。",
    "衣沾非所惜，屦湿知如何。"
  ],
  "enabled": true,
