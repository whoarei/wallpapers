{
  "id": "poem-2f682f0089b88d88e9dddb80",
  "title": "游仙词三十三首  其二○",
  "author": "王镃",
  "dynasty": "宋",
  "verses": [
    "偶巡三岛过瀛洲，闲把新绛系海虬。",
    "忽报词臣当直日，灵风吹到五云楼。"
  ],
  "enabled": true,
