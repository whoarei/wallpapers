{
  "id": "poem-fb4d60cdfe3e0b24a20b94f5",
  "title": "菩萨蛮·绿芜墙绕青苔院",
  "author": "陈克",
  "dynasty": "宋",
  "verses": [
    "绿芜墙绕青苔院。",
    "中庭日淡芭蕉卷。",
    "蝴蝶上阶飞。",
    "烘帘自在垂。",
    "玉钩双语燕。",
    "宝甃杨花转。",
    "几处簸钱声。",
    "绿窗春睡轻。"
  ],
  "enabled": true,
