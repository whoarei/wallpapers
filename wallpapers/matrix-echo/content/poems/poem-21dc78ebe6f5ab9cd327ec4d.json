{
  "id": "poem-21dc78ebe6f5ab9cd327ec4d",
  "title": "庭竹",
  "author": "李咸用",
  "dynasty": "唐",
  "verses": [
    "嫩绿与老碧，森然庭砌中。",
    "坐销三伏景，吟起数竿风。",
    "叶影重还密，梢声远或通。",
    "更期春共看，桃映小花红。"
  ],
  "enabled": true,
