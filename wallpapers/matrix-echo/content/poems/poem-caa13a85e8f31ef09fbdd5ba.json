{
  "id": "poem-caa13a85e8f31ef09fbdd5ba",
  "title": "石室",
  "author": "释了惠",
  "dynasty": "宋",
  "verses": [
    "锤凿不到处，纵横丈许宽。",
    "宁教苔藓去，要下一筹难。"
  ],
