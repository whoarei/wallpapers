{
  "id": "poem-c3b5b9269497a6c4c5274f2e",
  "title": "小游仙诗九十八首 二十一",
  "author": "曹唐",
  "dynasty": "唐",
  "verses": [
    "月影悠悠秋树明，露吹犀簟象床轻。",
    "嫔妃久立帐门外，暗笑夫人推酒声。"
  ],
