{
  "id": "poem-63b5235a996dee2099448e8c",
  "title": "惜别",
  "author": "王镃",
  "dynasty": "宋",
  "verses": [
    "袂分鸳锦梦双残，一线啼痕枕未干。",
    "门掩青灯人自去，杏花风起落花看。"
  ],
  "enabled": true,
  "collection": "宋诗选",
