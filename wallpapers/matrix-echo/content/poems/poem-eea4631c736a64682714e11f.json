{
  "id": "poem-eea4631c736a64682714e11f",
  "title": "分岁",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "办得分年供，清哉亦称怀。",
    "野槃均柿串，草具爨松钗。",
    "指冷柑初破，灰红芋旋埋。",
    "火边相枕藉，火尽又添柴。"
  ],
  "enabled": true,
  "collection": "宋诗选",
