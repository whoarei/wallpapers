{
  "id": "poem-273572a0d9256ef84a83752e",
  "title": "进船泛洛水应制",
  "author": "孙逖",
  "dynasty": "唐",
  "verses": [
    "禁园纡睿览，仙櫂叶时游。",
    "洛北风花树，江南彩画舟。",
    "芳生兰蕙草，春入凤凰楼。",
    "兴尽离宫暮，烟光起夕流。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
