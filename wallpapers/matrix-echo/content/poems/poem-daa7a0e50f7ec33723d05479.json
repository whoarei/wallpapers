{
  "id": "poem-daa7a0e50f7ec33723d05479",
  "title": "行宫",
  "author": "元稹",
  "dynasty": "唐",
  "verses": [
    "寥落古行宫，宫花寂寞红。",
    "白头宫女在，闲坐说玄宗。"
  ],
