{
  "id": "poem-bfe0189586c6932765dbdf6b",
  "title": "同陈宰黄簿游灵山八首宰云吾辈可谓忙里偷闲苦中作乐以八字为韵  其六",
  "author": "陈造",
  "dynasty": "宋",
  "verses": [
    "名山吾敢忘，独往兴易穷。",
    "胜游得胜士，杖屦凛生风。",
    "表表益者友，当求古人中。",
    "今世习凿齿，前身黄石公。"
  ],
  "enabled": true,
  "collection": "宋诗选",
