{
  "id": "poem-8a0e0700a96611ab02460ae7",
  "title": "和寿中丞伤猿",
  "author": "李洞",
  "dynasty": "唐",
  "verses": [
    "遗挂朱栏锁半寻，清声难买恨黄金。",
    "悬崖接果今何在，浅井窥星影已沉。",
    "归宅叶铺曾睡石，入朝灯照旧啼林。",
    "小山罢遶随湘客，高树休升对岳禽。",
    "天竺省怜伤倍切，亲知宽和思难任。",
    "相门恩重无由报，竟托仙郎日夜吟。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
