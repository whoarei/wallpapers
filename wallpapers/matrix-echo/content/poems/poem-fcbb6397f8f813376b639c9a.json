{
  "id": "poem-fcbb6397f8f813376b639c9a",
  "title": "又一首",
  "author": "张𬸦",
  "dynasty": "唐",
  "verses": [
    "自隐风流到，人前法用多。",
    "计时应拒得，佯作不禁他。"
  ],
