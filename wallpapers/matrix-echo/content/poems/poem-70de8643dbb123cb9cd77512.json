{
  "id": "poem-70de8643dbb123cb9cd77512",
  "title": "奉和武相公春晓闻莺",
  "author": "李益",
  "dynasty": "唐",
  "verses": [
    "蜀道山川心易惊，缘窗残梦晓闻莺。",
    "分明似写文君恨，万怨千愁弦上声。"
  ],
