{
  "id": "poem-d3ca6f27c5822cea3d7daf3e",
  "title": "登山",
  "author": "李涉",
  "dynasty": "唐",
  "verses": [
    "终日昏昏醉梦间，忽闻春尽强登山。",
    "因过竹院逢僧话，又得浮生半日闲。"
  ],
  "enabled": true,
  "collection": "千家诗",
