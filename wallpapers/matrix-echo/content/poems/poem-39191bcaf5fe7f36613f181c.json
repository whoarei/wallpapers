{
  "id": "poem-39191bcaf5fe7f36613f181c",
  "title": "送僧绎",
  "author": "皎然",
  "dynasty": "唐",
  "verses": [
    "斜日摇扬在柳丝，孤亭寂寂水逶迤。",
    "谁堪别后行人尽，唯有春风起路岐。"
  ],
  "enabled": true,
