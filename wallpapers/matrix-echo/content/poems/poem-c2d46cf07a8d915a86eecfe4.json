{
  "id": "poem-c2d46cf07a8d915a86eecfe4",
  "title": "湘灵鼓瑟",
  "author": "陈季",
  "dynasty": "唐",
  "verses": [
    "神女泛瑶瑟，古祠严野亭。",
    "楚云来泱漭，湘水助清泠。",
    "妙指微幽契，繁声入杳冥。",
    "一弹新月白，数曲暮山青。",
    "调苦荆人怨，时遥帝子灵。",
    "遗音如可赏，试奏为君听。"
  ],
  "enabled": true,
