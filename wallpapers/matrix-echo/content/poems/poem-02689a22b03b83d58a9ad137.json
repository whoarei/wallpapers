{
  "id": "poem-02689a22b03b83d58a9ad137",
  "title": "雪中访别魏使君  其二",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "大雅离骚不入时，反骚变雅又奚为。",
    "天台好处休提掇，只咏寒山拾得诗。"
  ],
  "enabled": true,
