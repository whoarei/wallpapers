{
  "id": "poem-ffefba2e7ca3c54a3f0862b8",
  "title": "句",
  "author": "沈佺期",
  "dynasty": "唐",
  "verses": [
    "周原五稼起，云海百川归。",
    "愿此零陵燕，长随征斾飞。"
  ],
