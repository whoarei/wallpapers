{
  "id": "poem-3768945cdbbdf96d601866ac",
  "title": "恸柳论",
  "author": "刘言史",
  "dynasty": "唐",
  "verses": [
    "孀妻栖户仍无嗣，欲访孤坟谁引至。",
    "裴回无处展哀情，惟有衣襟知下泪。"
  ],
  "enabled": true,
