{
  "id": "poem-d0944cc9b3fee81e2e41552b",
  "title": "洞庭隐",
  "author": "来鹄",
  "dynasty": "唐",
  "verses": [
    "高卧洞庭三十春，芰荷香里独垂纶。",
    "莫嫌无事闲销日，有事始怜无事人。"
  ],
  "enabled": true,
