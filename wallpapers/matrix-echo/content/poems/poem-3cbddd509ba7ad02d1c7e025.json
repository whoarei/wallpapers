{
  "id": "poem-3cbddd509ba7ad02d1c7e025",
  "title": "下池  其二",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "老子随行苜蓿盘，不曾无客自开单。",
    "更将余粒投清浅，聊为游鱼小倚阑。"
  ],
  "enabled": true,
