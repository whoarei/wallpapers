{
  "id": "poem-e7daaeffc480bef3c196d0d4",
  "title": "立春前四日天大雷电以雨",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "霹雳如春雨似秋，兰陵冬夜忆黄州。",
    "茂陵封禅期身后，恰恰营成小竹楼。"
  ],
  "enabled": true,
