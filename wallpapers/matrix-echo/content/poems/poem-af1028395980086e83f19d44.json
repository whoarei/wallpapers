{
  "id": "poem-af1028395980086e83f19d44",
  "title": "谷口书斋寄杨补阙",
  "author": "钱起",
  "dynasty": "唐",
  "verses": [
    "泉壑带茅茨，云霞生薜帷。",
    "竹怜新雨后，山爱夕阳时。",
    "闲鹭栖常早，秋花落更迟。",
    "家童扫萝迳，昨与故人期。"
  ],
  "enabled": true,
  "collection": "唐诗三百首",
