{
  "id": "poem-ca76c341291e3a401d5ed837",
  "title": "秋寄李频使君二首 二",
  "author": "贯休",
  "dynasty": "唐",
  "verses": [
    "务简趣难陪，清吟共绿苔。",
    "叶和秋蚁落，僧带野香来。",
    "留客朝尝酒，忧民夜画灰。",
    "终期冒风雪，江上见宗雷。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
