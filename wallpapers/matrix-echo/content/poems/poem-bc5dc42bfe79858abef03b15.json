{
  "id": "poem-bc5dc42bfe79858abef03b15",
  "title": "幽州未得授戒",
  "author": "义存",
  "dynasty": "唐",
  "verses": [
    "一十出家未是时，二十出家正是时。",
    "今遇官坛缘未合，𨀁踵且作老沙弥。"
  ],
  "enabled": true,
