{
  "id": "poem-e78cdbdb02f60fa1414e5ef1",
  "title": "庾岭  其二",
  "author": "高吉",
  "dynasty": "宋",
  "verses": [
    "江水悠悠去莫追，个中造道有深机。",
    "我来岂为观鱼说，人笑无钩钓傍矶。"
  ],
  "enabled": true,
