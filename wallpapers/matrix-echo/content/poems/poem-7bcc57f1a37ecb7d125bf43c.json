{
  "id": "poem-7bcc57f1a37ecb7d125bf43c",
  "title": "晚秋",
  "author": "王同祖",
  "dynasty": "宋",
  "verses": [
    "世变无穷客恨长，栏干遍倚怕斜阳。",
    "满篱黄菊无心看，付与游蜂自在忙。"
  ],
  "enabled": true,
  "collection": "宋诗选",
