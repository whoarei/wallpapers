{
  "id": "poem-415dc48e5079a299c4452c2e",
  "title": "四望亭",
  "author": "朱景玄",
  "dynasty": "唐",
  "verses": [
    "高亭群峰首，四面俯晴川。",
    "每见晨光晓，阶前万井烟。"
  ],
  "enabled": true,
