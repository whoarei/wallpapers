{
  "id": "poem-7ac415dafac3b435cef2ae16",
  "title": "河满子·红粉楼前月照",
  "author": "毛文锡",
  "dynasty": "五代",
  "verses": [
    "红粉楼前月照，碧纱窗外莺啼。",
    "梦断辽阳音信，那堪独守空闺。",
    "恨对百花时节，王孙绿草萋萋。"
  ],
  "enabled": true,
  "collection": "花间集",
