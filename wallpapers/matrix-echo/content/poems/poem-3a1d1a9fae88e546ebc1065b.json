{
  "id": "poem-3a1d1a9fae88e546ebc1065b",
  "title": "溪村",
  "author": "王镃",
  "dynasty": "宋",
  "verses": [
    "水路随山转，溪晴踏软沙。",
    "斜阳晒鱼网，疏竹露人家。",
    "行蟹上枯岸，饥禽衔落花。",
    "老翁分石坐，闲话到桑麻。"
  ],
  "enabled": true,
  "collection": "宋诗选",
