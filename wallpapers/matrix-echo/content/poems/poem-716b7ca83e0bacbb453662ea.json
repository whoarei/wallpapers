{
  "id": "poem-716b7ca83e0bacbb453662ea",
  "title": "望江怨·东风急",
  "author": "牛峤",
  "dynasty": "五代",
  "verses": [
    "东风急，惜别花时手频执。",
    "罗帷愁独入，马嘶残雨春芜湿。",
    "倚门立，寄语薄情郎，粉香和泪泣。"
  ],
  "enabled": true,
  "collection": "花间集",
  "tags": [],
