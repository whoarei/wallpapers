{
  "id": "poem-892b7c1702830e5b3c0bdd14",
  "title": "逢王泌自东京至",
  "author": "李端",
  "dynasty": "唐",
  "verses": [
    "逢君自乡至，雪涕问田园。",
    "几处生乔木，谁家在旧村。",
    "山峰横二室，水色映千门。",
    "愁见游从处，如今花正繁。"
  ],
  "enabled": true,
