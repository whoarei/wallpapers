{
  "id": "poem-9269bb7f7986318cae485f4d",
  "title": "咏史诗 荆山",
  "author": "胡曾",
  "dynasty": "唐",
  "verses": [
    "抱玉岩前桂叶稠，碧谿寒水至今流。",
    "空山落日猨声呌，疑是荆人哭未休。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
