{
  "id": "poem-db0207f3896ab4a3927444a1",
  "title": "宫词  其四一",
  "author": "张公庠",
  "dynasty": "宋",
  "verses": [
    "过腊愆阳陇麦低，御封香合奉精祈。",
    "君王晓入凝华殿，远近楼台看雪飞。"
  ],
  "enabled": true,
