{
  "id": "poem-89c5f53a5279a53ece5f5b1b",
  "title": "更漏子 其二",
  "author": "温庭筠",
  "dynasty": "唐",
  "verses": [
    "星斗稀，钟鼓歇，帘外晓莺残月。",
    "兰露重，柳风斜，满庭堆落花。",
    "虚阁上，倚栏望，还似去年惆怅。",
    "春欲暮，思无穷，旧欢如梦中。"
  ],
  "enabled": true,
  "collection": "花间集",
  "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/五代诗词/huajianji/huajianji-1-juan.json#record-15",
