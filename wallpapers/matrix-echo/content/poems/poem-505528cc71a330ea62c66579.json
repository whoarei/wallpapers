{
  "id": "poem-505528cc71a330ea62c66579",
  "title": "入蓝关",
  "author": "赵嘏",
  "dynasty": "唐",
  "verses": [
    "微烟已辨秦中树，远梦更依江上台。",
    "看落晚花还怅望，鲤鱼时节入关来。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
