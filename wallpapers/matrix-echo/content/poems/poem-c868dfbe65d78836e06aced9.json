{
  "id": "poem-c868dfbe65d78836e06aced9",
  "title": "扬州作",
  "author": "米芾",
  "dynasty": "宋",
  "verses": [
    "春风何索寞，带雪入扬州。",
    "尚想遗钗雀，曾观上玉钩。",
    "真同一梦觉，坐想十年游。",
    "邂逅逢孙楚，酣歌慰滞留。"
  ],
  "enabled": true,
