{
  "id": "poem-699a1f7fcdf86b3c342b003d",
  "title": "开元观",
  "author": "陈岩",
  "dynasty": "宋",
  "verses": [
    "坏道哀湍鬼火青，山间留得观冲名。",
    "仙宫分置玄真像，想见开元旧太平。"
  ],
  "enabled": true,
