{
  "id": "poem-753cd0322c2c169e96fedecc",
  "title": "郡城南曰琼台北曰语海余易之曰云海登眺有感  其一",
  "author": "李纲",
  "dynasty": "宋",
  "verses": [
    "孤城南面敞琼台，千里川原指顾开。",
    "试向绿云深处望，海山浮动见蓬莱。"
  ],
  "enabled": true,
  "collection": "宋诗选",
