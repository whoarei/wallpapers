{
  "id": "poem-4dc4d521638496cfd5df0351",
  "title": "永明山居诗（六十九首） 四十五",
  "author": "延寿",
  "dynasty": "唐",
  "verses": [
    "擕筇闲步望山行，竟日逍遥任野情。",
    "上岭梯登危石侧，渡溪桥踏古槎横。",
    "绿罗水皱岩根急，红锦霞舒海面明。",
    "一轴咏怀高尚意，援毫因事偶吟成。"
  ],
  "enabled": true,
