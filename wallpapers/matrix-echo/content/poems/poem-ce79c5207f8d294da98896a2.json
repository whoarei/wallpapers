{
  "id": "poem-ce79c5207f8d294da98896a2",
  "title": "集宿姚殿中宅期僧无可不至",
  "author": "马戴",
  "dynasty": "唐",
  "verses": [
    "殿中日相命，开尊话旧时。",
    "余钟催鸟绝，积雪阻僧期。",
    "林静寒光远，天阴曙色迟。",
    "今夕复何夕，人谒去难追。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
