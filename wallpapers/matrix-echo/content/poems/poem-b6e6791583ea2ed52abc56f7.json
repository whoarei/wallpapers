{
  "id": "poem-b6e6791583ea2ed52abc56f7",
  "title": "游仙窟诗 游后园",
  "author": "张文成",
  "dynasty": "唐",
  "verses": [
    "昔时过小苑，今朝戏后园。",
    "两岁梅花匝，三春柳色繁。",
    "水明鱼影静，林翠鸟歌喧。",
    "何须杏树岭，即是桃花源。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
