{
  "id": "poem-b7fa11ca845f52071bba2796",
  "title": "别孙䜣",
  "author": "高适",
  "dynasty": "唐",
  "verses": [
    "离人去复留，白马黑貂裘。",
    "屈指论前事，停鞭惜旧游。",
    "帝乡那可忘，旅馆日堪愁。",
    "谁念无知己，年年睢水流。"
  ],
  "enabled": true,
