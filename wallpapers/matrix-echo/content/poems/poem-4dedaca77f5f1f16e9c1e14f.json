{
  "id": "poem-4dedaca77f5f1f16e9c1e14f",
  "title": "赠越客",
  "author": "赵嘏",
  "dynasty": "唐",
  "verses": [
    "故国波涛隔，明时心久留。",
    "献书双阙晚，看月五陵秋。",
    "南棹何当返，长江忆共游。",
    "定知钓鱼伴，相望在汀州。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
  "tags": [
    "长江"
  ],
