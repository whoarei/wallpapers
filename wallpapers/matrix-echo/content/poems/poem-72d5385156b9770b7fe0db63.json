{
  "id": "poem-72d5385156b9770b7fe0db63",
  "title": "题令宣和尚院",
  "author": "贯休",
  "dynasty": "唐",
  "verses": [
    "轩窗领岚翠，师得世情忘。",
    "惟爱谈诸祖，曾经宿大荒。",
    "泉声淹卧榻，云片犯𬬻香。",
    "寄语题门者，看经在上方。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
