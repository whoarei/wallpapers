{
  "id": "poem-808992ab63eb08c2a03649d3",
  "title": "秋怀赤松道士",
  "author": "贯休",
  "dynasty": "唐",
  "verses": [
    "仙观在云端，相思星斗寒。",
    "常怜呼鹤易，却恨见君难。",
    "石罅青虵湿，风榸白菌干。",
    "终期花月下，坛上听君弹。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
