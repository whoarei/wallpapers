{
  "id": "poem-99787f4f7bcad0e7facb70f7",
  "title": "宿僧舍",
  "author": "赵嘏",
  "dynasty": "唐",
  "verses": [
    "高僧夜滴芙蓉漏，远客窗含杨柳风。",
    "何处相逢话心地，月明身在磬声中。"
  ],
  "enabled": true,
