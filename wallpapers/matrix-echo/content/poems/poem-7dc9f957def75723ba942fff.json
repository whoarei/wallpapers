{
  "id": "poem-7dc9f957def75723ba942fff",
  "title": "桐竹赠张燕公",
  "author": "李伯鱼",
  "dynasty": "唐",
  "verses": [
    "北竹青桐北，南桐绿竹南。",
    "竹林君早爱，桐树我初贪。",
    "凤栖桐不媿，凤食竹何慙。",
    "栖食更如此，余非凤所堪。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
