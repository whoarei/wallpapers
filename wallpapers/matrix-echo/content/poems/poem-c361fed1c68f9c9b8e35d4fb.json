{
  "id": "poem-c361fed1c68f9c9b8e35d4fb",
  "title": "即事三首  其一",
  "author": "李纲",
  "dynasty": "宋",
  "verses": [
    "宾江两岸木绵飞，负郭家家熟荔枝。",
    "瘴雨蛮烟已萧瑟，可堪梅子欲黄时。"
  ],
  "enabled": true,
