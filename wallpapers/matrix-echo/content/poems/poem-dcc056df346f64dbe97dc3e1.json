{
  "id": "poem-dcc056df346f64dbe97dc3e1",
  "title": "劝学偈",
  "author": "令参",
  "dynasty": "唐",
  "verses": [
    "苦哉甚苦哉，波里觅干灰。",
    "劝君收取手，正与摩时俫。",
    "（以上三首均见《祖堂集》卷十。",
    "）。"
  ],
  "enabled": true,
