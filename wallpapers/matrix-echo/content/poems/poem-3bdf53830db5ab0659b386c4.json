{
  "id": "poem-3bdf53830db5ab0659b386c4",
  "title": "送马戴书记之太原",
  "author": "薛能",
  "dynasty": "唐",
  "verses": [
    "一曲大河声，全家几日行。",
    "从容长约夜，差互忽离城。",
    "镇北胡沙浅，途中霍岳横。",
    "相逢莫已讯，诗雅负雄名。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
