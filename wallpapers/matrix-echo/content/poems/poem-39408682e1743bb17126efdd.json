{
  "id": "poem-39408682e1743bb17126efdd",
  "title": "酬万八贺九云门下归溪中作",
  "author": "孙逖",
  "dynasty": "唐",
  "verses": [
    "晚从灵境出，林壑曙云飞。",
    "稍觉清溪尽，回瞻画刹微。",
    "独园余兴在，孤櫂宿心违。",
    "更忆登攀处，天香满袖归。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
