{
  "id": "poem-0869e1a3cdfe3c190e0d14b3",
  "title": "田家",
  "author": "范成大",
  "dynasty": "宋",
  "verses": [
    "昼出耘田夜绩麻，村庄儿女各当家。",
    "童孙未解供耕织，也傍桑阴学种瓜。"
  ],
  "enabled": true,
  "collection": "千家诗",
