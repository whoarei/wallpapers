{
  "id": "poem-a5909cba509dc8f65b4704a5",
  "title": "送王牧往吉州谒王使君叔",
  "author": "李嘉祐",
  "dynasty": "唐",
  "verses": [
    "细草绿汀洲，王孙耐薄游。",
    "年华初冠带，文体旧弓裘。",
    "野渡花争发，春塘水乱流。",
    "使君怜小阮，应念倚门愁。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
  "tags": [
    "送别",
    "春天",
    "惜别"
  ],
