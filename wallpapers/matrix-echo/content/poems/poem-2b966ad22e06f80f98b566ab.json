{
  "id": "poem-2b966ad22e06f80f98b566ab",
  "title": "酬施先辈",
  "author": "孟简",
  "dynasty": "唐",
  "verses": [
    "襄阳才子得声多，四海皆传古镜歌。",
    "乐府正声三百首，[梨]园新入教青娥。"
  ],
  "enabled": true,
