{
  "id": "poem-48b354f9986551f50413070a",
  "title": "十二咏 双莲阁",
  "author": "李纲",
  "dynasty": "宋",
  "verses": [
    "并蔕芙蓉出绿波，靓粧鸾鉴照双娥。",
    "风清月晓微开处，无那幽人独见何。"
  ],
  "enabled": true,
  "collection": "宋诗选",
