{
  "id": "poem-170b9c44c6e31a63a61be8cb",
  "title": "密雨",
  "author": "华镇",
  "dynasty": "宋",
  "verses": [
    "昨夜好风月，须明陟路岐。",
    "阴云生陇上，密雨满天涯。",
    "岂患泥涂恶，难堪仆马疲。",
    "却愁期会失，心绪乱如丝。"
  ],
  "enabled": true,
  "collection": "宋诗选",
