{
  "id": "poem-be7a910fa6af6e1647efd4f6",
  "title": "霜天晓角·春云粉色",
  "author": "高观国",
  "dynasty": "宋",
  "verses": [
    "春云粉色。",
    "春水和云湿。",
    "试问西湖杨柳，东风外、几丝碧。",
    "望极。",
    "连翠陌。",
    "兰桡双桨急。",
    "欲访莫愁何处，旗亭在、画桥侧。"
  ],
  "enabled": true,
  "collection": "宋词选",
  "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/宋词/ci.song.6000.json#record-388",
  "tags": [
