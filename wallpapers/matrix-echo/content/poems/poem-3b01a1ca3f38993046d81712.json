{
  "id": "poem-3b01a1ca3f38993046d81712",
  "title": "峥嵘岭",
  "author": "孟郊",
  "dynasty": "唐",
  "verses": [
    "疏凿顺高下，结构横烟霞。",
    "坐啸郡斋肃，玩奇石路斜。",
    "古树浮绿气，高门结朱华。",
    "始见峥嵘状，仰止逾可嘉。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
