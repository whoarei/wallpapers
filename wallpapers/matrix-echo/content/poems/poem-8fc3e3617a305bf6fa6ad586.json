{
  "id": "poem-8fc3e3617a305bf6fa6ad586",
  "title": "卢令",
  "author": "佚名",
  "dynasty": "先秦",
  "verses": [
    "卢令令，其人美且仁。",
    "卢重环，其人美且鬈。",
    "卢重鋂，其人美且偲。"
  ],
