{
  "id": "poem-8d0657a2307a95fa2b9da250",
  "title": "秋夕",
  "author": "杜牧",
  "dynasty": "唐",
  "verses": [
    "红烛秋光冷画屏，轻罗小扇扑流萤。",
    "天阶夜色凉如水，坐看牵牛织女星。"
  ],
  "enabled": true,
