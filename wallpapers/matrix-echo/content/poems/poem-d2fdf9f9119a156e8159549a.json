{
  "id": "poem-d2fdf9f9119a156e8159549a",
  "title": "寄楚琼上人",
  "author": "李咸用",
  "dynasty": "唐",
  "verses": [
    "遥知无事日，静对五峰秋。",
    "鸟隔寒烟语，泉和夕照流。",
    "凭栏疎磬尽，瞑目远云收。",
    "几句出人意，风高白雪浮。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
