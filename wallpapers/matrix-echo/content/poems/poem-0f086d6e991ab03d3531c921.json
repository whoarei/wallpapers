{
  "id": "poem-0f086d6e991ab03d3531c921",
  "title": "寄雍陶先辈",
  "author": "刘得仁",
  "dynasty": "唐",
  "verses": [
    "久别青云士，幽人分固然。",
    "愁心不易去，蹇步卒难前。",
    "尽落经霜叶，频阴欲雪天。",
    "归山自有限，岂待白头年。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
