{
  "id": "poem-ffea718dde4409e27673f376",
  "title": "春暮",
  "author": "曹豳",
  "dynasty": "宋",
  "verses": [
    "门外无人问落花，绿阴冉冉遍天涯。",
    "林莺啼到无声处，青草池塘独听蛙。"
  ],
  "enabled": true,
  "collection": "千家诗",
