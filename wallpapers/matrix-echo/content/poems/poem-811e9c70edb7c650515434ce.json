{
  "id": "poem-811e9c70edb7c650515434ce",
  "title": "寄白学士",
  "author": "张籍",
  "dynasty": "唐",
  "verses": [
    "自掌天书见客稀，纵因休沐锁双扉。",
    "几回扶病欲相访，知向禁中归未归。"
  ],
  "enabled": true,
