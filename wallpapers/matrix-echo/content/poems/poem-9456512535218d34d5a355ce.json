{
  "id": "poem-9456512535218d34d5a355ce",
  "title": "春闺",
  "author": "沈佺期",
  "dynasty": "唐",
  "verses": [
    "铁马三军去，金闺二月还。",
    "边愁离上国，春梦失阳关。",
    "池水琉璃净，园花玳瑁斑。",
    "岁华空自掷，忧思不胜颜。"
  ],
  "enabled": true,
