{
  "id": "poem-39aab690ed5ede540021b528",
  "title": "小游仙诗九十八首 一",
  "author": "曹唐",
  "dynasty": "唐",
  "verses": [
    "玉箫金瑟发商声，桑叶枯干海水清。",
    "净埽蓬莱山下路，略邀王母话长生。"
  ],
