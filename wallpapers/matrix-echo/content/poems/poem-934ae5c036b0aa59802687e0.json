{
  "id": "poem-934ae5c036b0aa59802687e0",
  "title": "幽思",
  "author": "张碧",
  "dynasty": "唐",
  "verses": [
    "金炉烟霭微，锦釭残影灭。",
    "出户独裴回，落花满明月。"
  ],
