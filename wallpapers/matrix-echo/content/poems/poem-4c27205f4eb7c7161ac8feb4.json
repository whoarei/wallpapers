{
  "id": "poem-4c27205f4eb7c7161ac8feb4",
  "title": "苏小小墓",
  "author": "王镃",
  "dynasty": "宋",
  "verses": [
    "同心难结绣云长，红玉沉泥草亦香。",
    "娇魄年年寒食节，定应湖上作鸳鸯。"
  ],
  "enabled": true,
  "collection": "宋诗选",
