{
  "id": "poem-c8ef8ad4d39724962d56f77e",
  "title": "宫怨",
  "author": "李益",
  "dynasty": "唐",
  "verses": [
    "露湿晴花春殿香，月明歌吹在昭阳。",
    "似将海水添宫漏，共滴长门一夜长。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
