{
  "id": "poem-46b1b8a15c89ea4351048ff3",
  "title": "东门送客",
  "author": "李端",
  "dynasty": "唐",
  "verses": [
    "绿杨新草路，白发故乡人。",
    "既壮还应老，游梁复滞秦。",
    "逢花莫漫折，能有几多春。"
  ],
  "enabled": true,
