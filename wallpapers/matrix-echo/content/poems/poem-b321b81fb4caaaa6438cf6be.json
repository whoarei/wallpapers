{
  "id": "poem-b321b81fb4caaaa6438cf6be",
  "title": "柳二首 二",
  "author": "李绅",
  "dynasty": "唐",
  "verses": [
    "千条垂柳拂金丝，日暖牵风叶学眉。",
    "愁见花飞狂不定，还同轻薄五陵儿。"
  ],
  "enabled": true,
