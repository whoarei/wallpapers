{
  "id": "poem-794ef6956e8945098535997f",
  "title": "浣溪沙·五字诗中目乍成",
  "author": "纳兰性德",
  "dynasty": "清",
  "verses": [
    "五字诗中目乍成。",
    "尽教残福折书生。",
    "手挼裙带那时情。",
    "别后心期和梦杳，年来憔悴与愁并。",
    "夕阳依旧小窗明。"
  ],
  "enabled": true,
  "collection": "纳兰词",
