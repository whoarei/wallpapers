{
  "id": "poem-f86d45b7c1c10e5fdc1815d8",
  "title": "横吹曲辞 出塞",
  "author": "窦威",
  "dynasty": "唐",
  "verses": [
    "匈奴屡不平，汉将欲纵横。",
    "看云方结阵，却月始连营。",
    "潜军度马邑，扬斾掩龙城。",
    "会勒燕然石，方传车骑名。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
