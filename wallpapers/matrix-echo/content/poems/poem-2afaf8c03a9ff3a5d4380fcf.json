{
  "id": "poem-2afaf8c03a9ff3a5d4380fcf",
  "title": "望江南·多少泪",
  "author": "李煜",
  "dynasty": "五代",
  "verses": [
    "多少泪，断脸复横颐。",
    "心事莫将和泪说，凤笙休向泪时吹。",
    "肠断更无疑。"
  ],
  "enabled": true,
  "collection": "南唐二主词",
