{
  "id": "poem-8468930d715b2b30257097b2",
  "title": "闲游",
  "author": "张籍",
  "dynasty": "唐",
  "verses": [
    "老身不计人间事，野寺秋晴每独过。",
    "病眼校来犹断酒，却嫌行处菊花多。"
  ],
  "enabled": true,
