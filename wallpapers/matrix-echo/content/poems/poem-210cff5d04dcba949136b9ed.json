{
  "id": "poem-210cff5d04dcba949136b9ed",
  "title": "宫怨二首 一",
  "author": "柯崇",
  "dynasty": "唐",
  "verses": [
    "尘满金炉不炷香，黄昏独自立重廊。",
    "笙歌何处承恩宠，一一随风入上阳。"
  ],
  "enabled": true,
