{
  "id": "poem-4734952c7f70add2a157ead0",
  "title": "酬姚补阙南仲云溪馆中戏题随书见寄",
  "author": "皎然",
  "dynasty": "唐",
  "verses": [
    "寺溪临使府，风景借仁祠。",
    "补衮周官贵，能名汉主思。",
    "卧云知独处，望月忆同时。",
    "忽枉缄中赠，琼瑶满手持。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
