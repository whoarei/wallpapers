{
  "id": "poem-1ea35d14c54bd7218e1ece3a",
  "title": "送刘侍御",
  "author": "司空曙",
  "dynasty": "唐",
  "verses": [
    "狱成收夜烛，整豸出登车。",
    "黄叶辞荆楚，青山背汉初。",
    "早朝新羽衞，晚下步徒胥。",
    "应念长沙谪，思乡不食鱼。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
