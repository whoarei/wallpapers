{
  "id": "poem-29df12f8ee5c1317f095cf57",
  "title": "送吴郎西使成州",
  "author": "徐铉",
  "dynasty": "宋",
  "verses": [
    "所向皆为道，遐征岂足辞。",
    "中华垂尽处，别路正秋时。",
    "高阁兰台笔，闲吟板屋诗。",
    "良工无弃物，珍重岁寒姿。"
  ],
  "enabled": true,
  "collection": "宋诗选",
