{
  "id": "poem-2afec412857069febf0fe408",
  "title": "奉和正旦赐宰臣栢叶应制",
  "author": "武平一",
  "dynasty": "唐",
  "verses": [
    "绿叶迎春绿，寒枝历岁寒。",
    "愿持柏叶寿，长奉万年欢。"
  ],
