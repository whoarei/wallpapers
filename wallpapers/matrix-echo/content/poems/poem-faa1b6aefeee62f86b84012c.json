{
  "id": "poem-faa1b6aefeee62f86b84012c",
  "title": "始见二毛",
  "author": "鲍溶",
  "dynasty": "唐",
  "verses": [
    "玄发迎忧光色阑，衰华因镜强相看。",
    "百川赴海返潮易，一叶报秋归树难。",
    "初弄藕丝牵欲断，又惊机素翦仍残。",
    "颜生岂是光阴晚，余亦何人不自宽。"
  ],
  "enabled": true,
