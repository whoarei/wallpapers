{
  "id": "poem-fc054d030ff5075b325c1bff",
  "title": "落花",
  "author": "李咸用",
  "dynasty": "唐",
  "verses": [
    "拾得移时看，重思造化功。",
    "如何飘丽景，不似遇春风。",
    "满地余香在，繁枝一夜空。",
    "秪应公子见，先忆坠楼红。"
  ],
  "enabled": true,
