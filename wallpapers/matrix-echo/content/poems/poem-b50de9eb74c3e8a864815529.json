{
  "id": "poem-b50de9eb74c3e8a864815529",
  "title": "咏史诗 岘山",
  "author": "胡曾",
  "dynasty": "唐",
  "verses": [
    "晓日登临感晋臣，古碑零落岘山春。",
    "松间残露频频滴，酷似当时堕泪人。"
  ],
  "enabled": true,
