{
  "id": "poem-631fcd957722152a30f9dc36",
  "title": "古塞下曲四首 三",
  "author": "贯休",
  "dynasty": "唐",
  "verses": [
    "日向平沙出，还向平沙没。",
    "飞蓬落军营，惊雕去天末。",
    "帝乡青楼倚霄汉，歌吹掀天对花月。",
    "岂知塞上望乡人，日日双眸滴清血。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
