{
  "id": "poem-d93439f9e3758dd5e6fddee4",
  "title": "愁",
  "author": "徐夤",
  "dynasty": "唐",
  "verses": [
    "夜长偏觉漏声迟，往往随歌惨翠眉。",
    "黄叶落催砧杵日，子规啼破梦魂时。",
    "明妃去泣千行泪，蔡琰归梳两鬓丝。",
    "四皓入山招不得，无家归客最堪欺。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
