{
  "id": "poem-781e271a1a401f8265173c82",
  "title": "又一首",
  "author": "张𬸦",
  "dynasty": "唐",
  "verses": [
    "未必由诗得，将诗故表怜。",
    "闻渠掷入火，定是欲相然。",
    "。"
  ],
  "enabled": true,
