{
  "id": "poem-e90ce92c1100b8c82edf4680",
  "title": "下第别令狐员外",
  "author": "马戴",
  "dynasty": "唐",
  "verses": [
    "论文期雨夜，饮酒及芳晨。",
    "坐叹百花发，潜惊双鬓新。",
    "旧交多得路，别业远仍贫。",
    "便欲辞知己，归耕海上春。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
