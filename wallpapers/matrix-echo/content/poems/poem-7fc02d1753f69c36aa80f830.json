{
  "id": "poem-7fc02d1753f69c36aa80f830",
  "title": "次韵陈右史赏醉落托",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "罗幙低开护曲阑，娇红落托醉扶难。",
    "朝来嫩日疎云淡，纵有些风尽耐寒。"
  ],
  "enabled": true,
  "collection": "宋诗选",
