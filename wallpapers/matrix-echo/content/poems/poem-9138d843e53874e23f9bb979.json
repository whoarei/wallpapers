{
  "id": "poem-9138d843e53874e23f9bb979",
  "title": "容南初食荔枝二首  其二",
  "author": "李纲",
  "dynasty": "宋",
  "verses": [
    "买地城南种荔枝，毎留核付守园儿。",
    "但祈四海兵戈息，会见开花著子时。"
  ],
  "enabled": true,
