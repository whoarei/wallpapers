{
  "id": "poem-a1fb5ffb0ce261c9a73a80da",
  "title": "怡怡亭",
  "author": "王景云",
  "dynasty": "宋",
  "verses": [
    "老年常聚首，兄弟共怡怡。",
    "并坐闲挥麈，交斟醒设巵。",
    "双声频检韵，让道更敲棋。",
    "自是天伦乐，嬉游似少时。"
  ],
  "enabled": true,
  "collection": "宋诗选",
