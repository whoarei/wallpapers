{
  "id": "poem-8d25e590a7ab0b3e7a99c5ef",
  "title": "题刘氏绿映亭  其一",
  "author": "张栻",
  "dynasty": "宋",
  "verses": [
    "凉叶翻翻不受尘，芒鞋藤杖及清晨。",
    "开帘小放前溪入，澄绿光中独岸巾。"
  ],
  "enabled": true,
  "collection": "宋诗选",
