{
  "id": "poem-f3cbc07170e1d3a30336bb31",
  "title": "送流人",
  "author": "司空曙",
  "dynasty": "唐",
  "verses": [
    "闻说南中事，悲君重窜身。",
    "山村枫子鬼，江庙石郎神。",
    "童稚留荒宅，图书托故人。",
    "青门好风景，为尔一沾巾。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
