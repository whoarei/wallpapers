{
  "id": "poem-6f7e833cb35808ec98beb602",
  "title": "经涢川馆寄使府群公",
  "author": "李涉",
  "dynasty": "唐",
  "verses": [
    "涢川水竹十家余，渔艇蓬门对岸居。",
    "大胜尘中走鞍马，与他军府判文书。"
  ],
  "enabled": true,
