{
  "id": "poem-2e00d14f025644f4f1899d36",
  "title": "梅花",
  "author": "林宪",
  "dynasty": "宋",
  "verses": [
    "野梅空山中，正为照人开。",
    "如何绿窗底，疏映带苍苔。",
    "颇似古君子，无人自不谐。",
    "竹径酒初醒，一信清香来。"
  ],
  "enabled": true,
  "collection": "宋诗选",
