{
  "id": "poem-6825f8e973d22514b7d481af",
  "title": "送崔融",
  "author": "杜审言",
  "dynasty": "唐",
  "verses": [
    "君王行出将，书记远从征。",
    "祖帐连河阙，军麾动洛城。",
    "旌旗朝朔气，笳吹夜边声。",
    "坐觉烟尘少，秋风古北平。"
  ],
  "enabled": true,
  "collection": "千家诗",
  "tags": [],
