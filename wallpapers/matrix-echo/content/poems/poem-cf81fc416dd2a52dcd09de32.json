{
  "id": "poem-cf81fc416dd2a52dcd09de32",
  "title": "新楼诗二十首 望海亭",
  "author": "李绅",
  "dynasty": "唐",
  "verses": [
    "乌盈兔缺天涯迥，鹤背松梢拂槛低。",
    "湖镜坐隅看匣满，海涛生处辨云齐。",
    "夕岚明灭江帆小，烟树苍茫客思迷。",
    "萧索感心俱是梦，九天应共草萋萋。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
