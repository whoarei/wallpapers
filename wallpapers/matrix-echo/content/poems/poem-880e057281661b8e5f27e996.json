{
  "id": "poem-880e057281661b8e5f27e996",
  "title": "泛舟循惠间山水清绝口号四首  其一",
  "author": "李纲",
  "dynasty": "宋",
  "verses": [
    "雨过溪流没旧滩，舟行竟日画图间。",
    "重重翠绿相环揖，卧看王维著色山。"
  ],
  "enabled": true,
