{
  "id": "poem-c582e1c1d5fc7a3281184d2c",
  "title": "宫词  其五六",
  "author": "张公庠",
  "dynasty": "宋",
  "verses": [
    "倦饮情怀春晼晚，宫槐新叶未成阴。",
    "和风习习帘帘卷，轻絮翩翩院院深。"
  ],
  "enabled": true,
