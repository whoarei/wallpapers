{
  "id": "poem-3b25acf0aecd9bbb87b75808",
  "title": "送祖咏",
  "author": "卢象",
  "dynasty": "唐",
  "verses": [
    "田家宜伏腊，岁晏子言归。",
    "石路雪初下，荒村鸡共飞。",
    "东原多烟火，北涧隐寒晖。",
    "满酌野人酒，倦闻邻女机。",
    "胡为困樵采，几日罢朝衣。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
