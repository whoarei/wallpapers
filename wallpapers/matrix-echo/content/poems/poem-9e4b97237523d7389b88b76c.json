{
  "id": "poem-9e4b97237523d7389b88b76c",
  "title": "青山",
  "author": "米芾",
  "dynasty": "宋",
  "verses": [
    "一园松竹冷阴森，犹得桓公叹可临。",
    "却叵刘琨看左传，玉壶徒缺误雄心。"
  ],
  "enabled": true,
  "collection": "宋诗选",
