{
  "id": "poem-60c3acae00e2f738240ec9ed",
  "title": "感寓二首 一",
  "author": "梁德裕",
  "dynasty": "唐",
  "verses": [
    "彩云呈瑞质，五色发人寰。",
    "独作龙虎状，孤飞天地间。",
    "隐隐临北极，峨峨象南山。",
    "恨在帝乡外，不逢枝叶攀。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
