{
  "id": "poem-5cdacc49f53592d752c6a95b",
  "title": "白发",
  "author": "张载",
  "dynasty": "宋",
  "verses": [
    "白发千梳昼景暄，乌瓶一啜夜窗寒。",
    "庙堂勤苦茅斋静，不见人心是两般。"
  ],
  "enabled": true,
  "collection": "宋诗选",
