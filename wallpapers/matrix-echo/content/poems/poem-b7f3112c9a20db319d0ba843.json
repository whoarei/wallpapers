{
  "id": "poem-b7f3112c9a20db319d0ba843",
  "title": "诫贪",
  "author": "子兰",
  "dynasty": "唐",
  "verses": [
    "多求待心足，未足旋倾覆。",
    "明知贪者心，求荣不求辱。"
  ],
  "enabled": true,
