{
  "id": "poem-06b4f9916fb86b8978bb7b81",
  "title": "紫极宫",
  "author": "王镃",
  "dynasty": "宋",
  "verses": [
    "拜章台上月如霜，云湿阑干面面凉。",
    "道士醮归秋夜浄，满身薰得紫藤香。"
  ],
  "enabled": true,
  "collection": "宋诗选",
