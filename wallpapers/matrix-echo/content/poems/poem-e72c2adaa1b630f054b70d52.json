{
  "id": "poem-e72c2adaa1b630f054b70d52",
  "title": "沉机石",
  "author": "陈岩",
  "dynasty": "宋",
  "verses": [
    "忠诚为国心无累，简易临民讼自稀。",
    "与世相安真省事，若为作意苦沉机。"
  ],
  "enabled": true,
