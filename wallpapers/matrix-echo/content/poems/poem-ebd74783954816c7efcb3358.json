{
  "id": "poem-ebd74783954816c7efcb3358",
  "title": "峡哀 四",
  "author": "孟郊",
  "dynasty": "唐",
  "verses": [
    "峡乱鸣清磬，产石为鲜鳞。",
    "喷为腥雨涎，吹作黑井身。",
    "怪光闪众异，饿劒唯待人。",
    "老肠未曾饱，古齿崭岩嗔。",
    "嚼齿三峡泉，三峡声龂龂。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
