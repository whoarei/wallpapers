{
  "id": "poem-5c7aaeabdbd9a58d1c3b3393",
  "title": "次韵士特试谷帘泉见怀之作  其一",
  "author": "李纲",
  "dynasty": "宋",
  "verses": [
    "桑苎尝来第二泉，翠松偃盖色相鲜。",
    "谷帘窦乳争多少，西子南威各自妍。"
  ],
  "enabled": true,
  "collection": "宋诗选",
