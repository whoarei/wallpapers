{
  "id": "poem-e93207f1df70b827ff1bf6e1",
  "title": "采桑子·巂周声里严关峙",
  "author": "纳兰性德",
  "dynasty": "清",
  "verses": [
    "巂周声里严关峙，匹马登登，乱踏黄尘。",
    "听报邮签第几程。",
    "行人莫话前朝事，风雨诸陵，寂寞鱼灯。",
    "天寿山头冷月横。"
  ],
  "enabled": true,
  "collection": "纳兰词",
