{
  "id": "poem-b582b51e0f99f451c85a2bec",
  "title": "寄王侍御",
  "author": "谭用之",
  "dynasty": "宋",
  "verses": [
    "鸟尽弓藏良可哀，谁知归钓子陵台。",
    "炼多不信黄金耗，吟苦须惊白发催。",
    "喘月吴牛知夜至，嘶风胡马识秋来。",
    "燕歌别后休惆怅，黍已成畦菊已开。"
  ],
  "enabled": true,
  "collection": "宋诗选",
