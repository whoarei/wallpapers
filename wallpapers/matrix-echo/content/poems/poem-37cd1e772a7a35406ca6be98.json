{
  "id": "poem-37cd1e772a7a35406ca6be98",
  "title": "山花",
  "author": "李涉",
  "dynasty": "唐",
  "verses": [
    "六出花开赤玉盘，当中红湿耐春寒。",
    "长安若在五侯宅，谁肯将钱买牡丹。"
  ],
  "enabled": true,
