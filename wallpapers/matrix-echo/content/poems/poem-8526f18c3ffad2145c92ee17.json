{
  "id": "poem-8526f18c3ffad2145c92ee17",
  "title": "醉垂鞭·双蝶绣罗裙",
  "author": "张先",
  "dynasty": "宋",
  "verses": [
    "双蝶绣罗裙。",
    "东池宴。",
    "初相见。",
    "朱粉不深匀。",
    "闲花淡淡春。",
    "细看诸处好。",
    "人人道。",
    "柳腰身。",
    "昨日乱山昏。",
    "来时衣上云。"
  ],
  "enabled": true,
