{
  "id": "poem-886b22e6f4ce1f2ad02ebead",
  "title": "云封庵",
  "author": "徐凝",
  "dynasty": "唐",
  "verses": [
    "登岩背山河，立石秋风里。",
    "隐见浙江涛，一尺东沟水。"
  ],
  "enabled": true,
