{
  "id": "poem-1e5802928b1c607fc003e829",
  "title": "宫词  其九八",
  "author": "张公庠",
  "dynasty": "宋",
  "verses": [
    "自匀轻黛怯春寒，巧画双眉称绿鬟。",
    "楼上远山随指见，槛中新月对人弯。"
  ],
  "enabled": true,
