{
  "id": "poem-8ebdcd0768f0ad189f673c35",
  "title": "寄题江山叶氏翠香亭  其一",
  "author": "王柏",
  "dynasty": "宋",
  "verses": [
    "此君来与小山盟，共挹周扬一世英。",
    "何用偷它当日意，男儿自要立芳名。"
  ],
  "enabled": true,
