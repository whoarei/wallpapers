{
  "id": "poem-802dd2119c0315b26f560ac9",
  "title": "营州歌",
  "author": "高适",
  "dynasty": "唐",
  "verses": [
    "营州少年厌原野，狐裘蒙茸猎城下。",
    "虏酒千钟不醉人，胡儿十岁能骑马。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
  "tags": [
    "生活",
    "边塞"
  ],
