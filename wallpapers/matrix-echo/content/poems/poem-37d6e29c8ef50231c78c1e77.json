{
  "id": "poem-37d6e29c8ef50231c78c1e77",
  "title": "酬刘员外月下见寄",
  "author": "章八元",
  "dynasty": "唐",
  "verses": [
    "夜凉河汉白，卷箔出南轩。",
    "过月鸿争远，辞枝叶暗翻。",
    "独谣闻丽曲，缓步接清言。",
    "宣室思前席，行看拜主恩。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
