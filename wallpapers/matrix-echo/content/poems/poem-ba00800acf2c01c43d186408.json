{
  "id": "poem-ba00800acf2c01c43d186408",
  "title": "题安乐山",
  "author": "先汪",
  "dynasty": "唐",
  "verses": [
    "碧峰横倚白云端，隋氏真人化迹残。",
    "翠栢不凋龙骨瘦，石泉犹在镜光寒。"
  ],
  "enabled": true,
