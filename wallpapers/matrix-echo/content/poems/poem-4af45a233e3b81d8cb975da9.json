{
  "id": "poem-4af45a233e3b81d8cb975da9",
  "title": "谒云蓝山先越公墓",
  "author": "汪宗臣",
  "dynasty": "宋",
  "verses": [
    "此生未展云蓝墓，鬰鬰甘棠孙子情。",
    "今度忽为寒食客，欣欣乔木岁时荣。",
    "尧天日月重光显，越国江山几变更。",
    "回首千年有归鹤，练溪新涨匝春城。"
  ],
  "enabled": true,
  "collection": "宋诗选",
