{
  "id": "poem-6ccdd276ced1b72cb747bbd5",
  "title": "仙吕/点绛唇",
  "author": "杨景贤",
  "dynasty": "元",
  "verses": [
    "宝殿生香，美人扶向，瑶阶上。",
    "列七宝旌幢，端坐泥金亢。"
  ],
