{
  "id": "poem-ffb470dd1729a24d68d46350",
  "title": "减字木兰花·绿杨阴下",
  "author": "元绛",
  "dynasty": "宋",
  "verses": [
    "绿杨阴下。",
    "短帽轻衫行信马。",
    "过尽春风。",
    "踏尽青青打尽红。",
    "舞鸾歌凤。",
    "人面湖光红影动。",
    "醉眼归时。",
    "人在朱楼曲角西。"
  ],
  "enabled": true,
  "collection": "宋词选",
