{
  "id": "poem-955ceda4444bed685c0ce3fb",
  "title": "送人东游",
  "author": "温庭筠",
  "dynasty": "唐",
  "verses": [
    "荒戍落黄叶，浩然离故关。",
    "高风汉阳渡，初日郢门山。",
    "江上几人在，天涯孤櫂还。",
    "何当重相见，尊酒慰离颜。"
  ],
  "enabled": true,
