{
  "id": "poem-aeb5cf6419f8d24dc92f0df2",
  "title": "秾华",
  "author": "赵崇嶓",
  "dynasty": "宋",
  "verses": [
    "秾华侈春艳，松柏凌霜雪。",
    "芳时若转盼，万族畏销歇。",
    "人生金石交，所贵在黄发。",
    "同衾异寒燠，抱蕴应未察。",
    "贫贱张与陈，利达胡与越。",
    "安得皎洁心，长年似明月。"
  ],
  "enabled": true,
  "collection": "宋诗选",
