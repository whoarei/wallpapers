{
  "id": "poem-93d024b3eeed0ba2db51aada",
  "title": "郊庙歌辞 享太庙乐章 景云舞",
  "author": "张说",
  "dynasty": "唐",
  "verses": [
    "景云霏烂，告我帝符。",
    "噫帝冲德，与天为徒。",
    "笙镛遥远，俎豆虚无。",
    "春秋孝献，回复此都。"
  ],
  "enabled": true,
