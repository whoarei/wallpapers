{
  "id": "poem-bc006125073cf635465acd26",
  "title": "狼跋",
  "author": "佚名",
  "dynasty": "先秦",
  "verses": [
    "狼跋其胡，载疐其尾。公孙硕肤，赤舄几几。",
    "狼疐其尾，载跋其胡。公孙硕肤，德音不瑕？"
  ],
  "enabled": true,
  "collection": "诗经",
