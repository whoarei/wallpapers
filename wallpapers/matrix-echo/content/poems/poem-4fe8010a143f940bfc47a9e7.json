{
  "id": "poem-4fe8010a143f940bfc47a9e7",
  "title": "家书",
  "author": "宋伯仁",
  "dynasty": "宋",
  "verses": [
    "未得还乡泪欲珠，一书封了又踌躇。",
    "家人会得征夫意，门外西风即是书。"
  ],
  "enabled": true,
