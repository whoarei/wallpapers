{
  "id": "poem-cab8b1d0efbcba283984e9cd",
  "title": "多景楼",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "好山可是登临少，此地云胡应接多。",
    "天自有初恢壮观，人非无故辄悲歌。",
    "烟收三面平开镜，雨后双鬟对绾螺。",
    "欲辩南徐古徐话，忍将名刻细摩挲。"
  ],
  "enabled": true,
  "collection": "宋诗选",
