{
  "id": "poem-2e2f9ca370c6ef6eabfa6cbd",
  "title": "还家",
  "author": "于邺",
  "dynasty": "唐",
  "verses": [
    "为客忆归舍，归来还寂寥。",
    "壮时看欲过，白首固非遥。",
    "独酌几回醉，此愁终不销。",
    "犹残鸡与犬，驱去住山椒。"
  ],
  "enabled": true,
