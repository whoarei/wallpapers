{
  "id": "poem-69996a54292c7e0b0e970c4e",
  "title": "送若讷上人归衢州",
  "author": "苏颂",
  "dynasty": "宋",
  "verses": [
    "应供何来此，囊书谒紫宸。",
    "清闲频赐对，止观久谈真。",
    "恳谢兰袍宠，恩颁宝字新。",
    "重还乡寺日，学侣益归亲。"
  ],
  "enabled": true,
  "collection": "宋诗选",
