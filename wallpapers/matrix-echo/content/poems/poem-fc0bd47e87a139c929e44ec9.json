{
  "id": "poem-fc0bd47e87a139c929e44ec9",
  "title": "题十三弟竹园",
  "author": "刘言史",
  "dynasty": "唐",
  "verses": [
    "绕屋扶疎耸翠茎，苔滋粉漾有幽情。",
    "丹阳万户春光静，独自君家秋雨声。"
  ],
