{
  "id": "poem-029a2f44fb24e43733a1fade",
  "title": "南乡子·卧稻雨馀收",
  "author": "黄庭坚",
  "dynasty": "宋",
  "verses": [
    "卧稻雨馀收。",
    "处处游人簇远洲。",
    "白发又扶红袖醉，戎州。",
    "乱折黄花插满头。",
    "青眼想风流。",
    "画出西楼一帧秋。",
    "还把去年欢意舞，梁洲。",
    "塞雁西来特地愁。"
  ],
  "enabled": true,
  "collection": "宋词选",
