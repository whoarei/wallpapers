{
  "id": "poem-2aecb4defd45a803fef999d6",
  "title": "和韦舍人早朝",
  "author": "沈佺期",
  "dynasty": "唐",
  "verses": [
    "阊阖连云起，岩廊拂雾开。",
    "玉珂龙影度，珠履雁行来。",
    "长乐宵钟尽，明光晓奏催。",
    "一经推旧德，五字擢英才。",
    "俨若神仙去，纷从霄汉廻。",
    "千春奉休历，分禁喜趋陪。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
