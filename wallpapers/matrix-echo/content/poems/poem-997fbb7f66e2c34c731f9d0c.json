{
  "id": "poem-997fbb7f66e2c34c731f9d0c",
  "title": "夏日即事",
  "author": "吕从庆",
  "dynasty": "唐",
  "verses": [
    "结伴居山寺，超然见白云。",
    "境闲堪问道，客雅好论文。",
    "坐石惟看奕，行田或课耘。",
    "夜来尘俗语，不向梦中闻。"
  ],
  "enabled": true,
