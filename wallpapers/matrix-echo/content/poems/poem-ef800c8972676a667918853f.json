{
  "id": "poem-ef800c8972676a667918853f",
  "title": "金陵五题 乌衣巷",
  "author": "刘禹锡",
  "dynasty": "唐",
  "verses": [
    "朱雀桥边野草花，乌衣巷口夕阳斜。",
    "旧时王谢堂前燕，飞入寻常百姓家。"
  ],
  "enabled": true,
