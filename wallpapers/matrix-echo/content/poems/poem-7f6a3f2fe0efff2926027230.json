{
  "id": "poem-7f6a3f2fe0efff2926027230",
  "title": "别麻氏",
  "author": "赵嘏",
  "dynasty": "唐",
  "verses": [
    "晓哭呱呱动四隣，于君我作负心人。",
    "出门便涉东西路，回首初惊枕席尘。",
    "满眼泪珠和语咽，旧窗风月更谁亲。",
    "分离况值花时节，从此东风不似春。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
