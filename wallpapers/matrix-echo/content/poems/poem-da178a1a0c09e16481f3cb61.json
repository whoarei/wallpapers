{
  "id": "poem-da178a1a0c09e16481f3cb61",
  "title": "玉环山",
  "author": "王十朋",
  "dynasty": "宋",
  "verses": [
    "清有濯缨水，白有漱齿石。",
    "悠哉水石间，宦情聊自适。",
    "朝焉游其南，暮焉游其北。"
  ],
  "enabled": true,
  "collection": "宋诗选",
