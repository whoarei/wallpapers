{
  "id": "poem-589a2f05ba41afb0dc8147cf",
  "title": "蚕妇",
  "author": "来鹄",
  "dynasty": "唐",
  "verses": [
    "晓夕采桑多苦辛，好花时节不闲身。",
    "若教解爱繁华事，冻杀黄金屋里人。"
  ],
  "enabled": true,
