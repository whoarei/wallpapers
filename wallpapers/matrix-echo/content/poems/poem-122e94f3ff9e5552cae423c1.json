{
  "id": "poem-122e94f3ff9e5552cae423c1",
  "title": "甘园寻梅  其二",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "楮幌春生斗底房，不知冰结夜来霜。",
    "无因领略黄昏月，只遣疎钟管暗香。"
  ],
  "enabled": true,
