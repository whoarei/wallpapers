{
  "id": "poem-f7f12aab333ebf6e4201fb59",
  "title": "山鹧鸪词",
  "author": "徐凝",
  "dynasty": "唐",
  "verses": [
    "南越岭头山鹧鸪，传是当时守贞女。",
    "化为飞鸟怨何人，犹有啼声带蛮语。"
  ],
  "enabled": true,
