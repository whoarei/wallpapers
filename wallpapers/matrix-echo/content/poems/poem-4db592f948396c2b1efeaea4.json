{
  "id": "poem-4db592f948396c2b1efeaea4",
  "title": "游华山云际寺",
  "author": "张乔",
  "dynasty": "唐",
  "verses": [
    "少华中峰寺，高秋众景归。",
    "地连秦塞起，河隔晋山微。",
    "晚木蝉相应，凉天鴈并飞。",
    "殷勤记岩石，秪恐再来稀。"
  ],
  "enabled": true,
