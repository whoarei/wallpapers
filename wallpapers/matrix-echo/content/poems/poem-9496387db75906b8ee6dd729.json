{
  "id": "poem-9496387db75906b8ee6dd729",
  "title": "谒金门·春漏促",
  "author": "韦庄",
  "dynasty": "五代",
  "verses": [
    "春漏促，金烬暗挑残烛。",
    "一夜帘前风撼竹，梦魂相断续。",
    "有个娇娆如玉，夜夜绣屏孤宿。",
    "宋袍琵琶寻旧曲，远山眉黛绿。"
  ],
  "enabled": true,
  "collection": "花间集",
