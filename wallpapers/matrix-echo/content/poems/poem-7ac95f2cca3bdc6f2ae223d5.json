{
  "id": "poem-7ac95f2cca3bdc6f2ae223d5",
  "title": "书怀",
  "author": "于邺",
  "dynasty": "唐",
  "verses": [
    "长安多路岐，西去欲何依。",
    "浮世祗如此，旧山长忆归。",
    "自离京国久，应已故人稀。",
    "好与孤云住，孤云无是非。"
  ],
  "enabled": true,
