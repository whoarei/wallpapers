{
  "id": "poem-4c4baa780b5aa989b075aa50",
  "title": "次韵和复古春日五绝句  其一",
  "author": "司马光",
  "dynasty": "宋",
  "verses": [
    "雪霜哀鬓拔还生，桃李新园长未成。",
    "五十尚能胜六十，今年又灭去年情。"
  ],
  "enabled": true,
