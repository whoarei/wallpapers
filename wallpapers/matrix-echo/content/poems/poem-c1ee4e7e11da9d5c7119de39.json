{
  "id": "poem-c1ee4e7e11da9d5c7119de39",
  "title": "投赠张端公",
  "author": "孟郊",
  "dynasty": "唐",
  "verses": [
    "君子量不极，胸吞百川流。",
    "嫉邪霜气直，问俗春辞柔。",
    "日户昼辉静，月杯夜景幽。",
    "咏惊芙蓉发，笑激风飙秋。",
    "鸾步独无侣，鹤音仍寡俦。",
    "幸沾分寸顾，散此千万忧。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
