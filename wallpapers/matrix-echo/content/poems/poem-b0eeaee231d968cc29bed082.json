{
  "id": "poem-b0eeaee231d968cc29bed082",
  "title": "客夜与故人偶集",
  "author": "戴叔伦",
  "dynasty": "唐",
  "verses": [
    "天秋月又满，城阙夜千重。",
    "还作江南会，翻疑梦里逢。",
    "风枝惊暗鹊，露草覆寒蛩。",
    "羁旅长堪醉，相留畏晓钟。"
  ],
  "enabled": true,
