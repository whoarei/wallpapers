{
  "id": "poem-98a90fa93c403cf997fb9351",
  "title": "赠道人",
  "author": "曹松",
  "dynasty": "唐",
  "verses": [
    "住山因以福为庭，便向山中隐姓名。",
    "阆苑驾将雕羽去，洞天赢得绿毛生。",
    "日边肠胃餐霞火，月里肌肤饮露英。",
    "顾我从来断浮浊，拟驱鸡犬上三清。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
