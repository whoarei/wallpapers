{
  "id": "poem-6b27b34dace7d9deb2a604fc",
  "title": "清平乐·杏花时候",
  "author": "毛滂",
  "dynasty": "宋",
  "verses": [
    "杏花时候。",
    "庭下双梅瘦。",
    "天上流霞凝碧袖。",
    "起舞与君为寿。",
    "两桥风月同来。",
    "东堂且没尘埃。",
    "烟艇何时重理，更凭风月相催。"
  ],
  "enabled": true,
  "collection": "宋词选",
