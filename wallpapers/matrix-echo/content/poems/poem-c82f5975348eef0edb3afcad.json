{
  "id": "poem-c82f5975348eef0edb3afcad",
  "title": "和贾舍人早朝",
  "author": "王维",
  "dynasty": "唐",
  "verses": [
    "绛帻鸡人报晓筹，尚衣方进翠云裘。",
    "九天阊阖开宫殿，万国衣冠拜冕旒。",
    "日色才临仙掌动，香烟欲傍衮龙浮。",
    "朝罢须裁五色诏，佩声归到凤池头。"
  ],
  "enabled": true,
  "collection": "千家诗",
  "tags": [],
