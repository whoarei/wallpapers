{
  "id": "poem-fe76c30a5ca0d50d92fae079",
  "title": "别双温树",
  "author": "李绅",
  "dynasty": "唐",
  "verses": [
    "翠条盈尺怜孤秀，植向西窗待月轩。",
    "轻剪绿丝秋叶暗，密扶纤干夏阴繁。",
    "故山手种空怀想，温室心知不敢言。",
    "看尔拂云今得地，莫随陵谷改深根。"
  ],
  "enabled": true,
