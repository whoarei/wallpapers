{
  "id": "poem-4cfe3cb6a7f9005cee7d3e0c",
  "title": "却望无锡芙蓉湖 四",
  "author": "李绅",
  "dynasty": "唐",
  "verses": [
    "旧山认得烟岚近，湖水平铺碧岫间。",
    "喜见云泉还怅望，自慙山叟不归山。"
  ],
  "enabled": true,
