{
  "id": "poem-1ee0427dad3118c3aa54c391",
  "title": "送朴山人归新罗",
  "author": "马戴",
  "dynasty": "唐",
  "verses": [
    "浩渺行无极，扬帆但信风。",
    "云山过海半，乡树入舟中。",
    "波定遥天出，沙平远岸穷。",
    "离心寄何处，目断曙霞东。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
