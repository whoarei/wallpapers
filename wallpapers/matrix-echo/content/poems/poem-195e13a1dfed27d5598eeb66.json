{
  "id": "poem-195e13a1dfed27d5598eeb66",
  "title": "贫女",
  "author": "秦韬玉",
  "dynasty": "唐",
  "verses": [
    "蓬门未识绮罗香，拟托良媒益自伤。",
    "谁爱风流高格调，共怜时世俭梳妆。",
    "敢将十指夸偏巧，不把双眉鬬画长。",
    "苦恨年年压金线，为他人作嫁衣裳。"
  ],
  "enabled": true,
