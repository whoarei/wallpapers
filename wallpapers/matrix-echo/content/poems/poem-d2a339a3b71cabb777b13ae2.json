{
  "id": "poem-d2a339a3b71cabb777b13ae2",
  "title": "枝巢",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "欲扫嚣尘迹，枚条自改门。",
    "籁虚秋断续，花冷月黄昏。",
    "鸠拙休相笑，鸿冥倘可扪。",
    "逍遥与齐物，一等不须论。"
  ],
  "enabled": true,
  "collection": "宋诗选",
