{
  "id": "poem-772ac7733da0cc72760735b3",
  "title": "困中登山",
  "author": "佚名",
  "dynasty": "唐",
  "verses": [
    "戎庭闷且闲，谁复解愁颜。",
    "步步或登岭，悠悠时往还。",
    "野禽噪河曲，村犬吠林间。",
    "西北望君处，踌踷日暝山。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
