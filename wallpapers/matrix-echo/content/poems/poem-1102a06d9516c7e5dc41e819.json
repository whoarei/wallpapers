{
  "id": "poem-1102a06d9516c7e5dc41e819",
  "title": "赠别李山人",
  "author": "张乔",
  "dynasty": "唐",
  "verses": [
    "分合老西秦，年年梦白苹。",
    "曾为洞庭客，还送洞庭人。",
    "语别惜残夜，思归愁见春。",
    "遥知泊舟处，沙月自相亲。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
  "tags": [
    "洞庭湖"
  ],
