{
  "id": "poem-4d05a20f1ad57dd51c5887a5",
  "title": "感遇十二首 四",
  "author": "张九龄",
  "dynasty": "唐",
  "verses": [
    "孤鸿海上来，池潢不敢顾。",
    "侧见双翠鸟，巢在三珠树。",
    "矫矫珍木巅，得无金丸惧。",
    "美服患人指，高明逼神恶。",
    "今我游冥冥，弋者何所慕。"
  ],
  "enabled": true,
