{
  "id": "poem-6b1b719c49111a22abe5e443",
  "title": "寄远",
  "author": "赵嘏",
  "dynasty": "唐",
  "verses": [
    "禁钟声尽见栖禽，关塞迢迢故国心。",
    "无限春愁莫相问，落花流水洞房深。"
  ],
  "enabled": true,
