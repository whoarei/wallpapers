{
  "id": "poem-b862f53094928ae7f07ab428",
  "title": "仲春有怀  其一",
  "author": "张栻",
  "dynasty": "宋",
  "verses": [
    "青山四面拥江城，暮角声中淡月明。",
    "自倚阑干生白发，无心行乐趁春晴。"
  ],
  "enabled": true,
