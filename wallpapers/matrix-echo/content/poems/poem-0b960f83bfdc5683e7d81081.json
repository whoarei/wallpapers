{
  "id": "poem-0b960f83bfdc5683e7d81081",
  "title": "谴谪康州先寄弟渤",
  "author": "李涉",
  "dynasty": "唐",
  "verses": [
    "唯将直道信苍苍，可料无名抵宪章。",
    "阴隲却应先有谓，已交鸿鴈早随阳。"
  ],
