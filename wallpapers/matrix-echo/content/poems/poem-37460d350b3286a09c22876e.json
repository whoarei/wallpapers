{
  "id": "poem-37460d350b3286a09c22876e",
  "title": "将过江题白沙馆",
  "author": "徐铉",
  "dynasty": "宋",
  "verses": [
    "少长在维扬，依然认故乡。",
    "金陵佳丽地，不道少风光。",
    "稍望吴台远，行登楚塞长。",
    "殷勤语江岭，归梦莫相妨。"
  ],
  "enabled": true,
  "collection": "宋诗选",
