{
  "id": "poem-890caa557bb9ab4ca2234030",
  "title": "虞美人·落花已作风前舞",
  "author": "叶梦得",
  "dynasty": "宋",
  "verses": [
    "落花已作风前舞。",
    "又送黄昏雨。",
    "晓来庭院半残红。",
    "惟有游丝千丈、晴空。",
    "殷勤花下同携手。",
    "更尽杯中酒。",
    "美人不用敛蛾眉。",
    "我亦多情、无奈酒阑时。"
  ],
  "enabled": true,
