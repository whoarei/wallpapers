{
  "id": "poem-215a434f250c028b4cea40e1",
  "title": "咏怀古迹五首 五",
  "author": "杜甫",
  "dynasty": "唐",
  "verses": [
    "诸葛大名垂宇宙，宗臣遗像肃清高。",
    "三分割据纡筹策，万古云霄一羽毛。",
    "伯仲之间见伊吕，指挥若定失萧曹。",
    "福移汉祚难恢复，志决身歼军务劳。"
  ],
  "enabled": true,
