{
  "id": "poem-c5ed29b08560d1d5cfd0f871",
  "title": "赠小苏",
  "author": "关景仁",
  "dynasty": "宋",
  "verses": [
    "昔日闻苏小，今朝见小苏。",
    "未知苏小貌，得似小苏无。"
  ],
  "enabled": true,
  "collection": "宋诗选",
