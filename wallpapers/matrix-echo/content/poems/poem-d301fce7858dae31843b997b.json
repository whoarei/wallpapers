{
  "id": "poem-d301fce7858dae31843b997b",
  "title": "韦侍郎山居",
  "author": "王维",
  "dynasty": "唐",
  "verses": [
    "幸忝君子顾，遂陪尘外踪。",
    "闲花满岩谷，瀑水映杉松。",
    "啼鸟忽临涧，归云时抱峰。",
    "良游盛簪绂，继迹多夔龙。",
    "讵枉青门道，胡闻长乐钟。",
    "清晨去朝谒，车马何从容。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
