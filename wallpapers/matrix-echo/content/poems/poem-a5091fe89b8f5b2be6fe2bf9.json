{
  "id": "poem-a5091fe89b8f5b2be6fe2bf9",
  "title": "次韵和复古春日五绝句  其五",
  "author": "司马光",
  "dynasty": "宋",
  "verses": [
    "燕拂人衣絮扑头，红英满地绿阴稠。",
    "残春举目多愁思，休上迢迢百尺楼。"
  ],
  "enabled": true,
  "collection": "宋诗选",
