{
  "id": "poem-71153a5fe73b167639cf96ec",
  "title": "赤城李丹士",
  "author": "王镃",
  "dynasty": "宋",
  "verses": [
    "频年游岳洞，灵迹记无差。",
    "学得长生术，常留锻死砂。",
    "笛吹苍岛月，鞋踏赤城霞。",
    "又欲腾空去，寻仙到九华。"
  ],
  "enabled": true,
  "collection": "宋诗选",
