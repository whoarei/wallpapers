{
  "id": "poem-cf52c5fcb7e8b129578e4408",
  "title": "题伏龙寺壁",
  "author": "张栻",
  "dynasty": "宋",
  "verses": [
    "少日忆曾到，归途得小留。",
    "回还山寺古，萧瑟柿林秋。",
    "道路情无那，琴书可细求。",
    "从来士穷达，分付水悠悠。"
  ],
  "enabled": true,
  "collection": "宋诗选",
