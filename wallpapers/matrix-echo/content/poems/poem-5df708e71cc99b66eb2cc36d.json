{
  "id": "poem-5df708e71cc99b66eb2cc36d",
  "title": "至七里滩作",
  "author": "李嘉祐",
  "dynasty": "唐",
  "verses": [
    "迁客投于越，临江泪满衣。",
    "独随流水远，转觉故人稀。",
    "万木迎秋序，千峰驻晚晖。",
    "行舟犹未已，惆怅暮潮归。"
  ],
  "enabled": true,
