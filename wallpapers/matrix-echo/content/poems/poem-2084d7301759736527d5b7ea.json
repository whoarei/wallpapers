{
  "id": "poem-2084d7301759736527d5b7ea",
  "title": "咏刀子",
  "author": "张𬸦",
  "dynasty": "唐",
  "verses": [
    "自怜胶漆重，相思意不穷。",
    "不惜尖头物，终日在皮中。"
  ],
  "enabled": true,
