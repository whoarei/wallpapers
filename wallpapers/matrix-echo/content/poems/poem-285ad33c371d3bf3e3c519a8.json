{
  "id": "poem-285ad33c371d3bf3e3c519a8",
  "title": "送韦秀才",
  "author": "皎然",
  "dynasty": "唐",
  "verses": [
    "晨装行堕叶，万里望桑干。",
    "旧说泾关险，犹闻易水寒。",
    "黄云战后积，白草暮来看。",
    "近得君苗信，时教旅思宽。"
  ],
  "enabled": true,
