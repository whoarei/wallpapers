{
  "id": "poem-167c1d9d5fe6dfae3493e205",
  "title": "甘州子·露桃花里小楼深",
  "author": "顾敻",
  "dynasty": "五代",
  "verses": [
    "露桃花里小楼深，持玉盏，听瑶琴。",
    "醉归青琐入鸳衾，月色照衣襟。",
    "山枕上，翠钿镇眉心。"
  ],
  "enabled": true,
