{
  "id": "poem-b18b3d3b11385993f2283905",
  "title": "对雨闲吟呈吏部侍郎",
  "author": "李昉",
  "dynasty": "宋",
  "verses": [
    "羃羃浓云势未收，森森凉气忽如秋。",
    "密笼芳树飘何急，高卷疏帘看不休。",
    "咫尺莫闻人对语，逡巡已见水平流。",
    "此时遥忆诸君子，堪命棋枰与酒瓯。"
  ],
  "enabled": true,
  "collection": "宋诗选",
