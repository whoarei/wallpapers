{
  "id": "poem-9b039cbd38ddad89a795cc73",
  "title": "白鼍鸣",
  "author": "张籍",
  "dynasty": "唐",
  "verses": [
    "天欲雨，有东风，南谿白鼍鸣窟中。",
    "六月人家井无水，夜闻鼍声人尽起。"
  ],
  "enabled": true,
