{
  "id": "poem-dcd8bcaae7242a7af1126e2c",
  "title": "御书阁",
  "author": "王十朋",
  "dynasty": "宋",
  "verses": [
    "黄龙溪上祥云覆，紫帽山头瑞气蒙。",
    "俗眼惊传佛光现，不知宸翰在山中。"
  ],
  "enabled": true,
  "collection": "宋诗选",
