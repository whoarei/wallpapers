{
  "id": "poem-6cb55524d8201d538660cf77",
  "title": "代书寄泗州钱侍郎",
  "author": "徐铉",
  "dynasty": "宋",
  "verses": [
    "起部纡两绶，恢恢刃有余。",
    "既为侍中郎，又复专城居。",
    "无久恋铃阁，早应还直庐。",
    "浚川春水满，珍重寄双鱼。"
  ],
  "enabled": true,
  "collection": "宋诗选",
