{
  "id": "poem-e7f1004d1499f51993335bce",
  "title": "哭曲山人",
  "author": "司空曙",
  "dynasty": "唐",
  "verses": [
    "忆昔秋风起，君曾叹逐臣。",
    "何言芳草日，自作九泉人。"
  ],
  "enabled": true,
