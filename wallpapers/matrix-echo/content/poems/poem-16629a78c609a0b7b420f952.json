{
  "id": "poem-16629a78c609a0b7b420f952",
  "title": "玉真观",
  "author": "张籍",
  "dynasty": "唐",
  "verses": [
    "台殿曾为贵主家，春风吹尽竹窗纱。",
    "院中仙女修香火，不许闲人入看花。"
  ],
