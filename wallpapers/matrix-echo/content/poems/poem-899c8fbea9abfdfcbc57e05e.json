{
  "id": "poem-899c8fbea9abfdfcbc57e05e",
  "title": "酬郑毗踯躅咏",
  "author": "孟郊",
  "dynasty": "唐",
  "verses": [
    "不似人手致，岂关地势偏。",
    "孤光褭余翠，独影舞多妍。",
    "迸火烧闲地，红星堕青天。",
    "忽惊物表物，嘉客为留连。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
