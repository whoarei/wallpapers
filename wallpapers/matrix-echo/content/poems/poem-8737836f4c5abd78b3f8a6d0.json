{
  "id": "poem-8737836f4c5abd78b3f8a6d0",
  "title": "观妓",
  "author": "司空曙",
  "dynasty": "唐",
  "verses": [
    "翠蛾红脸不胜情，管绝弦余发一声。",
    "银烛摇摇尘暗下，却愁红粉泪痕生。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
