{
  "id": "poem-82d207ee2182a8ab528773b0",
  "title": "暮春杂咏八首  其二",
  "author": "曾协",
  "dynasty": "宋",
  "verses": [
    "莲沼琼瑶堕，萱庭锦绣张。",
    "静闻人语好，闲爱水风凉。",
    "藜杖休行乐，蒲团且坐忘。",
    "沙禽相识惯，趯趯近胡床。"
  ],
  "enabled": true,
  "collection": "宋诗选",
