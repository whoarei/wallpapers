{
  "id": "poem-6d6862c9d7dd8b72d3ba527d",
  "title": "咏怀古迹五首 一",
  "author": "杜甫",
  "dynasty": "唐",
  "verses": [
    "支离东北风尘际，漂泊西南天地间。",
    "三峡楼台淹日月，五溪衣服共云山。",
    "羯胡事主终无赖，词客衰时且未还。",
    "庾信平生最萧瑟，暮年诗赋动江关。"
  ],
  "enabled": true,
