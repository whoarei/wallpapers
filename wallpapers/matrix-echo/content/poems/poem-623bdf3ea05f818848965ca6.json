{
  "id": "poem-623bdf3ea05f818848965ca6",
  "title": "寄南中友人",
  "author": "张乔",
  "dynasty": "唐",
  "verses": [
    "相梦如相见，相思去后频。",
    "旧时行处断，华髪别来新。",
    "浪动三湘月，烟藏五岭春。",
    "又无归北客，书札寄何人。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
