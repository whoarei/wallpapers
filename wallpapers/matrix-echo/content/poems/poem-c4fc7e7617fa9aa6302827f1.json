{
  "id": "poem-c4fc7e7617fa9aa6302827f1",
  "title": "古镜",
  "author": "若虚",
  "dynasty": "唐",
  "verses": [
    "轩后红炉独铸成，藓痕磨落月轮呈。",
    "万般物象皆能鉴，一个人心不可明。",
    "匣内乍开鸾凤活，台前高挂鬼神惊。",
    "百年肝胆堪将比，祗怕看频素发生。"
  ],
  "enabled": true,
