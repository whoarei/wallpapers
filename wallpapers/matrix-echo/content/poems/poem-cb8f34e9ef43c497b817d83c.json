{
  "id": "poem-cb8f34e9ef43c497b817d83c",
  "title": "经王先生故居",
  "author": "赵嘏",
  "dynasty": "唐",
  "verses": [
    "晚波东去海茫茫，谁识蓬山不死乡。",
    "弄玉已归萧史去，碧楼红树倚斜阳。"
  ],
  "enabled": true,
