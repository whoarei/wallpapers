{
  "id": "poem-c64eadbca0ae2d7a030da2e3",
  "title": "秋宿经上人房",
  "author": "李洞",
  "dynasty": "唐",
  "verses": [
    "江房无叶落，松影带山高。",
    "满寺中秋月，孤窗入夜涛。",
    "旧真悬石壁，衰发落铜刀。",
    "卧听晓耕者，与师知苦劳。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
