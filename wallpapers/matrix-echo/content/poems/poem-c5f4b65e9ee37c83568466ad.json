{
  "id": "poem-c5f4b65e9ee37c83568466ad",
  "title": "伯时二马  其二",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "市骏爰从画骏谋，何如脱鞅纵骅骝。",
    "青青许负双眸子，不识骅骝只相牛。"
  ],
