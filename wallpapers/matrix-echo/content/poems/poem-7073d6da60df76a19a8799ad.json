{
  "id": "poem-7073d6da60df76a19a8799ad",
  "title": "峡哀 二",
  "author": "孟郊",
  "dynasty": "唐",
  "verses": [
    "上天下天水，出地入地舟。",
    "石劒相劈斫，石波怒蛟虬。",
    "花木叠宿春，风飙凝古秋。",
    "幽怪窟穴语，飞闻肸蚃流。",
    "沈哀日已深，衔诉将何求。"
  ],
  "enabled": true,
