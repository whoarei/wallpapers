{
  "id": "poem-57675d9145fa0157747bd11c",
  "title": "五祖再来赞",
  "author": "释了惠",
  "dynasty": "宋",
  "verses": [
    "前身后身，坐底立底。",
    "半假半真，全非全是。",
    "只因擡手肆乖张，万古黄梅如鼎沸。"
  ],
  "enabled": true,
  "collection": "宋诗选",
