{
  "id": "poem-82017735043fd0f9ddf88f14",
  "title": "废宅",
  "author": "周𣸣",
  "dynasty": "宋",
  "verses": [
    "牢落画堂空锁尘，荒凉庭树暗消春。",
    "豪家莫笑此中事，曾见此中人笑人。"
  ],
  "enabled": true,
