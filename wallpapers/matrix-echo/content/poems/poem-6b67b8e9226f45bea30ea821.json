{
  "id": "poem-6b67b8e9226f45bea30ea821",
  "title": "远寺钟",
  "author": "李嘉祐",
  "dynasty": "唐",
  "verses": [
    "疎钟何处来，度竹兼拂水。",
    "渐逐微风声，依依犹在耳。"
  ],
  "enabled": true,
