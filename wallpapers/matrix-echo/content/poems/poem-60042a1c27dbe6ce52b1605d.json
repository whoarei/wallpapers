{
  "id": "poem-60042a1c27dbe6ce52b1605d",
  "title": "上冯使君五首 一",
  "author": "贯休",
  "dynasty": "唐",
  "verses": [
    "撑船碧江上，春日何迟迟。",
    "汀花最深处，拾得鸳鸯儿。"
  ],
  "enabled": true,
