{
  "id": "poem-f38123d800a490d14afa05b4",
  "title": "除夜作",
  "author": "高适",
  "dynasty": "唐",
  "verses": [
    "旅馆寒灯独不眠，客心何事转凄然。",
    "故乡今夜思千里，愁鬓明朝又一年。"
  ],
  "enabled": true,
