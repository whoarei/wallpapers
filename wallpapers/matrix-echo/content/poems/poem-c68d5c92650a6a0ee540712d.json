{
  "id": "poem-c68d5c92650a6a0ee540712d",
  "title": "酬王哦松八景  其一",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "横玉临江展碧纨，冯夷庭院水晶寒。",
    "天教两赋酬风雅，不谓人闲作画看。"
  ],
  "enabled": true,
