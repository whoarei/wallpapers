{
  "id": "poem-71a785437279da6651eed114",
  "title": "清平乐·离愁万斛",
  "author": "向",
  "dynasty": "宋",
  "verses": [
    "离愁万斛。",
    "春思难拘束。",
    "瘦尽玉肌清彻骨。",
    "蹙损两眉秀绿。",
    "画屏罗幌输君。",
    "文鳞锦翼尤勤。",
    "长记酒醒香冷，笑将髻子隈人。"
  ],
  "enabled": true,
  "collection": "宋词选",
  "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/宋词/ci.song.2000.json#record-221",
