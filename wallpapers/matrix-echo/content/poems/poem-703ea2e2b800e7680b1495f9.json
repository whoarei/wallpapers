{
  "id": "poem-703ea2e2b800e7680b1495f9",
  "title": "石刻诗",
  "author": "陈抟",
  "dynasty": "宋",
  "verses": [
    "我谓浮荣真是幻，醉来舍辔谒高公。",
    "因聆玄论冥冥理，转觉尘寰一梦中。"
  ],
