{
  "id": "poem-64c3e67a5244adaa0302b8b2",
  "title": "归隐",
  "author": "陈抟",
  "dynasty": "宋",
  "verses": [
    "十年踪迹走红尘，回首青山入梦频。",
    "紫绶纵荣争及睡，朱门虽富不如贫。",
    "愁闻剑戟扶危主，闷听笙歌聒醉人。",
    "携取旧书归旧隐，野花啼鸟一般春。"
  ],
  "enabled": true,
  "collection": "千家诗",
  "tags": [],
