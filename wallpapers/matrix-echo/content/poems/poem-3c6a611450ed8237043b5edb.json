{
  "id": "poem-3c6a611450ed8237043b5edb",
  "title": "送孔征士",
  "author": "皇甫曾",
  "dynasty": "唐",
  "verses": [
    "谷口山多处，君归不可寻。",
    "家贫青史在，身老白云深。",
    "扫雪开松径，疏泉过竹林。",
    "余生负丘壑，相送亦何心。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
