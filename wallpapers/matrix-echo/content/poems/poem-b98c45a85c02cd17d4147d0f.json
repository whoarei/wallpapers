{
  "id": "poem-b98c45a85c02cd17d4147d0f",
  "title": "隋堤柳",
  "author": "李山甫",
  "dynasty": "唐",
  "verses": [
    "曾傍龙舟拂翠华，至今凝恨倚天涯。",
    "但经春色还秋色，不觉杨家是李家。",
    "背日古阴从北朽，逐波疎影向南斜。",
    "年年只有晴风便，遥为雷塘送雪花。"
  ],
  "enabled": true,
