{
  "id": "poem-71f92f53e3e87ec9e957ae12",
  "title": "秋闺",
  "author": "郑愔",
  "dynasty": "唐",
  "verses": [
    "征客向轮台，幽闺寂不开。",
    "音书秋鴈断，机杼夜蛩催。",
    "虚幌风吹叶，闲阶露湿苔。",
    "自怜愁思影，常共月裴回。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
