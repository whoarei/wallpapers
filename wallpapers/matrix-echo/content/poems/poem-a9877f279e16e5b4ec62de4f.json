{
  "id": "poem-a9877f279e16e5b4ec62de4f",
  "title": "巴江雨夜",
  "author": "杨凭",
  "dynasty": "唐",
  "verses": [
    "五岭天无雁，三巴客问津。",
    "纷纷轻汉暮，漠漠暗江春。",
    "青草连湖岸，繁花忆楚人。",
    "芳菲无限路，几夜月明新。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
