{
  "id": "poem-631552fc7ba4049eb9911849",
  "title": "赏春",
  "author": "路半千",
  "dynasty": "唐",
  "verses": [
    "暖日当头催展菜，和风次第遣开花。",
    "呼童远取溪心水，待客来煎柳眼茶。"
  ],
  "enabled": true,
