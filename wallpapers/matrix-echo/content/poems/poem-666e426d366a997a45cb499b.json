{
  "id": "poem-666e426d366a997a45cb499b",
  "title": "有赠",
  "author": "赵崇鉘",
  "dynasty": "宋",
  "verses": [
    "别意参差绕碧栏，外头斜月逼人寒。",
    "钩帘恐碍双栖鹊，乍可桃花隔雾看。"
  ],
  "enabled": true,
  "collection": "宋诗选",
