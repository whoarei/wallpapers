{
  "id": "poem-d9e7bf2ed65437138d86be9b",
  "title": "韦使君宅海榴咏",
  "author": "皇甫曾",
  "dynasty": "唐",
  "verses": [
    "淮阳卧理有清风，腊月榴花带雪红。",
    "闭阁寂寥常对此，江湖心在数枝中。"
  ],
  "enabled": true,
