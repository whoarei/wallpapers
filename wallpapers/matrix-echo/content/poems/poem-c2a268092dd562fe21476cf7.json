{
  "id": "poem-c2a268092dd562fe21476cf7",
  "title": "咏史诗 瑶池",
  "author": "胡曾",
  "dynasty": "唐",
  "verses": [
    "阿母瑶池宴穆王，九天仙乐送琼浆。",
    "漫矜八骏行如电，归到人间国已亡。"
  ],
