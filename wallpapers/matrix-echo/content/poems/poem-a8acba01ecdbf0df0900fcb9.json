{
  "id": "poem-a8acba01ecdbf0df0900fcb9",
  "title": "春秋战国门 田文",
  "author": "周昙",
  "dynasty": "唐",
  "verses": [
    "下客常才不足珍，谁为狗盗脱强秦。",
    "秦关若待鸡鸣出，笑杀临淄土偶人。"
  ],
