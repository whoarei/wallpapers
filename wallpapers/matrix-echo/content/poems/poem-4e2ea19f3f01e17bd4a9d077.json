{
  "id": "poem-4e2ea19f3f01e17bd4a9d077",
  "title": "次韵王省干  其一",
  "author": "陈造",
  "dynasty": "宋",
  "verses": [
    "南橘合嘉颂，为枳缘逾淮。",
    "黄浊转眼涸，一昨弥两涯。",
    "志士抱根柢，千古容兴怀。",
    "后生事虫篆，蚁穴鏖檀槐。"
  ],
  "enabled": true,
  "collection": "宋诗选",
