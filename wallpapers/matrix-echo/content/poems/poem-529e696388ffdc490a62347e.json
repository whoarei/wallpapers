{
  "id": "poem-529e696388ffdc490a62347e",
  "title": "题城南书院三十四咏  其二八",
  "author": "张栻",
  "dynasty": "宋",
  "verses": [
    "朝阳初上藕花香，下马虚亭一味凉。",
    "山鸟自呼鱼自乐，谁云身世可相忘。"
  ],
