{
  "id": "poem-499007cce0d25509e98dd8e5",
  "title": "广陵道",
  "author": "赵嘏",
  "dynasty": "唐",
  "verses": [
    "鬬鸡台边花照尘，炀帝陵下水含春。",
    "青云回翅北归雁，白首哭途何处人。"
  ],
  "enabled": true,
