{
  "id": "poem-74275bc899f19523bd8504a3",
  "title": "应天长·绿槐阴里黄莺语",
  "author": "韦庄",
  "dynasty": "五代",
  "verses": [
    "绿槐阴里黄莺语，深院无人春昼午。",
    "画帘垂，金凤舞，寂寞绣屏香一炷。",
    "碧天云，无定处，空有梦魂来去。",
    "夜夜绿窗风雨，断肠君信否。"
  ],
  "enabled": true,
