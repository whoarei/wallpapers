{
  "id": "poem-a0eed750f8f251ceabbe8cb4",
  "title": "偈颂七十一首  其四六",
  "author": "释了惠",
  "dynasty": "宋",
  "verses": [
    "虎生三子尾咤沙，咂舌垂涎弄爪牙。",
    "但见威风起岩窦，不知月照几千家。"
  ],
  "enabled": true,
