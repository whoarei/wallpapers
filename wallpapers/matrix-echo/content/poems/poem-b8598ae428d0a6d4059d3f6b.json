{
  "id": "poem-b8598ae428d0a6d4059d3f6b",
  "title": "题王况故居",
  "author": "刘言史",
  "dynasty": "唐",
  "verses": [
    "入巷萧条起悲绪，儿女犹居旧贫处。",
    "尘满空床屋见天，独作驴鸣一声去。"
  ],
  "enabled": true,
