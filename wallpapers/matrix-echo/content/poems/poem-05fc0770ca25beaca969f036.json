{
  "id": "poem-05fc0770ca25beaca969f036",
  "title": "郊庙歌辞 祭[太]社乐章 舒和",
  "author": "褚亮",
  "dynasty": "唐",
  "verses": [
    "神道发生敷九稼，阴极乘仁畅八埏。",
    "纬武经文隆景化，登祥荐祉启丰年。"
  ],
