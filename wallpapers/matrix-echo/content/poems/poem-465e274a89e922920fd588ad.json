{
  "id": "poem-465e274a89e922920fd588ad",
  "title": "九月二日",
  "author": "陈造",
  "dynasty": "宋",
  "verses": [
    "灯火一樽酒，笑语亦固然。",
    "如何棘围夜，忆归不成眠。",
    "衰怀动多感，妻儿须眼前。",
    "人生四方志，谁遣霜覆颠。"
  ],
  "enabled": true,
  "collection": "宋诗选",
