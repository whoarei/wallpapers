{
  "id": "poem-2cf72c75c5584f9287456443",
  "title": "登甘露寺",
  "author": "周繇",
  "dynasty": "唐",
  "verses": [
    "盘江上几层，峭壁半垂藤。",
    "殿锁南朝像，龛禅外国僧。",
    "海涛摏砌槛，山雨洒窗灯。",
    "日暮疎钟起，声声彻广陵。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
