{
  "id": "poem-94a7581e698b5233139bc445",
  "title": "泛舟",
  "author": "朱熹",
  "dynasty": "宋",
  "verses": [
    "昨夜江边春水生，艨艟巨舰一毛轻。",
    "向来枉费推移力，此日中流自在行。"
  ],
  "enabled": true,
  "collection": "千家诗",
