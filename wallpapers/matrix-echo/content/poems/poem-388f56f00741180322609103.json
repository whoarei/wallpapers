{
  "id": "poem-388f56f00741180322609103",
  "title": "听绍上人琴",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "悠然勇变划然鸣，古恨沉沉易水生。",
    "短发不禁愁触绪，恰如猿叫第三声。"
  ],
  "enabled": true,
