{
  "id": "poem-41cabbc10a4ddf2de89e7f2e",
  "title": "为有",
  "author": "李商隐",
  "dynasty": "唐",
  "verses": [
    "为有云屏无限娇，凤城寒尽怕春宵。",
    "无端嫁得金龟壻，辜负香衾事早朝。"
  ],
  "enabled": true,
  "collection": "唐诗三百首",
