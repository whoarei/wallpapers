{
  "id": "poem-9f365dcbbea98fe54d96dcc5",
  "title": "安居",
  "author": "宋伯仁",
  "dynasty": "宋",
  "verses": [
    "穷通岂在苦劳神，且作安居懒散人。",
    "买地种花多种竹，煮茶邀客也邀邻。",
    "求名岂识书三上，得兴无过醉一巡。",
    "喜得满𥰭收芋栗，杜陵应未笑全贫。"
  ],
  "enabled": true,
