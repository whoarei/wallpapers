{
  "id": "poem-47f0fc9f5bf122c81f1ec063",
  "title": "某忝被给札之召伏蒙景纯学士文丈宠示嘉篇且述早岁先人试职之日尝亦相遇于政府感怆不已辄次高韵",
  "author": "苏颂",
  "dynasty": "宋",
  "verses": [
    "先友勤渠庆得时，相逢仍在右垣扉。",
    "负山徒荷君恩重，起草多惭笔力微。",
    "早岁应门叨赏识，几年联襼接音徽。",
    "雕章华藻蒙褒贲，知我从今不患稀。"
  ],
  "enabled": true,
  "collection": "宋诗选",
  "tags": [],
  "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/全唐诗/poet.song.30000.json#record-52fe6939-0c8f-47cb-a425-ff744893ae67"
}
