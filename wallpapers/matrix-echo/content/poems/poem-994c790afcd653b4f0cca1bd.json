{
  "id": "poem-994c790afcd653b4f0cca1bd",
  "title": "上元侍宴",
  "author": "苏轼",
  "dynasty": "宋",
  "verses": [
    "淡月疏星绕建章，仙风吹下御炉香。",
    "侍臣鹄立通明殿，一朵红云捧玉皇。"
  ],
  "enabled": true,
  "collection": "千家诗",
