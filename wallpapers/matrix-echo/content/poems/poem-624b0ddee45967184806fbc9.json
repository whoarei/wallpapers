{
  "id": "poem-624b0ddee45967184806fbc9",
  "title": "宿龟山次韵",
  "author": "陈子高",
  "dynasty": "宋",
  "verses": [
    "潮回浪溅细沙倾，岸柳平波映眼明。",
    "桥接短亭连野迥，艇横长笛带风清。",
    "迢迢翠草寒烟暝，隠隠疏林暮霭晴。",
    "遥见叠峰清浅黛，客心伤处碧云轻。"
  ],
  "enabled": true,
  "collection": "宋诗选",
  "tags": [],
