{
  "id": "poem-231e3c8d95c0226a474e934d",
  "title": "观郡守题名",
  "author": "王十朋",
  "dynasty": "宋",
  "verses": [
    "春秋美恶不嫌同，老子韩非一传中。",
    "壁上题名二百辈，卓然名世两三公。"
  ],
  "enabled": true,
