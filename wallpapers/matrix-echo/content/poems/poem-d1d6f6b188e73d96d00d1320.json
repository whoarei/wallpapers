{
  "id": "poem-d1d6f6b188e73d96d00d1320",
  "title": "送华阴隐者",
  "author": "项斯",
  "dynasty": "唐",
  "verses": [
    "往往到城市，得非征药钱。",
    "世人空识面，弟子莫知年。",
    "自说能医死，相期更学仙。",
    "近来移住处，毛女旧峰前。"
  ],
  "enabled": true,
