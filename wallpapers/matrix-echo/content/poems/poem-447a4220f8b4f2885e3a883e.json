{
  "id": "poem-447a4220f8b4f2885e3a883e",
  "title": "送方外上人",
  "author": "刘长卿",
  "dynasty": "唐",
  "verses": [
    "孤云将野鹤，岂向人间住。",
    "莫买沃洲山，时人已知处。"
  ],
  "enabled": true,
