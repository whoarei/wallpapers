{
  "id": "poem-52c765f5e0f15c13bf7225c0",
  "title": "相思",
  "author": "王维",
  "dynasty": "唐",
  "verses": [
    "红豆生南国，秋来发故枝。",
    "愿君多采撷，此物最相思。"
  ],
