{
  "id": "poem-a5d6b4007dd464544fd77acb",
  "title": "塞北二首 一",
  "author": "沈佺期",
  "dynasty": "唐",
  "verses": [
    "虏障天骄起，秦城地脉分。",
    "柏坛飞五将，梅吹动三军。",
    "锋刃奔涛色，旌旗焰火文。",
    "朔风吹汗漫，飘砾洒轒辒。",
    "海气如秋雨，边烽似夏云。",
    "二庭无岁月，百战有功勋。",
    "形影随鱼贯，音书在雁群。",
    "归来拜天子，凯乐助南薰。"
  ],
  "enabled": true,
