{
  "id": "poem-28002f0ce54c7ba378574929",
  "title": "酬举生许遇山居",
  "author": "李涉",
  "dynasty": "唐",
  "verses": [
    "琉璃潭上新秋月，清净泉中智惠珠。",
    "不似本宗疎二教，许过云壑访潜夫。"
  ],
