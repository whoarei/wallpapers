{
  "id": "poem-abf83c31cb698806da2bd13e",
  "title": "秋日金陵制幕书事  其三",
  "author": "王同祖",
  "dynasty": "宋",
  "verses": [
    "哨马纷纷一水间，渡头分戍要防奸。",
    "可怜生计渔舟者，官给旗牌禁往还。"
  ],
