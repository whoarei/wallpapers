{
  "id": "poem-19de77e7e2018bb58a45ab99",
  "title": "柳枝·软碧瑶烟似送人",
  "author": "和凝",
  "dynasty": "五代",
  "verses": [
    "软碧瑶烟似送人，映花时把翠蛾颦。",
    "青青自是风流主，慢飐金丝待洛神。"
  ],
  "enabled": true,
