{
  "id": "poem-c4aa939078c7f08b0826cb49",
  "title": "雪霁晨起",
  "author": "李德裕",
  "dynasty": "唐",
  "verses": [
    "雪覆寒溪竹，风卷野田蓬。",
    "四望无竹迹，谁怜孤老翁。"
  ],
  "enabled": true,
