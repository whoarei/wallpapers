{
  "id": "poem-95d8a6c02352c0bbb40f3273",
  "title": "遣兴三首 二",
  "author": "杜甫",
  "dynasty": "唐",
  "verses": [
    "高秋登塞山，南望马邑州。",
    "降虏东击胡，壮健尽不留。",
    "穹庐莽牢落，上有行云愁。",
    "老弱哭道路，愿闻甲兵休。",
    "邺中事反复，死人积如丘。",
    "诸将已茅土，载驱谁与谋。"
  ],
  "enabled": true,
