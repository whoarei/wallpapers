{
  "id": "poem-f10b5d74f18fa2654c8ada59",
  "title": "咏史诗 五湖",
  "author": "胡曾",
  "dynasty": "唐",
  "verses": [
    "东上高山望五湖，雪涛烟浪起天隅。",
    "不知范蠡乘舟后，更有功臣继踵无。"
  ],
  "enabled": true,
