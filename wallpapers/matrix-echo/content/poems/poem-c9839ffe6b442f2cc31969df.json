{
  "id": "poem-c9839ffe6b442f2cc31969df",
  "title": "小游仙诗九十八首 六十五",
  "author": "曹唐",
  "dynasty": "唐",
  "verses": [
    "水满桑田白日沈，冻云干霰湿重阴。",
    "辽东归客闲相过，因话尧年雪更深。"
  ],
