{
  "id": "poem-dba120a7e030eb499290e2b2",
  "title": "城南即事  其一",
  "author": "张栻",
  "dynasty": "宋",
  "verses": [
    "活泉细引忽盈沟，自遶书斋堦堦流。",
    "添得眼前无限思，石桥竹坞共清幽。"
  ],
  "enabled": true,
