{
  "id": "poem-73630712f7f28055764b51ee",
  "title": "偈颂七十一首  其六七",
  "author": "释了惠",
  "dynasty": "宋",
  "verses": [
    "大机普应，妙用全彰。",
    "井通沧海，日上扶桑。",
    "击石火，闪电光。",
    "进前先蹉过，退后绝承当。"
  ],
  "enabled": true,
  "collection": "宋诗选",
