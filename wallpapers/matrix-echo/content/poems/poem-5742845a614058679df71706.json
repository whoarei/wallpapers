{
  "id": "poem-5742845a614058679df71706",
  "title": "送永阳崔明府",
  "author": "司空曙",
  "dynasty": "唐",
  "verses": [
    "古国群舒地，前当桐柏关。",
    "连绵江上雨，稠叠楚南山。",
    "沙馆行帆息，枫洲候吏还。",
    "乘篮若有暇，精舍在林间。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
