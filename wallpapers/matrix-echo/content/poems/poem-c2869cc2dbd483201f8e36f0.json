{
  "id": "poem-c2869cc2dbd483201f8e36f0",
  "title": "怨情",
  "author": "李白",
  "dynasty": "唐",
  "verses": [
    "美人卷珠帘，深坐颦蛾眉。",
    "但见泪痕湿，不知心恨谁。"
  ],
  "enabled": true,
