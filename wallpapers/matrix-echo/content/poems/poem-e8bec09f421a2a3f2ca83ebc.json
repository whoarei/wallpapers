{
  "id": "poem-e8bec09f421a2a3f2ca83ebc",
  "title": "张荃翁赴浦江丞而丧耦唁荃翁谢获轩见寄  其二",
  "author": "释居简",
  "dynasty": "宋",
  "verses": [
    "绝笑诸郎似乃翁，荃翁又自去哦松。",
    "捄焚赏必先焦额，欲雨香非后土龙。",
    "徵调苦多忘惜日，燮调伤煖不成冬。",
    "吴江短楫华亭月，称副茎虀藐万锺。"
  ],
  "enabled": true,
  "collection": "宋诗选",
  "tags": [],
