{
  "id": "poem-d30cb27ce20c7f41e1075831",
  "title": "夜携酒访崔正字",
  "author": "刘得仁",
  "dynasty": "唐",
  "verses": [
    "只应芸阁吏，知我僻兼愚。",
    "吟兴忘饥冻，生涯任有无。",
    "惨云埋远岫，阴吹吼寒株。",
    "忽起围炉思，招携酒满壶。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
