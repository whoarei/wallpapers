{
  "id": "poem-e1fb81311d22124d360f0a6f",
  "title": "感石浮图",
  "author": "王英",
  "dynasty": "唐",
  "verses": [
    "树福金岩顶，粧岩琢石成。",
    "真容绘美素，图镂万年荣。"
  ],
