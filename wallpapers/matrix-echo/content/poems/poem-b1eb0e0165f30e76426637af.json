{
  "id": "poem-b1eb0e0165f30e76426637af",
  "title": "括浙江潮候",
  "author": "释赞宁",
  "dynasty": "宋",
  "verses": [
    "午未未未申，申卯卯辰辰。",
    "巳巳巳午午，朔望一般轮。"
  ],
