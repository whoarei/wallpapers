{
  "id": "poem-9fb09fedf7c8ee85033fc5ef",
  "title": "和张仆射塞下曲 一",
  "author": "卢纶",
  "dynasty": "唐",
  "verses": [
    "鹫翎金仆姑，燕尾绣蝥弧。",
    "独立扬新令，千营共一呼。"
  ],
