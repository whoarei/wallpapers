{
  "id": "poem-791a20b76bccc93c12c30b4c",
  "title": "句",
  "author": "陈上卿",
  "dynasty": "唐",
  "verses": [
    "门前萧索青松老，云里逍遥白鹤闲。",
    "波澜晴泛三春色，桃李争开两岸芳。"
  ],
  "enabled": true,
