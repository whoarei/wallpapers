{
  "id": "poem-8110654245dd52d78ca24bbb",
  "title": "送欧阳衮归闽中",
  "author": "项斯",
  "dynasty": "唐",
  "verses": [
    "秦城几年住，犹著故乡衣。",
    "失意时相识，成名后独归。",
    "海秋蛮树黑，岭夜瘴禽飞。",
    "为学心难满，知君更掩扉。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
