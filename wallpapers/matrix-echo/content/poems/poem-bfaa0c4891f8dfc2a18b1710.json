{
  "id": "poem-bfaa0c4891f8dfc2a18b1710",
  "title": "杜少府之任蜀州",
  "author": "王勃",
  "dynasty": "唐",
  "verses": [
    "城阙辅三秦，风烟望五津。",
    "与君离别意，同是宦游人。",
    "海内存知己，天涯若比隣。",
    "无为在岐路，儿女共沾巾。"
  ],
  "enabled": true,
