{
  "id": "poem-17d1a4b866eb01126478b1e4",
  "title": "夏日登车盖亭",
  "author": "蔡确",
  "dynasty": "宋",
  "verses": [
    "纸屏石枕竹方床，手倦抛书午梦长。",
    "睡起莞然成独笑，数声渔笛在沧浪。"
  ],
  "enabled": true,
