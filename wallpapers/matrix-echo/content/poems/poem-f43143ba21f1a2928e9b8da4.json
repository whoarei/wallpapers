{
  "id": "poem-f43143ba21f1a2928e9b8da4",
  "title": "送韦员外还京",
  "author": "崔峒",
  "dynasty": "唐",
  "verses": [
    "十年离乱后，此去若为情。",
    "春晚香山绿，人稀豫水清。",
    "野陂看独树，关路逐残莺。",
    "前殿朝明主，应怜白发生。"
  ],
  "enabled": true,
