{
  "id": "poem-aaac345cdb2915d9634008a3",
  "title": "乌夜啼·月儿犹未全明",
  "author": "张镃",
  "dynasty": "宋",
  "verses": [
    "月儿犹未全明。",
    "乞怜生。",
    "几片彩云来去、更风轻。",
    "应见我。",
    "行又坐。",
    "苦凝情。",
    "卷起帘儿不睡、到三更。"
  ],
  "enabled": true,
  "collection": "宋词选",
  "source": "https://github.com/chinese-poetry/chinese-poetry/blob/b8594f81a89752241442f2ce267d6f66f96704ee/宋词/ci.song.6000.json#record-327",
