{
  "id": "poem-66b1b939e47dd7f5a1e868ad",
  "title": "伤春",
  "author": "杨万里",
  "dynasty": "宋",
  "verses": [
    "准拟今春乐事浓，依然枉却一东风。",
    "年年不带看花眼，不是愁中即病中。"
  ],
  "enabled": true,
  "collection": "千家诗",
