{
  "id": "poem-621c751aaaf4fc54d0bc305f",
  "title": "又",
  "author": "吕从庆",
  "dynasty": "唐",
  "verses": [
    "隔绝羊肠已数旬，到来春霭正盈盈。",
    "山神拟欲求新句，牵住衣裳不放行。"
  ],
