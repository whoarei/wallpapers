{
  "id": "poem-e1a6d6a1bd5355cc9ecdefa2",
  "title": "葛仙井",
  "author": "任翻",
  "dynasty": "唐",
  "verses": [
    "古井碧沈沈，分明见百寻。",
    "味甘传邑内，脉冷应山心。",
    "圆入月轮净，直涵峰影深。",
    "自从仙去后，汲引到如今。"
  ],
  "enabled": true,
