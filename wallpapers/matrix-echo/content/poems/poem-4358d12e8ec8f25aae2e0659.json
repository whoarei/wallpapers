{
  "id": "poem-4358d12e8ec8f25aae2e0659",
  "title": "坐睡",
  "author": "赵文",
  "dynasty": "宋",
  "verses": [
    "非痴非梦小瞢腾，瞑坐还同入定僧。",
    "口似汝阳狂见曲，头疑季子困悬绳。",
    "儿来问字几三退，客苦多言彊一应。",
    "日日如期不相贷，世情谁似尔堪凭。"
  ],
  "enabled": true,
  "collection": "宋诗选",
