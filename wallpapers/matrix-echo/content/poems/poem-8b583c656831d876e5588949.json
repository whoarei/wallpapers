{
  "id": "poem-8b583c656831d876e5588949",
  "title": "宛陵馆冬青树",
  "author": "赵嘏",
  "dynasty": "唐",
  "verses": [
    "碧树如烟覆晚波，清秋欲尽客重过。",
    "故园亦有如烟树，鸿雁不来风雨多。"
  ],
  "enabled": true,
