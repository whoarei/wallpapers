{
  "id": "poem-7fc72ebd0a1939f6c0536a4f",
  "title": "江村夜泊",
  "author": "项斯",
  "dynasty": "唐",
  "verses": [
    "日落江路黑，前村人语稀。",
    "几家深树里，一火夜渔归。"
  ],
  "enabled": true,
