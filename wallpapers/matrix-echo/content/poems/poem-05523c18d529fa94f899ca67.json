{
  "id": "poem-05523c18d529fa94f899ca67",
  "title": "瑶池",
  "author": "李商隐",
  "dynasty": "唐",
  "verses": [
    "瑶池阿母绮窗开，黄竹歌声动地哀。",
    "八骏日行三万里，穆王何事不重来。"
  ],
  "enabled": true,
