{
  "id": "poem-9fd169054677e93bf91ad4b2",
  "title": "早起",
  "author": "杨厚",
  "dynasty": "唐",
  "verses": [
    "星汉转寒更，伊余索寞情。",
    "钟催归梦断，雁引远愁生。",
    "危壁兰光暗，疎帘露气清。",
    "闲庭聊一望，海日为分明。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
