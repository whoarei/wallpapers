{
  "id": "poem-57831c6f41d225c5bdc142f6",
  "title": "汴河曲",
  "author": "李益",
  "dynasty": "唐",
  "verses": [
    "汴水东流无限春，隋家宫阙已成尘。",
    "行人莫上长堤望，风起杨花愁杀人。"
  ],
