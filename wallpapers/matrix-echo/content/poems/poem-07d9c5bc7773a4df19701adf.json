{
  "id": "poem-07d9c5bc7773a4df19701adf",
  "title": "寄西山胡汾吴樵",
  "author": "贯休",
  "dynasty": "唐",
  "verses": [
    "带经锄陇者，何止手胼胝。",
    "觅句句句好，慙予筋力衰。",
    "云塠临案冷，鹿队过门迟。",
    "相忆空回首，江头日暮时。"
  ],
  "enabled": true,
  "collection": "全唐诗选",
