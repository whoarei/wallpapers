{
  "id": "poem-51f775f8d5fc6153ec912a01",
  "title": "又泛西溪诗十首  其五",
  "author": "刘跂",
  "dynasty": "宋",
  "verses": [
    "天生桥畔水交流，夹岸花飞逐客舟。",
    "时听山禽歌一曲，何须吹笛舞凉州。"
  ],
  "enabled": true,
