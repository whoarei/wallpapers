{
  "id": "poem-3e506e3cda842b13d652c73a",
  "title": "贺王起",
  "author": "广宣",
  "dynasty": "唐",
  "verses": [
    "从辞凤阁掌丝纶，便向青云领贡宾。",
    "再辟文场无枉路，两开金榜绝冤人。",
    "眼看龙化门前水，手放莺飞谷口春。",
    "明日定归台席去，鹡鸰原上共陶钧。"
  ],
  "enabled": true,
