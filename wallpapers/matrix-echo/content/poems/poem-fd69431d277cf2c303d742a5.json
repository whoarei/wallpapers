{
  "id": "poem-fd69431d277cf2c303d742a5",
  "title": "宋中十首 二",
  "author": "高适",
  "dynasty": "唐",
  "verses": [
    "朝临孟诸上，忽见芒砀间。",
    "赤帝终已矣，白云长不还。",
    "时清更何有，禾黍徧空山。"
  ],
  "enabled": true,
