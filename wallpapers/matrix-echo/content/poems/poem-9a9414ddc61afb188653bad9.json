{
  "id": "poem-9a9414ddc61afb188653bad9",
  "title": "人日",
  "author": "林滋",
  "dynasty": "唐",
  "verses": [
    "春辉新入碧烟开，芳院初将穆景来。",
    "共向花前图瑞胜，试看池上动轻苔。",
    "林香半落沾罗幌，蕙色微含近酒桮。",
    "闻道宸游方命赏，应随恩赉喜昭回。"
  ],
  "enabled": true,
