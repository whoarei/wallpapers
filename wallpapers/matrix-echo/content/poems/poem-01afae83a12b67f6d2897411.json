{
  "id": "poem-01afae83a12b67f6d2897411",
  "title": "颂古七十六首  其一四",
  "author": "释士珪",
  "dynasty": "宋",
  "verses": [
    "江西一喝动乾坤，大用全机是灭门。",
    "三日耳聋风过树，累他黄蘖丧儿孙。"
  ],
  "enabled": true,
