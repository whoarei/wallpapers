{
  "id": "poem-99385719c359f7bd3e792bc7",
  "title": "经古墓",
  "author": "熊孺登",
  "dynasty": "唐",
  "verses": [
    "碑折松枯山火烧，夜台从闭不曾朝。",
    "那将逝者比流水，流水东流逢上潮。"
  ],
  "enabled": true,
