{
  "id": "poem-2a6a78d0c09e7ea09f4fdcb4",
  "title": "庙山道中",
  "author": "王同祖",
  "dynasty": "宋",
  "verses": [
    "萧萧疏雨点孤蓬，舟子招呼语顺风。",
    "小麦青青春恰半，一犂江上看田翁。"
  ],
  "enabled": true,
  "collection": "宋诗选",
