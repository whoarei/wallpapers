{
  "id": "poem-81d0e17997fe5185bcd84ef6",
  "title": "代陈季若上张帅  其四",
  "author": "林光朝",
  "dynasty": "宋",
  "verses": [
    "长陪彩仗下蓬莱，万岁声中霁色开。",
    "自是北门须卧护，双旌迢递日边来。"
  ],
