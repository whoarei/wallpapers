{
  "id": "poem-2d34e2e4e482fb889aab764b",
  "title": "新节",
  "author": "司空图",
  "dynasty": "唐",
  "verses": [
    "转悲新岁重于山，不似轻鸥肯复还。",
    "朱绂纵教金印换，青云未胜白头闲。"
  ],
  "enabled": true,
