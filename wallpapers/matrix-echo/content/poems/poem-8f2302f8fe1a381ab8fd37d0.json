{
  "id": "poem-8f2302f8fe1a381ab8fd37d0",
  "title": "上长庆和尚偈（题拟）",
  "author": "王延彬",
  "dynasty": "唐",
  "verses": [
    "世人悟道非从耳，耳患虽加道亦分。",
    "灵鹫一机迦叶会，吾师传得岂关闻。",
    "（《祖堂集》卷十。",
    "）。"
  ],
