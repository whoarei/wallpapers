{
  "id": "poem-e77ff80223dd6ee4b0835191",
  "title": "田漏",
  "author": "林之奇",
  "dynasty": "宋",
  "verses": [
    "古星昏晓中，寒暑已不疑。",
    "田家更置漏，寸晷亦欲知。",
    "汗与水俱滴，身随阴屡移。",
    "谁当哀此劳，往往夺其时。"
  ],
  "enabled": true,
  "collection": "宋诗选",
